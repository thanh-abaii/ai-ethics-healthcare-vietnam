    <!-- divider start -->
    <section class="service-area over-layer-default" style="background-image: url(/Images/bg/5.jpg); display: none" id="home_box_5">
        <div class="container padding-top-40">
            <div class="section-content">
                <div class="row">
                    <div class="col-md-6">
                        <div class="booking-from">
                            <h2 id="booking_title"></h2>
                            <div class="border-style-2 margin-bottom-30"></div>
                            <p class="margin-bottom-20" id="booking_message"></p>
                            <form method="post" action="#" id="form_contact" onsubmit="return CheckFormContact()">
                                <div class="row">
                                    <div class="col-md-6">
                                        <input type="text" name="CTEN" id="CTEN" class="form-control" placeholder="Họ và tên *" required>
                                    </div>
                                    <div class="col-md-6">
                                        <input type="text" name="CSDT" id="CSDT" class="form-control" placeholder="Số điện thoại" required>
                                    </div>
                                    <div class="col-md-6">
                                        <input type="email" name="CEMAIL" class="form-control" placeholder="Email *" id="CEMAIL" required>
                                    </div>
                                    <div class="col-md-6">
                                        <input type="text" name="CDIACHI" class="form-control" placeholder="Địa chỉ" id="CDIACHI" required>
                                    </div>
                                    <div class="col-md-12">
                                        <div class="contact-textarea">
                                            <textarea class="form-control" rows="2" placeholder="Thắc mắc, góp ý,... *" id="message" name="message" required></textarea>
                                            <button class="btn btn-theme" id="submit_form" type="submit" value="Submit Form">Gửi thông tin</button>
                                        </div>
                                    </div>
                                    <input type="hidden" name="contact_lang" id="contact_lang" />
                                    <div id="form-messages"></div>

                                </div>
                            </form>
                            <div id="result_message"></div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="booking-from">
                        <h2 id="datlich_title"></h2>
                        <div class="border-style-2 margin-bottom-30"></div>
                        <p class="margin-bottom-20" id="datlich_message">Vui lòng gửi cho chúng tôi yêu cầu của bạn!</p>
                        <form method="post" action="#" id="form_book" onsubmit="return CheckFormBook()">
                                <div class="row">
                                    <div class="col-md-6">
                                        <input type="text" name="lich_CTEN" id="lich_CTEN" class="form-control" placeholder="Họ và tên *" required>
                                    </div>
                                    <div class="col-md-6">
                                        <input type="text" name="lich_CSDT" id="lich_CSDT" class="form-control" placeholder="Số điện thoại *" required>
                                    </div>
                                    <div class="col-md-12 nomargin">
                                        <input type="email" name="lich_CEMAIL" class="form-control" placeholder="Email *" id="lich_CEMAIL" required>
                                    </div>
                                    <div class="col-md-12">
                                        <div class="contact-textarea">
                                            <textarea class="form-control" rows="2" placeholder="Yêu cầu *" id="lich_message" name="message" required></textarea>
                                            <button class="btn btn-theme" id="lich_submit_form" type="submit" value="Submit Form">Gửi yêu cầu</button>
                                        </div>
                                    </div>
                                    <input type="hidden" name="lich_contact_lang" id="lich_contact_lang" />
                                    <div id="lich_form-messages"></div>

                                </div>
                            </form>
                            <div id="result_message_lich"></div>
                            </div>
                        
                    </div>
                </div>
            </div>
        </div>
    </section>

    

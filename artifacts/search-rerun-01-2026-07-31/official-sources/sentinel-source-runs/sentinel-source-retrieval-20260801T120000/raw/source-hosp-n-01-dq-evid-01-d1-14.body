:[[\"$\",\"div\",null,{\"className\":\"breadcrumb\",\"children\":[[\"$\",\"div\",null,{\"className\":\"container\",\"children\":[[\"$\",\"h1\",null,{\"className\":\"pb-2 h1\",\"children\":\"Thư viện video\"}],[\"$\",\"ul\",null,{\"children\":[[\"$\",\"li\",null,{\"children\":[\"$\",\"$L22\",null,{\"href\":\"/\",\"title\":\"\",\"children\":\"Trang chủ\"}]}],[[\"$\",\"li\",\"1\",{\"children\":[\"$\",\"$L22\",null,{\"href\":\"\",\"children\":[[\"$\",\"span\",null,{\"className\":\"dot px-3\"}],[\"$\",\"span\",null,{\"children\":\"Thư viện video\"}]]}]}]]]}]]}],\"$undefined\"]}],[\"$\",\"$L23\",null,{\"isShowVideo\":true,\"isShowImage\":false,\"datas\":[{\"id\":\"b5c0691b-d7ad-4e0a-a8b6-8b3ea0130a8d\",\"title\":\"Bệnh viện Bạch Mai tiếp sức tỉnh Sơn La nâng tầm y tế cơ sở\",\"slug\":\"benh-vien-bach-mai-tiep-suc-tinh-son-la-nang-tam-y-te-co-so\",\"excerpt\":\"\u003cp\u003eY tế cơ sở l\u0026agrave; nền tảng của chăm s\u0026oacute;c sức khỏe ban đầu. Nhưng ở Sơn La, một tỉnh miền n\u0026uacute;i c\u0026ograve;n nhiều kh\u0026oacute; khăn, để nền tảng ấy thực sự vững chắc vẫn l\u0026agrave; b\u0026agrave;i to\u0026aacute;n cần th\u0026ecirc;m lời giải. Buổi l\u0026agrave;m việc của đo\u0026agrave;n c\u0026ocirc;ng t\u0026aacute;c Bệnh viện Bạch Mai tại địa phương cho thấy một hướng đi r\u0026otilde; hơn: đưa chuy\u0026ecirc;n m\u0026ocirc;n, kỹ thuật v\u0026agrave; kinh nghiệm từ tuyến cuối về gần d\u0026acirc;n hơn, để người bệnh được chăm s\u0026oacute;c tốt hơn ngay tại cơ sở.\u0026nbsp;\u003c/p\u003e\",\"viewCount\":351,\"publishDate\":\"2026-04-22T00:00:00\",\"thumbnailId\":\"a27e16c4-03aa-4021-bb63-0ed37dee0529\",\"thumbnail\":{\"id\":\"a27e16c4-03aa-4021-bb63-0ed37dee0529\",\"fileName\":\"screenshot1776908489.jpeg\",\"url\":\"http://apicms.bachmai.gov.vn/documents/0/0/screenshot1776908489.jpeg/a27e16c4-03aa-4021-bb63-0ed37dee0529\",\"path\":\"http://apicms.bachmai.gov.vn/images/2026/4/23/6a5898d6-0f74-4713-8628-9196d19f6ac8_screenshot1776908489.jpeg\"},\"categoryId\":null,\"categories\":[{\"id\":\"1b40cae3-77e4-4190-9181-668bf3a3c04d\",\"name\":\"Thư viện video\",\"slug\":\"thu-vien-video\"}],\"isFeatured\":false,\"isHomepage\":false},{\"id\":\"34785bc3-691a-4569-95e8-51546ffee4a5\",\"title\":\"Lễ kỷ niệm ngày Công tác Xã hội Việt Nam, lần thứ 10\",\"slug\":\"le-ky-niem-ngay-cong-tac-xa-hoi-viet-nam-lan-thu-10\",\"excerpt\":\"\",\"viewCount\":368,\"publishDate\":\"2026-03-23T00:00:00\",\"thumbnailId\":\"deaffbbc-7316-4ebd-b23e-bb5e727daecb\",\"thumbnail\":{\"id\":\"deaffbbc-7316-4ebd-b23e-bb5e727daecb\",\"fileName\":\"screenshot1774256081.png\",\"url\":\"http://apicms.bachmai.gov.vn/documents/0/0/screenshot1774256081.png/deaffbbc-7316-4ebd-b23e-bb5e727daecb\",\"path\":\"http://apicms.bachmai.gov.vn/images/2026/3/23/e3997e69-eee4-40b5-b81f-1a199569a6c0_screenshot1774256081.png\"},\"categoryId\":null,\"categories\":[{\"id\":\"1b40cae3-77e4-4190-9181-668bf3a3c04d\",\"name\":\"Thư viện video\",\"slug\":\"thu-vien-video\"}],\"isFeatured\":false,\"isHomepage\":false},{\"id\":\"5b1138b4-cba7-445e-8c4e-e983ae18655a\",\"title\":\"Bệnh viện Bạch Mai hướng dẫn đăng ký chữ ký số cá nhân trên VNeID\",\"slug\":\"benh-vien-bach-mai-huong-dan-dang-ky-chu-ky-so-ca-nhan-tren-vneid\",\"excerpt\":\"\u003cp\u003eTạm biệt giấy tờ, tạm biệt chờ đợi - K\u0026yacute; số ngay tr\u0026ecirc;n điện thoại: Tương lai y tế đ\u0026atilde; ở Bạch Mai H\u0026atilde;y c\u0026ugrave;ng Bệnh viện Bạch Mai ti\u0026ecirc;n phong trong h\u0026agrave;nh tr\u0026igrave;nh số ho\u0026aacute;, v\u0026igrave; một tương lai chăm s\u0026oacute;c sức khoẻ dễ d\u0026agrave;ng v\u0026agrave; thuận tiện hơn cho tất cả mọi người.\u003c/p\u003e\",\"viewCount\":1425,\"publishDate\":\"2025-10-07T00:00:00\",\"thumbnailId\":\"4297948f-7323-4889-abdd-209d6e45e72c\",\"thumbnail\":{\"id\":\"4297948f-7323-4889-abdd-209d6e45e72c\",\"fileName\":\"untitled.png\",\"url\":\"http://apicms.bachmai.gov.vn/documents/0/0/untitled.png/4297948f-7323-4889-abdd-209d6e45e72c\",\"path\":\"http://apicms.bachmai.gov.vn/images/2025/10/7/ac13cd38-63c4-4dc8-80e0-9a61a29c0ed3_untitled.png\"},\"categoryId\":null,\"categories\":[{\"id\":\"1b40cae3-77e4-4190-9181-668bf3a3c04d\",\"name\":\"Thư viện video\",\"slug\":\"thu-vien-video\"}],\"isFeatured\":false,\"isHomepage\":false},{\"id\":\"3e093b42-c72b-461e-b097-b05d75bee26e\",\"title\":\"Công nghệ kết nối vùng cao\",\"slug\":\"cong-nghe-ket-noi-vung-cao\",\"excerpt\":\"\u003cp\u003eC\u0026ugrave;ng với sự ph\u0026aacute;t triển của c\u0026ocirc;ng nghệ 4.0, y tế Việt Nam đang kh\u0026ocirc;ng ngừng đổi mới, ứng dụng nhiều kỹ thuật hiện đại nhằm n\u0026acirc;ng cao chất lượng điều trị. Trong đ\u0026oacute;, c\u0026oacute; c\u0026ocirc;ng nghệ kh\u0026aacute;m chữa bệnh từ xa bằng k\u0026iacute;nh Hololens \u0026ndash; giải ph\u0026aacute;p gi\u0026uacute;p b\u0026aacute;c sĩ tuyến tỉnh tiếp cận kỹ thuật cao, x\u0026oacute;a nh\u0026ograve;a khoảng c\u0026aacute;ch về chuy\u0026ecirc;n m\u0026ocirc;n v\u0026agrave; địa l\u0026yacute;, c\u0026ograve;n người d\u0026acirc;n th\u0026igrave; được tiếp cận dịch vụ y tế chất lượng cao.\u003c/p\u003e\",\"viewCount\":421,\"publishDate\":\"2025-10-01T00:00:00\",\"thumbnailId\":\"19611ba0-3595-4eb8-ad67-8a5a0f69a8ff\",\"thumbnail\":{\"id\":\"19611ba0-3595-4eb8-ad67-8a5a0f69a8ff\",\"fileName\":\"untitled.jpg\",\"url\":\"http://apicms.bachmai.gov.vn/documents/0/0/untitled.jpg/19611ba0-3595-4eb8-ad67-8a5a0f69a8ff\",\"path\":\"http://apicms.bachmai.gov.vn/images/2025/10/7/df285f2b-83fc-4227-850d-0709dbf97764_untitled.jpg\"},\"categoryId\":null,\"categories\":[{\"id\":\"1b40cae3-77e4-4190-9181-668bf3a3c04d\",\"name\":\"Thư viện video\",\"slug\":\"thu-vien-video\"}],\"isFeatured\":false,\"isHomepage\":false},{\"id\":\"bd3ae419-483c-4d9c-b0ac-f901fc43ab6f\",\"title\":\"ỨNG DỤNG TRÍ TUỆ NHÂN TẠO (AI) TRONG CHẨN ĐOÁN SỚM UNG THƯ PHỔI TẠI BỆNH VIỆN BẠCH MAI\",\"slug\":\"ung-dung-tri-tue-nhan-tao-ai-trong-chan-doan-som-ung-thu-phoi-tai-benh-vien-bach-mai\",\"excerpt\":\"\",\"viewCount\":973,\"publ
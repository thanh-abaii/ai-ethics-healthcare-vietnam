<script>
  const urlParams = new URLSearchParams(window.location.search);
  const utm_source = urlParams.get("utm_source");
  const utm_campaign = urlParams.get("utm_campaign");
  const utm_medium = urlParams.get("utm_medium");

  // window.addEventListener(
  //   "insider:api-initialized",
  //   function () {
  //     Insider.track("events", [
  //       {
  //         event_name: "chuyenkhoa_view",
  //         category: "Trung tâm Tim mạch",
  //         event_params: {
  //           custom: {
  //             utm_source: utm_source,
  //             utm_medium: utm_medium,
  //             utm_campaign: utm_campaign,
  //           },
  //         },
  //       },
  //     ]);
  //   },
  //   {
  //     once: true,
  //   }
  // );

   let currentIndex = 0;
    let startX;

function slide(direction) {
    const galleryWrapper = document.querySelector('.gallery-wrapper');
    const items = document.querySelectorAll('.gallery-wrapper > div');
    const itemWidth = items[0].clientWidth + 20; // Include padding
    const totalItems = items.length;
    const visibleItems = 3;

    currentIndex += direction;
    if (currentIndex < 0) {
        currentIndex = totalItems - visibleItems;
    } else if (currentIndex >= totalItems) {
        currentIndex = 0;
    }

    galleryWrapper.style.transform = `translateX(-${currentIndex * itemWidth}px)`;
    startX = null; // Reset startX to prevent multiple slides
}

function handleTouchStart(event) {
    startX = event.touches[0].clientX;
}

function handleTouchMove(event) {
    if (!startX) {
        return;
    }

    const currentX = event.touches[0].clientX;
    const diffX = startX - currentX;

    if (Math.abs(diffX) > 50) {
        if (diffX > 0) {
            slide(1);
        } else {
            slide(-1);
        }
       
    }
}

if(window.innerWidth < 768) {
    document.querySelector('.specialty-gal')?.addEventListener('touchstart', handleTouchStart);
    document.querySelector('.specialty-gal')?.addEventListener('touchmove', handleTouchMove);
}else{
    document.querySelector('.arrow-left')?.addEventListener('click', () => slide(-1));
document.querySelector('.arrow-right')?.addEventListener('click', () => slide(1));
}

function ShowTab(tab,self_el){
  // Insider.track('events', [{event_name: 'chuyenkhoa_'+tab+'_click',event_params: {
  //   "category": "Trung tâm Tim mạch",
  // },},]);
    let tabs = document.querySelectorAll('.cat-tab');
    let tab_els = document.querySelectorAll('.item_tab_subcate');
    tabs.forEach((item)=>{
        item.classList.remove('first_tab');
    })
    tab_els.forEach((item)=>{
        item.classList.remove('active');
    })
    document.getElementById(tab).classList.add('first_tab');
    self_el.classList.add('active');
}
</script>

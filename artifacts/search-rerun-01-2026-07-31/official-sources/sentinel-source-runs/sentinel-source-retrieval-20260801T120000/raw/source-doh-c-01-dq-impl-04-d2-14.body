							<input type="hidden" value="https://soyte.danang.gov.vn/vi/web/syt/w/hon-500-can-bo-co-so-tham-gia-tap-huan-truyen-thong-phong-chong-mua-ban-nguoi-tai-cac-xa-vung-cao-da-nang" id="currentURL">
						</div>

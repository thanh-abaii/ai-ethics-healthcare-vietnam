<script>
    $(document).ready(function() {
      function getCleanUrl(url) {
        if(!url) return "";
        
        // Xử lý trường hợp URL có phần /ID và tham số query
        var match = url.match(/(.+\.mp4)\/[^\/]+(\?.*)?$/);
        if(match) {
          return match[1];
        }
        
        // Trường hợp URL chỉ có .mp4 và tham số query
        var queryIndex = url.indexOf('?');
        if(queryIndex !== -1 && url.indexOf('.mp4') < queryIndex) {
          return url.substring(0, queryIndex);
        }
        
        // Trường hợp URL chỉ kết thúc với .mp4
        var mp4Index = url.indexOf('.mp4');
        if(mp4Index !== -1) {
          return url.substring(0, mp4Index + 4);
        }
        
        return url;
      }
      
      function processVideo(videoElement) {
        try {
          // Xử lý source trong video
          var sourceElements = videoElement.find("source");
          if(sourceElements.length > 0) {
            sourceElements.each(function() {
              var sourceUrl = $(this).attr("src");
              if(sourceUrl) {
                var cleanSourceUrl = getCleanUrl(sourceUrl);
                $(this).attr("src", cleanSourceUrl);
                // Sửa lỗi type có dấu chấm phẩy
                var type = $(this).attr("type");
                if(type && type.endsWith(';')) {
                  $(this).attr("type", type.slice(0, -1));
                }
              }
            });
          } else {
            // Xử lý trường hợp video không có thẻ source
            var videoSrc = videoElement.attr("src");
            if(videoSrc) {
              var cleanVideoSrc = getCleanUrl(videoSrc);
              videoElement.attr("src", cleanVideoSrc);
            }
          }
          
          // Xử lý poster
          var posterUrl = videoElement.attr("poster");
          if(posterUrl) {
            var cleanPosterUrl = getCleanUrl(posterUrl);
            videoElement.attr("poster", cleanPosterUrl);
          }
          
          // Tải lại video
          if(videoElement[0]) {
            videoElement[0].load();
          }
        } catch(e) {
          console.error("Lỗi khi xử lý video:", e);
        }
      }
      
      function processAllVideos() {
        
        
        // Xử lý video trong contentText
        if($("#contentText").length) {
          $("#contentText video").each(function() {
            processVideo($(this));
          });
        }
        
        // Xử lý video trong liferayckevideo
        $(".liferayckevideo").each(function() {
          var container = $(this);
          var video = container.find("video");
          if(video.length > 0) {
            processVideo(video);
          }
        });
        
        // Xử lý tất cả video còn lại
        $("video").each(function() {
          processVideo($(this));
        });
      }
      
      // Chạy xử lý ngay lập tức
      processAllVideos();
      
      // Chạy lại sau 1 giây để đảm bảo xử lý các video được thêm sau
      setTimeout(processAllVideos, 1000);
      
      // Chạy lại sau 3 giây để đảm bảo xử lý các video được tải chậm
      setTimeout(processAllVideos, 3000);
      
      // Theo dõi thay đổi DOM để xử lý video mới được thêm vào
      if(window.MutationObserver) {
        var observer = new MutationObserver(function(mutations) {
          var needsProcessing = false;
          mutations.forEach(function(mutation) {
            if(mutation.addedNodes.length) {
              needsProcessing = true;
            }
          });
          
          if(needsProcessing) {
            processAllVideos();
            addPlayButtonsToVideos();
          }
        });
        
        observer.observe(document.body, {
          childList: true,
          subtree: true
        });
      }
      
      // Hàm thêm nút play cho video
      function addPlayButtonsToVideos() {
        $('.liferayckevideo.video-container').each(function() {
          var container = $(this);
          var video = container.find('video');
          
          if (container.find('.video-play-button').length === 0 && video.length > 0) {
            var playButton = $('<div class="video-play-button" title="Phát video"></div>');
            container.append(playButton);
            
            playButton.on('click', function() {
              var videoElement = video[0];
              if (videoElement) {
                videoElement.play();
                $(this).addClass('playing');
              }
            });
            
            video.on('play', function() {
              playButton.addClass('playing');
            });
            
            video.on('pause ended', function() {
              playButton.removeClass('playing');
            });
          }
        });
      }
      
      addPlayButtonsToVideos();
      
      setTimeout(addPlayButtonsToVideos, 1000);
      
      setTimeout(addPlayButtonsToVideos, 3000);
    });
  </script>
</div></div></div></div></div></div></div></div>

		.modal-thongtin-content {
			background-color: #fefefe;
			margin: auto;
			padding: 20px;
			border: 1px solid #888;
			width: 60%;
		}
	}

	@media only screen and (max-width: 768px) {
		.pagination2 a {
			cursor: pointer;
			color: black;
			padding: 3px 8px;
			text-decoration: none;
			transition: background-color .3s;
			margin: 0px;
			border-radius: 5px;
			background: #ddd;

<span class="abcd" style="display:none;">{mvccVersion=13, ctCollectionId=0, uuid=16495c0a-cbd2-426a-29b7-58a8eec27c4d, id=3973632, resourcePrimKey=3973633, groupId=131507, companyId=37610, userId=1865253, userName=Phạm Thị Anh, createDate=Thu May 21 15:29:36 ICT 2026, modifiedDate=Thu May 21 16:00:42 ICT 2026, folderId=0, classNameId=0, classPK=0, treePath=/, articleId=3973631, version=1.0, urlTitle=moi-bao-gia-dich-vu-photo-tai-lieu-phuc-vu-hoi-nghi-tap-huan-tuyen-truyen-tren-linh-vuc-phong-chong-te-nan-xa-hoi-nam-2026, content=<!--?xml version="1.0"?-->

<root available-locales="vi_VN" default-locale="vi_VN">
	<dynamic-element name="isTopNews" type="boolean" index-type="keyword" instance-id="paykqyow">
		<dynamic-content language-id="vi_VN"></dynamic-content>
	</dynamic-element>
	<dynamic-element name="noiDung" type="text_area" index-type="text" instance-id="qttjyfti">
		<dynamic-content language-id="vi_VN">&lt;p style="margin-bottom:8px; text-align:justify;line-height:30px"&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;b&gt;1. &lt;/b&gt;&lt;b&gt;Thông tin của đơn vị yêu cầu báo giá&lt;/b&gt;&lt;span style="letter-spacing:-.1pt"&gt;&lt;/span&gt;&lt;/p&gt;

&lt;p style="margin-bottom:8px; text-align:justify; text-indent:35.45pt;line-height:30px"&gt;&lt;span style="tab-stops:center 244.8pt"&gt;a) Đơn vị yêu cầu báo giá&lt;/span&gt;&lt;/p&gt;

&lt;p style="margin-bottom:8px; text-align:justify; text-indent:35.45pt;line-height:30px"&gt;&lt;span style="tab-stops:center 244.8pt"&gt;- &amp;nbsp;Sở Y tế thành phố Đà Nẵng.&lt;/span&gt;&lt;/p&gt;

&lt;p style="margin-bottom:8px; text-align:justify; text-indent:35.45pt;line-height:30px"&gt;&lt;span style="tab-stops:center 244.8pt"&gt;- Địa chỉ: 168 Nguyễn Sinh Sắc, phường Hòa Khánh, thành phố Đà Nẵng.&lt;/span&gt;&lt;/p&gt;

&lt;p style="margin-bottom:8px; text-align:justify; text-indent:35.45pt;line-height:30px"&gt;&lt;span style="tab-stops:center 244.8pt"&gt;b) Thông tin liên hệ người chịu trách nhiệm tiếp nhận báo giá&lt;/span&gt;&lt;/p&gt;

&lt;p style="margin-bottom:8px; text-align:justify; text-indent:35.45pt;line-height:30px"&gt;&lt;span style="tab-stops:center 244.8pt"&gt;- Bà Phạm Thị Anh - chuyên viên Phòng Phòng, chống tệ nạn xã hội.&lt;/span&gt;&lt;/p&gt;

&lt;p style="margin-bottom:8px; text-align:justify; text-indent:35.45pt;line-height:30px"&gt;&lt;span style="tab-stops:center 244.8pt"&gt;- Số điện thoại liên hệ: 0985.126.503.&lt;/span&gt;&lt;/p&gt;

&lt;p style="margin-bottom:8px; text-align:justify; text-indent:35.45pt;line-height:30px"&gt;&lt;span style="tab-stops:center 244.8pt"&gt;c) Cách thức tiếp nhận báo giá&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;/span&gt;&lt;/p&gt;

&lt;p class="MsoBodyText" style="margin-bottom:8px; text-align:justify; text-indent:35.45pt;line-height:30px"&gt;&lt;span style="punctuation-wrap:simple"&gt;- Nhận trực tiếp hoặc qua đường bưu điện tại địa chỉ: Sở Y tế thành phố Đà Nẵng (168 Nguyễn Sinh Sắc, phường Hòa Khánh, thành phố Đà Nẵng)&lt;span lang="VI" style="letter-spacing:-.25pt"&gt;.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;

&lt;p class="MsoBodyText" style="margin-bottom:8px; text-align:justify; text-indent:35.45pt;line-height:30px"&gt;&lt;span style="punctuation-wrap:simple"&gt;&lt;span style="letter-spacing:-.25pt"&gt;- Nhận bản scan từ bản gốc báo giá qua Email: anhpt3@danang.gov.vn&lt;/span&gt;&lt;span lang="VI" style="letter-spacing:-.25pt"&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;

&lt;p style="margin-bottom:8px; text-align:justify; text-indent:35.45pt;line-height:30px"&gt;&lt;span style="tab-stops:center 244.8pt"&gt;d) Thời hạn tiếp nhận báo giá&lt;/span&gt;&lt;/p&gt;

&lt;p style="margin-bottom:8px; text-align:justify; text-indent:35.45pt;line-height:30px"&gt;&lt;span style="tab-stops:center 244.8pt"&gt;- Từ 07h30 ngày 22 tháng 5 năm 2026 đến trước 17h00 ngày 28 tháng 5 năm 2026 (trong giờ hành chính). &lt;/span&gt;&lt;/p&gt;

&lt;p style="margin-bottom:8px; text-align:justify; text-indent:35.45pt;line-height:30px"&gt;&lt;span style="tab-stops:center 244.8pt"&gt;- Các báo giá nhận được sau thời điểm nêu trên sẽ không được xem xét.&lt;/span&gt;&lt;/p&gt;

&lt;p style="margin-bottom:8px; text-align:justify; text-indent:35.45pt;line-height:30px"&gt;&lt;span style="tab-stops:center 244.8pt"&gt;đ) Thời hạn có hiệu lực của báo giá: Tối thiểu 90 ngày kể từ ngày ban hành. &lt;/span&gt;&lt;/p&gt;

&lt;p style="margin-bottom:8px; text-align:justify; text-indent:35.45pt;line-height:30px"&gt;&lt;span style="tab-stops:294.0pt"&gt;&lt;b&gt;2. &lt;/b&gt;&lt;b&gt;Nội dung yêu cầu báo giá&lt;/b&gt;&lt;/span&gt;&lt;/p&gt;

&lt;p style="margin-bottom:8px; text-align:justify; text-indent:35.45pt;line-height:30px"&gt;&lt;span style="tab-stops:294.0pt"&gt;a) Mô tả chi tiết các gói dịch vụ yêu cầu báo giá: Nội dung chi tiết theo Phụ lục I đính kèm.&lt;/span&gt;&lt;/p&gt;

&lt;p style="margin-bottom:8px; text-align:justify; text-indent:35.45pt;line-height:30px"&gt;&lt;span style="tab-stops:294.0pt"&gt;b) Mẫu Báo giá: Nhà cung cấp thực hiện báo giá theo mẫu quy định tại Phụ lục II đính kèm.&lt;/span&gt;&lt;/p&gt;

&lt;p style="margin-bottom:8px; text-align:justify; text-indent:35.45pt;line-height:30px"&gt;Chi tiết&amp;nbsp;&lt;a href="/documents/131507/3962803/6134.SYT.PPCTNXH.21.05.2026.signed.signed.signed.pdf/b7a9b9a7-9b78-7351-d0dc-99fdc8e09a03?t=1779352159718" style=";color: #2980b9;text-align: center;text-decoration: underline;font-weight: bold"&gt;tại đây&lt;/a&gt;&lt;/p&gt;

&lt;p style="margin-bottom:8px; text-align:justify; text-indent:35.45pt;line-height:30px"&gt;Kính mời các Công ty, đơn vị, doanh nghiệp tham gia báo giá!&lt;/p&gt;

&lt;p style="margin-bottom: 8px; text-indent: 35.45pt; line-height: 30px; text-align: right;"&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; Phòng Phòng, chống tệ nạn xã hội&lt;/p&gt;</dynamic-content>
	</dynamic-element>
</root>, DDMStructureKey=41537, DDMTemplateKey=102007, defaultLanguageId=vi_VN, layoutUuid=, displayDate=Thu May 21 16:00:00 ICT 2026, expirationDate=null, reviewDate=null, indexable=true, smallImage=false, smallImageId=0, smallImageURL=, lastPublishDate=null, status=0, statusByUserId=1865253, statusByUserName=Phạm Thị Anh, statusDate=Thu May 21 16:00:42 ICT 2026}</span>

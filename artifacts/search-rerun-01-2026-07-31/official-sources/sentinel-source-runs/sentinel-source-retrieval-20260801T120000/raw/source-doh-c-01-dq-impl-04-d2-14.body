			font-weight: 700;
			line-height: 33.6px;
			letter-spacing: -0.28px;
		}

		#contentText iframe {
			width: 100% !important;
		}

		.detail-social > a:hover {
			cursor: pointer;
		}

		.article-head .article-info {
			margin-bottom: 0;
			padding: 4px 0 8px 0;
			font-size: 14px;
			height: 59px !important;
		}

		.modal-thongtin-content {
			background-color: #fefefe;
			margin: auto;
			padding: 20px;
			border: 1px solid #888;
			width: 100%;
		}

    .liferayckevideo video {
		width: 100% !important;
		height: 465px !important;
	}

	/* Nút play overlay */
	.video-play-button {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		width: 60px;
		height: 60px;
		background: rgba(0, 0, 0, 0.7);
		border: 3px solid #fff;
		border-radius: 50%;
		cursor: pointer;
		z-index: 10;
		display: flex;
		align-items: center;
		justify-content: center;
		transition: all 0.3s ease;
	}

	.video-play-button:hover {
		background: rgba(0, 0, 0, 0.9);
		transform: translate(-50%, -50%) scale(1.1);
	}

	.video-play-button::before {
		content: '';
		width: 0;
		height: 0;
		border-style: solid;
		border-width: 15px 0 15px 25px;
		border-color: transparent transparent transparent #fff;
		margin-left: 5px;
	}

	.video-play-button.playing {
		display: none;
	}

	.social-buttons {
		display: flex;
	}

	.article-head {
		margin-bottom: 0;
	}

	.botting-border {
		color: #292a32;
		background: unset;
		font-family: "Roboto";
		text-transform: unset;
		font-weight: bold;
		font-size: 20px;
		margin-bottom: 15px;
		border-bottom: 3px solid #d1d2d4;
	}

	.buttonIn {
		position: relative;
	}

	.btnsend {
		color: #FFF;
		border-color: #f70000;
		padding: 3px 0.75rem;
		border: none;
		height: 42px;
		cursor: pointer;
		border-radius: 6px;
		background: #C8392B;
		margin-top: 17px;
		font-size: 14px;
		font-style: normal;
		font-weight: 700;
		line-height: 130%; /* 18.2px */
		letter-spacing: 0.021px;
	}

	.button-dt {
		color: #FFF;
		background-color: #f70000;
		border-color: #f70000;
		padding: 3px 0.75rem;
		border-radius: 5px;
		margin: 2px;
	}

	.button-dt-close {
		color: #FFF;
		background-color: #f70000;
		border-color: #f70000;
		padding: 3px 0.75rem;
		border-radius: 5px;
		margin: 2px;
	}

	.md-textarea {
		width: 100%;
	}

	.comment {
		display: inline-block;
		margin-top: 5px;
		width: 100%;
	}

	.comment-text {
		padding-left: 51px;
		margin-top: -9px;
		font-size: 14px;
	}

	.comment-child {
		margin-left: 35px;
	}


	.modal-thongtin {
		display: none;
		position: fixed;
		z-index: 1111;
		padding-top: 100px;
		left: 0;
		top: 0;
		width: 100%;
		height: 100%;
		overflow: auto;
		background-color: rgb(0, 0, 0);
		background-color: rgba(0, 0, 0, .4);
	}

	.modal-thongtin-reply {
		display: none;
		position: fixed;
		z-index: 1;
		padding-top: 100px;
		left: 0;
		top: 0;
		width: 100%;
		height: 100%;
		overflow: auto;
		background-color: rgb(0, 0, 0);
		background-color: rgba(0, 0, 0, .4);
	}


	.close {
		color: #aaaaaa;
		float: right;
		font-size: 28px;
		font-weight: bold;
	}

	.close:hover,
	.close:focus {
		color: #000;
		text-decoration: none;
		cursor: pointer;
	}

	.btnreply {
		color: #FFF;
		background-color: #f70000;
		border-color: #f70000;
		padding: 3px 0.75rem;
		border-radius: 5px;
		height: 28px;
		border: none;
		float: right;
	}

	.autofit-float.autofit-row.portlet-header {
		display: none;
	}

	.breadcrumb > li.active {
		color: #f70000;
	}

	.zalo-share-button {
		width: 158px !important;
	}

	iframe {
		min-width: 92px;
	}

	b.text-summary {
		color: #000;
		font-size: 16px;
		font-style: italic;
		font-weight: 700;
		line-height: normal;
	}

	@media only screen and (min-width: 768px) {
		.other-imgs {
			height: 60px;

			letter-spacing: -0.28px;
		}

		#contentText iframe {
			width: 100% !important;
		}

		.detail-social > a:hover {
			cursor: pointer;
		}

		.article-head .article-info {
			margin-bottom: 0;
			padding: 4px 0 8px 0;
			font-size: 14px;
			height: 59px !important;
		}

		.modal-thongtin-content {
			background-color: #fefefe;
			margin: auto;
			padding: 20px;
			border: 1px solid #888;
			width: 100%;
		}
	}

	span.sticker-overlay {
		background: var(--main-color-background);
		color: var(--main-color-text);
		opacity: 0.8;
	}


	.detail__flex {
		display: flex;
	}

	.sp-dislaydate {
		color: var(--darkdefault-212529, #212529);
		font-size: 16px;
		font-style: normal;
		font-weight: 400;
		line-height: 130%;
		letter-spacing: 0.08px;
		/*border-left: 3px solid #212529;*/

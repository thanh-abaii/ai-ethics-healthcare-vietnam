<span class="abcd" style="display:none;">{mvccVersion=1, ctCollectionId=0, uuid=3837c4d4-38cb-41fd-97d4-56366c65b49a, id=935663, resourcePrimKey=935664, groupId=131507, companyId=37610, userId=408547, userName=Admin Data, createDate=Mon Aug 26 10:12:04 ICT 2024, modifiedDate=Mon Aug 26 10:12:04 ICT 2024, folderId=0, classNameId=0, classPK=0, treePath=/, articleId=935662, version=1.0, urlTitle=trien-khai-thong-tu-so-62-2024-tt-btc-222501, content=<!--?xml version="1.0"?-->
            <root available-locales="vi_VN" default-locale="vi_VN">
            <dynamic-element name="isTopNews" type="boolean" index-type="keyword" instance-id="ziqhuyca">

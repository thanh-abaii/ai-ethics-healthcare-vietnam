<script>

	(function() {
		const searchInputSyt = document.getElementById('search-input-syt');
		const searchBtnSyt = document.getElementById('search-btn-syt');

		searchBtnSyt.addEventListener('click', function() {
			let query = searchInputSyt.value;
			if (query) {
				window.location.href = `/web/syt/tim-kiem?q=` + query;
			} else {
				alert("Vui lòng nhập từ khóa tìm kiếm!");
			}
		});
		searchInputSyt.addEventListener('keypress', function(event) {
			if (event.key === 'Enter') {
				searchBtnSyt.click();
			}
		});
	})();

	(function() {
		const openMenuIcon = document.getElementById('icon-open-menu');
		const menuMobile = document.getElementById('menu-mobile');

		openMenuIcon.addEventListener('click', function(event) {
			event.stopPropagation();

			menuMobile.style.display = 'block';
			menuMobile.style.setProperty('display', 'block', 'important');

			let overlay = document.createElement('div');
			overlay.classList.add('menu-overlay');
			menuMobile.appendChild(overlay);

			overlay.addEventListener('click', function() {
				menuMobile.style.display = 'none';
				menuMobile.removeChild(overlay);
			});
		});
		menuMobile.addEventListener('click', function(event) {
			event.stopPropagation();
		});
	})();
</script>
</body>


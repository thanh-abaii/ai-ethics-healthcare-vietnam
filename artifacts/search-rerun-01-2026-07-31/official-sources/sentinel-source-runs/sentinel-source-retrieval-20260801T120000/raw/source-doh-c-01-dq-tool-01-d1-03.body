<script>
	$(document).ready(function () {
		$(".hrefShareFb").attr("href", "https://www.facebook.com/sharer/sharer.php?u=" + window.location.href);
		/*$("#hrefShareEmail").attr("href", "mailto:?subject=I wanted you to see this site&amp;body=Check out this site " + window.location.href);*/
		$("#hrefShareEmail").attr("href", 'https://mail.google.com/mail/u/0/?su='+'Tổng quan'+'&body=' + window.location.href+'&fs=1&tf=cm');
		$("#hrefShareSkype").attr("href", "https://web.skype.com/share?url=" + window.location.href);
		$("#trigger_zalo").attr("data-href", "" + window.location.href);
		$(".hrefShareTwitter").attr("href", "https://twitter.com/intent/tweet?text=" + window.location.href);
		var modal = $('.modal-thongtin');
		var btn = $('.btnsend');
		var button_dt = $('.button-dt');
		var button_dt_close = $('.button-dt-close');
		var span = $('.close');
		var baiVietId = $('#baiVietId');
		var tieuDe = $('#tieuDe');
		var commentContent = $('#commentContent');
		var commentName = $('#commentName');
		var commentAddress = $('#commentAddress');
		var commentEmail = $('#commentEmail');

		/*btn.click(function () {
            if (commentContent.val().length == 0) {
                alert('Vui lòng nhập nội dung ý kiến!');
            } else {
                modal.show();
                btn.hide();
            }
        });*/


		button_dt.click(function () {
			const valid = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
			if (commentName.val().length == 0) {
				commentName.css('border-color', 'red');
				commentName.focus();
			} else if (commentAddress.val().length == 0) {
				commentAddress.css('border-color', 'red');
				commentAddress.focus();
			} else if (commentEmail.val().length == 0) {
				commentEmail.css('border-color', 'red');
				commentEmail.focus();
			} else if (!valid.test(commentEmail.val())) {
				commentEmail.css('border-color', 'red');
				commentEmail.focus();
				alert('Vui lòng nhập đúng email!');
			} else {
				comment(baiVietId.val(), tieuDe.val(), commentContent.val(), commentName.val(), commentAddress.val(), commentEmail.val(), groupId);
				commentContent.val('');
				commentName.val('');
				commentAddress.val('');
				commentEmail.val('');
				modal.hide();
				btn.show();
			}
		});

		button_dt_close.click(function () {
			commentContent.val('');
			commentName.val('');
			commentAddress.val('');
			commentEmail.val('');
			commentName.css('border-color', '#ccc');
			commentAddress.css('border-color', '#ccc');
			commentEmail.css('border-color', '#ccc');
			modal.hide();
			btn.show();

		});

		span.click(function () {
			commentContent.val('');
			commentName.val('');
			commentAddress.val('');
			commentEmail.val('');
			modal.hide();
			$('.replyBox').hide();
			btn.show();

			$('.inputReplyContent').val('');
			commentNameReply.val('');
			commentAddressReply.val('');
			commentEmailReply.val('');
			modal_reply.hide();
			$('.replyBox').hide();
			btnreply.show();
		});

		$(window).on('click', function (e) {
			if ($(e.target).is('.modal-thongtin')) {
				commentContent.val('');
				commentName.val('');
				commentAddress.val('');
				commentEmail.val('');
				modal.hide();
				btn.show();
			}
			if ($(e.target).is('.modal-thongtin-reply')) {
				$('.inputReplyContent').val('');
				commentNameReply.val('');
				commentAddressReply.val('');
				commentEmailReply.val('');
				modal_reply.hide();
				btnreply.show();
			}
		});


		var modal_reply = $('.modal-thongtin-reply');
		var btnreply = $('.btnreply');
		var button_dt_reply = $('.button-dt-reply');
		var button_dt_reply_close = $('.button-dt-reply-close');
		var span = $('.close');
		var commentNameReply = $('#commentNameReply');
		var commentAddressReply = $('#commentAddressReply');
		var commentEmailReply = $('#commentEmailReply');

		function submitreply() {
			var commentId = $('#commentId').val();
			if ($('#inputReplyContent' + commentId).val().length == 0) {
				alert('Vui lòng nhập nội dung ý kiến!');
			} else {
				modal_reply.show();
				$('#commentContentReply').val($('#inputReplyContent' + commentId).val());
				btnreply.hide();
			}
		}

		button_dt_reply.click(function () {
			if (commentNameReply.val().length == 0) {
				commentNameReply.css('border-color', 'red');
			} else if (commentAddressReply.val().length == 0) {
				commentAddressReply.css('border-color', 'red');
			} else if (commentEmailReply.val().length == 0) {
				commentEmailReply.css('border-color', 'red');
			} else {
				replyComment($('#commentId').val(), baiVietId.val(), tieuDe.val(), $('#commentContentReply').val(), commentNameReply.val(), commentAddressReply.val(), commentEmailReply.val());
				$('.inputReplyContent').val('');
				commentNameReply.val('');
				commentAddressReply.val('');
				commentEmailReply.val('');
				modal_reply.hide();
			}
		});

		button_dt_reply_close.click(function () {
			$('.inputReplyContent').val('');
			commentNameReply.val('');
			commentAddressReply.val('');
			commentEmailReply.val('');
			modal_reply.hide();

		});
	});

	function printById(elementId) {
		var contentHTML = document.getElementById(elementId).innerHTML;
		var titleDetail = document.getElementById('title-detail').innerHTML;
		var printWindow = window.open('', '', 'width=800,height=600');

		printWindow.document.open();
		printWindow.document.write(`
            <html>
                <head>
                    <style>
.text-summary > p {
        color: #000;
        font-size: 16px;
        font-style: italic;
        font-weight: 700;
        line-height: normal;
    }
    p {
        text-align: justify;
        color: #2E2E2E;
        font-size: 16px;
        font-style: normal;
        font-weight: 400;
        line-height: 22.4px;
        letter-spacing: 0.08px;
    }
                    </style>
                </head>
                <body>`+titleDetail+contentHTML+`
                </body>
            </html>
        `);
		printWindow.document.close();
		printWindow.focus();
		setTimeout(() => {
			printWindow.print();
			printWindow.close();
		}, 500);
	}

	$(function () {
		var star = '.star',
				selected = '.selected';
		$(star).on('click', function () {
			$(selected).each(function () {
				$(this).removeClass('selected');
			});
			$(this).addClass('selected');
		});
	});

	function submitreply() {
		var commentId = $('#commentId').val();
		if ($('#inputReplyContent' + commentId).val().length == 0) {
			alert('Vui lòng nhập nội dung ý kiến!');
		} else {
			$('.modal-thongtin-reply').show();
			$('#commentContentReply').val($('#inputReplyContent' + commentId).val());
			$('.btnreply').hide();
		}
	}

	function changePageSize() {
		var pageSize = $('#pageSize').val();
		var pageIndex = $('#pageIndex').val();
		paginate(pageIndex, pageSize);
	}

	function changePageIndex() {
		var pageSize = $('#pageSize').val();
		var pageIndex = $('#pageIndex').val();
		$('#curPage').val(pageIndex);
		paginate(pageIndex, pageSize);
	}

	function gotoPage(i) {
		$('a[name="gotoPage"]').removeClass("active");
		$('#gotoPage' + i).addClass("active");
		$('.list-unstyled').css("display", "none");
		$('ul[name="list-unstyled-' + i + '"]').css("display", "grid");
		$('#currentPage').val(i);
	}

	function previousPage() {
		var i = $('#currentPage').val();
		if (i > 1) {
			gotoPage(Number(i) - 1);
		}
	}

	function nextPage() {
		var i = $('#currentPage').val();
		var totalPage = $('#totalPages').val();
		console.log(i);
		console.log(totalPage);
		if (i < totalPage) {
			gotoPage(Number(i) + 1);
		}
	}


</script>

	.star {
		position: relative;
		display: inline-block;
		transition: color 0.2s ease;
		color: #ebebeb;
	}

	.star:before {
		content: '\2605';
		width: 30px;
		height: 30px;
		font-size: 30px;
	}

	.star:hover,
	.star.selected,
	.star:hover ~ .star,
	.star.selected ~ .star {
		transition: color 0.8s ease;
		color: #FDE16D;
	}

	.ratings-wrapper {
		display: inline-block;
		margin-bottom: 20px;
	}

	.ratings {
		display: flex;
		flex-direction: row-reverse;
	}

	.ratings span {
		cursor: pointer;
		transition: color 0.8s ease;
		font-size: 50px;
	}

	.ratings span:hover {
		transition: color 0.8s ease;
		color: #FDE16D;
	}

	.ratings span:hover ~ span {
		transition: color 0.8s ease;
		color: #FDE16D;
	}

	.ratings span[data-clicked] {
		color: #FDE16D;
	}

	.ratings span[data-clicked] ~ span {
		color: #FDE16D;
	}


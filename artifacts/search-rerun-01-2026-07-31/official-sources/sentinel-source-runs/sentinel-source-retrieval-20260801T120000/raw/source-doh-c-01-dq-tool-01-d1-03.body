              <dynamic-content language-id="vi_VN">&lt;p&gt; Các dịch vụ công đang triễn khai tại trung tâm Giám định Y khoa&lt;/p&gt; &lt;table border="0" cellpadding="0" cellspacing="0" style="width:684px;" width="684"&gt; &lt;tbody&gt; &lt;tr&gt; &lt;td style="width:307px;"&gt; &lt;br clear="all" /&gt; &lt;p align="center" style="margin-left:.6pt;"&gt; SỞ Y TẾ THÀNH PHỐ ĐÀ NẴNG&lt;/p&gt; &lt;p align="center"&gt; &lt;strong&gt;TRUNG TÂM GIÁM ĐỊNH Y KHOA&lt;/strong&gt;&lt;/p&gt; &lt;/td&gt; &lt;td style="width:377px;"&gt; &lt;p align="center"&gt; &lt;strong&gt;CÔNG HOÀ XÃ HỘI CHỦ NGHĨA VIỆT NAM&lt;/strong&gt;&lt;/p&gt; &lt;p align="center"&gt; &lt;strong&gt;Độc lập - Tự do - Hạnh phúc&lt;/strong&gt;&lt;/p&gt; &lt;/td&gt; &lt;/tr&gt; &lt;tr&gt; &lt;td style="width:307px;"&gt; &lt;p align="center"&gt; &lt;img height="2" src="file:///C:/DOCUME~1/Admin/LOCALS~1/Temp/msohtml1/01/clip_image001.gif" width="126" /&gt;&lt;/p&gt; &lt;p align="center"&gt; Số:&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; /TB-GĐYK&lt;/p&gt; &lt;p align="center"&gt; &amp;nbsp;&lt;/p&gt; &lt;/td&gt; &lt;td style="width:377px;"&gt; &lt;p align="center"&gt; &lt;img height="2" src="file:///C:/DOCUME~1/Admin/LOCALS~1/Temp/msohtml1/01/clip_image002.gif" width="206" /&gt;&lt;/p&gt; &lt;p align="center"&gt; &lt;em&gt;&amp;nbsp; Đà nẵng, ngày &amp;nbsp;05 &amp;nbsp;tháng 01 &amp;nbsp;năm 2015&lt;/em&gt;&lt;/p&gt; &lt;/td&gt; &lt;/tr&gt; &lt;/tbody&gt; &lt;/table&gt; &lt;p align="center" style="margin-left:-12.0pt;"&gt; &lt;strong&gt;THÔNG BÁO&lt;/strong&gt;&lt;br /&gt; &lt;em&gt;&lt;strong&gt;V/v các dịch vụ công tại Trung tâm Giám định Y khoa&lt;/strong&gt;&lt;/em&gt;&lt;/p&gt; &lt;p style="margin-left:-12.0pt;"&gt; &amp;nbsp;&lt;/p&gt; &lt;table align="left" cellpadding="0" cellspacing="0"&gt; &lt;tbody&gt; &lt;tr&gt; &lt;td height="2"&gt; &amp;nbsp;&lt;/td&gt; &lt;/tr&gt; &lt;tr&gt; &lt;td&gt; &amp;nbsp;&lt;/td&gt; &lt;td&gt; &lt;img height="2" src="file:///C:/DOCUME~1/Admin/LOCALS~1/Temp/msohtml1/01/clip_image003.gif" width="127" /&gt;&lt;/td&gt; &lt;/tr&gt; &lt;/tbody&gt; &lt;/table&gt; &lt;p&gt; &amp;nbsp;&lt;/p&gt; &lt;p&gt; &amp;nbsp;&lt;/p&gt; &lt;p&gt; &amp;nbsp;&lt;/p&gt; &lt;p style="margin-left:-12.0pt;"&gt; &lt;strong&gt;Để đáp ứng các nhu cầu về khám giám định cho CBCNV và nhân dân trên địa bàn thành phố Đà Nẵng, Trung tâm GĐYK Đà Nẵng thông báo danh mục các dịch vụ công đã, đang và sẽ triển khai tại đơn vị như sau:&lt;/strong&gt;&lt;/p&gt; &lt;p&gt; &amp;nbsp;&lt;/p&gt; &lt;table border="1" cellpadding="0" cellspacing="0" style="width:632px;" width="632"&gt; &lt;tbody&gt; &lt;tr&gt; &lt;td style="width:64px;height:37px;"&gt; &lt;p align="center"&gt; &lt;strong&gt;STT&lt;/strong&gt;&lt;/p&gt; &lt;/td&gt; &lt;td style="width:395px;height:37px;"&gt; &lt;p align="center"&gt; &lt;strong&gt;Loại dịch vụ công&lt;/strong&gt;&lt;/p&gt; &lt;/td&gt; &lt;td style="width:174px;height:37px;"&gt; &lt;p align="center"&gt; &lt;strong&gt;Ghi chú&lt;/strong&gt;&lt;/p&gt; &lt;/td&gt; &lt;/tr&gt; &lt;tr&gt; &lt;td style="width:64px;height:39px;"&gt; &lt;p align="center"&gt; &lt;strong&gt;1&lt;/strong&gt;&lt;/p&gt; &lt;/td&gt; &lt;td style="width:395px;height:39px;"&gt; &lt;p&gt; &lt;strong&gt;Khám giám định hưu mất sức&lt;/strong&gt;&lt;/p&gt; &lt;/td&gt; &lt;td style="width:174px;height:39px;"&gt; &lt;p align="center"&gt; &lt;strong&gt;đã triển khai&lt;/strong&gt;&lt;/p&gt; &lt;/td&gt; &lt;/tr&gt; &lt;tr&gt; &lt;td style="width:64px;height:37px;"&gt; &lt;p align="center"&gt; &lt;strong&gt;2&lt;/strong&gt;&lt;/p&gt; &lt;/td&gt; &lt;td style="width:395px;height:37px;"&gt; &lt;p&gt; &lt;strong&gt;Khám giám định tai nạn lao động&lt;/strong&gt;&lt;/p&gt; &lt;/td&gt; &lt;td style="width:174px;height:37px;"&gt; &lt;p align="center"&gt; &lt;strong&gt;đã triển khai&lt;/strong&gt;&lt;/p&gt; &lt;/td&gt; &lt;/tr&gt; &lt;tr&gt; &lt;td style="width:64px;height:37px;"&gt; &lt;p align="center"&gt; &lt;strong&gt;3&lt;/strong&gt;&lt;/p&gt; &lt;/td&gt; &lt;td style="width:395px;height:37px;"&gt; &lt;p&gt; &lt;strong&gt;Khám giám định bệnh nghề nghiệp&lt;/strong&gt;&lt;/p&gt; &lt;/td&gt; &lt;td style="width:174px;height:37px;"&gt; &lt;p align="center"&gt; &lt;strong&gt;đã triển khai&lt;/strong&gt;&lt;/p&gt; &lt;/td&gt; &lt;/tr&gt; &lt;tr&gt; &lt;td style="width:64px;height:39px;"&gt; &lt;p align="center"&gt; &lt;strong&gt;4&lt;/strong&gt;&lt;/p&gt; &lt;/td&gt; &lt;td style="width:395px;height:39px;"&gt; &lt;p&gt; &lt;strong&gt;Khám giám định thương tật&lt;/strong&gt;&lt;/p&gt; &lt;/td&gt; &lt;td style="width:174px;height:39px;"&gt; &lt;p align="center"&gt; &lt;strong&gt;chuẫn bị triển khai&lt;/strong&gt;&lt;/p&gt; &lt;/td&gt; &lt;/tr&gt; &lt;tr&gt; &lt;td style="width:64px;height:39px;"&gt; &lt;p align="center"&gt; &lt;strong&gt;5&lt;/strong&gt;&lt;/p&gt; &lt;/td&gt; &lt;td style="width:395px;height:39px;"&gt; &lt;p&gt; &lt;strong&gt;Khám sức khỏe tuyển dụng&lt;/strong&gt;&lt;/p&gt; &lt;/td&gt; &lt;td style="width:174px;height:39px;"&gt; &lt;p align="center"&gt; &lt;strong&gt;đã triển khai&lt;/strong&gt;&lt;/p&gt; &lt;/td&gt; &lt;/tr&gt; &lt;tr&gt; &lt;td style="width:64px;height:37px;"&gt; &lt;p align="center"&gt; &lt;strong&gt;6&lt;/strong&gt;&lt;/p&gt; &lt;/td&gt; &lt;td style="width:395px;height:37px;"&gt; &lt;p&gt; &lt;strong&gt;Khám sức khỏe định kỳ&lt;/strong&gt;&lt;/p&gt; &lt;/td&gt; &lt;td style="width:174px;height:37px;"&gt; &lt;p align="center"&gt; &lt;strong&gt;đã triển khai&lt;/strong&gt;&lt;/p&gt; &lt;/td&gt; &lt;/tr&gt; &lt;tr&gt; &lt;td style="width:64px;height:39px;"&gt; &lt;p align="center"&gt; &lt;strong&gt;7&lt;/strong&gt;&lt;/p&gt; &lt;/td&gt; &lt;td style="width:395px;height:39px;"&gt; &lt;p&gt; &lt;strong&gt;Khám giám định tổng hợp&lt;/strong&gt;&lt;/p&gt; &lt;/td&gt; &lt;td style="width:174px;height:39px;"&gt; &lt;p align="center"&gt; &lt;strong&gt;đã triển khai&lt;/strong&gt;&lt;/p&gt; &lt;/td&gt; &lt;/tr&gt; &lt;tr&gt; &lt;td style="width:64px;height:39px;"&gt; &lt;p align="center"&gt; &lt;strong&gt;8&lt;/strong&gt;&lt;/p&gt; &lt;/td&gt; &lt;td style="width:395px;height:39px;"&gt; &lt;p&gt; &lt;strong&gt;Khám giám định liên quan DIOXIN&lt;/strong&gt;&lt;/p&gt; &lt;/td&gt; &lt;td style="width:174px;height:39px;"&gt; &lt;p align="center"&gt; &lt;strong&gt;đã triển khai&lt;/strong&gt;&lt;/p&gt; &lt;/td&gt; &lt;/tr&gt; &lt;tr&gt; &lt;td style="width:64px;height:39px;"&gt; &lt;p align="center"&gt; &lt;strong&gt;9&lt;/strong&gt;&lt;/p&gt; &lt;/td&gt; &lt;td style="width:395px;height:39px;"&gt; &lt;p&gt; &lt;strong&gt;Khám giám định người khuyết tật&lt;/strong&gt;&lt;/p&gt; &lt;/td&gt; &lt;td style="width:174px;height:39px;"&gt; &lt;p align="center"&gt; &lt;strong&gt;đang triển khai&lt;/strong&gt;&lt;/p&gt; &lt;/td&gt; &lt;/tr&gt; &lt;tr&gt; &lt;td style="width:64px;height:39px;"&gt; &lt;p align="center"&gt; &lt;strong&gt;10&lt;/strong&gt;&lt;/p&gt; &lt;/td&gt; &lt;td style="width:395px;height:39px;"&gt; &lt;p&gt; &lt;strong&gt;Khám giám định để sinh con thứ 3&lt;/strong&gt;&lt;/p&gt; &lt;/td&gt; &lt;td style="width:174px;height:39px;"&gt; &lt;p align="center"&gt; &lt;strong&gt;đang triển khai&lt;/strong&gt;&lt;/p&gt; &lt;/td&gt; &lt;/tr&gt; &lt;/tbody&gt; &lt;/table&gt; &lt;p&gt; &amp;nbsp;&lt;/p&gt; &lt;p&gt; &lt;strong&gt;Các thủ tục về hồ sơ khám giám định đều được niêm yết công khai tại trung tâm, quý vị có thể liên hệ trực tiếp tại văn phòng GĐYK hoặc qua điện thoại số: 05113.822.354 để được hướng dẫn thêm./.&lt;/strong&gt;&lt;/p&gt; &lt;p&gt; &amp;nbsp;&lt;/p&gt; &lt;p&gt; &lt;strong&gt;&lt;em&gt;Nơi nhận&lt;/em&gt;&lt;/strong&gt;:&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;strong&gt;GIÁM ĐỐC&lt;/strong&gt;&lt;/p&gt; &lt;p&gt; &lt;span style="line-height: 1.4;"&gt;- Sở Y tế (B/c);&lt;/span&gt;&lt;/p&gt; &lt;p&gt; - Văn phòng GĐYK (niêm yết); &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;(đã ký)&lt;/p&gt; &lt;p&gt; - Lưu: VT.&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/p&gt; &lt;p&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;strong&gt;Trương Công Dụng&lt;/strong&gt;&lt;/p&gt; &lt;p&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/p&gt;</dynamic-content>
            </dynamic-element>                

	<style>

    @media only screen and (max-width: 576px) {
        .limit-tin-descc-news > p {
            -webkit-line-clamp: 3 !important;
        }
    }

    .txt-content > a {
        font-family: Roboto;
        font-size: 16px;
        font-weight: 700;
        line-height: 20.8px;
        letter-spacing: 0.0015em;
        color: #2E2E2E;
    }

    ul.ct-ul-paginate > li {
        margin: 0 3px;
    }

    .wrap-item-content:hover > .row > .txt-content > a {
        color: white;
    }

    .wrap-item-content:hover > .row > .txt-content > a {
        color: white;
    }


    .align-items-center {
        align-items: center !important;
    }
    .d-flex {
        display: flex !important;
    }


    .pagination {
        gap: 8px;
    }
    .pagination .page-link {
        border-radius: 4px;
        color: #2e2e2e;
        padding: 6px 12px;
        font-size: 14px;
        background: transparent;
        position: relative;
    }
    .pagination .page-item {
        font-weight: 700;
        border-radius: 4px !important;
    }
    .pagination .page-item.active .page-link {
        background-color: #035FB5 !important;
        border-color: #035FB5 !important;
        color: white !important;
        border-radius: 4px;
    }
    .investor .pagination .page-link:hover {
        background-color: #035FB5 !important;
        color: white !important;
        border-radius: 4px;
    }
     .pagination .page-link:hover .fa-long-arrow-right:before
     {
        color: white !important;
    }
    .pagination .page-link:hover .fa-long-arrow-left:before
     {
        color: white !important;
    }
    .pagination .page-link:hover .fa-angle-right:before
     {
        color: white !important;
    }
    .pagination .page-link:hover .fa-angle-left:before
     {
        color: white !important;
    }
    .pagination .page-link:focus {
        box-shadow: none;
    }
    .arr-prev,
    .arr-next,
    .arr-first,
    .arr-last {
        background-color: #f4f4f4 !important;
        color: #E0E0E04D !important;
    }
    .page-item .page-link{
        cursor: pointer !important;
    }
    .page-item.disabled .page-link {
        background-color: #e9ecef !important;
        color: #6c757d !important;
        cursor: not-allowed !important;
        pointer-events: none;
    }
    .arr-next,
    .arr-last {
        border-radius: 0px 8px 8px 0px !important;
    }
    .arr-first,
    .arr-prev {
        border-radius: 8px 0px 0px 8px !important;
    }
    .page-link .tooltiptext {
        visibility: hidden;
        width: auto;
        min-width: 90px;
        background-color: #f4f4f4;
        color: #333;
        text-align: center;
        padding: 5px 8px;
        border-radius: 4px;
        position: absolute;
        top: 125%;
        left: 50%;
        transform: translateX(-50%);
        opacity: 0;
        transition: opacity 0.3s;
        z-index: 1;
    }
    .page-link:hover .tooltiptext {
        visibility: visible;
        opacity: 1;
    }
    .form-control-sm {
        appearance: none;
        -webkit-appearance: none;
        -moz-appearance: none;
        width: 60px;
        background-color: #f4f4f4;
        border: none;
        font-weight: 700;
    }

    .limit-tin-desc-2 > p ,
    .limit-tin-desc-2 > p > p {
        text-overflow: ellipsis;

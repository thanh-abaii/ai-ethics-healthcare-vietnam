<input type="hidden" id="totalEntries" value="10">
<div class="d-flex justify-content-center align-items-center my-3 pagination-wrapper">
    <div class="d-flex align-items-center me-3 wrapper-pagination-left">
        <span style="color: #777777; font-size: 16px; margin-right: 8px; font-weight: 400;">Trang</span>
        <div class="select-wrapper mr-2">
            <select class="form-control form-control-sm">
            </select>
            <i class="fa fa-chevron-down" aria-hidden="true"></i>
        </div>
        <span style="color: #777777; font-size: 16px; margin-right: 8px; font-weight: 400;">của <span id="total-pages"></span> kết quả </span>
    </div>
    <nav aria-label="Page navigation">
        <div id="page-numbers" class="d-flex">
        </div>
    </nav>
</div>

</div>


<script>
    $(document).ready(function() {
        function getTotalItems() {
            const searchResultsText = $('.search-results').text().trim();
            const matches = searchResultsText.match(/of\s+([0-9.,]+)\s+kết quả/);
            if (matches && matches[1]) {
                const totalItems = parseInt(matches[1].replace(/[.,]/g, ''));
                $('#total-pages').text(matches[1]);
                return totalItems;
            }
            return 0;
        }

        // Constants
        const ITEMS_PER_PAGE = 10;
        const TOTAL_ITEMS = getTotalItems();
        const TOTAL_PAGES = Math.ceil(TOTAL_ITEMS / ITEMS_PER_PAGE);
        const instanceID = "tsmj";

        // Hide pagination elements if there's only 1 page or no items
        if (TOTAL_PAGES <= 1 || TOTAL_ITEMS === 0) {
            $('.pagination-wrapper').attr('style', 'display: none !important');
            return;
        }
        const urlParams = new URLSearchParams(window.location.search);
        let currentPage = parseInt(urlParams.get('_com_liferay_asset_publisher_web_portlet_AssetPublisherPortlet_INSTANCE_'+instanceID+'_cur')) || 1;

        currentPage = Math.min(Math.max(1, currentPage), TOTAL_PAGES);
        const select = $('.form-control-sm');
        for(let i = 1; i <= TOTAL_PAGES; i++) {
            select.append($('<option>', {
                value: i,
                text: i <= 9 ? '0' + i : i.toString(),
                selected: i === currentPage
            }));
        }
        select.on('change', function() {
            navigateToPage($(this).val(), instanceID);
        });
        function generatePagination(instanceID) {
            const pageNumbers = $('#page-numbers');
            pageNumbers.empty();
            const pagination = $('<ul class="pagination">');
            if (TOTAL_PAGES > 1) {
                pagination.append(
                    '<li class="page-item ' + (currentPage === 1 ? 'disabled' : '') + '">' +
                    '<a class="page-link arr-first" onclick="navigateToPage(1, \'' + instanceID + '\')">' +
                    '<i class="fa fa-angle-left"></i>' +
                    '<span class="tooltiptext">Trang đầu</span>' +
                    '</a>' +
                    '</li>'
                );
                pagination.append(
                    '<li class="page-item ' + (currentPage === 1 ? 'disabled' : '') + '">' +
                    '<a class="page-link arr-prev" onclick="navigateToPage(' + (currentPage - 1) + ', \'' + instanceID + '\')">' +
                    '<i class="fa fa-long-arrow-left"></i>' +
                    '<span class="tooltiptext">Trang trước</span>' +
                    '</a>' +
                    '</li>'
                );
                function addPageNumber(pageNum) {
                    pagination.append(
                        '<li class="page-item ' + (currentPage === pageNum ? 'active' : '') + '">' +
                        '<a class="page-link" onclick="navigateToPage(' + pageNum + ', \'' + instanceID + '\')">' + pageNum + '</a>' +
                        '</li>'
                    );
                }
                if (TOTAL_PAGES <= 5) {
                    for (let i = 1; i <= TOTAL_PAGES; i++) {
                        addPageNumber(i);
                    }
                } else {
                    if (currentPage <= 3) {
                        // Near the start
                        for (let i = 1; i <= 4; i++) {
                            addPageNumber(i);
                        }
                        pagination.append('<li class="page-item disabled"><a class="page-link">...</a></li>');
                        addPageNumber(TOTAL_PAGES);
                    } else if (currentPage >= TOTAL_PAGES - 2) {
                        // Near the end
                        addPageNumber(1);
                        pagination.append('<li class="page-item disabled"><a class="page-link">...</a></li>');
                        for (let i = TOTAL_PAGES - 3; i <= TOTAL_PAGES; i++) {
                            addPageNumber(i);
                        }
                    } else {
                        // In the middle
                        addPageNumber(1);
                        pagination.append('<li class="page-item disabled"><a class="page-link">...</a></li>');
                        for (let i = currentPage - 1; i <= currentPage + 1; i++) {
                            addPageNumber(i);
                        }
                        pagination.append('<li class="page-item disabled"><a class="page-link">...</a></li>');
                        addPageNumber(TOTAL_PAGES);
                    }
                }
                pagination.append(
                    '<li class="page-item ' + (currentPage === TOTAL_PAGES ? 'disabled' : '') + '">' +
                    '<a class="page-link arr-next" onclick="navigateToPage(' + (currentPage + 1) + ', \'' + instanceID + '\')">' +
                    '<i class="fa fa-long-arrow-right"></i>' +
                    '<span class="tooltiptext">Trang sau</span>' +
                    '</a>' +
                    '</li>'
                );

                // Last page button
                pagination.append(
                    '<li class="page-item ' + (currentPage === TOTAL_PAGES ? 'disabled' : '') + '">' +
                    '<a class="page-link arr-last" onclick="navigateToPage(' + TOTAL_PAGES + ', \'' + instanceID + '\')">' +
                    '<i class="fa fa-angle-right"></i>' +
                    '<span class="tooltiptext">Trang cuối</span>' +
                    '</a>' +
                    '</li>'
                );
            }

            pageNumbers.append(pagination);
        }
        generatePagination(instanceID);
    });

    function navigateToPage(page, instanceID) {
        const baseUrl = window.location.pathname;
        const params = new URLSearchParams(window.location.search);

        params.set('_com_liferay_asset_publisher_web_portlet_AssetPublisherPortlet_INSTANCE_'+instanceID+'_cur', page);

        if (!params.has('p_p_id')) {
            params.set('p_p_id', 'com_liferay_asset_publisher_web_portlet_AssetPublisherPortlet_INSTANCE_'+instanceID);
        }
        if (!params.has('p_p_lifecycle')) params.set('p_p_lifecycle', '0');
        if (!params.has('p_p_state')) params.set('p_p_state', 'normal');
        if (!params.has('p_p_mode')) params.set('p_p_mode', 'view');
        if (!params.has('_com_liferay_asset_publisher_web_portlet_AssetPublisherPortlet_INSTANCE_'+instanceID+'_delta')) {
            params.set('_com_liferay_asset_publisher_web_portlet_AssetPublisherPortlet_INSTANCE_'+instanceID+'_delta', 10);
        }
        if (!params.has('p_r_p_resetCur')) params.set('p_r_p_resetCur', 'false');
        window.location.href = baseUrl + '?' + params.toString();
    }
    

</script>
    <script>
        $(document).ready(function () {
          try {
            var linkCheck = $('a[href="https://hoidap.danang.gov.vn/CD_TraCuu.aspx"]');
            var linkInsertAfter = $('a[href="https://gopy.danang.gov.vn"]');
        
            if (linkCheck.length === 0 && linkInsertAfter.length > 0) {
              var newLink = `
                <a target="_blank" href="https://hoidap.danang.gov.vn/CD_TraCuu.aspx" title="Hỏi đáp" class="item d-flex align-items-center" 
                   style="--bg-urll: url(/documents/131507/131575/background-blq-syt2.jpg); 
                          --bg-linear: linear-gradient(180deg, rgb(255 156 156 / 0%) 0%, rgba(120, 187, 255, 0) 72.47%);">
                  <img src="/documents/131507/131575/entypo_chat.png" alt="">
                  <div class="flex-fill d-flex justify-content-center">
                    <p class="mb-0"><span class="no-wrap" style="color: #2E2E2E;">HỎI ĐÁP</span></p>
                  </div>
                </a>
              `;
              linkInsertAfter.after(newLink);
            }
          } catch (e) {
            console.error("Lỗi khi thêm link HỎI ĐÁP:", e);
          }
        });
    </script>

		
		
	




			
			
		
	
	





	










































	













































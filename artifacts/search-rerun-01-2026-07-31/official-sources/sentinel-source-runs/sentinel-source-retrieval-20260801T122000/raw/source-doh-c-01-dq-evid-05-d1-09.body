                <option class="custom-option-enabled" style="cursor: pointer !important; color: #2E2E2E !important;" value="https://hoavang.danang.gov.vn/" data-target="_blank">UBND Huyện Hòa Vang</option>
                <option class="custom-option-enabled" style="cursor: pointer !important; color: #2E2E2E !important;" value="https://hoangsa.danang.gov.vn/" data-target="_blank">UBND Huyện Hoàng Sa</option>

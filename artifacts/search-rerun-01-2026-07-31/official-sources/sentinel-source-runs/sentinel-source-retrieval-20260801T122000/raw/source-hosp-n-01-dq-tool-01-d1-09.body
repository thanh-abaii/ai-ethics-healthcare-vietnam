ng người đ\u0026atilde; hy sinh tuổi trẻ v\u0026igrave; độc lập d\u0026acirc;n tộc với những thầy thuốc h\u0026ocirc;m nay đang ng\u0026agrave;y đ\u0026ecirc;m g\u0026igrave;n giữ sự sống.\u003c/span\u003e\u003c/p\u003e\n\u003cp class=\"MsoNormal\" style=\"text-align: justify; margin: 6.0pt 0in 6.0pt 0in;\"\u003e\u003cspan style=\"font-family: 'Times New Roman',serif; mso-ansi-language: VI;\"\u003eNhững ng\u0026agrave;y qua, tại Bệnh viện Bạch Mai\u003c/span\u003e\u003cspan lang=\"EN-US\" style=\"font-family: 'Times New Roman',serif;\"\u003e cơ sở Ninh B\u0026igrave;nh\u003c/span\u003e\u003cspan style=\"font-family: 'Times New Roman',serif; mso-ansi-language: VI;\"\u003e, tập thể y b\u0026aacute;c sĩ đ\u0026atilde; tận t\u0026acirc;m chăm s\u0026oacute;c một bệnh nh\u0026acirc;n đặc biệt: cụ Nguyễn Văn T\u0026iacute;ch, 96 tuổi, 76 năm tuổi Đảng, nguy\u0026ecirc;n Trung đo\u0026agrave;n trưởng Trung đo\u0026agrave;n T\u0026ecirc;n lửa 263. Cụ l\u0026agrave; người chỉ huy trực tiếp trận đ\u0026aacute;nh bắn rơi chiếc m\u0026aacute;y bay B-52 đầu ti\u0026ecirc;n tr\u0026ecirc;n đất liền Việt Nam, g\u0026oacute;p phần tạo tiền đề cho Chiến thắng \"H\u0026agrave; Nội - Điện Bi\u0026ecirc;n Phủ tr\u0026ecirc;n kh\u0026ocirc;ng\" cuối năm 1972.\u003c/span\u003e\u003c/p\u003e"])</script><script>self.__next_f.push([1,"25:T534,"])</script><script>self.__next_f.push([1,"\u003cp class=\"MsoNormal\" style=\"text-align: justify; text-indent: 0in; margin: 6.0pt 0in 6.0pt 0in;\"\u003e\u003cspan style=\"font-size: 12.0pt; line-height: 115%; mso-ansi-language: VI;\"\u003eNg\u0026agrave;y 24/7, trong khu\u0026ocirc;n khổ chương tr\u0026igrave;nh Ph\u0026ograve;ng ngừa nguy cơ nhiễm khuẩn v\u0026agrave; sai s\u0026oacute;t thuốc trong liệu ph\u0026aacute;p tĩnh mạch trị liệu (PRIME), Bệnh viện Bạch Mai tổ chức đ\u0026agrave;o tạo chuy\u0026ecirc;n đề về c\u0026ocirc;ng t\u0026aacute;c Dược d\u0026agrave;nh cho b\u0026aacute;c sĩ v\u0026agrave; điều dưỡng của 10 đơn vị tham gia chương tr\u0026igrave;nh.\u003c/span\u003e\u003c/p\u003e\n\u003cp class=\"MsoNormal\" style=\"text-align: justify; text-indent: 0in; margin: 6.0pt 0in 6.0pt 0in;\"\u003e\u003cspan style=\"font-size: 12.0pt; line-height: 115%; mso-ansi-language: VI;\"\u003eĐ\u0026acirc;y l\u0026agrave; bước triển khai tiếp theo sau khi bệnh viện ho\u0026agrave;n th\u0026agrave;nh đ\u0026agrave;o tạo cho 120 điều dưỡng n\u0026ograve;ng cốt. Từ lực lượng hạt nh\u0026acirc;n n\u0026agrave;y, chương tr\u0026igrave;nh được mở rộng tới 360 điều dưỡng, g\u0026oacute;p phần đưa kiến thức v\u0026agrave;o thực h\u0026agrave;nh thường quy, chuẩn h\u0026oacute;a quy tr\u0026igrave;nh v\u0026agrave; n\u0026acirc;ng cao an to\u0026agrave;n người bệnh, hướng tới mục ti\u0026ecirc;u đạt chứng nhận JCI v\u0026agrave;o cuối năm 2026.\u003c/span\u003e\u003c/p\u003e"])</script><script>self.__next_f.push([1,"26:T4d2,"])</script><script>self.__next_f.push([1,"\u003cp class=\"MsoNormal\" style=\"text-align: justify; line-height: 15.0pt; mso-line-height-rule: exactly; margin: 6.0pt 0in 6.0pt 0in;\"\u003e\u003cspan style=\"font-size: 12.0pt; mso-fareast-font-family: 'Times New Roman'; color: black; mso-themecolor: text1;\"\u003eSinh ra đ\u0026atilde; mất thị lực do đục thủy tinh thể bẩm sinh hai mắt, cậu b\u0026eacute; 41 th\u0026aacute;ng tuổi người d\u0026acirc;n tộc Mường lại đối mặt với nguy cơ mất ch\u0026acirc;n sau khi bị rắn hổ mang cắn. Tr\u0026ecirc;n cơ thể chỉ nặng 9 kg, nọc độc g\u0026acirc;y hoại tử lan rộng từ b\u0026agrave;n ch\u0026acirc;n l\u0026ecirc;n cẳng ch\u0026acirc;n v\u0026agrave; đ\u0026ugrave;i, tạo n\u0026ecirc;n một khuyết hổng phần mềm rất lớn.\u003c/span\u003e\u003c/p\u003e\n\u003cp class=\"MsoNormal\" style=\"text-align: justify; line-height: 15.0pt; mso-line-height-rule: exactly; margin: 6.0pt 0in 6.0pt 0in;\"\u003e\u003cspan style=\"font-size: 12.0pt; mso-fareast-font-family: 'Times New Roman'; color: black; mso-themecolor: text1;\"\u003eBằng sự phối hợp của nhiều chuy\u0026ecirc;n khoa c\u0026ugrave;ng kỹ thuật gh\u0026eacute;p da đặc biệt, c\u0026aacute;c b\u0026aacute;c sĩ Bệnh viện Bạch Mai đ\u0026atilde; bảo tồn được chi thể, giữ lại cơ hội bước đi cho em.\u003c/span\u003e\u003c/p\u003e"])</script><script>self.__next_f.push([1,"27:T663,"])</script><script>self.__next_f.push([1,"\u003cp class=\"MsoNormal\" style=\"text-align: justify; text-justify: inter-ideograph; margin: 6.0pt 0in 6.0pt 0in;\"\u003e\u003cspan style=\"font-family: 'Times New Roman',serif; mso-ascii-theme-font: major-latin; mso-hansi-theme-font: major-latin; mso-bidi-theme-font: major-latin;\"\u003eChiều 22/7, 5 trong số 8 nạn nh\u0026acirc;n vụ ngộ độc kh\u0026iacute; hydro sulfide (H₂S) tại một trang trại chăn nu\u0026ocirc;i lợn ở Thanh H\u0026oacute;a đ\u0026atilde; được xuất viện. Hai trường hợp ban đầu bị ngộ độc nặng, c\u0026oacute; tổn thương tim v\u0026agrave; một người bệnh ph\u0026aacute;t hiện th\u0026ecirc;m vấn đề sức khỏe vẫn tiếp tục điều trị, theo d\u0026otilde;i tại Bệnh viện Bạch Mai cơ sở Ninh B\u0026igrave;nh.\u003c/span\u003e\u003c/p\u003e\n\u003cp class=\"MsoNormal\" style=\"text-align: justify; text-justify: inter-ideograph; margin: 6.0pt 0in 6.0pt 0in;\"\u003e\u003cspan style=\"font-family: 'Times New Roman',serif; mso-ascii-theme-font: major-latin; mso-hansi-theme-font: major-latin; mso-bidi-theme-font: major-latin;\"\u003eĐ\u0026acirc;y l\u0026agrave; th\u0026ocirc;ng tin từ Khoa Hồi sức t\u0026iacute;ch cực \u003c/span\u003e\u003cspan lang=\"EN-US\" style=\"font-family: 'Times New Roman',serif; mso-ascii-theme-font: major-latin; mso-hansi-theme-font: major-latin; mso-bidi-theme-font: major-latin; mso-ansi-language: EN-US;\"\u003e-\u003c/span\u003e\u003cspan style=\"font-family: 'Times New Roman',serif; mso-ascii-theme-font: major-latin; mso-hansi-theme-font: major-latin; mso-bidi-theme-font: major-latin;\"\u003e Chống độc, Bệnh viện Bạch Mai cơ sở Ninh B\u0026igrave;nh sau nhiều ng\u0026agrave;y điều trị t\u0026iacute;ch cực cho c\u0026aacute;c nạn nh\u0026acirc;n.\u003c/span\u003e\u003c/p\u003e"])</script><script>self.__next_f.push([1,"5:[\"$\",\"div\",null,{\"className\":\"category-news\",\"children\":[[\"$\",\"div\",null,{\"className\":\"breadcrumb\",\"children\":[[\"$\",\"div\",null,{\"className\":\"container\",\"children\":[[\"$\",\"h1\",null,{\"className\":\"pb-2 h1\",\"children\":\"Tin trong ngành\"}],[\"$\",\"ul\",null,{\"children\":[[\"$\",\"li\",null,{\"children\":[\"$\",\"$L22\",null,{\"href\":\"/\",\"title\":\"\",\"children\":\"Trang chủ\"}]}],[[\"$\",\"li\",\"1\",{\"children\":[\"$\",\"$L22\",null,{\"href\":\"\",\"children\":[[\"$\",\"span\",null,{\"className\":\"dot px-3\"}],[\"$\",\"span\",null,{\"children\":\"Tin trong ngành\"}]]}]}]]]}]]}],\"$undefined\"]}],[\"$\",\"div\",null,{\"className\":\"container mt-6\",\"children\":[\"$\",\"div\",null,{\"className\":\"category-news__items mb-4 mb-md-5\",\"children\":[\"$\",\"$L23\",null,{\"filtersId\":\"0dd604d2-9f22-30ce-7edf-2c8f61bf4e94\",\"post\":{\"totalCount\":2236,\"items\":[{\"id\":\"bf0a0a2b-f6c2-44ef-bf64-3239693cdb84\",\"title\":\"Thông báo về Lễ viếng, Lễ truy điệu và Lễ an táng Giáo sư Vũ Văn Đính - Anh Hùng lao động, Thầy thuốc nhân dân\",\"slug\":\"thong-bao-ve-le-vieng-le-truy-dieu-va-le-an-tang-giao-su-vu-van-dinh-anh-hung-lao-dong-thay-thuoc-nhan-dan\",\"excerpt\":\"\",\"viewCount\":95,\"publishDate\":\"2026-07-31T00:00:00\",\"thumbnailId\":\"e95e2896-ccaa-4c75-b199-ec095c5e7daa\",\"thumbnail\":{\"id\":\"e95e2896-ccaa-4c75-b199-ec095c5e7daa\",\"fileName\":\"geminigeneratedimage9zkbmn9zkbmn9zkb.png\",\"url\":\"http://apicms.bachmai.gov.vn/documents/0/0/geminigeneratedimage9zkbmn9zkbmn9zkb.png/e95e2896-ccaa-4c75-b199-ec095c5e7daa\",\"path\":\"http://apicms.bachmai.gov.vn/images/2026/7/31/e6c535c1-aefe-46b8-9992-83cc880bcf71_geminigeneratedimage9zkbmn9zkbmn9zkb.png\"},\"categoryId\":null,\"categories\":[{\"id\":\"0dd604d2-9f22-30ce-7edf-2c8f61bf4e94\",\"name\":\"Tin trong ngành\",\"slug\":\"tin-trong-nganh\"}],\"isFeatured\":true,\"isHomepage\":false},{\"id\":\"c5bdcec6-dc62-4363-8717-5d88894d7905\",\"title\":\"Tiếp bước người Thầy lớn - Viết tiếp trang sử vẻ vang của Bệnh viện Bạch Mai và nền y học Việt Nam\",\"slug\":\"tiep-buoc-nguoi-thay-lon-viet-tiep-trang-su-ve-vang-cua-benh-vien-bach-mai-va-nen-y-hoc-viet-nam\",\"excerpt\":\"\u003cp class=\\\"MsoNormal\\\" style=\\\"text-align: justify; margin: 6.0pt 0in 6.0pt 0in;\\\"\u003e\u003cspan lang=\\\"EN-US\\\" style=\\\"font-family: 'Times New Roman',serif;\\\"\u003eC\u0026oacute; những con người khi rời c\u0026otilde;i tạm, sự ra đi kh\u0026ocirc;ng chỉ để lại khoảng trống trong một gia đ\u0026igrave;nh hay một cơ quan, m\u0026agrave; c\u0026ograve;n để lại khoảng lặng trong cả một chuy\u0026ecirc;n ng\u0026agrave;nh, một nền y học. Sự từ biệt của\u0026nbsp;Anh h\u0026ugrave;ng Lao động, Thầy thuốc Nh\u0026acirc;n d\u0026acirc;n, Gi\u0026aacute;o sư Vũ Văn Đ\u0026iacute;nh\u0026nbsp;l\u0026agrave; một mất m\u0026aacute;t như vậy.\u003c/span\u003e\u003c/p\u003e\",\"viewCount\":2492,\"publishDate\":\"2026-07-31T00:00:00\",\"thumbnailId\":\"b44ac19c-0430-4d6a-b524-a0e5f70373db\",\"thumbnail\":{\"id\":\"b44ac19c-0430-4d6a-b524-a0e5f70373db\",\"fileName\":\"339a1935.JPG\",\"url\":\"http://apicms.bachmai.gov.vn/documents/0/0/339a1935.JPG/b44ac19c-0430-4d6a-b524-a0e5f70373db\",\"path\":\"http://apicms.bachmai.gov.vn/images/2026/7/31/db93312d-b571-4af2-8e50-9c9ab55ff88a_339a1935.JPG\"},\"categoryId\":null,\"categories\":[{\"id\":\"0dd604d2-9f22-30ce-7edf-2c8f61bf4e94\",\"name\":\"Tin trong ngành\",\"slug\":\"tin-trong-nganh\"}],\"isFeatured\":false,\"isHomepage\":true},{\"id\":\"5b84eef0-06c1-44f0-ac5d-2bca5ff716e1\",\"title\":\"Nghĩa tình người thầy thuốc với người anh hùng năm xưa: Một cuộc gặp gỡ giữa lịch sử và y đức\",\"slug\":\"nghia-tinh-nguoi-thay-thuoc-voi-nguoi-anh-hung-nam-xua-mot-cuoc-gap-go-giua-lich-su-va-y-duc\",\"excerpt\":\"$24\",\"viewCount\":990,\"publishDate\":\"2026-07-30T00:00:00\",\"thumbnailId\":\"5d33a6df-d5ae-45ec-91c5-2ed7a8a57a57\",\"thumbnail\":{\"id\":\"5d33a6df-d5ae-45ec-91c5-2ed7a8a57a57\",\"fileName\":\"dsc00149.jpg\",\"url\":\"http://apicms.bachmai.gov.vn/documents/0/0/dsc00149.jpg/5d33a6df-d5ae-45ec-91c5-2ed7a8a57a57\",\"path\":\"http://apicms.bachmai.gov.vn/images/2026/7/30/2822348a-875e-4acb-afda-a9c04b41efdb_dsc00149.jpg\"},\"categoryId\":null,\"categories\":[{\"id\":\"0dd604d2-9f22-30ce-7edf-2c8f61bf4e94\",\"name\":\"Tin trong ngành\",\"slug\":\"tin-trong-nganh\"}],\"isFeatured\":false,\"isHomepage\":true},{\"id\":\"c1a8d55d-1a67-4d0f-97cb-c6ecb5f86ff0\",\"title\":\"Vĩnh biệt Giáo sư, Anh hùng Lao động, Thầy thuốc Nhân dân Vũ Văn Đính - Người đặt nền móng cho chuyên ngành Hồi sức cấp cứu Việt Nam\",\"slug\":\"vinh-biet-giao-su-anh-hung-lao-dong-thay-thuoc-nhan-dan-vu-van-dinh-nguoi-dat-nen-mong-cho-chuyen-nganh-hoi-suc-cap-cuu-viet-nam\",\"excerpt\":\"\u003cp class=\\\"MsoNormal\\\" style=\\\"text-align: justify;\\\"\u003e\u003cspan style=\\\"font-family: 'Times New Roman',serif; mso-ansi-language: VI;\\\"\u003eNhững ng\u0026agrave;y cuối th\u0026aacute;ng Bảy, Bệnh viện Bạch Mai đ\u0026oacute;n nhận một mất m\u0026aacute;t lớn khi Gi\u0026aacute;o sư, Anh h\u0026ugrave;ng Lao động, Thầy thuốc Nh\u0026acirc;n d\u0026acirc;n Vũ Văn Đ\u0026iacute;nh từ trần.\u003c/span\u003e\u003c/p\u003e\\n\u003cp class=\\\"MsoNormal\\\" style=\\\"text-align: justify;\\\"\u003e\u003cspan style=\\\"font-family: 'Times New Roman',serif; mso-ansi-language: VI;\\\"\u003eSự ra đi của Gi\u0026aacute;o sư l\u0026agrave; niềm tiếc thương s\u0026acirc;u sắc đối với c\u0026aacute;c thế hệ học tr\u0026ograve;, đồng nghiệp v\u0026agrave; đội ngũ thầy thuốc đ\u0026atilde; từng được \u0026ocirc;ng d\u0026igrave;u dắt, truyền cảm hứng v\u0026agrave; đồng h\u0026agrave;nh trong suốt qu\u0026aacute; tr\u0026igrave;nh x\u0026acirc;y dựng, ph\u0026aacute;t triển chuy\u0026ecirc;n ng\u0026agrave;nh Hồi sức cấp cứu Việt Nam.\u003c/span\u003e\u003c/p\u003e\",\"viewCount\":253,\"publishDate\":\"2026-07-30T00:00:00\",\"thumbnailId\":\"c609b0fc-befc-4e73-bfe5-6e73aeff0d3c\",\"thumbnail\":{\"id\":\"c609b0fc-befc-4e73-bfe5-6e73aeff0d3c\",\"fileName\":\"screenshot1785383914.png\",\"url\":\"http://apicms.bachmai.gov.vn/documents/0/0/screenshot1785383914.png/c609b0fc-befc-4e73-bfe5-6e73aeff0d3c\",\"path\":\"http://apicms.bachmai.gov.vn/images/2026/7/30/16f3d679-2a18-45fd-979d-34a97c60a494_screenshot1785383914.png\"},\"categoryId\":null,\"categories\":[{\"id\":\"0dd604d2-9f22-30ce-7edf-2c8f61bf4e94\",\"name\":\"Tin trong ngành\",\"slug\":\"tin-trong-nganh\"}],\"isFeatured\":false,\"isHomepage\":true},{\"id\":\"d0041381-d232-41b1-8a5f-ce50e0416c2d\",\"title\":\"Những người điều dưỡng lặng thầm phía sau hành trình hồi sinh người bệnh\",\"slug\":\"nhung-nguoi-dieu-duong-lang-tham-phia-sau-hanh-trinh-hoi-sinh-nguoi-benh\",\"excerpt\":\"\u003cp class=\\\"MsoNormal\\\" style=\\\"text-align: justify; margin: 6.0pt 0in 6.0pt 0in;\\\"\u003e\u003cspan style=\\\"font-size: 12.0pt; line-height: 115%; mso-ansi-language: VI;\\\"\u003eGiữa tiếng m\u0026aacute;y thở, \u0026aacute;nh s\u0026aacute;ng từ những m\u0026agrave;n h\u0026igrave;nh theo d\u0026otilde;i hoạt động suốt ng\u0026agrave;y đ\u0026ecirc;m v\u0026agrave; những hồi chu\u0026ocirc;ng b\u0026aacute;o động c\u0026oacute; thể vang l\u0026ecirc;n bất cứ l\u0026uacute;c n\u0026agrave;o, người điều dưỡng hồi sức vẫn lặng lẽ c\u0026oacute; mặt b\u0026ecirc;n từng giường bệnh. Từ việc kiểm tra đường truyền, theo d\u0026otilde;i từng chỉ số sinh tồn đến một lời động vi\u0026ecirc;n hay c\u0026aacute;i nắm tay kh\u0026iacute;ch lệ, tất cả đều g\u0026oacute;p phần g\u0026igrave;n giữ sự sống v\u0026agrave; tiếp th\u0026ecirc;m niềm tin cho người bệnh trong những thời khắc mong manh nhất.\u003c/span\u003e\u003c/p\u003e\",\"viewCount\":250,\"publishDate\":\"2026-07-30T00:00:00\",\"thumbnailId\":\"457c54f6-3f48-46e6-b4f7-38805d509f03\",\"thumbnail\":{\"id\":\"457c54f6-3f48-46e6-b4f7-38805d509f03\",\"fileName\":\"17853105329502525361213050377605g821177366828960831207800a1a201a3f71302063da0a8e7455.jpg\",\"url\":\"http://apicms.bachmai.gov.vn/documents/0/0/17853105329502525361213050377605g821177366828960831207800a1a201a3f71302063da0a8e7455.jpg/457c54f6-3f48-46e6-b4f7-38805d509f03\",\"path\":\"http://apicms.bachmai.gov.vn/images/2026/7/30/96f64572-bc2c-43db-a760-568bc7943403_17853105329502525361213050377605g821177366828960831207800a1a201a3f71302063da0a8e7455.jpg\"},\"categoryId\":null,\"categories\":[{\"id\":\"0dd604d2-9f22-30ce-7edf-2c8f61bf4e94\",\"name\":\"Tin trong ngành\",\"slug\":\"tin-trong-nganh\"}],\"isFeatured\":false,\"isHomepage\":true},{\"id\":\"fff945a9-cf46-4780-b958-f5e0512bf959\",\"title\":\"Bệnh viện Bạch Mai chuẩn hóa bữa ăn điều trị, bảo đảm an toàn cho người bệnh\",\"slug\":\"benh-vien-bach-mai-chuan-hoa-bua-an-dieu-tri-bao-dam-an-toan-cho-nguoi-benh\",\"excerpt\":\"\u003cp class=\\\"MsoNormal\\\" style=\\\"text-align: justify;\\\"\u003e\u003cspan style=\\\"font-family: 'Times New Roman',serif; mso-ansi-language: VI;\\\"\u003eKh\u0026ocirc;ng chỉ ch\u0026uacute; trọng n\u0026acirc;ng cao chất lượng chuy\u0026ecirc;n m\u0026ocirc;n v\u0026agrave; l\u0026agrave;m chủ c\u0026aacute;c kỹ thuật y khoa hiện đại, Bệnh viện Bạch Mai c\u0026ograve;n đặc biệt quan t\u0026acirc;m đến chất lượng dinh dưỡng v\u0026agrave; an to\u0026agrave;n thực phẩm trong từng bữa ăn của người bệnh. Đ\u0026acirc;y được xem l\u0026agrave; một mắt x\u0026iacute;ch quan trọng g\u0026oacute;p phần n\u0026acirc;ng cao hiệu quả điều trị v\u0026agrave; r\u0026uacute;t ngắn thời gian hồi phục.\u003c/span\u003e\u003c/p\u003e\",\"viewCount\":125,\"publishDate\":\"2026-07-28T00:00:00\",\"thumbnailId\":\"f7c15d20-4275-4d8c-9116-5e10c60ab19d\",\"thumbnail\":{\"id\":\"f7c15d20-4275-4d8c-9116-5e10c60ab19d\",\"fileName\":\"17852335255168632047732760297797g8211773668289608312607f6ab4d926d9f476672c03efff6e67.jpg\",\"url\":\"http://apicms.bachmai.gov.vn/documents/0/0/17852335255168632047732760297797g8211773668289608312607f6ab4d926d9f476672c03efff6e67.jpg/f7c15d20-4275-4d8c-9116-5e10c60ab19d\",\"path\":\"http://apicms.bachmai.gov.vn/images/2026/7/28/92082a57-526c-4193-94af-8a5a3ff4bb97_17852335255168632047732760297797g8211773668289608312607f6ab4d926d9f476672c03efff6e67.jpg\"},\"categoryId\":null,\"categories\":[{\"id\":\"0dd604d2-9f22-30ce-7edf-2c8f61bf4e94\",\"name\":\"Tin trong ngành\",\"slug\":\"tin-trong-nganh\"}],\"isFeatured\":false,\"isHomepage\":true},{\"id\":\"aa658289-2b1e-40d5-bc99-c0412aaa8c1b\",\"title\":\"Nâng cao an toàn sử dụng thuốc, hướng tới chuẩn chất lượng quốc tế\",\"slug\":\"nang-cao-an-toan-su-dung-thuoc-huong-toi-chuan-chat-luong-quoc-te\",\"excerpt\":\"$25\",\"viewCount\":220,\"publishDate\":\"2026-07-27T00:00:00\",\"thumbnailId\":\"34022810-5775-4e47-8a19-28c1235511e3\",\"thumbnail\":{\"id\":\"34022810-5775-4e47-8a19-28c1235511e3\",\"fileName\":\"1785120435497670025587116394840267002558711639484021598f9a44fca460ee8370491b4b24a7a.jpg\",\"url\":\"http://apicms.bachmai.gov.vn/documents/0/0/1785120435497670025587116394840267002558711639484021598f9a44fca460ee8370491b4b24a7a.jpg/34022810-5775-4e47-8a19-28c1235511e3\",\"path\":\"http://apicms.bachmai.gov.vn/images/2026/7/27/18ac4bcf-8085-4881-ad54-726fca214365_1785120435497670025587116394840267002558711639484021598f9a44fca460ee8370491b4b24a7a.jpg\"},\"categoryId\":null,\"categories\":[{\"id\":\"0dd604d2-9f22-30ce-7edf-2c8f61bf4e94\",\"name\":\"Tin trong ngành\",\"slug\":\"tin-trong-nganh\"}],\"isFeatured\":false,\"isHomepage\":true},{\"id\":\"a6e87e78-59f9-4ca9-9820-c0c929d8aec4\",\"title\":\"Bệnh viện Bạch Mai cơ sở Ninh Bình: Đưa y tế tuyến cuối, chất lượng cao đến gần với người dân\",\"slug\":\"benh-vien-bach-mai-co-so-ninh-binh-dua-y-te-tuyen-cuoi-chat-luong-cao-den-gan-voi-nguoi-dan\",\"excerpt\":\"\u003cp class=\\\"MsoNormal\\\" style=\\\"text-align: justify; line-height: 15.0pt; mso-line-height-rule: exactly; margin: 6.0pt 0in 6.0pt 0in;\\\"\u003e\u003cspan style=\\\"font-size: 12.0pt; mso-ansi-language: VI;\\\"\u003eChỉ sau hơn ba tuần hoạt động, Bệnh viện Bạch Mai cơ sở Ninh B\u0026igrave;nh kh\u0026ocirc;ng chỉ tiếp nhận hơn 42.800 lượt kh\u0026aacute;m ngoại tr\u0026uacute; v\u0026agrave; điều trị gần 4.800 người bệnh nội tr\u0026uacute;, m\u0026agrave; c\u0026ograve;n li\u0026ecirc;n tiếp l\u0026agrave;m chủ nhiều kỹ thuật chuy\u0026ecirc;n s\u0026acirc;u, cứu sống nhiều ca bệnh nặng ngay tại địa phương. Những kết quả bước đầu cho thấy m\u0026ocirc; h\u0026igrave;nh \\\"Một Bạch Mai - Hai cơ sở\\\" đang ph\u0026aacute;t huy hiệu quả, gi\u0026uacute;p người d\u0026acirc;n được tiếp cận dịch vụ y tế chất lượng cao m\u0026agrave; kh\u0026ocirc;ng c\u0026ograve;n phải vất vả chuyển l\u0026ecirc;n H\u0026agrave; Nội. \u003c/span\u003e\u003c/p\u003e\",\"viewCount\":717,\"publishDate\":\"2026-07-24T00:00:00\",\"thumbnailId\":\"5c434027-2cd8-4960-b11a-72bc8e38301c\",\"thumbnail\":{\"id\":\"5c434027-2cd8-4960-b11a-72bc8e38301c\",\"fileName\":\"e17edafe-6a28-4ec3-b1b7-e7779baef4efmceu89764123241783601805843.jpg\",\"url\":\"http://apicms.bachmai.gov.vn/documents/0/0/e17edafe-6a28-4ec3-b1b7-e7779baef4efmceu89764123241783601805843.jpg/5c434027-2cd8-4960-b11a-72bc8e38301c\",\"path\":\"http://apicms.bachmai.gov.vn/images/2026/7/24/0560d66b-e3cd-4d5a-ad9a-ec61c1c06268_e17edafe-6a28-4ec3-b1b7-e7779baef4efmceu89764123241783601805843.jpg\"},\"categoryId\":null,\"categories\":[{\"id\":\"0dd604d2-9f22-30ce-7edf-2c8f61bf4e94\",\"name\":\"Tin trong ngành\",\"slug\":\"tin-trong-nganh\"}],\"isFeatured\":true,\"isHomepage\":true},{\"id\":\"1c9e43f4-8e89-4153-a4c3-31eb1db8dec7\",\"title\":\"Không cần lên Hà Nội: Người bệnh suy thận được mổ AVF và lọc máu kỹ thuật cao ngay tại Ninh Bình\",\"slug\":\"khong-can-len-ha-noi-nguoi-benh-suy-than-duoc-mo-avf-va-loc-mau-ky-thuat-cao-ngay-tai-ninh-binh\",\"excerpt\":\"\u003cp class=\\\"MsoNormal\\\" style=\\\"text-align: justify; text-justify: inter-ideograph; line-height: 15.0pt; mso-line-height-rule: exactly; margin: 6.0pt 0in 6.0pt 0in;\\\"\u003e\u003cspan lang=\\\"EN-US\\\" style=\\\"font-size: 12.0pt;\\\"\u003eThay v\u0026igrave; phải vượt h\u0026agrave;ng chục c\u0026acirc;y số l\u0026ecirc;n H\u0026agrave; Nội lọc\u003c/span\u003e\u003cspan style=\\\"font-size: 12.0pt; mso-ansi-language: VI;\\\"\u003e m\u0026aacute;u \u003c/span\u003e\u003cspan lang=\\\"EN-US\\\" style=\\\"font-size: 12.0pt;\\\"\u003ehay can thiệp đường v\u0026agrave;o mạch m\u0026aacute;u, người bệnh suy thận mạn tại Ninh B\u0026igrave;nh v\u0026agrave; c\u0026aacute;c v\u0026ugrave;ng l\u0026acirc;n cận nay đ\u0026atilde; c\u0026oacute; thể tiếp cận trọn g\u0026oacute;i c\u0026aacute;c kỹ thuật chuy\u0026ecirc;n s\u0026acirc;u từ mổ tạo th\u0026ocirc;ng động tĩnh mạch (AVF), đặt catheter đường hầm để lọc m\u0026aacute;u, lọc m\u0026aacute;u HDF Online ngay tại Bệnh viện Bạch Mai Cơ sở Ninh B\u0026igrave;nh.\u003c/span\u003e\u003c/p\u003e\",\"viewCount\":1306,\"publishDate\":\"2026-07-23T00:00:00\",\"thumbnailId\":\"5f4c63cc-b1fa-4c8f-9524-2a688d21a6f6\",\"thumbnail\":{\"id\":\"5f4c63cc-b1fa-4c8f-9524-2a688d21a6f6\",\"fileName\":\"screenshot1784790927.png\",\"url\":\"http://apicms.bachmai.gov.vn/documents/0/0/screenshot1784790927.png/5f4c63cc-b1fa-4c8f-9524-2a688d21a6f6\",\"path\":\"http://apicms.bachmai.gov.vn/images/2026/7/23/5c040a89-2081-44be-9fa5-ada2feebdcfb_screenshot1784790927.png\"},\"categoryId\":null,\"categories\":[{\"id\":\"0dd604d2-9f22-30ce-7edf-2c8f61bf4e94\",\"name\":\"Tin trong ngành\",\"slug\":\"tin-trong-nganh\"}],\"isFeatured\":false,\"isHomepage\":true},{\"id\":\"9d44a690-7dd0-42c7-9c5c-38e48bdab3db\",\"title\":\"Những tình nguyện viên áo trắng đồng hành cùng người bệnh tại Bệnh viện Bạch Mai cơ sở Ninh Bình\",\"slug\":\"nhung-tinh-nguyen-vien-ao-trang-dong-hanh-cung-nguoi-benh-tai-benh-vien-bach-mai-co-so-ninh-binh\",\"excerpt\":\"\u003cp class=\\\"MsoNormal\\\" style=\\\"text-align: justify; line-height: 15.0pt; mso-line-height-rule: exactly; margin: 6.0pt 0in 6.0pt 0in;\\\"\u003e\u003cspan style=\\\"font-family: 'Times New Roman',serif; mso-ansi-language: VI;\\\"\u003eS\u0026aacute;ng sớm tại khu vực kh\u0026aacute;m bệnh của Bệnh viện Bạch Mai cơ sở Ninh B\u0026igrave;nh, h\u0026igrave;nh ảnh những sinh vi\u0026ecirc;n trong m\u0026agrave;u \u0026aacute;o blouse trắng tận t\u0026igrave;nh hướng dẫn người bệnh l\u0026agrave;m thủ tục, d\u0026igrave;u c\u0026aacute;c cụ gi\u0026agrave; đến ph\u0026ograve;ng kh\u0026aacute;m hay đẩy xe lăn đưa người bệnh đi chụp chiếu đ\u0026atilde; trở n\u0026ecirc;n quen thuộc. Những lời chỉ dẫn nhẹ nh\u0026agrave;ng, nụ cười th\u0026acirc;n thiện hay chiếc \u0026ocirc; được mở vội dưới trời nắng gắt tưởng chừng chỉ l\u0026agrave; những việc rất nhỏ, nhưng lại gi\u0026uacute;p nhiều người bệnh, đặc biệt l\u0026agrave; người cao tuổi v\u0026agrave; những người lần đầu đến bệnh viện, cảm thấy y\u0026ecirc;n t\u0026acirc;m hơn trong suốt h\u0026agrave;nh tr\u0026igrave;nh kh\u0026aacute;m chữa bệnh.\u003c/span\u003e\u003c/p\u003e\",\"viewCount\":1037,\"publishDate\":\"2026-07-23T00:00:00\",\"thumbnailId\":\"e7da7a46-b64a-408d-9c3c-c94429709055\",\"thumbnail\":{\"id\":\"e7da7a46-b64a-408d-9c3c-c94429709055\",\"fileName\":\"17847964288402525361213050377605g8211773668289608312e60649e6d198a25c8016a6278f407f0a.jpg\",\"url\":\"http://apicms.bachmai.gov.vn/documents/0/0/17847964288402525361213050377605g8211773668289608312e60649e6d198a25c8016a6278f407f0a.jpg/e7da7a46-b64a-408d-9c3c-c94429709055\",\"path\":\"http://apicms.bachmai.gov.vn/images/2026/7/23/709168a4-840c-4aaf-881b-aeca64ccfb46_17847964288402525361213050377605g8211773668289608312e60649e6d198a25c8016a6278f407f0a.jpg\"},\"categoryId\":null,\"categories\":[{\"id\":\"0dd604d2-9f22-30ce-7edf-2c8f61bf4e94\",\"name\":\"Tin trong ngành\",\"slug\":\"tin-trong-nganh\"},{\"id\":\"5f378e4b-f605-9119-c818-27e5225b973f\",\"name\":\"Nhịp cầu nhân ái\",\"slug\":\"nhip-cau-nhan-ai\"}],\"isFeatured\":false,\"isHomepage\":true},{\"id\":\"45ac8cab-598a-4550-a3fe-9a1b83776ef6\",\"title\":\"Giữ lại đôi chân cho cậu bé khiếm thị 41 tháng tuổi bị rắn hổ mang cắn\",\"slug\":\"giu-lai-doi-chan-cho-cau-be-khiem-thi-41-thang-tuoi-bi-ran-ho-mang-can\",\"excerpt\":\"$26\",\"viewCount\":1346,\"publishDate\":\"2026-07-23T00:00:00\",\"thumbnailId\":\"e8f35b08-cb05-48b1-87bc-e89746b73564\",\"thumbnail\":{\"id\":\"e8f35b08-cb05-48b1-87bc-e89746b73564\",\"fileName\":\"1000029653.jpg\",\"url\":\"http://apicms.bachmai.gov.vn/documents/0/0/1000029653.jpg/e8f35b08-cb05-48b1-87bc-e89746b73564\",\"path\":\"http://apicms.bachmai.gov.vn/images/2026/7/23/d39692e9-6d78-45ea-991d-bd65115d9e88_1000029653.jpg\"},\"categoryId\":null,\"categories\":[{\"id\":\"0dd604d2-9f22-30ce-7edf-2c8f61bf4e94\",\"name\":\"Tin trong ngành\",\"slug\":\"tin-trong-nganh\"}],\"isFeatured\":false,\"isHomepage\":true},{\"id\":\"bd2ccc0d-5e80-4f05-bc0f-ec6a11684c8b\",\"title\":\"Vụ ngộ độc khí H₂S tại trang trại lợn ở Thanh Hóa: 5 người bệnh xuất viện, 3 trường hợp tiếp tục được theo dõi\",\"slug\":\"vu-ngo-doc-khi-h₂s-tai-trang-trai-lon-o-thanh-hoa-5-nguoi-benh-xuat-vien-3-truong-hop-tiep-tuc-duoc-theo-doi\",\"excerpt\":\"$27\",\"viewCount\":228,\"publishDate\":\"2026-07-23T00:00:00\",\"thumbnailId\":\"819d6b8a-1e11-4d69-a0c9-d200371d43b7\",\"thumbnail\":{\"id\":\"819d6b8a-1e11-4d69-a0c9-d200371d43b7\",\"fileName\":\"17845281152442525361213050377605g82117736682896083126a5aa7a50fd95c605682603c908eec05.jpg\",\"url\":\"http://apicms.bachmai.gov.vn/documents/0/0/17845281152442525361213050377605g82117736682896083126a5aa7a50fd95c605682603c908eec05.jpg/819d6b8a-1e11-4d69-a0c9-d200371d43b7\",\"path\":\"http://apicms.bachmai.gov.vn/images/2026/7/23/97793100-735f-4218-bde3-0906a2a6896f_17845281152442525361213050377605g82117736682896083126a5aa7a50fd95c605682603c908eec05.jpg\"},\"categoryId\":null,\"categories\":[{\"id\":\"0dd604d2-9f22-30ce-7edf-2c8f61bf4e94\",\"name\":\"Tin trong ngành\",\"slug\":\"tin-trong-nganh\"}],\"isFeatured\":false,\"isHomepage\":true},{\"id\":\"57d941c7-c064-4fb6-8815-db98941b7041\",\"title\":\"Dốc lòng vì người bệnh: Thầy thuốc Bạch Mai giành lại sự sống cho hai ca sốt rét ác tính nguy kịch\",\"slug\":\"doc-long-vi-nguoi-benh-thay-thuoc-bach-mai-gianh-lai-su-song-cho-hai-ca-sot-ret-ac-tinh-nguy-kich\",\"excerpt\":\"\u003cp class=\\\"MsoNormal\\\" style=\\\"mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; text-align: justify; mso-outline-level: 2;\\\"\u003e\u003cspan lang=\\\"EN-US\\\" style=\\\"font-size: 12.0pt; color: black; mso-themecolor: text1;\\\"\u003eHai người bệnh li\u0026ecirc;n tiếp được chuyển đến Bệnh viện Bạch Mai trong t\u0026igrave;nh trạng h\u0026ocirc;n m\u0026ecirc;, suy đa tạng, t\u0026iacute;nh mạng \u0026ldquo;ng\u0026agrave;n c\u0026acirc;n treo sợi t\u0026oacute;c\u0026rdquo; v\u0026igrave; sốt r\u0026eacute;t \u0026aacute;c t\u0026iacute;nh - căn bệnh hiện kh\u0026ocirc;ng c\u0026ograve;n phổ biến tại Việt Nam, trong khi nguồn thuốc điều trị đặc hiệu rất hạn chế. Trước t\u0026igrave;nh thế cấp b\u0026aacute;ch, Ban Gi\u0026aacute;m đốc Bệnh viện Bạch Mai c\u0026ugrave;ng c\u0026aacute;c thầy thuốc Viện Y học nhiệt đới v\u0026agrave; nhiều chuy\u0026ecirc;n khoa đ\u0026atilde; dốc to\u0026agrave;n lực, chạy đua từng giờ để t\u0026igrave;m đường sống cho người bệnh.\u003c/span\u003e\u003c/p\u003e\",\"viewCount\":1347,\"publishDate\":\"2026-07-22T00:00:00\",\"thumbnailId\":\"c1beef4c-b078-448b-b66f-19ae9dd02990\",\"thumbnail\":{\"id\":\"c1beef4c-b078-448b-b66f-19ae9dd02990\",\"fileName\":\"dsc5788.jpg\",\"url\":\"http://apicms.bachmai.gov.vn/documents/0/0/dsc5788.jpg/c1beef4c-b078-448b-b66f-19ae9dd02990\",\"path\":\"http://apicms.bachmai.gov.vn/images/2026/7/22/462c2721-468d-411d-9177-00efdea161fd_dsc5788.jpg\"},\"categoryId\":null,\"categories\":[{\"id\":\"0dd604d2-9f22-30ce-7edf-2c8f61bf4e94\",\"name\":\"Tin trong ngành\",\"slug\":\"tin-trong-nganh\"}],\"isFeatured\":false,\"isHomepage\":true},{\"id\":\"0166dd90-e32d-456c-bf8e-72f07ac5c4c8\",\"title\":\"Thông tin tình hình 8 nạn nhân ngộ độc khí H₂S đang được cấp cứu tại Bệnh viện Bạch Mai cơ sở Ninh Bình \",\"slug\":\"thong-tin-tinh-hinh-8-nan-nhan-ngo-doc-khi-h₂s-dang-duoc-cap-cuu-tai-benh-vien-bach-mai-co-so-ninh-binh\",\"excerpt\":\"\u003cp class=\\\"MsoNormal\\\" style=\\\"text-align: justify; margin: 6.0pt 0in 6.0pt 0in;\\\"\u003e\u003cspan style=\\\"font-family: 'Times New Roman',serif;\\\"\u003eTừ 24 giờ ng\u0026agrave;y 18/7 đến trưa ng\u0026agrave;y 19/7/2026, Trung t\u0026acirc;m Chống độc - Bệnh viện Bạch Mai cơ sở Ninh B\u0026igrave;nh đ\u0026atilde; tiếp nhận cấp cứu khẩn cấp một loạt 8 bệnh nh\u0026acirc;n nam bị ngộ độc kh\u0026iacute; sunphua hydro (H₂S) trong vụ ngộ độc đặc biệt nghi\u0026ecirc;m trọng xảy ra tại một trang trại chăn nu\u0026ocirc;i lợn lớn. Sự c\u0026oacute; mặt v\u0026agrave; chỉ đạo trực tiếp của GS.TS Đ\u0026agrave;o Xu\u0026acirc;n Cơ, Gi\u0026aacute;m đốc Bệnh viện Bạch Mai, c\u0026ugrave;ng việc Bệnh viện Bạch Mai cơ sở Ninh B\u0026igrave;nh đi v\u0026agrave;o vận h\u0026agrave;nh đ\u0026atilde; cho thấy khả năng huy động, ứng ph\u0026oacute; khẩn cấp của bệnh viện, g\u0026oacute;p phần đưa dịch vụ y tế chất lượng cao đến gần người d\u0026acirc;n hơn, đ\u0026aacute;p ứng y\u0026ecirc;u cầu cấp cứu kịp thời trong c\u0026aacute;c t\u0026igrave;nh huống nguy cấp.\u003c/span\u003e\u003c/p\u003e\",\"viewCount\":2312,\"publishDate\":\"2026-07-19T00:00:00\",\"thumbnailId\":\"ffb1d5da-dc36-478e-9ff8-5b9c9a71cd90\",\"thumbnail\":{\"id\":\"ffb1d5da-dc36-478e-9ff8-5b9c9a71cd90\",\"fileName\":\"178447260641018510834259162450546959678069364066331f38053a95be3d2b732f7c3752270c2a0.jpg\",\"url\":\"http://apicms.bachmai.gov.vn/documents/0/0/178447260641018510834259162450546959678069364066331f38053a95be3d2b732f7c3752270c2a0.jpg/ffb1d5da-dc36-478e-9ff8-5b9c9a71cd90\",\"path\":\"http://apicms.bachmai.gov.vn/images/2026/7/19/84e4b3e5-8fbc-4318-a60f-aa92e6693074_178447260641018510834259162450546959678069364066331f38053a95be3d2b732f7c3752270c2a0.jpg\"},\"categoryId\":null,\"categories\":[{\"id\":\"0dd604d2-9f22-30ce-7edf-2c8f61bf4e94\",\"name\":\"Tin trong ngành\",\"slug\":\"tin-trong-nganh\"}],\"isFeatured\":false,\"isHomepage\":true}]},\"totalPage\":14,\"isPagination\":true,\"col\":8}]}]}]]}]\n"])</script></body></html>
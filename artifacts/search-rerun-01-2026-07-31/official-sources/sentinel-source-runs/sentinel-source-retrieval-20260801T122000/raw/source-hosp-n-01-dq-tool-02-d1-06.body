u bệnh c\u0026ugrave;ng c\u0026aacute;c chuy\u0026ecirc;n khoa G\u0026acirc;y m\u0026ecirc; hồi sức, Nội tiết đ\u0026atilde; thực hiện th\u0026agrave;nh c\u0026ocirc;ng nhiều ca phẫu thuật ung thư v\u0026uacute; phức tạp.\u003c/span\u003e\u003c/p\u003e\n\u003cp class=\"MsoNormal\" style=\"text-align: justify; margin: 6.0pt 0in 6.0pt 0in;\"\u003e\u003cspan style=\"font-family: 'Times New Roman',serif; mso-ansi-language: VI;\"\u003eNg\u0026agrave;y 30/7, Khoa Ngoại tổng hợp (Bệnh viện Bạch Mai cơ sở Ninh B\u0026igrave;nh) tiếp nhận, hội chẩn đa chuy\u0026ecirc;n khoa v\u0026agrave; phẫu thuật th\u0026agrave;nh c\u0026ocirc;ng cho c\u0026aacute;c trường hợp người bệnh cao tuổi mắc ung thư v\u0026uacute; k\u0026egrave;m nhiều bệnh l\u0026yacute; mạn t\u0026iacute;nh. Việc huy động Hội đồng đa chuy\u0026ecirc;n khoa (MDT) c\u0026ugrave;ng năng lực kiểm so\u0026aacute;t nguy cơ nội khoa, g\u0026acirc;y m\u0026ecirc; hồi sức chuy\u0026ecirc;n s\u0026acirc;u đ\u0026atilde; gi\u0026uacute;p qu\u0026aacute; tr\u0026igrave;nh can thiệp ngoại khoa diễn ra an to\u0026agrave;n, người bệnh phục hồi tốt sau phẫu thuật.\u003c/span\u003e\u003c/p\u003e"])</script><script>self.__next_f.push([1,"25:T521,"])</script><script>self.__next_f.push([1,"\u003cp class=\"MsoNormal\" style=\"text-align: justify; line-height: 15.0pt; mso-line-height-rule: exactly; margin: 6.0pt 0in 6.0pt 0in;\"\u003e\u003cspan style=\"font-family: 'Times New Roman',serif;\"\u003eBệnh viện Bạch Mai cơ sở Ninh B\u0026igrave;nh vừa thực hiện th\u0026agrave;nh c\u0026ocirc;ng ca cắt b\u0026egrave; củng gi\u0026aacute;c mạc mắt phải đầu ti\u0026ecirc;n điều trị cho người bệnh mắc \u003c/span\u003e\u003cspan lang=\"VI\" style=\"font-family: 'Times New Roman',serif; mso-ansi-language: VI;\"\u003eG\u003c/span\u003e\u003cspan style=\"font-family: 'Times New Roman',serif;\"\u003el\u0026ocirc;c\u0026ocirc;m nặng. Ca phẫu thuật được thực hiện bởi \u003c/span\u003e\u003cspan style=\"font-family: 'Times New Roman',serif; mso-ansi-language: EN-US;\"\u003eb\u0026aacute;c sĩ chuy\u0026ecirc;n khoa Mắt\u003c/span\u003e\u003cspan style=\"font-family: 'Times New Roman',serif; mso-ansi-language: VI;\"\u003e \u003c/span\u003e\u003cspan style=\"font-family: 'Times New Roman',serif;\"\u003ec\u0026ugrave;ng \u0026ecirc;-k\u0026iacute;p chuy\u0026ecirc;n khoa \u003c/span\u003e\u003cspan lang=\"VI\" style=\"font-family: 'Times New Roman',serif; mso-ansi-language: VI;\"\u003ev\u0026agrave; Trung t\u0026acirc;m G\u0026acirc;y m\u0026ecirc; hồi sức\u003c/span\u003e\u003cspan style=\"font-family: 'Times New Roman',serif;\"\u003e đ\u0026aacute;nh dấu bước tiến quan trọng trong việc triển khai c\u0026aacute;c kỹ thuật chuy\u0026ecirc;n s\u0026acirc;u về nh\u0026atilde;n khoa tại bệnh viện.\u003c/span\u003e\u003c/p\u003e"])</script><script>self.__next_f.push([1,"26:T4f1,"])</script><script>self.__next_f.push([1,"\u003cp class=\"MsoNormal\" style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: 12.0pt; line-height: 107%; font-family: 'Times New Roman',serif; mso-ansi-language: VI;\"\u003eTrong chiến lược ph\u0026aacute;t triển trở th\u0026agrave;nh trung t\u0026acirc;m y học chuy\u0026ecirc;n s\u0026acirc;u ngang tầm khu vực v\u0026agrave; quốc tế, Bệnh viện Bạch Mai x\u0026aacute;c định hợp t\u0026aacute;c quốc tế l\u0026agrave; một trong những động lực quan trọng để tiếp cận c\u0026aacute;c th\u0026agrave;nh tựu y học ti\u0026ecirc;n tiến, n\u0026acirc;ng cao chất lượng chuy\u0026ecirc;n m\u0026ocirc;n v\u0026agrave; ph\u0026aacute;t triển nguồn nh\u0026acirc;n lực.\u003c/span\u003e\u003c/p\u003e\n\u003cp class=\"MsoNormal\" style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: 12.0pt; line-height: 107%; font-family: 'Times New Roman',serif; mso-ansi-language: VI;\"\u003eNg\u0026agrave;y 19/7/2026, Bệnh viện Bạch Mai đ\u0026oacute;n đo\u0026agrave;n l\u0026atilde;nh đạo, chuy\u0026ecirc;n gia của Bệnh viện Cựu chiến binh Đ\u0026agrave;i Bắc (Taipei Veterans General Hospital - TVGH) c\u0026ugrave;ng đại diện nhiều bệnh viện, trường đại học v\u0026agrave; doanh nghiệp y tế h\u0026agrave;ng đầu Đ\u0026agrave;i Loan đến thăm, l\u0026agrave;m việc tại cả hai cơ sở H\u0026agrave; Nội v\u0026agrave; Ninh B\u0026igrave;nh.\u003c/span\u003e\u003c/p\u003e"])</script><script>self.__next_f.push([1,"5:[\"$\",\"div\",null,{\"className\":\"category-news\",\"children\":[[\"$\",\"div\",null,{\"className\":\"breadcrumb\",\"children\":[[\"$\",\"div\",null,{\"className\":\"container\",\"children\":[[\"$\",\"h1\",null,{\"className\":\"pb-2 h1\",\"children\":\"Tin hoạt động Bệnh viện\"}],[\"$\",\"ul\",null,{\"children\":[[\"$\",\"li\",null,{\"children\":[\"$\",\"$L22\",null,{\"href\":\"/\",\"title\":\"\",\"children\":\"Trang chủ\"}]}],[[\"$\",\"li\",\"1\",{\"children\":[\"$\",\"$L22\",null,{\"href\":\"\",\"children\":[[\"$\",\"span\",null,{\"className\":\"dot px-3\"}],[\"$\",\"span\",null,{\"children\":\"Tin hoạt động Bệnh viện\"}]]}]}]]]}]]}],\"$undefined\"]}],[\"$\",\"div\",null,{\"className\":\"container mt-6\",\"children\":[\"$\",\"div\",null,{\"className\":\"category-news__items mb-4 mb-md-5\",\"children\":[\"$\",\"$L23\",null,{\"filtersId\":\"6fe85f1d-d00b-b3be-1d7d-99e588de7e2e\",\"post\":{\"totalCount\":1638,\"items\":[{\"id\":\"add2a3c6-284d-4d03-9f29-e2ab4c4cd693\",\"title\":\"Bệnh viện Bạch Mai và Bộ Y tế Angola thúc đẩy hợp tác đào tạo nguồn nhân lực y tế\",\"slug\":\"benh-vien-bach-mai-va-bo-y-te-angola-thuc-day-hop-tac-dao-tao-nguon-nhan-luc-y-te\",\"excerpt\":\"\u003cp class=\\\"MsoNormal\\\" style=\\\"text-align: justify; margin: 6.0pt 0in 6.0pt 0in;\\\"\u003e\u003cspan style=\\\"font-size: 12.0pt; line-height: 107%; font-family: 'Times New Roman',serif; mso-ansi-language: VI;\\\"\u003eS\u0026aacute;ng 30/7, tại H\u0026agrave; Nội, Bệnh viện Bạch Mai tiếp v\u0026agrave; l\u0026agrave;m việc với đo\u0026agrave;n c\u0026ocirc;ng t\u0026aacute;c Bộ Y tế Angola nhằm trao đổi về khả năng hợp t\u0026aacute;c trong đ\u0026agrave;o tạo, ph\u0026aacute;t triển nguồn nh\u0026acirc;n lực y tế v\u0026agrave; chuyển giao kỹ thuật chuy\u0026ecirc;n m\u0026ocirc;n giữa hai b\u0026ecirc;n. Buổi l\u0026agrave;m việc mở ra những định hướng hợp t\u0026aacute;c thiết thực, g\u0026oacute;p phần tiếp nối truyền thống hữu nghị l\u0026acirc;u đời giữa Việt Nam v\u0026agrave; Angola trong lĩnh vực y tế.\u003c/span\u003e\u003c/p\u003e\",\"viewCount\":106,\"publishDate\":\"2026-07-31T00:00:00\",\"thumbnailId\":\"a3635896-6e95-422c-900d-c59c52368031\",\"thumbnail\":{\"id\":\"a3635896-6e95-422c-900d-c59c52368031\",\"fileName\":\"17853806592576700255871163948402g8211773668289608312ce6db84bbe97212d1bbd2f1b75dc68c5.jpg\",\"url\":\"http://apicms.bachmai.gov.vn/documents/0/0/17853806592576700255871163948402g8211773668289608312ce6db84bbe97212d1bbd2f1b75dc68c5.jpg/a3635896-6e95-422c-900d-c59c52368031\",\"path\":\"http://apicms.bachmai.gov.vn/images/2026/7/30/c29d008e-4275-48ce-b18d-d8b3c3581ddf_17853806592576700255871163948402g8211773668289608312ce6db84bbe97212d1bbd2f1b75dc68c5.jpg\"},\"categoryId\":null,\"categories\":[{\"id\":\"6fe85f1d-d00b-b3be-1d7d-99e588de7e2e\",\"name\":\"Tin hoạt động Bệnh viện\",\"slug\":\"tin-hoat-ong-benh-vien\"}],\"isFeatured\":false,\"isHomepage\":true},{\"id\":\"f06ea70d-a3ae-45c9-aeff-2df613f72574\",\"title\":\"106 cán bộ y tế Bệnh viện Bạch Mai được cấp chứng chỉ an toàn tiêm chủng\",\"slug\":\"106-can-bo-y-te-benh-vien-bach-mai-duoc-cap-chung-chi-an-toan-tiem-chung\",\"excerpt\":\"\u003cp class=\\\"MsoNormal\\\" style=\\\"mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; text-align: justify;\\\"\u003e\u003cspan lang=\\\"EN-US\\\" style=\\\"font-size: 12.0pt; mso-fareast-font-family: 'Times New Roman'; color: windowtext;\\\"\u003eSau khi ho\u0026agrave;n th\u0026agrave;nh chương tr\u0026igrave;nh đ\u0026agrave;o tạo \u0026ldquo;Ti\u0026ecirc;m chủng v\u0026agrave; an to\u0026agrave;n ti\u0026ecirc;m chủng\u0026rdquo;, 106 b\u0026aacute;c sĩ, điều dưỡng Bệnh viện Bạch Mai đ\u0026atilde; được cấp chứng chỉ. Chương tr\u0026igrave;nh g\u0026oacute;p phần n\u0026acirc;ng cao năng lực tư vấn, chỉ định v\u0026agrave; tổ chức ti\u0026ecirc;m chủng an to\u0026agrave;n, hướng tới chiến lược dự ph\u0026ograve;ng bệnh chủ động cho người bệnh, nh\u0026acirc;n vi\u0026ecirc;n y tế v\u0026agrave; cộng đồng.\u003c/span\u003e\u003c/p\u003e\",\"viewCount\":342,\"publishDate\":\"2026-07-30T00:00:00\",\"thumbnailId\":\"20b7750d-f427-40e9-b314-e2a25474c103\",\"thumbnail\":{\"id\":\"20b7750d-f427-40e9-b314-e2a25474c103\",\"fileName\":\"picture2.jpg\",\"url\":\"http://apicms.bachmai.gov.vn/documents/0/0/picture2.jpg/20b7750d-f427-40e9-b314-e2a25474c103\",\"path\":\"http://apicms.bachmai.gov.vn/images/2026/7/30/bf15ceed-1b3b-4176-b5c6-3d6fa1859e50_picture2.jpg\"},\"categoryId\":null,\"categories\":[{\"id\":\"6fe85f1d-d00b-b3be-1d7d-99e588de7e2e\",\"name\":\"Tin hoạt động Bệnh viện\",\"slug\":\"tin-hoat-ong-benh-vien\"}],\"isFeatured\":false,\"isHomepage\":true},{\"id\":\"eb85996a-d466-4841-adce-b19aa5e3fcbb\",\"title\":\"Hội chẩn đa chuyên khoa, phẫu thuật thành công ung thư vú cho người bệnh cao tuổi\",\"slug\":\"hoi-chan-da-chuyen-khoa-phau-thuat-thanh-cong-ung-thu-vu-cho-nguoi-benh-cao-tuoi\",\"excerpt\":\"$24\",\"viewCount\":657,\"publishDate\":\"2026-07-30T00:00:00\",\"thumbnailId\":\"48b72e76-d96d-450d-9aad-a167b067f566\",\"thumbnail\":{\"id\":\"48b72e76-d96d-450d-9aad-a167b067f566\",\"fileName\":\"17853968437912525361213050377605g821177366828960831222c250a9b4da78c8aa11de607db8d125.jpg\",\"url\":\"http://apicms.bachmai.gov.vn/documents/0/0/17853968437912525361213050377605g821177366828960831222c250a9b4da78c8aa11de607db8d125.jpg/48b72e76-d96d-450d-9aad-a167b067f566\",\"path\":\"http://apicms.bachmai.gov.vn/images/2026/7/30/c21900b1-a260-4137-b9c8-e1172137bc2f_17853968437912525361213050377605g821177366828960831222c250a9b4da78c8aa11de607db8d125.jpg\"},\"categoryId\":null,\"categories\":[{\"id\":\"6fe85f1d-d00b-b3be-1d7d-99e588de7e2e\",\"name\":\"Tin hoạt động Bệnh viện\",\"slug\":\"tin-hoat-ong-benh-vien\"}],\"isFeatured\":false,\"isHomepage\":true},{\"id\":\"f65083f1-81af-4c72-b136-043f85791321\",\"title\":\"Chuyến xe 5 giờ sáng xuyên màn mưa và giọt nước mắt nghẹn ngào của người cha ở Ninh Bình\",\"slug\":\"chuyen-xe-5-gio-sang-xuyen-man-mua-va-giot-nuoc-mat-nghen-ngao-cua-nguoi-cha-o-ninh-binh\",\"excerpt\":\"\u003cp class=\\\"MsoNormal\\\" style=\\\"text-align: justify; line-height: 15.0pt; mso-line-height-rule: exactly; margin: 6.0pt 0in 6.0pt 0in;\\\"\u003e\u003cspan style=\\\"font-family: 'Times New Roman',serif; mso-ansi-language: VI;\\\"\u003eMột ca chấn thương h\u0026agrave;m mặt phức tạp do tai nạn giao th\u0026ocirc;ng vừa được c\u0026aacute;c b\u0026aacute;c sĩ Khoa Răng H\u0026agrave;m Mặt, Bệnh viện Bạch Mai xử tr\u0026iacute; th\u0026agrave;nh c\u0026ocirc;ng tại cơ sở Ninh B\u0026igrave;nh. Đằng sau ca phẫu thuật l\u0026agrave; h\u0026agrave;nh tr\u0026igrave;nh vượt mưa từ H\u0026agrave; Nội xuống Ninh B\u0026igrave;nh từ 5 giờ s\u0026aacute;ng của TS.BSCC. Ho\u0026agrave;ng Ngọc Lan c\u0026ugrave;ng \u0026ecirc;-k\u0026iacute;p, đồng thời khẳng định năng lực triển khai kỹ thuật chuy\u0026ecirc;n s\u0026acirc;u ngay tại địa phương.\u003c/span\u003e\u003c/p\u003e\",\"viewCount\":1300,\"publishDate\":\"2026-07-29T00:00:00\",\"thumbnailId\":\"c6e3c100-4fc5-4845-953f-8c767c5cd185\",\"thumbnail\":{\"id\":\"c6e3c100-4fc5-4845-953f-8c767c5cd185\",\"fileName\":\"17853170582812525361213050377605g821177366828960831247263ac9c0ff086da11126098b3f8bfc.jpg\",\"url\":\"http://apicms.bachmai.gov.vn/documents/0/0/17853170582812525361213050377605g821177366828960831247263ac9c0ff086da11126098b3f8bfc.jpg/c6e3c100-4fc5-4845-953f-8c767c5cd185\",\"path\":\"http://apicms.bachmai.gov.vn/images/2026/7/29/9e1a1ee5-2296-43b1-a9a6-ebdd57fd4765_17853170582812525361213050377605g821177366828960831247263ac9c0ff086da11126098b3f8bfc.jpg\"},\"categoryId\":null,\"categories\":[{\"id\":\"6fe85f1d-d00b-b3be-1d7d-99e588de7e2e\",\"name\":\"Tin hoạt động Bệnh viện\",\"slug\":\"tin-hoat-ong-benh-vien\"}],\"isFeatured\":true,\"isHomepage\":true},{\"id\":\"71a85d9e-2934-4a09-b875-c8e014c8444a\",\"title\":\"Bệnh viện Bạch Mai tăng cường phối hợp đa ngành trong tư vấn hiến, ghép mô, tạng\",\"slug\":\"benh-vien-bach-mai-tang-cuong-phoi-hop-da-nganh-trong-tu-van-hien-ghep-mo-tang\",\"excerpt\":\"\u003cp class=\\\"MsoNormal\\\" style=\\\"text-align: justify; text-justify: inter-ideograph; margin: 6.0pt 0in 6.0pt 0in;\\\"\u003e\u003cspan style=\\\"font-family: 'Times New Roman',serif; mso-ansi-language: VI;\\\"\u003eChiều 29/7, Bệnh viện Bạch Mai tổ chức chương tr\u0026igrave;nh tập huấn \\\"Phối hợp đa ng\u0026agrave;nh trong c\u0026ocirc;ng t\u0026aacute;c x\u0026atilde; hội về tư vấn, vận động hiến, gh\u0026eacute;p m\u0026ocirc;, tạng\\\", nhằm cập nhật kiến thức, n\u0026acirc;ng cao kỹ năng v\u0026agrave; tăng cường năng lực phối hợp giữa c\u0026aacute;c đơn vị trong hoạt động tư vấn, vận động hiến, gh\u0026eacute;p m\u0026ocirc;, tạng.\u003c/span\u003e\u003c/p\u003e\",\"viewCount\":236,\"publishDate\":\"2026-07-29T00:00:00\",\"thumbnailId\":\"7158187f-f7ac-46ad-a89d-46c593f830bd\",\"thumbnail\":{\"id\":\"7158187f-f7ac-46ad-a89d-46c593f830bd\",\"fileName\":\"17853153328976700255871163948402g8211773668289608312e8f0acd742b4257279780000af844de1.jpg\",\"url\":\"http://apicms.bachmai.gov.vn/documents/0/0/17853153328976700255871163948402g8211773668289608312e8f0acd742b4257279780000af844de1.jpg/7158187f-f7ac-46ad-a89d-46c593f830bd\",\"path\":\"http://apicms.bachmai.gov.vn/images/2026/7/29/2b2eadff-4a16-4104-9c3a-2d4dfc42c7a8_17853153328976700255871163948402g8211773668289608312e8f0acd742b4257279780000af844de1.jpg\"},\"categoryId\":null,\"categories\":[{\"id\":\"6fe85f1d-d00b-b3be-1d7d-99e588de7e2e\",\"name\":\"Tin hoạt động Bệnh viện\",\"slug\":\"tin-hoat-ong-benh-vien\"}],\"isFeatured\":false,\"isHomepage\":true},{\"id\":\"90eb05ea-3fdd-4d6d-a611-f8ca332d332a\",\"title\":\"Món quà cuộc sống diệu kỳ: 50 phút thần tốc giành lại nhịp đập cho người bệnh ngừng tim tại Bệnh viện Bạch Mai cơ sở Ninh Bình\",\"slug\":\"mon-qua-cuoc-song-dieu-ky-50-phut-than-toc-gianh-lai-nhip-dap-cho-nguoi-benh-ngung-tim-tai-benh-vien-bach-mai-co-so-ninh-binh\",\"excerpt\":\"\u003cp class=\\\"MsoNormal\\\" style=\\\"text-align: justify; margin: 6.0pt 0in 6.0pt 0in;\\\"\u003e\u003cspan style=\\\"font-family: 'Times New Roman',serif; mso-ansi-language: VI;\\\"\u003eTr\u0026ograve;n một th\u0026aacute;ng kể từ ng\u0026agrave;y ch\u0026iacute;nh thức đi v\u0026agrave;o hoạt động, Bệnh viện Bạch Mai cơ sở Ninh B\u0026igrave;nh vừa cứu sống một người bệnh ngừng tim do nhồi m\u0026aacute;u cơ tim cấp bằng cuộc cấp cứu k\u0026eacute;o d\u0026agrave;i chỉ 50 ph\u0026uacute;t. Kh\u0026ocirc;ng chỉ l\u0026agrave; th\u0026agrave;nh c\u0026ocirc;ng về chuy\u0026ecirc;n m\u0026ocirc;n, ca bệnh c\u0026ograve;n khẳng định gi\u0026aacute; trị của việc đưa kỹ thuật y tế chuy\u0026ecirc;n s\u0026acirc;u đến gần người d\u0026acirc;n, gi\u0026uacute;p r\u0026uacute;t ngắn khoảng c\u0026aacute;ch sinh tử v\u0026agrave; giữ lại cơ hội sống ngay tr\u0026ecirc;n qu\u0026ecirc; hương.\u003c/span\u003e\u003c/p\u003e\",\"viewCount\":927,\"publishDate\":\"2026-07-27T00:00:00\",\"thumbnailId\":\"42e481fb-90ca-44fd-8d56-7cec1edb413d\",\"thumbnail\":{\"id\":\"42e481fb-90ca-44fd-8d56-7cec1edb413d\",\"fileName\":\"17851389320302525361213050377605g82117736682896083128c773151abf6b721f89edb7b4fcca5fd.jpg\",\"url\":\"http://apicms.bachmai.gov.vn/documents/0/0/17851389320302525361213050377605g82117736682896083128c773151abf6b721f89edb7b4fcca5fd.jpg/42e481fb-90ca-44fd-8d56-7cec1edb413d\",\"path\":\"http://apicms.bachmai.gov.vn/images/2026/7/27/33c71317-d4ff-4901-8d56-e9823d33cdf1_17851389320302525361213050377605g82117736682896083128c773151abf6b721f89edb7b4fcca5fd.jpg\"},\"categoryId\":null,\"categories\":[{\"id\":\"6fe85f1d-d00b-b3be-1d7d-99e588de7e2e\",\"name\":\"Tin hoạt động Bệnh viện\",\"slug\":\"tin-hoat-ong-benh-vien\"}],\"isFeatured\":false,\"isHomepage\":true},{\"id\":\"6ce6b34d-ccd7-4387-a54f-5fd6c1260eda\",\"title\":\"Bệnh viện Bạch Mai tham gia chương trình khám bệnh, trao quà tri ân người có công tại phường Sơn Nam, tỉnh Hưng Yên nhân ngày 27/7/2026\",\"slug\":\"benh-vien-bach-mai-tham-gia-chuong-trinh-kham-benh-trao-qua-tri-an-nguoi-co-cong-tai-phuong-son-nam-tinh-hung-yen-nhan-ngay-2772026\",\"excerpt\":\"\u003cp class=\\\"MsoNormal\\\" style=\\\"text-align: justify; margin: 6.0pt 0in 6.0pt 0in;\\\"\u003e\u003cspan lang=\\\"EN-US\\\" style=\\\"font-family: 'Times New Roman',serif;\\\"\u003eHướng tới kỷ niệm 79 năm Ng\u0026agrave;y Thương binh - Liệt sĩ, ng\u0026agrave;y 25/7/2026, Bệnh viện Bạch Mai đ\u0026atilde; đồng h\u0026agrave;nh c\u0026ugrave;ng Đo\u0026agrave;n c\u0026ocirc;ng t\u0026aacute;c của Trung ương Hội Thầy thuốc trẻ Việt Nam do Đồng ch\u0026iacute; Đỗ Xu\u0026acirc;n Tuy\u0026ecirc;n - Thứ trưởng Bộ Y tế l\u0026agrave;m Trưởng đo\u0026agrave;n, tổ chức Chương tr\u0026igrave;nh kh\u0026aacute;m bệnh, tư vấn sức khỏe v\u0026agrave; tặng qu\u0026agrave; tri \u0026acirc;n người c\u0026oacute; c\u0026ocirc;ng tại tỉnh Hưng Y\u0026ecirc;n. Chương tr\u0026igrave;nh vinh dự c\u0026oacute; sự tham dự của đại diện L\u0026atilde;nh đạo c\u0026aacute;c đơn vị, đo\u0026agrave;n thể v\u0026agrave; ch\u0026iacute;nh quyền địa phương. \u003c/span\u003e\u003c/p\u003e\",\"viewCount\":445,\"publishDate\":\"2026-07-26T00:00:00\",\"thumbnailId\":\"73e9d9c9-9351-4c6a-b757-12056adf51ad\",\"thumbnail\":{\"id\":\"73e9d9c9-9351-4c6a-b757-12056adf51ad\",\"fileName\":\"17849880463548632047732760297797g25043974166515298075df4aa1397a5e50ecd7c5b8eb6997226.jpg\",\"url\":\"http://apicms.bachmai.gov.vn/documents/0/0/17849880463548632047732760297797g25043974166515298075df4aa1397a5e50ecd7c5b8eb6997226.jpg/73e9d9c9-9351-4c6a-b757-12056adf51ad\",\"path\":\"http://apicms.bachmai.gov.vn/images/2026/7/27/7bbf64ca-50be-4852-ae6e-d66701448446_17849880463548632047732760297797g25043974166515298075df4aa1397a5e50ecd7c5b8eb6997226.jpg\"},\"categoryId\":null,\"categories\":[{\"id\":\"9440bf8a-5507-beb2-ace6-91e90772fff6\",\"name\":\"Sự kiện nổi bật\",\"slug\":\"su-kien-noi-bat\"},{\"id\":\"6fe85f1d-d00b-b3be-1d7d-99e588de7e2e\",\"name\":\"Tin hoạt động Bệnh viện\",\"slug\":\"tin-hoat-ong-benh-vien\"},{\"id\":\"9440bf8a-5507-beb2-ace6-91e90772fff6\",\"name\":\"Sự kiện nổi bật\",\"slug\":\"su-kien-noi-bat\"}],\"isFeatured\":false,\"isHomepage\":true},{\"id\":\"d080d35b-60cd-4d03-aa11-c2e96f345d04\",\"title\":\"Vượt qua chặng đường dài, bệnh nhân người Lào được điều trị bệnh lý Glôcôm tại Bệnh viện Bạch Mai cơ sở Ninh Bình \",\"slug\":\"vuot-qua-chang-duong-dai-benh-nhan-nguoi-lao-duoc-dieu-tri-benh-ly-glocom-tai-benh-vien-bach-mai-co-so-ninh-binh\",\"excerpt\":\"$25\",\"viewCount\":1339,\"publishDate\":\"2026-07-26T00:00:00\",\"thumbnailId\":\"7863d82b-0edd-4e85-88ea-b494735192c6\",\"thumbnail\":{\"id\":\"7863d82b-0edd-4e85-88ea-b494735192c6\",\"fileName\":\"17849399782752834711692859378904283471169285937890455f8d5198e9edb7498a43ab762165fce.jpg\",\"url\":\"http://apicms.bachmai.gov.vn/documents/0/0/17849399782752834711692859378904283471169285937890455f8d5198e9edb7498a43ab762165fce.jpg/7863d82b-0edd-4e85-88ea-b494735192c6\",\"path\":\"http://apicms.bachmai.gov.vn/images/2026/7/26/e56fc39a-ef00-4bd2-8004-1298bea83c0b_17849399782752834711692859378904283471169285937890455f8d5198e9edb7498a43ab762165fce.jpg\"},\"categoryId\":null,\"categories\":[{\"id\":\"6fe85f1d-d00b-b3be-1d7d-99e588de7e2e\",\"name\":\"Tin hoạt động Bệnh viện\",\"slug\":\"tin-hoat-ong-benh-vien\"}],\"isFeatured\":false,\"isHomepage\":true},{\"id\":\"c9707dfe-d3d2-45f3-964b-6117af00ff1f\",\"title\":\"Bệnh viện Bạch Mai cơ sở Ninh Bình triển khai kỹ thuật nút tắc tĩnh mạch điều trị xuất huyết dạ dày, khống chế chảy máu trong 20 phút\",\"slug\":\"benh-vien-bach-mai-co-so-ninh-binh-trien-khai-ky-thuat-nut-tac-tinh-mach-dieu-tri-xuat-huyet-da-day-khong-che-chay-mau-trong-20-phut\",\"excerpt\":\"\u003cp class=\\\"MsoNormal\\\" style=\\\"text-align: justify; line-height: 15.0pt; mso-line-height-rule: exactly; margin: 6.0pt 0in 6.0pt 0in;\\\"\u003e\u003cspan style=\\\"font-size: 12.0pt; mso-ansi-language: VI;\\\"\u003eMột người bệnh 68 tuổi nhập viện trong t\u0026igrave;nh trạng n\u0026ocirc;n ra nhiều m\u0026aacute;u đỏ tươi, huyết \u0026aacute;p tụt, nồng độ hemoglobin chỉ c\u0026ograve;n 57 g/L, đứng trước nguy cơ sốc mất m\u0026aacute;u do vỡ gi\u0026atilde;n tĩnh mạch dạ d\u0026agrave;y. Trong t\u0026igrave;nh huống cấp cứu, c\u0026aacute;c b\u0026aacute;c sĩ Khoa Điện quang, Bệnh viện Bạch Mai cơ sở Ninh B\u0026igrave;nh đ\u0026atilde; lần đầu triển khai th\u0026agrave;nh c\u0026ocirc;ng kỹ thuật n\u0026uacute;t tắc tĩnh mạch ngược d\u0026ograve;ng c\u0026oacute; hỗ trợ dụng cụ n\u0026uacute;t mạch (Plug-Assisted Retrograde Transvenous Obliteration - PARTO), xử tr\u0026iacute; b\u0026uacute;i gi\u0026atilde;n v\u0026agrave; kiểm so\u0026aacute;t nguồn chảy m\u0026aacute;u, kịp thời cứu sống người bệnh.\u003c/span\u003e\u003c/p\u003e\",\"viewCount\":661,\"publishDate\":\"2026-07-23T00:00:00\",\"thumbnailId\":\"a10b74e8-88d1-4703-81e4-446f111c28ee\",\"thumbnail\":{\"id\":\"a10b74e8-88d1-4703-81e4-446f111c28ee\",\"fileName\":\"picture2.png\",\"url\":\"http://apicms.bachmai.gov.vn/documents/0/0/picture2.png/a10b74e8-88d1-4703-81e4-446f111c28ee\",\"path\":\"http://apicms.bachmai.gov.vn/images/2026/7/23/eeefd75c-90c0-4d0d-a931-c38c085417ea_picture2.png\"},\"categoryId\":null,\"categories\":[{\"id\":\"6fe85f1d-d00b-b3be-1d7d-99e588de7e2e\",\"name\":\"Tin hoạt động Bệnh viện\",\"slug\":\"tin-hoat-ong-benh-vien\"}],\"isFeatured\":false,\"isHomepage\":true},{\"id\":\"6f900b6c-bebd-438f-8958-d8c1aa2069f4\",\"title\":\"Đặt stent chuyển dòng, hóa giải “quả bom nổ chậm” trong não người bệnh 65 tuổi\",\"slug\":\"dat-stent-chuyen-dong-hoa-giai-“qua-bom-no-cham”-trong-nao-nguoi-benh-65-tuoi\",\"excerpt\":\"\u003cp class=\\\"MsoNormal\\\" style=\\\"text-align: justify; line-height: 15.0pt; mso-line-height-rule: exactly; margin: 6.0pt 0in 6.0pt 0in;\\\"\u003e\u003cspan style=\\\"font-size: 12.0pt; mso-ansi-language: VI;\\\"\u003eNhiều năm chịu đựng những cơn đau đầu, ch\u0026oacute;ng mặt k\u0026eacute;o d\u0026agrave;i, người phụ nữ 65 tuổi ở Ninh B\u0026igrave;nh bất ngờ được ph\u0026aacute;t hiện t\u0026uacute;i ph\u0026igrave;nh lớn tại động mạch cảnh trong tr\u0026aacute;i với bờ kh\u0026ocirc;ng đều, nguy cơ vỡ cao. Bằng kỹ thuật đặt stent chuyển d\u0026ograve;ng, c\u0026aacute;c b\u0026aacute;c sĩ Bệnh viện Bạch Mai cơ sở Ninh B\u0026igrave;nh đ\u0026atilde; can thiệp th\u0026agrave;nh c\u0026ocirc;ng, mở th\u0026ecirc;m cơ hội điều trị những tổn thương mạch m\u0026aacute;u n\u0026atilde;o phức tạp ngay tại địa phương.\u003c/span\u003e\u003c/p\u003e\",\"viewCount\":263,\"publishDate\":\"2026-07-23T00:00:00\",\"thumbnailId\":\"a5fa3d25-7bac-4071-ac6c-616b70d95da6\",\"thumbnail\":{\"id\":\"a5fa3d25-7bac-4071-ac6c-616b70d95da6\",\"fileName\":\"picture14.jpg\",\"url\":\"http://apicms.bachmai.gov.vn/documents/0/0/picture14.jpg/a5fa3d25-7bac-4071-ac6c-616b70d95da6\",\"path\":\"http://apicms.bachmai.gov.vn/images/2026/7/23/043e24f5-a829-4f6e-999f-56bb65de875e_picture14.jpg\"},\"categoryId\":null,\"categories\":[{\"id\":\"6fe85f1d-d00b-b3be-1d7d-99e588de7e2e\",\"name\":\"Tin hoạt động Bệnh viện\",\"slug\":\"tin-hoat-ong-benh-vien\"}],\"isFeatured\":false,\"isHomepage\":true},{\"id\":\"6b2eec73-87cb-43d5-a24b-b7ae569d0f12\",\"title\":\"Bệnh viện Bạch Mai tiếp nhận thiết bị y tế do Công ty RION (Nhật Bản) tài trợ, thúc đẩy phát triển chuyên sâu thính học\",\"slug\":\"benh-vien-bach-mai-tiep-nhan-thiet-bi-y-te-do-cong-ty-rion-nhat-ban-tai-tro-thuc-day-phat-trien-chuyen-sau-thinh-hoc\",\"excerpt\":\"\u003cp class=\\\"MsoNormal\\\" style=\\\"text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size: 12.0pt; line-height: 107%; font-family: 'Times New Roman',serif; mso-ansi-language: VI;\\\"\u003eNg\u0026agrave;y 22/7, tại Bệnh viện Bạch Mai cơ sở Ninh B\u0026igrave;nh, Bệnh viện Bạch Mai tổ chức lễ tiếp nhận thiết bị y tế do C\u0026ocirc;ng ty RION (Nhật Bản) t\u0026agrave;i trợ cho Khoa Tai Mũi Họng. Sự kiện đ\u0026aacute;nh dấu bước ph\u0026aacute;t triển mới trong mối quan hệ hợp t\u0026aacute;c bền chặt giữa hai đơn vị sau hơn một thập kỷ đồng h\u0026agrave;nh trong lĩnh vực th\u0026iacute;nh học, g\u0026oacute;p phần n\u0026acirc;ng cao chất lượng kh\u0026aacute;m chữa bệnh v\u0026agrave; đ\u0026agrave;o tạo nguồn nh\u0026acirc;n lực chuy\u0026ecirc;n s\u0026acirc;u tại Việt Nam.\u003c/span\u003e\u003c/p\u003e\",\"viewCount\":584,\"publishDate\":\"2026-07-22T00:00:00\",\"thumbnailId\":\"35ffbd2c-fa4b-44e2-8281-fcacb44a9e68\",\"thumbnail\":{\"id\":\"35ffbd2c-fa4b-44e2-8281-fcacb44a9e68\",\"fileName\":\"dsc08644.jpg\",\"url\":\"http://apicms.bachmai.gov.vn/documents/0/0/dsc08644.jpg/35ffbd2c-fa4b-44e2-8281-fcacb44a9e68\",\"path\":\"http://apicms.bachmai.gov.vn/images/2026/7/22/5c88d7a3-475a-4bbc-882c-2980ad8aaf7a_dsc08644.jpg\"},\"categoryId\":null,\"categories\":[{\"id\":\"6fe85f1d-d00b-b3be-1d7d-99e588de7e2e\",\"name\":\"Tin hoạt động Bệnh viện\",\"slug\":\"tin-hoat-ong-benh-vien\"}],\"isFeatured\":false,\"isHomepage\":true},{\"id\":\"74aa38b1-d0fb-4c45-871d-b9b9ac07f8ec\",\"title\":\"Bệnh viện Bạch Mai tiễn hai người bệnh sốt rét ác tính nguy kịch ra viện\",\"slug\":\"benh-vien-bach-mai-tien-hai-nguoi-benh-sot-ret-ac-tinh-nguy-kich-ra-vien\",\"excerpt\":\"\u003cp class=\\\"MsoNormal\\\" style=\\\"text-align: justify; line-height: 15.0pt; mso-line-height-rule: exactly; margin: 6.0pt 0in 6.0pt 0in;\\\"\u003e\u003cspan style=\\\"font-size: 12.0pt;\\\"\u003eNg\u0026agrave;y 22/7, Bệnh viện Bạch Mai tổ chức lễ tiễn hai người bệnh sốt r\u0026eacute;t \u0026aacute;c t\u0026iacute;nh từng trong t\u0026igrave;nh trạng nguy kịch trở về với gia đ\u0026igrave;nh. Th\u0026agrave;nh c\u0026ocirc;ng n\u0026agrave;y kh\u0026ocirc;ng chỉ khẳng định năng lực chuy\u0026ecirc;n m\u0026ocirc;n của Bệnh viện Bạch Mai m\u0026agrave; c\u0026ograve;n l\u0026agrave; kết quả của sức mạnh phối hợp đa chuy\u0026ecirc;n khoa, sự hỗ trợ kịp thời của Bộ Y tế, Tổ chức Y tế Thế giới v\u0026agrave; tinh thần tận t\u0026acirc;m, dốc l\u0026ograve;ng v\u0026igrave; người bệnh của đội ngũ thầy thuốc.\u003c/span\u003e\u003c/p\u003e\",\"viewCount\":201,\"publishDate\":\"2026-07-22T00:00:00\",\"thumbnailId\":\"007671fe-7488-4664-8019-4a72890c51da\",\"thumbnail\":{\"id\":\"007671fe-7488-4664-8019-4a72890c51da\",\"fileName\":\"dsc5809.jpg\",\"url\":\"http://apicms.bachmai.gov.vn/documents/0/0/dsc5809.jpg/007671fe-7488-4664-8019-4a72890c51da\",\"path\":\"http://apicms.bachmai.gov.vn/images/2026/7/22/ff42bf08-2a01-4768-92e4-46fac213029f_dsc5809.jpg\"},\"categoryId\":null,\"categories\":[{\"id\":\"6fe85f1d-d00b-b3be-1d7d-99e588de7e2e\",\"name\":\"Tin hoạt động Bệnh viện\",\"slug\":\"tin-hoat-ong-benh-vien\"}],\"isFeatured\":false,\"isHomepage\":true},{\"id\":\"34093c02-071d-4212-b129-efd6b2cf95c5\",\"title\":\"Bệnh viện Bạch Mai lan tỏa đạo lý \\\"Uống nước nhớ nguồn\\\" bằng những việc làm thiết thực\",\"slug\":\"benh-vien-bach-mai-lan-toa-dao-ly-uong-nuoc-nho-nguon-bang-nhung-viec-lam-thiet-thuc\",\"excerpt\":\"\u003cp class=\\\"MsoNormal\\\" style=\\\"text-align: justify; text-justify: inter-ideograph; line-height: 115%; margin: 6.0pt 0in 6.0pt 0in;\\\"\u003e\u003cspan style=\\\"font-size: 12.0pt; line-height: 115%; mso-ansi-language: VI;\\\"\u003eNhững ng\u0026agrave;y th\u0026aacute;ng 7, Bệnh viện Bạch Mai tổ chức chương tr\u0026igrave;nh tri \u0026acirc;n c\u0026aacute;c thương binh, bệnh binh v\u0026agrave; người c\u0026oacute; c\u0026ocirc;ng với c\u0026aacute;ch mạng đang điều trị tại bệnh viện. Kh\u0026ocirc;ng chỉ l\u0026agrave; hoạt động thường ni\u0026ecirc;n nh\u0026acirc;n dịp kỷ niệm Ng\u0026agrave;y Thương binh-Liệt sĩ (27/7), chương tr\u0026igrave;nh c\u0026ograve;n thể hiện đạo l\u0026yacute; \\\"Uống nước nhớ nguồn\\\", lan tỏa truyền thống nh\u0026acirc;n văn đ\u0026atilde; được g\u0026igrave;n giữ suốt hơn một thế kỷ của Bệnh viện Bạch Mai.\u003c/span\u003e\u003c/p\u003e\",\"viewCount\":646,\"publishDate\":\"2026-07-22T00:00:00\",\"thumbnailId\":\"8bf12178-cc93-46dc-97e0-9d60509f91be\",\"thumbnail\":{\"id\":\"8bf12178-cc93-46dc-97e0-9d60509f91be\",\"fileName\":\"dsc5984.jpg\",\"url\":\"http://apicms.bachmai.gov.vn/documents/0/0/dsc5984.jpg/8bf12178-cc93-46dc-97e0-9d60509f91be\",\"path\":\"http://apicms.bachmai.gov.vn/images/2026/7/22/fcc83974-bfd6-4484-b761-d242eca24245_dsc5984.jpg\"},\"categoryId\":null,\"categories\":[{\"id\":\"6fe85f1d-d00b-b3be-1d7d-99e588de7e2e\",\"name\":\"Tin hoạt động Bệnh viện\",\"slug\":\"tin-hoat-ong-benh-vien\"},{\"id\":\"5f378e4b-f605-9119-c818-27e5225b973f\",\"name\":\"Nhịp cầu nhân ái\",\"slug\":\"nhip-cau-nhan-ai\"}],\"isFeatured\":false,\"isHomepage\":true},{\"id\":\"64a45210-f5ad-476c-971d-74db369b3c3c\",\"title\":\"Bệnh viện Bạch Mai thúc đẩy hợp tác quốc tế với các đối tác y tế hàng đầu Đài Loan\",\"slug\":\"benh-vien-bach-mai-thuc-day-hop-tac-quoc-te-voi-cac-doi-tac-y-te-hang-dau-dai-loan\",\"excerpt\":\"$26\",\"viewCount\":406,\"publishDate\":\"2026-07-20T00:00:00\",\"thumbnailId\":\"3b8b0e14-83e2-4fdc-a312-e8b0a1c51427\",\"thumbnail\":{\"id\":\"3b8b0e14-83e2-4fdc-a312-e8b0a1c51427\",\"fileName\":\"mg7321.JPG\",\"url\":\"http://apicms.bachmai.gov.vn/documents/0/0/mg7321.JPG/3b8b0e14-83e2-4fdc-a312-e8b0a1c51427\",\"path\":\"http://apicms.bachmai.gov.vn/images/2026/7/20/3ebe3637-8e46-44a0-8f09-376e731e98c1_mg7321.JPG\"},\"categoryId\":null,\"categories\":[{\"id\":\"6fe85f1d-d00b-b3be-1d7d-99e588de7e2e\",\"name\":\"Tin hoạt động Bệnh viện\",\"slug\":\"tin-hoat-ong-benh-vien\"}],\"isFeatured\":false,\"isHomepage\":true}]},\"totalPage\":14,\"isPagination\":true,\"col\":8}]}]}]]}]\n"])</script></body></html>
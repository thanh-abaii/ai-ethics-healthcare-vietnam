 là bệnh viện Đa khoa hoàn chỉnh hạng đặc biệt đầu tiên tại Việt Nam, với tầm nhìn trở thành bệnh viện uy tín trong khu vực và trên thế giới. Chúng tôi cam kết chăm sóc sức khỏe toàn diện cho mọi người dân bằng tài năng, y đức và sự tận tâm.\"}],[\"$\",\"meta\",\"6\",{\"name\":\"twitter:card\",\"content\":\"summary\"}],[\"$\",\"meta\",\"7\",{\"name\":\"twitter:title\",\"content\":\"Chuyên mục bài viết | Cổng thông tin điện tử bệnh viện Bạch Mai\"}],[\"$\",\"meta\",\"8\",{\"name\":\"twitter:description\",\"content\":\"Bệnh viện Bạch Mai là bệnh viện Đa khoa hoàn chỉnh hạng đặc biệt đầu tiên tại Việt Nam, với tầm nhìn trở thành bệnh viện uy tín trong khu vực và trên thế giới. Chúng tôi cam kết chăm sóc sức khỏe toàn diện cho mọi người dân bằng tài năng, y đức và sự tận tâm.\"}],[\"$\",\"link\",\"9\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"95x94\"}],[\"$\",\"$L11\",\"10\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n"])</script><script>self.__next_f.push([1,"f:\"$9:metadata\"\n"])</script><script>self.__next_f.push([1,"12:I[78616,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"6697\",\"static/chunks/6697-d002001fd5e6e8b5.js\",\"9701\",\"static/chunks/9701-31e906848a910dc4.js\",\"3584\",\"static/chunks/3584-7e99a282bc4340d3.js\",\"7249\",\"static/chunks/7249-0b33e3fd5c0d66cd.js\",\"6844\",\"static/chunks/app/(vi)/layout-e76031f859212b3f.js\"],\"default\"]\n13:I[46665,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"6697\",\"static/chunks/6697-d002001fd5e6e8b5.js\",\"9701\",\"static/chunks/9701-31e906848a910dc4.js\",\"3584\",\"static/chunks/3584-7e99a282bc4340d3.js\",\"7249\",\"static/chunks/7249-0b33e3fd5c0d66cd.js\",\"6844\",\"static/chunks/app/(vi)/layout-e76031f859212b3f.js\"],\"default\"]\n"])</script><script>self.__next_f.push([1,"4:[\"$\",\"html\",null,{\"lang\":\"vi\",\"className\":\"__variable_3b6de7 __variable_6e1c1f\",\"children\":[[\"$\",\"body\",null,{\"className\":\"d-flex flex-column min-h-screen\",
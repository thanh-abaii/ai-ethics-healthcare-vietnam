m x\u0026uacute;c \u003c/span\u003e\u003cspan lang=\"EN-US\" style=\"font-size: 12.0pt; mso-ansi-language: EN-US;\"\u003e-\u003c/span\u003e\u003cspan style=\"font-size: 12.0pt;\"\u003e đ\u0026ecirc;m nhạc đặc biệt mang t\u0026ecirc;n \u0026ldquo;Blouse trắng \u003c/span\u003e\u003cspan lang=\"EN-US\" style=\"font-size: 12.0pt; mso-ansi-language: EN-US;\"\u003e-\u003c/span\u003e\u003cspan style=\"font-size: 12.0pt;\"\u003e Tr\u0026aacute;i tim hồng\u0026rdquo;. Kh\u0026ocirc;ng phải s\u0026acirc;n khấu lộng lẫy, hay \u0026aacute;nh đ\u0026egrave;n h\u0026agrave;o nho\u0026aacute;ng, chương tr\u0026igrave;nh chạm tới tr\u0026aacute;i tim người tham dự bằng sự ch\u0026acirc;n th\u0026agrave;nh, bằng t\u0026igrave;nh y\u0026ecirc;u thương lặng lẽ nhưng bền bỉ của những con người kho\u0026aacute;c \u0026aacute;o blouse trắng v\u0026agrave; những tấm l\u0026ograve;ng đồng h\u0026agrave;nh v\u0026igrave; cộng đồng.\u0026nbsp;\u003c/span\u003e\u003c/p\u003e"])</script><script>self.__next_f.push([1,"5:[\"$\",\"div\",null,{\"className\":\"category-news\",\"children\":[[\"$\",\"div\",null,{\"className\":\"breadcrumb\",\"children\":[[\"$\",\"div\",null,{\"className\":\"container\",\"children\":[[\"$\",\"h1\",null,{\"className\":\"pb-2 h1\",\"children\":\"Nhịp cầu nhân ái\"}],[\"$\",\"ul\",null,{\"children\":[[\"$\",\"li\",null,{\"children\":[\"$\",\"$L22\",null,{\"href\":\"/\",\"title\":\"\",\"children\":\"Trang chủ\"}]}],[[\"$\",\"li\",\"1\",{\"children\":[\"$\",\"$L22\",null,{\"href\":\"\",\"children\":[[\"$\",\"span\",null,{\"className\":\"dot px-3\"}],[\"$\",\"span\",null,{\"children\":\"Nhịp cầu nhân ái\"}]]}]}]]]}]]}],\"$undefined\"]}],[\"$\",\"div\",null,{\"className\":\"container mt-6\",\"children\":[\"$\",\"div\",null,{\"className\":\"category-news__items mb-4 mb-md-5\",\"children\":[\"$\",\"$L23\",null,{\"filtersId\":\"5f378e4b-f605-9119-c818-27e5225b973f\",\"post\":{\"totalCount\":479,\"items\":[{\"id\":\"9d44a690-7dd0-42c7-9c5c-38e48bdab3db\",\"title\":\"Những tình nguyện viên áo trắng đồng hành cùng người bệnh tại Bệnh viện Bạch Mai cơ sở Ninh Bình\",\"slug\":\"nhung-tinh-nguyen-vien-ao-trang-dong-hanh-cung-nguoi-benh-tai-benh-vien-bach-mai-co-so-ninh-binh\",\"excerpt\":\"\u003cp class=\\\"MsoNormal\\\" style=\\\"text-align: justify; line-height: 15.0pt; mso-line-height-rule: exactly; margin: 6.0pt 0in 6.0pt 0in;\\\"\u003e\u003cspan style=\\\"font-family: 'Times New Roman',serif; mso-ansi-language: VI;\\\"\u003eS\u0026aacute;ng sớm tại khu vực kh\u0026aacute;m bệnh của Bệnh viện Bạch Mai cơ sở Ninh B\u0026igrave;nh, h\u0026igrave;nh ảnh những sinh vi\u0026ecirc;n trong m\u0026agrave;u \u0026aacute;o blouse trắng tận t\u0026igrave;nh hướng dẫn người bệnh l\u0026agrave;m thủ tục, d\u0026igrave;u c\u0026aacute;c cụ gi\u0026agrave; đến ph\u0026ograve;ng kh\u0026aacute;m hay đẩy xe lăn đưa người bệnh đi chụp chiếu đ\u0026atilde; trở n\u0026ecirc;n quen thuộc. Những lời chỉ dẫn nhẹ nh\u0026agrave;ng, nụ cười th\u0026acirc;n thiện hay chiếc \u0026ocirc; được mở vội dưới trời nắng gắt tưởng chừng chỉ l\u0026agrave; những việc rất nhỏ, nhưng lại gi\u0026uacute;p nhiều người bệnh, đặc biệt l\u0026agrave; người cao tuổi v\u0026agrave; những người lần đầu đến bệnh viện, cảm thấy y\u0026ecirc;n t\u0026acirc;m hơn trong suốt h\u0026agrave;nh tr\u0026igrave;nh kh\u0026aacute;m chữa bệnh.\u003c/span\u003e\u003c/p\u003e\",\"viewCount\":1037,\"publishDate\":\"2026-07-23T00:00:00\",\"thumbnailId\":\"e7da7a46-b64a-408d-9c3c-c94429709055\",\"thumbnail\":{\"id\":\"e7da7a46-b64a-408d-9c3c-c94429709055\",\"fileName\":\"17847964288402525361213050377605g8211773668289608312e60649e6d198a25c8016a6278f407f0a.jpg\",\"url\":\"http://apicms.bachmai.gov.vn/documents/0/0/17847964288402525361213050377605g8211773668289608312e60649e6d198a25c8016a6278f407f0a.jpg/e7da7a46-b64a-408d-9c3c-c94429709055\",\"path\":\"http://apicms.bachmai.gov.vn/images/2026/7/23/709168a4-840c-4aaf-881b-aeca64ccfb46_17847964288402525361213050377605g8211773668289608312e60649e6d198a25c8016a6278f407f0a.jpg\"},\"categoryId\":null,\"categories\":[{\"id\":\"0dd604d2-9f22-30ce-7edf-2c8f61bf4e94\",\"name\":\"Tin trong ngành\",\"slug\":\"tin-trong-nganh\"},{\"id\":\"5f378e4b-f605-9119-c818-27e5225b973f\",\"name\":\"Nhịp cầu nhân ái\",\"slug\":\"nhip-cau-nhan-ai\"}],\"isFeatured\":false,\"isHomepage\":true},{\"id\":\"a96e3e7a-0fe9-4e40-94ff-c80758e3c7b6\",\"title\":\"Đại sứ quán Hoàng gia Thái Lan trao quà hỗ trợ người bệnh khó khăn tại Bệnh viện Bạch Mai\",\"slug\":\"dai-su-quan-hoang-gia-thai-lan-trao-qua-ho-tro-nguoi-benh-kho-khan-tai-benh-vien-bach-mai\",\"excerpt\":\"\u003cp class=\\\"MsoNormal\\\" style=\\\"text-align: justify; text-justify: inter-ideograph;\\\"\u003e\u003cspan style=\\\"font-size: 12.0pt; line-height: 107%; mso-ansi-language: VI;\\\"\u003eNg\u0026agrave;y 22/7, Bệnh viện Bạch Mai tổ chức chương tr\u0026igrave;nh tiếp nhận qu\u0026agrave; tặng từ Đại sứ qu\u0026aacute;n Ho\u0026agrave;ng gia Th\u0026aacute;i Lan tại H\u0026agrave; Nội d\u0026agrave;nh cho người bệnh c\u0026oacute; ho\u0026agrave;n cảnh kh\u0026oacute; khăn. Hoạt động mang \u0026yacute; nghĩa nh\u0026acirc;n văn, diễn ra nh\u0026acirc;n dịp kỷ niệm sinh nhật Quốc vương Th\u0026aacute;i Lan Maha Vajiralongkorn v\u0026agrave; hướng tới 50 năm thiết lập quan hệ ngoại giao Việt Nam - Th\u0026aacute;i Lan (1976-2026).\u003c/span\u003e\u003c/p\u003e\",\"viewCount\":81,\"publishDate\":\"2026-07-22T00:00:00\",\"thumbnailId\":\"e9efab68-4371-4734-becf-71c91d0275b9\",\"thumbnail\":{\"id\":\"e9efab68-4371-4734-becf-71c91d0275b9\",\"fileName\":\"dsc5614.jpg\",\"url\":\"http://apicms.bachmai.gov.vn/documents/0/0/dsc5614.jpg/e9efab68-4371-4734-becf-71c91d0275b9\",\"path\":\"http://apicms.bachmai.gov.vn/images/2026/7/22/026dc096-9717-4de1-a9d0-9b3f4daa963f_dsc5614.jpg\"},\"categoryId\":null,\"categories\":[{\"id\":\"5f378e4b-f605-9119-c818-27e5225b973f\",\"name\":\"Nhịp cầu nhân ái\",\"slug\":\"nhip-cau-nhan-ai\"}],\"isFeatured\":false,\"isHomepage\":true},{\"id\":\"34093c02-071d-4212-b129-efd6b2cf95c5\",\"title\":\"Bệnh viện Bạch Mai lan tỏa đạo lý \\\"Uống nước nhớ nguồn\\\" bằng những việc làm thiết thực\",\"slug\":\"benh-vien-bach-mai-lan-toa-dao-ly-uong-nuoc-nho-nguon-bang-nhung-viec-lam-thiet-thuc\",\"excerpt\":\"\u003cp class=\\\"MsoNormal\\\" style=\\\"text-align: justify; text-justify: inter-ideograph; line-height: 115%; margin: 6.0pt 0in 6.0pt 0in;\\\"\u003e\u003cspan style=\\\"font-size: 12.0pt; line-height: 115%; mso-ansi-language: VI;\\\"\u003eNhững ng\u0026agrave;y th\u0026aacute;ng 7, Bệnh viện Bạch Mai tổ chức chương tr\u0026igrave;nh tri \u0026acirc;n c\u0026aacute;c thương binh, bệnh binh v\u0026agrave; người c\u0026oacute; c\u0026ocirc;ng với c\u0026aacute;ch mạng đang điều trị tại bệnh viện. Kh\u0026ocirc;ng chỉ l\u0026agrave; hoạt động thường ni\u0026ecirc;n nh\u0026acirc;n dịp kỷ niệm Ng\u0026agrave;y Thương binh-Liệt sĩ (27/7), chương tr\u0026igrave;nh c\u0026ograve;n thể hiện đạo l\u0026yacute; \\\"Uống nước nhớ nguồn\\\", lan tỏa truyền thống nh\u0026acirc;n văn đ\u0026atilde; được g\u0026igrave;n giữ suốt hơn một thế kỷ của Bệnh viện Bạch Mai.\u003c/span\u003e\u003c/p\u003e\",\"viewCount\":646,\"publishDate\":\"2026-07-22T00:00:00\",\"thumbnailId\":\"8bf12178-cc93-46dc-97e0-9d60509f91be\",\"thumbnail\":{\"id\":\"8bf12178-cc93-46dc-97e0-9d60509f91be\",\"fileName\":\"dsc5984.jpg\",\"url\":\"http://apicms.bachmai.gov.vn/documents/0/0/dsc5984.jpg/8bf12178-cc93-46dc-97e0-9d60509f91be\",\"path\":\"http://apicms.bachmai.gov.vn/images/2026/7/22/fcc83974-bfd6-4484-b761-d242eca24245_dsc5984.jpg\"},\"categoryId\":null,\"categories\":[{\"id\":\"6fe85f1d-d00b-b3be-1d7d-99e588de7e2e\",\"name\":\"Tin hoạt động Bệnh viện\",\"slug\":\"tin-hoat-ong-benh-vien\"},{\"id\":\"5f378e4b-f605-9119-c818-27e5225b973f\",\"name\":\"Nhịp cầu nhân ái\",\"slug\":\"nhip-cau-nhan-ai\"}],\"isFeatured\":false,\"isHomepage\":true},{\"id\":\"d602f1b1-523b-446a-a7e9-a3e5fb52dad1\",\"title\":\"Khởi đầu bằng sự tri ân, lan tỏa trách nhiệm vì sức khỏe nhân dân\",\"slug\":\"khoi-dau-bang-su-tri-an-lan-toa-trach-nhiem-vi-suc-khoe-nhan-dan\",\"excerpt\":\"\u003cp class=\\\"MsoNormal\\\" style=\\\"text-align: justify; margin: 6.0pt 0in 6.0pt 0in;\\\"\u003e\u003cspan style=\\\"font-size: 12.0pt; line-height: 115%; font-family: 'Times New Roman',serif; mso-ansi-language: EN-US;\\\"\u003eNhững ng\u0026agrave;y đầu th\u0026aacute;ng 7/2026, Bệnh viện Bạch Mai cơ sở Ninh B\u0026igrave;nh tiếp tục ghi dấu ấn bằng một hoạt động mang đậm \u0026yacute; nghĩa nh\u0026acirc;n văn: Ho\u0026agrave;n th\u0026agrave;nh chương tr\u0026igrave;nh kh\u0026aacute;m, tầm so\u0026aacute;t v\u0026agrave; s\u0026agrave;ng lọc sức khỏe miễn ph\u0026iacute; d\u0026agrave;nh cho 5.000 thương binh, bệnh binh, người c\u0026oacute; c\u0026ocirc;ng với c\u0026aacute;ch mạng v\u0026agrave; gia đ\u0026igrave;nh ch\u0026iacute;nh s\u0026aacute;ch tr\u0026ecirc;n địa b\u0026agrave;n tỉnh Ninh B\u0026igrave;nh.\u003c/span\u003e\u003c/p\u003e\",\"viewCount\":2167,\"publishDate\":\"2026-07-05T00:00:00\",\"thumbnailId\":\"8f5f50e1-3d11-4297-a27d-eb52014cfd4e\",\"thumbnail\":{\"id\":\"8f5f50e1-3d11-4297-a27d-eb52014cfd4e\",\"fileName\":\"1783226642163863204773276029779786320477327602977972d2e4f1152af20b3a45e339be037ddb2.jpg\",\"url\":\"http://apicms.bachmai.gov.vn/documents/0/0/1783226642163863204773276029779786320477327602977972d2e4f1152af20b3a45e339be037ddb2.jpg/8f5f50e1-3d11-4297-a27d-eb52014cfd4e\",\"path\":\"http://apicms.bachmai.gov.vn/images/2026/7/5/1839294f-1059-44a3-85cb-17ce8451408f_1783226642163863204773276029779786320477327602977972d2e4f1152af20b3a45e339be037ddb2.jpg\"},\"categoryId\":null,\"categories\":[{\"id\":\"0dd604d2-9f22-30ce-7edf-2c8f61bf4e94\",\"name\":\"Tin trong ngành\",\"slug\":\"tin-trong-nganh\"},{\"id\":\"5f378e4b-f605-9119-c818-27e5225b973f\",\"name\":\"Nhịp cầu nhân ái\",\"slug\":\"nhip-cau-nhan-ai\"}],\"isFeatured\":false,\"isHomepage\":true},{\"id\":\"0bcc28f6-e866-4a45-a445-c6ccb788fa6f\",\"title\":\"Hành trình sống trọn vẹn cùng bệnh suy tim\",\"slug\":\"hanh-trinh-song-tron-ven-cung-benh-suy-tim\",\"excerpt\":\"\u003cp class=\\\"MsoNormal\\\" style=\\\"text-align: justify; line-height: 16.0pt; mso-line-height-rule: exactly; margin: 6.0pt 0in 6.0pt 0in;\\\"\u003e\u003cspan style=\\\"font-family: 'Times New Roman',serif;\\\"\u003eTrong khu\u0026ocirc;n khổ Hội nghị Tim mạch Quốc tế thường ni\u0026ecirc;n 2026 do Viện Tim mạch Việt Nam - Bệnh viện Bạch Mai tổ chức ng\u0026agrave;y 19-20/6 tại H\u0026agrave; Nội, một phi\u0026ecirc;n hội thảo đặc biệt đ\u0026atilde; để lại nhiều cảm x\u0026uacute;c cho người tham dự.\u003c/span\u003e\u003c/p\u003e\",\"viewCount\":241,\"publishDate\":\"2026-06-24T00:00:00\",\"thumbnailId\":\"dd0a1fa1-d00d-4c88-8348-1c9e0ff4e421\",\"thumbnail\":{\"id\":\"dd0a1fa1-d00d-4c88-8348-1c9e0ff4e421\",\"fileName\":\"17822659263478632047732760297797g6262828886273343844f743462ddf25b9d95c6f21b522c5e2ee.jpg\",\"url\":\"http://apicms.bachmai.gov.vn/documents/0/0/17822659263478632047732760297797g6262828886273343844f743462ddf25b9d95c6f21b522c5e2ee.jpg/dd0a1fa1-d00d-4c88-8348-1c9e0ff4e421\",\"path\":\"http://apicms.bachmai.gov.vn/images/2026/6/24/69c2c93d-1208-408b-a126-3769a065f907_17822659263478632047732760297797g6262828886273343844f743462ddf25b9d95c6f21b522c5e2ee.jpg\"},\"categoryId\":null,\"categories\":[{\"id\":\"5f378e4b-f605-9119-c818-27e5225b973f\",\"name\":\"Nhịp cầu nhân ái\",\"slug\":\"nhip-cau-nhan-ai\"},{\"id\":\"b00df27b-bbcd-fffe-ee65-5a225b509ff6\",\"name\":\"Y học thường thức\",\"slug\":\"y-hoc-thuong-thuc\"}],\"isFeatured\":false,\"isHomepage\":true},{\"id\":\"544969d9-58f9-4ab1-8bff-d179d0f9bab7\",\"title\":\"Từ giọt máu nghĩa tình đến sự sống của người bệnh\",\"slug\":\"tu-giot-mau-nghia-tinh-den-su-song-cua-nguoi-benh\",\"excerpt\":\"\u003cp class=\\\"MsoNormal\\\" style=\\\"text-align: justify;\\\"\u003e\u003cspan style=\\\"font-size: 12.0pt; line-height: 115%; color: black; mso-themecolor: text1;\\\"\u003eMỗi ng\u0026agrave;y, Bệnh viện Bạch Mai sử dụng khoảng 600 đơn vị m\u0026aacute;u v\u0026agrave; chế phẩm m\u0026aacute;u phục vụ cấp cứu, hồi sức, phẫu thuật, điều trị ung thư, bệnh l\u0026yacute; huyết học, gh\u0026eacute;p tạng v\u0026agrave; nhiều trường hợp bệnh nặng kh\u0026aacute;c. Đằng sau những t\u0026uacute;i m\u0026aacute;u lặng lẽ được truyền v\u0026agrave;o cơ thể người bệnh l\u0026agrave; nghĩa cử cao đẹp của h\u0026agrave;ng triệu người hiến m\u0026aacute;u t\u0026igrave;nh nguyện - những người đ\u0026atilde; \u0026acirc;m thầm trao tặng cơ hội sống cho cộng đồng.\u003c/span\u003e\u003c/p\u003e\",\"viewCount\":719,\"publishDate\":\"2026-06-14T00:00:00\",\"thumbnailId\":\"c57e99fa-8cde-46a1-bde6-2757d7548675\",\"thumbnail\":{\"id\":\"c57e99fa-8cde-46a1-bde6-2757d7548675\",\"fileName\":\"z793446748342122ea7000271add18f1bcfdbe706cc5d1.jpg\",\"url\":\"http://apicms.bachmai.gov.vn/documents/0/0/z793446748342122ea7000271add18f1bcfdbe706cc5d1.jpg/c57e99fa-8cde-46a1-bde6-2757d7548675\",\"path\":\"http://apicms.bachmai.gov.vn/images/2026/6/14/551d6536-5605-4d9c-ac07-fe014df6fc5e_z793446748342122ea7000271add18f1bcfdbe706cc5d1.jpg\"},\"categoryId\":null,\"categories\":[{\"id\":\"0dd604d2-9f22-30ce-7edf-2c8f61bf4e94\",\"name\":\"Tin trong ngành\",\"slug\":\"tin-trong-nganh\"},{\"id\":\"5f378e4b-f605-9119-c818-27e5225b973f\",\"name\":\"Nhịp cầu nhân ái\",\"slug\":\"nhip-cau-nhan-ai\"}],\"isFeatured\":false,\"isHomepage\":true},{\"id\":\"0ef003c4-b2d7-4132-94cc-2fd2f7393a58\",\"title\":\"Hơn 800 người dân vùng cao Lâm Thượng được khám bệnh, tư vấn sức khỏe miễn phí\",\"slug\":\"hon-800-nguoi-dan-vung-cao-lam-thuong-duoc-kham-benh-tu-van-suc-khoe-mien-phi\",\"excerpt\":\"\u003cp class=\\\"MsoNormal\\\" style=\\\"text-align: justify; line-height: 16.0pt; mso-line-height-rule: exactly; margin: 6.0pt 0in 6.0pt 0in;\\\"\u003e\u003cspan style=\\\"font-size: 12.0pt; mso-ansi-language: VI;\\\"\u003eHơn 800 người d\u0026acirc;n x\u0026atilde; L\u0026acirc;m Thượng, tỉnh L\u0026agrave;o Cai, đặc biệt l\u0026agrave; người cao tuổi, trẻ nhỏ v\u0026agrave; người c\u0026oacute; bệnh l\u0026yacute; nền đ\u0026atilde; được c\u0026aacute;c b\u0026aacute;c sĩ tuyến đầu trực tiếp thăm kh\u0026aacute;m, tư vấn sức khỏe v\u0026agrave; trao qu\u0026agrave;.\u003c/span\u003e\u003cspan style=\\\"font-size: 12.0pt; mso-ansi-language: EN-US;\\\"\u003e \u003c/span\u003e\u003cspan style=\\\"font-size: 12.0pt; mso-ansi-language: VI;\\\"\u003eĐ\u0026acirc;y kh\u0026ocirc;ng chỉ l\u0026agrave; hoạt động an sinh \u0026yacute; nghĩa trước Hội nghị thường ni\u0026ecirc;n C\u0026acirc;u lạc bộ Gi\u0026aacute;m đốc bệnh viện c\u0026aacute;c tỉnh ph\u0026iacute;a Bắc m\u0026agrave; c\u0026ograve;n l\u0026agrave; h\u0026agrave;nh tr\u0026igrave;nh sẻ chia, chăm lo sức khỏe cộng đồng của c\u0026aacute;c bệnh viện thuộc Ban Chủ nhiệm C\u0026acirc;u lạc bộ, trong đ\u0026oacute; n\u0026ograve;ng cốt l\u0026agrave; Bệnh viện Bạch Mai. \u003c/span\u003e\u003c/p\u003e\",\"viewCount\":558,\"publishDate\":\"2026-05-17T00:00:00\",\"thumbnailId\":\"2d00531d-d2e2-4c27-82f3-5b3060110d2e\",\"thumbnail\":{\"id\":\"2d00531d-d2e2-4c27-82f3-5b3060110d2e\",\"fileName\":\"202605161214002.jpg\",\"url\":\"http://apicms.bachmai.gov.vn/documents/0/0/202605161214002.jpg/2d00531d-d2e2-4c27-82f3-5b3060110d2e\",\"path\":\"http://apicms.bachmai.gov.vn/images/2026/5/17/2ee9031e-0c04-486c-aeae-1c6f06daca48_202605161214002.jpg\"},\"categoryId\":null,\"categories\":[{\"id\":\"5f378e4b-f605-9119-c818-27e5225b973f\",\"name\":\"Nhịp cầu nhân ái\",\"slug\":\"nhip-cau-nhan-ai\"},{\"id\":\"0dd604d2-9f22-30ce-7edf-2c8f61bf4e94\",\"name\":\"Tin trong ngành\",\"slug\":\"tin-trong-nganh\"}],\"isFeatured\":false,\"isHomepage\":true},{\"id\":\"1d2a4495-6872-48a6-9ca8-bdf246ea0b30\",\"title\":\"Bệnh viện Bạch Mai khám bệnh, cấp thuốc miễn phí và thúc đẩy chuyển đổi số y tế tại Hà Tĩnh\",\"slug\":\"benh-vien-bach-mai-kham-benh-cap-thuoc-mien-phi-va-thuc-day-chuyen-doi-so-y-te-tai-ha-tinh\",\"excerpt\":\"\u003cp class=\\\"MsoNormal\\\" style=\\\"text-align: justify; margin: 6.0pt 0in 6.0pt 0in;\\\"\u003e\u003cspan style=\\\"font-size: 12.0pt; line-height: 115%; font-family: 'Times New Roman',serif; mso-ansi-language: EN-US;\\\"\u003eS\u0026aacute;ng 17/5, tại tỉnh H\u0026agrave; Tĩnh, Bệnh viện Bạch Mai phối hợp Sở Y tế H\u0026agrave; Tĩnh v\u0026agrave; Ng\u0026acirc;n h\u0026agrave;ng TMCP Đầu tư v\u0026agrave; Ph\u0026aacute;t triển Việt Nam (BIDV) tổ chức chương tr\u0026igrave;nh kh\u0026aacute;m sức khỏe, cấp ph\u0026aacute;t thuốc miễn ph\u0026iacute; v\u0026agrave; trao qu\u0026agrave; an sinh x\u0026atilde; hội cho 1.500 người d\u0026acirc;n thuộc diện ch\u0026iacute;nh s\u0026aacute;ch, ho\u0026agrave;n cảnh kh\u0026oacute; khăn tr\u0026ecirc;n địa b\u0026agrave;n tỉnh. \u003c/span\u003e\u003c/p\u003e\",\"viewCount\":662,\"publishDate\":\"2026-05-17T00:00:00\",\"thumbnailId\":\"c17401ce-93d5-4e5d-997e-595ec6a6da05\",\"thumbnail\":{\"id\":\"c17401ce-93d5-4e5d-997e-595ec6a6da05\",\"fileName\":\"dsc1968.jpg\",\"url\":\"http://apicms.bachmai.gov.vn/documents/0/0/dsc1968.jpg/c17401ce-93d5-4e5d-997e-595ec6a6da05\",\"path\":\"http://apicms.bachmai.gov.vn/images/2026/5/17/8b13bc02-95af-49b4-9541-70c20c139450_dsc1968.jpg\"},\"categoryId\":null,\"categories\":[{\"id\":\"5f378e4b-f605-9119-c818-27e5225b973f\",\"name\":\"Nhịp cầu nhân ái\",\"slug\":\"nhip-cau-nhan-ai\"},{\"id\":\"6fe85f1d-d00b-b3be-1d7d-99e588de7e2e\",\"name\":\"Tin hoạt động Bệnh viện\",\"slug\":\"tin-hoat-ong-benh-vien\"}],\"isFeatured\":false,\"isHomepage\":true},{\"id\":\"62e41bbc-f8e8-42d7-aefc-5095841bfc10\",\"title\":\"Hành trình mang hy vọng lên vùng cao: Sứ mệnh của những trái tim Bạch Mai tại Vân Hồ \",\"slug\":\"hanh-trinh-mang-hy-vong-len-vung-cao-su-menh-cua-nhung-trai-tim-bach-mai-tai-van-ho\",\"excerpt\":\"\u003cp class=\\\"MsoNormal\\\" style=\\\"text-align: justify; margin: 6.0pt 0in 6.0pt 0in;\\\"\u003e\u003cspan style=\\\"font-size: 12.0pt; line-height: 115%; font-family: 'Times New Roman',serif; mso-ascii-theme-font: major-latin; mso-hansi-theme-font: major-latin; mso-bidi-theme-font: major-latin; mso-ansi-language: VI;\\\"\u003eTrong kh\u0026ocirc;ng kh\u0026iacute; ấm \u0026aacute;p của những ng\u0026agrave;y th\u0026aacute;ng 4 lịch sử, đo\u0026agrave;n tiền trạm của Bệnh viện Bạch Mai đ\u0026atilde; ch\u0026iacute;nh thức c\u0026oacute; mặt tại x\u0026atilde; V\u0026acirc;n Hồ, tỉnh Sơn La. Tất cả c\u0026aacute;c kh\u0026acirc;u chuẩn bị cuối c\u0026ugrave;ng đang được ho\u0026agrave;n tất để đ\u0026oacute;n đợi \\\"chuyến xe hạnh ph\u0026uacute;c\\\" mang theo c\u0026aacute;c chuy\u0026ecirc;n gia h\u0026agrave;ng đầu v\u0026agrave; những m\u0026oacute;n qu\u0026agrave; nghĩa t\u0026igrave;nh đến với đồng b\u0026agrave;o nơi đ\u0026acirc;y.\u003c/span\u003e\u003c/p\u003e\",\"viewCount\":471,\"publishDate\":\"2026-04-16T00:00:00\",\"thumbnailId\":\"522edbc1-84cb-449c-9272-c3f870fa54c1\",\"thumbnail\":{\"id\":\"522edbc1-84cb-449c-9272-c3f870fa54c1\",\"fileName\":\"z773211909346155e488dea0e7d2f81b56f638323ae8e3.jpg\",\"url\":\"http://apicms.bachmai.gov.vn/documents/0/0/z773211909346155e488dea0e7d2f81b56f638323ae8e3.jpg/522edbc1-84cb-449c-9272-c3f870fa54c1\",\"path\":\"http://apicms.bachmai.gov.vn/images/2026/4/16/38cbadcc-bc16-451e-b3c6-59ad46f2637a_z773211909346155e488dea0e7d2f81b56f638323ae8e3.jpg\"},\"categoryId\":null,\"categories\":[{\"id\":\"5f378e4b-f605-9119-c818-27e5225b973f\",\"name\":\"Nhịp cầu nhân ái\",\"slug\":\"nhip-cau-nhan-ai\"}],\"isFeatured\":false,\"isHomepage\":true},{\"id\":\"65a4d851-0d33-4cdf-829a-6d59477c9fed\",\"title\":\"Bệnh viện Bạch Mai ký kết hợp tác với Quỹ “Chạm yêu thương”: Gieo yêu thương - Lan tỏa hy vọng cho người bệnh\",\"slug\":\"benh-vien-bach-mai-ky-ket-hop-tac-voi-quy-“cham-yeu-thuong”-gieo-yeu-thuong-lan-toa-hy-vong-cho-nguoi-benh\",\"excerpt\":\"\u003cp class=\\\"MsoNormal\\\" style=\\\"text-align: justify; line-height: 16.0pt; mso-line-height-rule: exactly; margin: 6.0pt 0cm 6.0pt 0cm;\\\"\u003e\u003cspan style=\\\"font-size: 12.0pt;\\\"\u003eBệnh viện Bạch Mai vừa ch\u0026iacute;nh thức k\u0026yacute; kết thỏa thuận hợp t\u0026aacute;c với Quỹ \u0026ldquo;Chạm y\u0026ecirc;u thương\u0026rdquo; (được bảo trợ bởi Techcombank). Sự kiện đ\u0026aacute;nh dấu h\u0026agrave;nh tr\u0026igrave;nh chung tay của hai đơn vị trong c\u0026aacute;c hoạt động x\u0026atilde; hội, hướng tới hỗ trợ to\u0026agrave;n diện cho người bệnh, đặc biệt l\u0026agrave; trẻ em c\u0026oacute; ho\u0026agrave;n cảnh kh\u0026oacute; khăn.\u003c/span\u003e\u003c/p\u003e\",\"viewCount\":472,\"publishDate\":\"2026-03-27T00:00:00\",\"thumbnailId\":\"48c280ea-10fc-46fd-8a44-0749323edbbb\",\"thumbnail\":{\"id\":\"48c280ea-10fc-46fd-8a44-0749323edbbb\",\"fileName\":\"dsc0044.jpg\",\"url\":\"http://apicms.bachmai.gov.vn/documents/0/0/dsc0044.jpg/48c280ea-10fc-46fd-8a44-0749323edbbb\",\"path\":\"http://apicms.bachmai.gov.vn/images/2026/3/27/1663d4bb-edb9-4e4f-a0e4-6db01ecb3c63_dsc0044.jpg\"},\"categoryId\":null,\"categories\":[{\"id\":\"5f378e4b-f605-9119-c818-27e5225b973f\",\"name\":\"Nhịp cầu nhân ái\",\"slug\":\"nhip-cau-nhan-ai\"}],\"isFeatured\":false,\"isHomepage\":true},{\"id\":\"0395b943-21e1-4fee-a378-de5cbac3e95b\",\"title\":\"Hành trình kết nối và “bản tình ca chữa lành” từ những trái tim thấu cảm\",\"slug\":\"hanh-trinh-ket-noi-va-“ban-tinh-ca-chua-lanh”-tu-nhung-trai-tim-thau-cam\",\"excerpt\":\"\u003cp class=\\\"MsoNormal\\\" style=\\\"text-align: justify; text-justify: inter-ideograph; line-height: 115%; margin: 6.0pt 0cm 6.0pt 0cm;\\\"\u003e\u003cspan style=\\\"font-size: 12.0pt; line-height: 115%; mso-ansi-language: VI;\\\"\u003eC\u0026oacute; những nỗi đau được xoa dịu kh\u0026ocirc;ng chỉ bằng thuốc men, m\u0026agrave; bằng hơi ấm của sự thấu cảm. C\u0026oacute; những cuộc đời được hồi sinh kh\u0026ocirc;ng chỉ nhờ kỹ thuật y khoa ti\u0026ecirc;n tiến, m\u0026agrave; c\u0026ograve;n từ những nhịp cầu nh\u0026acirc;n \u0026aacute;i thầm lặng.\u003c/span\u003e\u003c/p\u003e\",\"viewCount\":1211,\"publishDate\":\"2026-03-18T00:00:00\",\"thumbnailId\":\"2518ee1f-1c69-4289-a717-5ca11ec5aedc\",\"thumbnail\":{\"id\":\"2518ee1f-1c69-4289-a717-5ca11ec5aedc\",\"fileName\":\"dsc00779.jpg\",\"url\":\"http://apicms.bachmai.gov.vn/documents/0/0/dsc00779.jpg/2518ee1f-1c69-4289-a717-5ca11ec5aedc\",\"path\":\"http://apicms.bachmai.gov.vn/images/2026/3/18/4487927a-b6a5-4fc2-8db5-ad15c502e820_dsc00779.jpg\"},\"categoryId\":null,\"categories\":[{\"id\":\"6fe85f1d-d00b-b3be-1d7d-99e588de7e2e\",\"name\":\"Tin hoạt động Bệnh viện\",\"slug\":\"tin-hoat-ong-benh-vien\"},{\"id\":\"5f378e4b-f605-9119-c818-27e5225b973f\",\"name\":\"Nhịp cầu nhân ái\",\"slug\":\"nhip-cau-nhan-ai\"}],\"isFeatured\":false,\"isHomepage\":true},{\"id\":\"c0a33c70-2b64-4f2d-b7c9-767d20ee66bc\",\"title\":\"BẠCH MAI TẾT BÍNH NGỌ 2026: Nơi sự tử tế kết hoa và Màu áo trắng dệt nên mùa xuân hy vọng\",\"slug\":\"bach-mai-tet-binh-ngo-2026-noi-su-tu-te-ket-hoa-va-mau-ao-trang-det-nen-mua-xuan-hy-vong\",\"excerpt\":\"\u003cp class=\\\"MsoNormal\\\" style=\\\"text-align: justify; text-justify: inter-ideograph; line-height: 115%; margin: 6.0pt 0in 6.0pt 0in;\\\"\u003e\u003cspan style=\\\"font-size: 12.0pt; line-height: 115%;\\\"\u003eKhi những cơn mưa xu\u0026acirc;n bắt đầu giăng mắc tr\u0026ecirc;n những nh\u0026agrave;nh lộc non, v\u0026agrave; hơi thở của Tết B\u0026iacute;nh Ngọ đ\u0026atilde; chạm ng\u0026otilde; từng nh\u0026agrave;, c\u0026oacute; một nơi m\u0026agrave; nhịp thời gian dường như hối hả hơn nhưng cũng đong đầy cảm x\u0026uacute;c hơn \u0026ndash; đ\u0026oacute; ch\u0026iacute;nh l\u0026agrave; Bệnh viện Bạch Mai. Giữa lồng lộng gi\u0026oacute; đ\u0026ocirc;ng, tinh thần \\\"Hết l\u0026ograve;ng v\u0026igrave; người bệnh\\\" lại rực ch\u0026aacute;y, sưởi ấm những mảnh đời đang nỗ lực gi\u0026agrave;nh giật sự sống nơi giường bệnh. Với ch\u0026uacute;ng t\u0026ocirc;i, Tết kh\u0026ocirc;ng chỉ l\u0026agrave; đo\u0026agrave;n vi\u0026ecirc;n, m\u0026agrave; c\u0026ograve;n l\u0026agrave; tr\u0026aacute;ch nhiệm thi\u0026ecirc;ng li\u0026ecirc;ng để giữ g\u0026igrave;n sự sống v\u0026agrave; nụ cười cho nh\u0026acirc;n d\u0026acirc;n.\u003c/span\u003e\u003c/p\u003e\",\"viewCount\":2484,\"publishDate\":\"2026-02-17T00:00:00\",\"thumbnailId\":\"44b41e3a-7292-4210-9298-419a0297636c\",\"thumbnail\":{\"id\":\"44b41e3a-7292-4210-9298-419a0297636c\",\"fileName\":\"z7539043266150dd9ef25e2e4ac7bcc6550db113253136.jpg\",\"url\":\"http://apicms.bachmai.gov.vn/documents/0/0/z7539043266150dd9ef25e2e4ac7bcc6550db113253136.jpg/44b41e3a-7292-4210-9298-419a0297636c\",\"path\":\"http://apicms.bachmai.gov.vn/images/2026/2/16/5776baa6-4f2d-4668-a1db-2360daad2556_z7539043266150dd9ef25e2e4ac7bcc6550db113253136.jpg\"},\"categoryId\":null,\"categories\":[{\"id\":\"5f378e4b-f605-9119-c818-27e5225b973f\",\"name\":\"Nhịp cầu nhân ái\",\"slug\":\"nhip-cau-nhan-ai\"}],\"isFeatured\":false,\"isHomepage\":true},{\"id\":\"c3ee8d34-44b2-48c7-9a8a-1df709e33899\",\"title\":\"Bệnh viện Bạch Mai hỗ trợ toàn bộ suất ăn bệnh lý, dinh dưỡng cho người bệnh và người nhà người bệnh trong dịp Tết Bính Ngọ 2026\",\"slug\":\"benh-vien-bach-mai-ho-tro-toan-bo-suat-an-benh-ly-dinh-duong-cho-nguoi-benh-va-nguoi-nha-nguoi-benh-trong-dip-tet-binh-ngo-2026\",\"excerpt\":\"\u003cp class=\\\"MsoNormal\\\" style=\\\"text-align: justify; margin: 6.0pt 0in 6.0pt 0in;\\\"\u003e\u003cspan lang=\\\"VI\\\" style=\\\"font-family: 'Times New Roman',serif; mso-ansi-language: VI;\\\"\u003eVới mong muốn sẻ chia g\u0026aacute;nh nặng v\u0026agrave; mang hơi ấm t\u0026igrave;nh th\u0026acirc;n đến những Người bệnh, Người nh\u0026agrave; đ\u0026oacute;n Tết xa nh\u0026agrave; v\u0026agrave; Nh\u0026acirc;n vi\u0026ecirc;n y tế. Bệnh viện Bạch Mai triển khai chương tr\u0026igrave;nh: \\\"Suất ăn nghĩa t\u0026igrave;nh \u0026ndash; Trọn vẹn niềm tin\\\".\u003c/span\u003e\u003c/p\u003e\",\"viewCount\":992,\"publishDate\":\"2026-02-16T00:00:00\",\"thumbnailId\":\"1f3d463d-f919-4b49-98c4-c48c229e70c1\",\"thumbnail\":{\"id\":\"1f3d463d-f919-4b49-98c4-c48c229e70c1\",\"fileName\":\"picture1.jpg\",\"url\":\"http://apicms.bachmai.gov.vn/documents/0/0/picture1.jpg/1f3d463d-f919-4b49-98c4-c48c229e70c1\",\"path\":\"http://apicms.bachmai.gov.vn/images/2026/2/16/2ea12a6e-36ac-4a01-b3ca-070801016414_picture1.jpg\"},\"categoryId\":null,\"categories\":[{\"id\":\"5f378e4b-f605-9119-c818-27e5225b973f\",\"name\":\"Nhịp cầu nhân ái\",\"slug\":\"nhip-cau-nhan-ai\"}],\"isFeatured\":false,\"isHomepage\":true},{\"id\":\"97dac406-1902-40a4-92ef-3d31f7e5a32b\",\"title\":\"Blouse trắng - Trái tim hồng: Âm nhạc kết nối yêu thương, thắp sáng hy vọng\",\"slug\":\"blouse-trang-trai-tim-hong-am-nhac-ket-noi-yeu-thuong-thap-sang-hy-vong\",\"excerpt\":\"$24\",\"viewCount\":1170,\"publishDate\":\"2026-02-05T00:00:00\",\"thumbnailId\":\"09dac9ce-272a-452d-baec-6b4bc276f7d0\",\"thumbnail\":{\"id\":\"09dac9ce-272a-452d-baec-6b4bc276f7d0\",\"fileName\":\"z7504092537824c96d1f6f1211b4d8b8d8018d7cc8dc62.jpg\",\"url\":\"http://apicms.bachmai.gov.vn/documents/0/0/z7504092537824c96d1f6f1211b4d8b8d8018d7cc8dc62.jpg/09dac9ce-272a-452d-baec-6b4bc276f7d0\",\"path\":\"http://apicms.bachmai.gov.vn/images/2026/2/5/e8a75415-f9af-46ed-a76c-f5f67b06dc6f_z7504092537824c96d1f6f1211b4d8b8d8018d7cc8dc62.jpg\"},\"categoryId\":null,\"categories\":[{\"id\":\"6fe85f1d-d00b-b3be-1d7d-99e588de7e2e\",\"name\":\"Tin hoạt động Bệnh viện\",\"slug\":\"tin-hoat-ong-benh-vien\"},{\"id\":\"5f378e4b-f605-9119-c818-27e5225b973f\",\"name\":\"Nhịp cầu nhân ái\",\"slug\":\"nhip-cau-nhan-ai\"}],\"isFeatured\":false,\"isHomepage\":true}]},\"totalPage\":14,\"isPagination\":true,\"col\":8}]}]}]]}]\n"])</script></body></html>
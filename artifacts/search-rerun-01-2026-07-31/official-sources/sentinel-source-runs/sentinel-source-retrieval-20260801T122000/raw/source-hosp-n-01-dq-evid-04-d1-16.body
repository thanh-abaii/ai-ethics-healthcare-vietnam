nks/2619-04bc32f026a0d946.js\",\"6697\",\"static/chunks/6697-d002001fd5e6e8b5.js\",\"9701\",\"static/chunks/9701-31e906848a910dc4.js\",\"3584\",\"static/chunks/3584-7e99a282bc4340d3.js\",\"7249\",\"static/chunks/7249-0b33e3fd5c0d66cd.js\",\"6844\",\"static/chunks/app/(vi)/layout-e76031f859212b3f.js\"],\"default\"]\n14:T4be,"])</script><script>self.__next_f.push([1,"\u003cp class=\"MsoNormal\" style=\"text-align: justify; text-justify: inter-ideograph;\"\u003e\u003cstrong\u003e\u003cspan style=\"font-size: 12.0pt; line-height: 107%; mso-ansi-language: VI;\"\u003eKhung giờ thăm bệnh ra sao? Người nh\u0026agrave; cần l\u0026agrave;m g\u0026igrave; để được ở lại chăm s\u0026oacute;c? Những vật dụng n\u0026agrave;o kh\u0026ocirc;ng được mang v\u0026agrave;o buồng bệnh?...\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp class=\"MsoNormal\" style=\"text-align: justify; text-justify: inter-ideograph;\"\u003e\u003cspan style=\"font-size: 12.0pt; line-height: 107%; mso-ansi-language: VI;\"\u003eĐể gi\u0026uacute;p người bệnh v\u0026agrave; gia đ\u0026igrave;nh thuận tiện trong qu\u0026aacute; tr\u0026igrave;nh kh\u0026aacute;m, chữa bệnh, Bệnh viện Bạch Mai \u003c/span\u003e\u003cspan lang=\"EN-US\" style=\"font-size: 12.0pt; line-height: 107%;\"\u003eđ\u0026atilde;\u003c/span\u003e\u003cspan style=\"font-size: 12.0pt; line-height: 107%; mso-ansi-language: VI;\"\u003e ban h\u0026agrave;nh Nội quy Bệnh viện theo Quyết định số 6864/QĐ-BM do PGS.TS Đ\u0026agrave;o Xu\u0026acirc;n Cơ, Gi\u0026aacute;m đốc Bệnh viện k\u0026yacute;. Nội quy được \u0026aacute;p dụng thống nhất tại cả hai cơ sở của Bệnh viện Bạch Mai: cơ sở H\u0026agrave; Nội v\u0026agrave; cơ sở Ninh B\u0026igrave;nh.\u003c/span\u003e\u003c/p\u003e"])</script><script>self.__next_f.push([1,"15:T4e2,"])</script><script>self.__next_f.push([1,"\u003cp class=\"MsoNormal\" style=\"text-align: justify; line-height: 15.0pt; mso-line-height-rule: exactly; margin: 6.0pt 0in 6.0pt 0in;\"\u003e\u003cspan style=\"font-size: 12.0pt; mso-ansi-language: VI;\"\u003eSuốt nhiều th\u0026aacute;ng, cứ đến lịch điều trị, người phụ nữ 58 tuổi ở huyện Vụ Bản (Ninh B\u0026igrave;nh) lại dậy từ 5 giờ s\u0026aacute;ng, bắt xe kh\u0026aacute;ch l\u0026ecirc;n H\u0026agrave; Nội để truyền thuốc sinh học điều trị vi\u0026ecirc;m khớp dạng thấp. Mỗi chuyến đi k\u0026eacute;o d\u0026agrave;i h\u0026agrave;ng trăm ki-l\u0026ocirc;-m\u0026eacute;t kh\u0026ocirc;ng chỉ khiến b\u0026agrave; th\u0026ecirc;m mệt mỏi m\u0026agrave; c\u0026ograve;n l\u0026agrave; g\u0026aacute;nh nặng đối với gia đ\u0026igrave;nh.\u003c/span\u003e\u003c/p\u003e\n\u003cp class=\"MsoNormal\" style=\"text-align: justify; line-height: 15.0pt; mso-line-height-rule: exactly; margin: 6.0pt 0in 6.0pt 0in;\"\u003e\u003cspan style=\"font-size: 12.0pt; mso-ansi-language: VI;\"\u003eGiờ đ\u0026acirc;y, khi Bệnh viện Bạch Mai cơ sở Ninh B\u0026igrave;nh triển khai điều trị thuốc sinh học theo quy tr\u0026igrave;nh chuy\u0026ecirc;n m\u0026ocirc;n thống nhất với cơ sở H\u0026agrave; Nội, người bệnh đ\u0026atilde; c\u0026oacute; thể tiếp cận kỹ thuật chuy\u0026ecirc;n s\u0026acirc;u ngay tại địa phương.\u003c/span\u003e\u003c/p\u003e"])</script><script>self.__next_f.push([1,"16:T47b,"])</script><script>self.__next_f.push([1,"\u003cp class=\"MsoNormal\" style=\"text-align: justify; text-justify: inter-ideograph; line-height: 16.0pt; mso-line-height-rule: exactly; margin: 6.0pt 0in 6.0pt 0in;\"\u003e\u003cspan style=\"font-size: 12.0pt; mso-bidi-font-family: 'Times New Roman'; mso-ansi-language: VI;\"\u003eNhằm bảo đảm an ninh, an to\u0026agrave;n giao th\u0026ocirc;ng, ph\u0026ograve;ng ch\u0026aacute;y chữa ch\u0026aacute;y v\u0026agrave; tạo thuận lợi cho người d\u0026acirc;n khi đến kh\u0026aacute;m, chữa bệnh, Bệnh viện Bạch Mai cơ sở Ninh B\u0026igrave;nh đ\u0026atilde; ban h\u0026agrave;nh quy định về ph\u0026acirc;n luồng giao th\u0026ocirc;ng v\u0026agrave; quản l\u0026yacute; phương tiện ra v\u0026agrave;o theo Quyết định số 4245/QĐ-BM.\u003c/span\u003e\u003c/p\u003e\n\u003cp class=\"MsoNormal\" style=\"text-align: justify; text-justify: inter-ideograph; line-height: 16.0pt; mso-line-height-rule: exactly; margin: 6.0pt 0in 6.0pt 0in;\"\u003e\u003cspan style=\"font-size: 12.0pt; mso-bidi-font-family: 'Times New Roman'; mso-ansi-language: VI;\"\u003eĐể việc di chuyển trong khu\u0026ocirc;n vi\u0026ecirc;n bệnh viện được nhanh ch\u0026oacute;ng, thuận tiện, người d\u0026acirc;n cần lưu \u0026yacute; một số hướng dẫn sau:\u003c/span\u003e\u003c/p\u003e"])</script><script>self.__next_f.push([1,"17:T51f,"])</script><script>self.__next_f.push([1,"\u003cp class=\"MsoNormal\" style=\"margin: 6.0pt 0cm 6.0pt 0cm;\"\u003e\u003cstrong\u003e\u003cspan style=\"font-size: 12.0pt; line-height: 115%;\"\u003e1. Polyp đại tr\u0026agrave;ng l\u0026agrave; g\u0026igrave;?\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp class=\"MsoNormal\" style=\"margin: 6.0pt 0cm 6.0pt 0cm;\"\u003e\u003cspan style=\"font-size: 12.0pt; line-height: 115%;\"\u003ePolyp đại tr\u0026agrave;ng l\u0026agrave; c\u0026aacute;c khối u nhỏ h\u0026igrave;nh th\u0026agrave;nh b\u0026ecirc;n trong ni\u0026ecirc;m mạc ruột gi\u0026agrave;. Ch\u0026uacute;ng thường kh\u0026ocirc;ng g\u0026acirc;y triệu chứng ban đầu, nhưng theo thời gian c\u0026oacute; thể ph\u0026aacute;t triển k\u0026iacute;ch thước v\u0026agrave; dẫn đến:\u003c/span\u003e\u003c/p\u003e\n\u003cp class=\"MsoNormal\" style=\"margin: 6.0pt 0cm 6.0pt 0cm;\"\u003e\u003cspan style=\"font-size: 12.0pt; line-height: 115%;\"\u003e\u0026bull; Nguy cơ chuyển th\u0026agrave;nh ung thư đại trực tr\u0026agrave;ng\u003c/span\u003e\u003c/p\u003e\n\u003cp class=\"MsoNormal\" style=\"margin: 6.0pt 0cm 6.0pt 0cm;\"\u003e\u003cspan style=\"font-size: 12.0pt; line-height: 115%;\"\u003e\u0026bull; G\u0026acirc;y chảy m\u0026aacute;u, tắc ruột hoặc hẹp l\u0026ograve;ng ruột\u003c/span\u003e\u003c/p\u003e\n\u003cp class=\"MsoNormal\" style=\"margin: 6.0pt 0cm 6.0pt 0cm;\"\u003e\u003cstrong\u003e\u003cspan style=\"font-size: 12.0pt; line-height: 115%;\"\u003eV\u0026igrave; vậy, việc ph\u0026aacute;t hiện v\u0026agrave; cắt bỏ polyp qua nội soi l\u0026agrave; rất cần thiết, đặc biệt với polyp \u0026ge; 1cm.\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e"])</script><script>self.__next_f.push([1,"5:[\"$\",\"div\",null,{\"className\":\"category-news\",\"children\":[[\"$\",\"div\",null,{\"className\":\"breadcrumb\",\"children\":[[\"$\",\"div\",null,{\"className\":\"container\",\"children\":[[\"$\",\"h1\",null,{\"className\":\"pb-2 h1\",\"children\":\"Hướng dẫn và quy trình khám chữa bệnh\"}],[\"$\",\"ul\",null,{\"children\":[[\"$\",\"li\",null,{\"children\":[\"$\",\"$L12\",null,{\"href\":\"/\",\"title\":\"\",\"children\":\"Trang chủ\"}]}],[[\"$\",\"li\",\"1\",{\"children\":[\"$\",\"$L12\",null,{\"href\":\"\",\"children\":[[\"$\",\"span\",null,{\"className\":\"dot px-3\"}],[\"$\",\"span\",null,{\"children\":\"Hướng dẫn và quy trình khám chữa bệnh\"}]]}]}]]]}]]}],\"$undefined\"]}],[\"$\",\"div\",null,{\"className\":\"container mt-6\",\"children\":[\"$\",\"div\",null,{\"className\":\"category-news__items mb-4 mb-md-5\",\"children\":[\"$\",\"$L13\",null,{\"filtersId\":\"49a0cfb4-2d21-d9b8-6e2f-e85f6f82e8d2\",\"post\":{\"totalCount\":23,\"items\":[{\"id\":\"5394411b-34d5-4dfc-befa-124179acdaf0\",\"title\":\"06 bước khám chữa bệnh tại Bệnh viện Bạch Mai: Nhanh chóng, thuận tiện và hiệu quả\",\"slug\":\"06-buoc-kham-chua-benh-tai-benh-vien-bach-mai-nhanh-chong-thuan-tien-va-hieu-qua\",\"excerpt\":\"\u003cp class=\\\"MsoNormal\\\" style=\\\"text-align: justify; line-height: 15.0pt; mso-line-height-rule: exactly; margin: 6.0pt 0in 6.0pt 0in;\\\"\u003e\u003cspan style=\\\"font-size: 12.0pt;\\\"\u003eMỗi ng\u0026agrave;y, Bệnh viện Bạch Mai tiếp đ\u0026oacute;n h\u0026agrave;ng ngh\u0026igrave;n lượt người bệnh đến kh\u0026aacute;m v\u0026agrave; điều trị. Để gi\u0026uacute;p người d\u0026acirc;n tiết kiệm thời gian, hạn chế chờ đợi v\u0026agrave; c\u0026oacute; trải nghiệm kh\u0026aacute;m chữa bệnh thuận lợi hơn, bệnh viện đ\u0026atilde; triển khai nhiều h\u0026igrave;nh thức đăng k\u0026yacute;, thanh to\u0026aacute;n v\u0026agrave; tra cứu kết quả hiện đại. Chỉ cần nắm r\u0026otilde; 6 bước dưới đ\u0026acirc;y, bạn sẽ chủ động hơn trong suốt qu\u0026aacute; tr\u0026igrave;nh kh\u0026aacute;m bệnh.\u003c/span\u003e\u003c/p\u003e\",\"viewCount\":99,\"publishDate\":\"2026-07-30T00:00:00\",\"thumbnailId\":\"a97dd6b8-ef5b-439a-8b62-4b716bac8731\",\"thumbnail\":{\"id\":\"a97dd6b8-ef5b-439a-8b62-4b716bac8731\",\"fileName\":\"picture2.jpg\",\"url\":\"http://apicms.bachmai.gov.vn/documents/0/0/picture2.jpg/a97dd6b8-ef5b-439a-8b62-4b716bac8731\",\"path\":\"http://apicms.bachmai.gov.vn/images/2026/7/30/5ff3d468-179e-428a-8826-5b42edfac621_picture2.jpg\"},\"categoryId\":null,\"categories\":[{\"id\":\"49a0cfb4-2d21-d9b8-6e2f-e85f6f82e8d2\",\"name\":\"Hướng dẫn và quy trình khám chữa bệnh\",\"slug\":\"huong-dan-va-quy-trinh-kham-chua-benh\"}],\"isFeatured\":false,\"isHomepage\":true},{\"id\":\"d194e513-361e-4c35-8ca8-f8745693f163\",\"title\":\"Bệnh viện Bạch Mai triển khai trích sao hồ sơ bệnh án trực tuyến\",\"slug\":\"benh-vien-bach-mai-trien-khai-trich-sao-ho-so-benh-an-truc-tuyen\",\"excerpt\":\"\u003cp class=\\\"MsoNormal\\\" style=\\\"text-align: justify;\\\"\u003e\u003cspan style=\\\"font-family: 'Times New Roman',serif; mso-ansi-language: VI;\\\"\u003eNgười bệnh kh\u0026ocirc;ng c\u0026ograve;n phải xếp h\u0026agrave;ng chờ đợi hay mang theo nhiều giấy tờ khi cần tr\u0026iacute;ch sao hồ sơ bệnh \u0026aacute;n. Từ nay, to\u0026agrave;n bộ quy tr\u0026igrave;nh c\u0026oacute; thể thực hiện trực tuyến tr\u0026ecirc;n ứng dụng Bạch Mai Care \u003c/span\u003e\u003cspan lang=\\\"EN-US\\\" style=\\\"font-family: 'Times New Roman',serif;\\\"\u003e-\u003c/span\u003e\u003cspan style=\\\"font-family: 'Times New Roman',serif; mso-ansi-language: VI;\\\"\u003e Hồ sơ sức khỏe, gi\u0026uacute;p tiết kiệm thời gian, giảm thủ tục v\u0026agrave; thuận tiện hơn trong qu\u0026aacute; tr\u0026igrave;nh sử dụng dịch vụ y tế.\u003c/span\u003e\u003c/p\u003e\",\"viewCount\":170,\"publishDate\":\"2026-07-30T00:00:00\",\"thumbnailId\":\"4f0c2d16-c573-4baa-9405-2946382c148e\",\"thumbnail\":{\"id\":\"4f0c2d16-c573-4baa-9405-2946382c148e\",\"fileName\":\"f37249b9-fd8c-441f-82ea-8a80e5657454.png\",\"url\":\"http://apicms.bachmai.gov.vn/documents/0/0/f37249b9-fd8c-441f-82ea-8a80e5657454.png/4f0c2d16-c573-4baa-9405-2946382c148e\",\"path\":\"http://apicms.bachmai.gov.vn/images/2026/7/30/33833b6b-fffe-42b1-8ae0-ee9e8d94c489_f37249b9-fd8c-441f-82ea-8a80e5657454.png\"},\"categoryId\":null,\"categories\":[{\"id\":\"49a0cfb4-2d21-d9b8-6e2f-e85f6f82e8d2\",\"name\":\"Hướng dẫn và quy trình khám chữa bệnh\",\"slug\":\"huong-dan-va-quy-trinh-kham-chua-benh\"}],\"isFeatured\":false,\"isHomepage\":true},{\"id\":\"f9d36f41-548c-489a-bd76-b7700e8a7134\",\"title\":\"Hướng dẫn khám chữa bệnh nhanh chóng, thuận tiện tại Bệnh viện Bạch Mai cơ sở Ninh Bình\",\"slug\":\"huong-dan-kham-chua-benh-nhanh-chong-thuan-tien-tai-benh-vien-bach-mai-co-so-ninh-binh\",\"excerpt\":\"\u003cp class=\\\"MsoNormal\\\" style=\\\"text-align: justify; line-height: 15.0pt; mso-line-height-rule: exactly; border: none; mso-padding-alt: 31.0pt 31.0pt 31.0pt 31.0pt; mso-border-shadow: yes; margin: 6.0pt 0in 6.0pt 0in;\\\"\u003e\u003cspan style=\\\"font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-ansi-language: VI;\\\"\u003eNhằm n\u0026acirc;ng cao chất lượng phục vụ, tối ưu quy tr\u0026igrave;nh tiếp đ\u0026oacute;n v\u0026agrave; giảm thời gian chờ đợi, Bệnh viện Bạch Mai cơ sở Ninh B\u0026igrave;nh triển khai m\u0026ocirc; h\u0026igrave;nh kh\u0026aacute;m chữa bệnh th\u0026ocirc;ng minh với nhiều tiện \u0026iacute;ch như đặt lịch kh\u0026aacute;m trực tuyến, lấy số tự động tại Kiosk v\u0026agrave; thanh to\u0026aacute;n kh\u0026ocirc;ng d\u0026ugrave;ng tiền mặt. Dưới đ\u0026acirc;y l\u0026agrave; hướng dẫn gi\u0026uacute;p người bệnh kh\u0026aacute;m chữa bệnh nhanh ch\u0026oacute;ng, thuận tiện hơn.\u003c/span\u003e\u003c/p\u003e\",\"viewCount\":709,\"publishDate\":\"2026-07-23T00:00:00\",\"thumbnailId\":\"d6043eb5-1f3f-41b5-b856-7c123f55f27e\",\"thumbnail\":{\"id\":\"d6043eb5-1f3f-41b5-b856-7c123f55f27e\",\"fileName\":\"17847139844218632047732760297797g821177366828960831230a8abf103aa241854693aa2b15fe047.jpg\",\"url\":\"http://apicms.bachmai.gov.vn/documents/0/0/17847139844218632047732760297797g821177366828960831230a8abf103aa241854693aa2b15fe047.jpg/d6043eb5-1f3f-41b5-b856-7c123f55f27e\",\"path\":\"http://apicms.bachmai.gov.vn/images/2026/7/23/9fb1fca2-e632-45d7-b8a7-ca50f0bc5aa1_17847139844218632047732760297797g821177366828960831230a8abf103aa241854693aa2b15fe047.jpg\"},\"categoryId\":null,\"categories\":[{\"id\":\"49a0cfb4-2d21-d9b8-6e2f-e85f6f82e8d2\",\"name\":\"Hướng dẫn và quy trình khám chữa bệnh\",\"slug\":\"huong-dan-va-quy-trinh-kham-chua-benh\"}],\"isFeatured\":false,\"isHomepage\":true},{\"id\":\"abc39b84-ff79-4bd7-aa77-e93f7cb8e690\",\"title\":\"Khám bệnh không tiền mặt tại Bệnh viện Bạch Mai: Nhanh hơn, an toàn hơn\",\"slug\":\"kham-benh-khong-tien-mat-tai-benh-vien-bach-mai-nhanh-hon-an-toan-hon\",\"excerpt\":\"\u003cp class=\\\"MsoNormal\\\" style=\\\"text-align: justify; text-justify: inter-ideograph; line-height: 115%; margin: 6.0pt 0in 6.0pt 0in;\\\"\u003e\u003cspan style=\\\"font-size: 12.0pt; line-height: 115%; mso-ansi-language: VI;\\\"\u003eNgười bệnh đến kh\u0026aacute;m tại Bệnh viện Bạch Mai cơ sở H\u0026agrave; Nội v\u0026agrave; cơ sở Ninh B\u0026igrave;nh giờ đ\u0026acirc;y c\u0026oacute; thể thanh to\u0026aacute;n viện ph\u0026iacute; nhanh ch\u0026oacute;ng bằng nhiều h\u0026igrave;nh thức điện tử, kh\u0026ocirc;ng cần mang theo nhiều tiền mặt, gi\u0026uacute;p tiết kiệm thời gian, bảo đảm an to\u0026agrave;n v\u0026agrave; n\u0026acirc;ng cao trải nghiệm trong suốt qu\u0026aacute; tr\u0026igrave;nh kh\u0026aacute;m chữa bệnh.\u003c/span\u003e\u003c/p\u003e\",\"viewCount\":551,\"publishDate\":\"2026-07-22T00:00:00\",\"thumbnailId\":\"bcaa3732-40a7-4b39-bf5a-47cd965eeaf2\",\"thumbnail\":{\"id\":\"bcaa3732-40a7-4b39-bf5a-47cd965eeaf2\",\"fileName\":\"4a4b5ddd-81ef-42f5-abd3-18ed8170623dmceu99414619821740476512329.jpg\",\"url\":\"http://apicms.bachmai.gov.vn/documents/0/0/4a4b5ddd-81ef-42f5-abd3-18ed8170623dmceu99414619821740476512329.jpg/bcaa3732-40a7-4b39-bf5a-47cd965eeaf2\",\"path\":\"http://apicms.bachmai.gov.vn/images/2026/7/22/68fd9fa5-fa69-4810-ae38-10f3ce755d7d_4a4b5ddd-81ef-42f5-abd3-18ed8170623dmceu99414619821740476512329.jpg\"},\"categoryId\":null,\"categories\":[{\"id\":\"49a0cfb4-2d21-d9b8-6e2f-e85f6f82e8d2\",\"name\":\"Hướng dẫn và quy trình khám chữa bệnh\",\"slug\":\"huong-dan-va-quy-trinh-kham-chua-benh\"}],\"isFeatured\":false,\"isHomepage\":true},{\"id\":\"f6d9b9a1-4f45-422a-9a2c-0c87c6bf7014\",\"title\":\"Bệnh viện Bạch Mai nâng cấp ứng dụng Bạch Mai Care, trả kết quả cận lâm sàng theo thời gian thực\",\"slug\":\"benh-vien-bach-mai-nang-cap-ung-dung-bach-mai-care-tra-ket-qua-can-lam-sang-theo-thoi-gian-thuc\",\"excerpt\":\"\u003cp class=\\\"MsoNormal\\\" style=\\\"text-align: justify; text-justify: inter-ideograph;\\\"\u003e\u003cspan style=\\\"font-size: 12.0pt; line-height: 107%; mso-bidi-font-family: 'Times New Roman'; mso-ansi-language: VI;\\\"\u003eTừ ng\u0026agrave;y 20/7/2026, người bệnh kh\u0026aacute;m tại Bệnh viện Bạch Mai c\u0026oacute; thể xem kết quả x\u0026eacute;t nghiệm, chẩn đo\u0026aacute;n h\u0026igrave;nh ảnh v\u0026agrave; c\u0026aacute;c dịch vụ cận l\u0026acirc;m s\u0026agrave;ng ngay sau khi b\u0026aacute;c sĩ ho\u0026agrave;n tất k\u0026yacute; số tr\u0026ecirc;n ứng dụng Bạch Mai Care \u003c/span\u003e\u003cspan lang=\\\"EN-US\\\" style=\\\"font-size: 12.0pt; line-height: 107%; mso-bidi-font-family: 'Times New Roman';\\\"\u003e-\u003c/span\u003e\u003cspan style=\\\"font-size: 12.0pt; line-height: 107%; mso-bidi-font-family: 'Times New Roman'; mso-ansi-language: VI;\\\"\u003e Hồ sơ sức khỏe.\u003c/span\u003e\u003c/p\u003e\",\"viewCount\":1641,\"publishDate\":\"2026-07-21T00:00:00\",\"thumbnailId\":\"e403416a-44fb-44c7-8378-29f903e2a71b\",\"thumbnail\":{\"id\":\"e403416a-44fb-44c7-8378-29f903e2a71b\",\"fileName\":\"banner-app-bach-mai-care-ho-so-suc-khoe.jpg\",\"url\":\"http://apicms.bachmai.gov.vn/documents/0/0/banner-app-bach-mai-care-ho-so-suc-khoe.jpg/e403416a-44fb-44c7-8378-29f903e2a71b\",\"path\":\"http://apicms.bachmai.gov.vn/images/2026/7/21/bed85bdb-3766-45c8-b2a0-1ec3a60c3f94_banner-app-bach-mai-care-ho-so-suc-khoe.jpg\"},\"categoryId\":null,\"categories\":[{\"id\":\"49a0cfb4-2d21-d9b8-6e2f-e85f6f82e8d2\",\"name\":\"Hướng dẫn và quy trình khám chữa bệnh\",\"slug\":\"huong-dan-va-quy-trinh-kham-chua-benh\"}],\"isFeatured\":false,\"isHomepage\":true},{\"id\":\"c170aee6-7f03-4b13-9531-8b5805d17cb7\",\"title\":\"Đến Bệnh viện Bạch Mai khám, điều trị cần lưu ý những gì?\",\"slug\":\"den-benh-vien-bach-mai-kham-dieu-tri-can-luu-y-nhung-gi\",\"excerpt\":\"$14\",\"viewCount\":612,\"publishDate\":\"2026-07-21T00:00:00\",\"thumbnailId\":\"60ce4556-301a-41c4-8441-f8606abd13f8\",\"thumbnail\":{\"id\":\"60ce4556-301a-41c4-8441-f8606abd13f8\",\"fileName\":\"1784277752679506796487395075247550679648739507524756fcb796d541020c64e0697851405ae4d.jpg\",\"url\":\"http://apicms.bachmai.gov.vn/documents/0/0/1784277752679506796487395075247550679648739507524756fcb796d541020c64e0697851405ae4d.jpg/60ce4556-301a-41c4-8441-f8606abd13f8\",\"path\":\"http://apicms.bachmai.gov.vn/images/2026/7/21/9692e350-3751-4079-895a-822d1379b7b2_1784277752679506796487395075247550679648739507524756fcb796d541020c64e0697851405ae4d.jpg\"},\"categoryId\":null,\"categories\":[{\"id\":\"49a0cfb4-2d21-d9b8-6e2f-e85f6f82e8d2\",\"name\":\"Hướng dẫn và quy trình khám chữa bệnh\",\"slug\":\"huong-dan-va-quy-trinh-kham-chua-benh\"}],\"isFeatured\":false,\"isHomepage\":true},{\"id\":\"299c7233-9371-44fc-ae34-b7e4073fbc99\",\"title\":\"Hướng dẫn di chuyển đến Bệnh viện Bạch Mai cơ sở Ninh Bình\",\"slug\":\"huong-dan-di-chuyen-den-benh-vien-bach-mai-co-so-ninh-binh\",\"excerpt\":\"\u003cp class=\\\"MsoNormal\\\" style=\\\"line-height: 16.0pt; mso-line-height-rule: exactly; margin: 6.0pt 0in 6.0pt 0in;\\\"\u003e\u003cspan style=\\\"font-size: 12.0pt; font-family: 'Times New Roman',serif;\\\"\u003eBệnh viện Bạch Mai cơ sở Ninh B\u0026igrave;nh đ\u0026atilde; ch\u0026iacute;nh thức đi v\u0026agrave;o hoạt động, gi\u0026uacute;p người d\u0026acirc;n nhiều tỉnh, th\u0026agrave;nh ph\u0026iacute;a Bắc v\u0026agrave; Bắc Trung Bộ tiếp cận dịch vụ y tế chất lượng cao ngay tại khu vực, giảm thời gian v\u0026agrave; chi ph\u0026iacute; đi lại.\u003c/span\u003e\u003cspan style=\\\"font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-ansi-language: EN-US;\\\"\u003e \u003c/span\u003e\u003cspan style=\\\"font-size: 12.0pt; font-family: 'Times New Roman',serif;\\\"\u003eDưới đ\u0026acirc;y l\u0026agrave; những phương \u0026aacute;n di chuyển thuận tiện đến bệnh viện, ph\u0026ugrave; hợp với từng nhu cầu.\u003c/span\u003e\u003c/p\u003e\",\"viewCount\":1846,\"publishDate\":\"2026-07-20T00:00:00\",\"thumbnailId\":\"a7835e9a-efa5-4f82-95bd-68a4d55645d8\",\"thumbnail\":{\"id\":\"a7835e9a-efa5-4f82-95bd-68a4d55645d8\",\"fileName\":\"screenshot1784690463.png\",\"url\":\"http://apicms.bachmai.gov.vn/documents/0/0/screenshot1784690463.png/a7835e9a-efa5-4f82-95bd-68a4d55645d8\",\"path\":\"http://apicms.bachmai.gov.vn/images/2026/7/22/8dbde6b6-9da4-4b49-a639-641071cd44d1_screenshot1784690463.png\"},\"categoryId\":null,\"categories\":[{\"id\":\"49a0cfb4-2d21-d9b8-6e2f-e85f6f82e8d2\",\"name\":\"Hướng dẫn và quy trình khám chữa bệnh\",\"slug\":\"huong-dan-va-quy-trinh-kham-chua-benh\"}],\"isFeatured\":false,\"isHomepage\":true},{\"id\":\"f72792a2-edbe-484f-8693-acdaa88de94c\",\"title\":\"Người bệnh cơ xương khớp được điều trị thuốc sinh học ngay tại Bệnh viện Bạch Mai cơ sở Ninh Bình\",\"slug\":\"nguoi-benh-co-xuong-khop-duoc-dieu-tri-thuoc-sinh-hoc-ngay-tai-benh-vien-bach-mai-co-so-ninh-binh\",\"excerpt\":\"$15\",\"viewCount\":1427,\"publishDate\":\"2026-07-15T00:00:00\",\"thumbnailId\":\"bf4158b9-a2bb-4597-9497-862bbdbaee93\",\"thumbnail\":{\"id\":\"bf4158b9-a2bb-4597-9497-862bbdbaee93\",\"fileName\":\"1000029450.jpg\",\"url\":\"http://apicms.bachmai.gov.vn/documents/0/0/1000029450.jpg/bf4158b9-a2bb-4597-9497-862bbdbaee93\",\"path\":\"http://apicms.bachmai.gov.vn/images/2026/7/15/d28d9c96-9d6f-445d-ae7b-a1558fdb41ab_1000029450.jpg\"},\"categoryId\":null,\"categories\":[{\"id\":\"49a0cfb4-2d21-d9b8-6e2f-e85f6f82e8d2\",\"name\":\"Hướng dẫn và quy trình khám chữa bệnh\",\"slug\":\"huong-dan-va-quy-trinh-kham-chua-benh\"}],\"isFeatured\":false,\"isHomepage\":true},{\"id\":\"c4e2c022-bc57-43dd-9aa4-2bfbc30a7f00\",\"title\":\"Hướng dẫn phân luồng giao thông và gửi xe cho người dân tại Bệnh viện Bạch Mai cơ sở Ninh Bình\",\"slug\":\"huong-dan-phan-luong-giao-thong-va-gui-xe-cho-nguoi-dan-tai-benh-vien-bach-mai-co-so-ninh-binh\",\"excerpt\":\"$16\",\"viewCount\":2394,\"publishDate\":\"2026-07-07T00:00:00\",\"thumbnailId\":\"a69334f9-8469-4657-a9b3-a318a13a71b1\",\"thumbnail\":{\"id\":\"a69334f9-8469-4657-a9b3-a318a13a71b1\",\"fileName\":\"17834106478338632047732760297797g82117736682896083120cdd8b5e1bbf677015a28a0025f8fb82.jpg\",\"url\":\"http://apicms.bachmai.gov.vn/documents/0/0/17834106478338632047732760297797g82117736682896083120cdd8b5e1bbf677015a28a0025f8fb82.jpg/a69334f9-8469-4657-a9b3-a318a13a71b1\",\"path\":\"http://apicms.bachmai.gov.vn/images/2026/7/7/94357d5f-bc9d-4e66-8e28-9397be3f5d1a_17834106478338632047732760297797g82117736682896083120cdd8b5e1bbf677015a28a0025f8fb82.jpg\"},\"categoryId\":null,\"categories\":[{\"id\":\"49a0cfb4-2d21-d9b8-6e2f-e85f6f82e8d2\",\"name\":\"Hướng dẫn và quy trình khám chữa bệnh\",\"slug\":\"huong-dan-va-quy-trinh-kham-chua-benh\"}],\"isFeatured\":false,\"isHomepage\":true},{\"id\":\"5eddba7e-d16d-4a11-8a6d-3b95202070f5\",\"title\":\"App Bạch Mai CARE ra mắt tính năng mới: Có đủ kết quả, điện thoại tự báo, người bệnh không còn phải chờ đợi\",\"slug\":\"app-bach-mai-care-ra-mat-tinh-nang-moi-co-du-ket-qua-dien-thoai-tu-bao-nguoi-benh-khong-con-phai-cho-doi\",\"excerpt\":\"\u003cp class=\\\"MsoNormal\\\" style=\\\"text-align: justify; text-justify: inter-ideograph;\\\"\u003e\u003cspan style=\\\"font-size: 12.0pt; line-height: 107%; mso-ansi-language: VI;\\\"\u003eĐi kh\u0026aacute;m tại bệnh viện tuyến cuối, điều khiến nhiều người mệt mỏi kh\u0026ocirc;ng chỉ l\u0026agrave; x\u0026eacute;t nghiệm hay chụp chiếu, m\u0026agrave; ch\u0026iacute;nh l\u0026agrave; khoảng thời gian thấp thỏm chờ kết quả cận l\u0026acirc;m s\u0026agrave;ng. Sau khi l\u0026agrave;m x\u0026eacute;t nghiệm, si\u0026ecirc;u \u0026acirc;m, chụp X-quang\u0026hellip;, kh\u0026ocirc;ng \u0026iacute;t người phải li\u0026ecirc;n tục đi ra đi v\u0026agrave;o trước cửa ph\u0026ograve;ng kh\u0026aacute;m để xem kết quả đ\u0026atilde; \u0026ldquo;l\u0026ecirc;n hệ thống\u0026rdquo; hay chưa.\u003c/span\u003e\u003c/p\u003e\",\"viewCount\":2486,\"publishDate\":\"2026-05-25T00:00:00\",\"thumbnailId\":\"d0a16045-23db-41bd-9ca7-eb07a703c527\",\"thumbnail\":{\"id\":\"d0a16045-23db-41bd-9ca7-eb07a703c527\",\"fileName\":\"z78634797486809b1ddcb22cd1d68ed18edbe077074627.jpg\",\"url\":\"http://apicms.bachmai.gov.vn/documents/0/0/z78634797486809b1ddcb22cd1d68ed18edbe077074627.jpg/d0a16045-23db-41bd-9ca7-eb07a703c527\",\"path\":\"http://apicms.bachmai.gov.vn/images/2026/5/25/8ee8bb9e-c79c-48f1-a523-09763305222b_z78634797486809b1ddcb22cd1d68ed18edbe077074627.jpg\"},\"categoryId\":null,\"categories\":[{\"id\":\"49a0cfb4-2d21-d9b8-6e2f-e85f6f82e8d2\",\"name\":\"Hướng dẫn và quy trình khám chữa bệnh\",\"slug\":\"huong-dan-va-quy-trinh-kham-chua-benh\"}],\"isFeatured\":false,\"isHomepage\":true},{\"id\":\"c1d85f0c-6e10-4bb7-be38-083ee1af016c\",\"title\":\"Đặt lịch khám trực tuyến qua Cổng thông tin điện tử Bệnh viện Bạch Mai: Nhanh chóng - Chủ động - Tiện lợi\",\"slug\":\"dat-lich-kham-truc-tuyen-qua-cong-thong-tin-dien-tu-benh-vien-bach-mai-nhanh-chong-chu-dong-tien-loi\",\"excerpt\":\"\u003cp class=\\\"MsoNormal\\\" style=\\\"text-align: justify; text-justify: inter-ideograph; line-height: 16.0pt; mso-line-height-rule: exactly; margin: 6.0pt 0in 6.0pt 0in;\\\"\u003e\u003cstrong\u003e\u003cem\u003e\u003cspan lang=\\\"EN-US\\\" style=\\\"font-size: 12.0pt; mso-fareast-font-family: 'Times New Roman'; mso-bidi-font-family: 'Times New Roman'; color: #1f1f1f; border: none windowtext 1.0pt; mso-border-alt: none windowtext 0in; padding: 0in;\\\"\u003eVới mục ti\u0026ecirc;u n\u0026acirc;ng cao trải nghiệm người bệnh trong thời đại kỹ thuật số, Bệnh viện Bạch Mai kh\u0026ocirc;ng ngừng đẩy mạnh chuyển đổi số, mang đến giải ph\u0026aacute;p đặt lịch kh\u0026aacute;m trực tuyến gi\u0026uacute;p người d\u0026acirc;n l\u0026agrave;m chủ thời gian v\u0026agrave; tối ưu h\u0026oacute;a h\u0026agrave;nh tr\u0026igrave;nh chăm s\u0026oacute;c sức khỏe.\u003c/span\u003e\u003c/em\u003e\u003c/strong\u003e\u003c/p\u003e\",\"viewCount\":64384,\"publishDate\":\"2026-04-24T00:00:00\",\"thumbnailId\":\"60f156d5-ad3c-495b-a09e-c6ee03edded8\",\"thumbnail\":{\"id\":\"60f156d5-ad3c-495b-a09e-c6ee03edded8\",\"fileName\":\"z7755793003814fe8f0dd59cbe701442a1996762f6d13d.jpg\",\"url\":\"http://apicms.bachmai.gov.vn/documents/0/0/z7755793003814fe8f0dd59cbe701442a1996762f6d13d.jpg/60f156d5-ad3c-495b-a09e-c6ee03edded8\",\"path\":\"http://apicms.bachmai.gov.vn/images/2026/4/24/d8fdb00e-bd71-46ee-9bd8-d52c5c227403_z7755793003814fe8f0dd59cbe701442a1996762f6d13d.jpg\"},\"categoryId\":null,\"categories\":[{\"id\":\"b00df27b-bbcd-fffe-ee65-5a225b509ff6\",\"name\":\"Y học thường thức\",\"slug\":\"y-hoc-thuong-thuc\"},{\"id\":\"49a0cfb4-2d21-d9b8-6e2f-e85f6f82e8d2\",\"name\":\"Hướng dẫn và quy trình khám chữa bệnh\",\"slug\":\"huong-dan-va-quy-trinh-kham-chua-benh\"}],\"isFeatured\":false,\"isHomepage\":true},{\"id\":\"5fb5b997-70fa-47e4-b76d-ae09e3249507\",\"title\":\"Các biến chứng sau nhổ răng: Những điều người bệnh cần biết\",\"slug\":\"cac-bien-chung-sau-nho-rang-nhung-dieu-nguoi-benh-can-biet\",\"excerpt\":\"\u003cp class=\\\"MsoNormal\\\" style=\\\"text-align: justify; margin: 6.0pt 0cm 6.0pt 0cm;\\\"\u003e\u003cspan style=\\\"font-family: 'Times New Roman',serif; mso-ansi-language: VI;\\\"\u003eNhổ răng l\u0026agrave; một thủ thuật nha khoa phổ biến, được thực hiện hằng ng\u0026agrave;y tại nhiều cơ sở y tế. Phần lớn c\u0026aacute;c trường hợp diễn ra an to\u0026agrave;n v\u0026agrave; l\u0026agrave;nh thương tốt. Tuy nhi\u0026ecirc;n, kh\u0026ocirc;ng phải ca nhổ răng n\u0026agrave;o cũng \u0026ldquo;kết th\u0026uacute;c\u0026rdquo; ngay sau khi răng được lấy ra khỏi ổ. Một số phản ứng hoặc biến chứng c\u0026oacute; thể xuất hiện v\u0026agrave; cần được nhận biết sớm để xử tr\u0026iacute; kịp thời.\u003c/span\u003e\u003c/p\u003e\",\"viewCount\":2228,\"publishDate\":\"2026-01-26T00:00:00\",\"thumbnailId\":\"61e7cbd2-dc5c-4427-b300-ee22a032361d\",\"thumbnail\":{\"id\":\"61e7cbd2-dc5c-4427-b300-ee22a032361d\",\"fileName\":\"bien-chung-sau-nho-rang-so-8-2.jpg\",\"url\":\"http://apicms.bachmai.gov.vn/documents/0/0/bien-chung-sau-nho-rang-so-8-2.jpg/61e7cbd2-dc5c-4427-b300-ee22a032361d\",\"path\":\"http://apicms.bachmai.gov.vn/images/2026/1/26/4235732a-07f9-44ef-b7b4-2a9601a5f825_bien-chung-sau-nho-rang-so-8-2.jpg\"},\"categoryId\":null,\"categories\":[{\"id\":\"49a0cfb4-2d21-d9b8-6e2f-e85f6f82e8d2\",\"name\":\"Hướng dẫn và quy trình khám chữa bệnh\",\"slug\":\"huong-dan-va-quy-trinh-kham-chua-benh\"}],\"isFeatured\":false,\"isHomepage\":true},{\"id\":\"738fb91e-6269-4b88-b986-2f02c63fc0f8\",\"title\":\"Cắt polyp đại tràng qua nội soi: Hướng dẫn dành cho người bệnh\",\"slug\":\"cat-polyp-dai-trang-qua-noi-soi-huong-dan-danh-cho-nguoi-benh\",\"excerpt\":\"$17\",\"viewCount\":2061,\"publishDate\":\"2026-01-22T00:00:00\",\"thumbnailId\":\"0efa6d92-97d8-4286-946f-be4372f2dfd8\",\"thumbnail\":{\"id\":\"0efa6d92-97d8-4286-946f-be4372f2dfd8\",\"fileName\":\"benh-polyp-dai-trang9-800x450.jpg\",\"url\":\"http://apicms.bachmai.gov.vn/documents/0/0/benh-polyp-dai-trang9-800x450.jpg/0efa6d92-97d8-4286-946f-be4372f2dfd8\",\"path\":\"http://apicms.bachmai.gov.vn/images/2026/1/22/53c617a1-88c1-4a37-8df4-fd8d56db2278_benh-polyp-dai-trang9-800x450.jpg\"},\"categoryId\":null,\"categories\":[{\"id\":\"49a0cfb4-2d21-d9b8-6e2f-e85f6f82e8d2\",\"name\":\"Hướng dẫn và quy trình khám chữa bệnh\",\"slug\":\"huong-dan-va-quy-trinh-kham-chua-benh\"}],\"isFeatured\":false,\"isHomepage\":true},{\"id\":\"fb837b6e-e9a5-4e1a-a2d3-590dbec31010\",\"title\":\"Thông điệp từ Bệnh viện Bạch Mai gửi tới người bệnh giữa tâm bão!\",\"slug\":\"thong-diep-tu-benh-vien-bach-mai-gui-toi-nguoi-benh-giua-tam-bao\",\"excerpt\":\"\u003cp class=\\\"MsoNormal\\\" style=\\\"text-align: justify;\\\"\u003e\u003cem style=\\\"mso-bidi-font-style: normal;\\\"\u003e\u003cspan lang=\\\"EN\\\" style=\\\"font-size: 12.0pt; line-height: 115%; font-family: 'Times New Roman','serif';\\\"\u003eK\u0026iacute;nh gửi Qu\u0026yacute; người bệnh v\u0026agrave; gia đ\u0026igrave;nh,\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e\\n\u003cp class=\\\"MsoNormal\\\" style=\\\"text-align: justify;\\\"\u003e\u003cspan lang=\\\"EN\\\" style=\\\"font-size: 12.0pt; line-height: 115%; font-family: 'Times New Roman','serif';\\\"\u003eTrước những diễn biến phức tạp của cơn b\u0026atilde;o số 10, thay v\u0026igrave; những lo lắng về lịch hẹn kh\u0026aacute;m chữa bệnh, trước hết, b\u0026agrave; con c\u0026ocirc; b\u0026aacute;c h\u0026atilde;y giữ vững sự an to\u0026agrave;n cho bản th\u0026acirc;n v\u0026agrave; gia đ\u0026igrave;nh. Sức khỏe v\u0026agrave; t\u0026iacute;nh mạng của Qu\u0026yacute; người bệnh l\u0026agrave; ưu ti\u0026ecirc;n cao nhất của ch\u0026uacute;ng t\u0026ocirc;i.\u003c/span\u003e\u003c/p\u003e\",\"viewCount\":15645,\"publishDate\":\"2025-09-30T00:00:00\",\"thumbnailId\":\"1f7c5fcb-349e-4382-93d3-0309f918147c\",\"thumbnail\":{\"id\":\"1f7c5fcb-349e-4382-93d3-0309f918147c\",\"fileName\":\"bvbm-3.jpg\",\"url\":\"http://apicms.bachmai.gov.vn/documents/0/0/bvbm-3.jpg/1f7c5fcb-349e-4382-93d3-0309f918147c\",\"path\":\"http://apicms.bachmai.gov.vn/images/2025/9/30/d4aa9095-87ce-437b-b85d-f323331e6fea_bvbm-3.jpg\"},\"categoryId\":null,\"categories\":[{\"id\":\"49a0cfb4-2d21-d9b8-6e2f-e85f6f82e8d2\",\"name\":\"Hướng dẫn và quy trình khám chữa bệnh\",\"slug\":\"huong-dan-va-quy-trinh-kham-chua-benh\"}],\"isFeatured\":false,\"isHomepage\":true}]},\"totalPage\":14,\"isPagination\":true,\"col\":8}]}]}]]}]\n"])</script><script>self.__next_f.push([1,"4:[\"$\",\"html\",null,{\"lang\":\"vi\",\"className\":\"__variable_3b6de7 __variable_6e1c1f\",\"children\":[[\"$\",\"body\",null,{\"className\":\"d-flex flex-column min-h-screen\",\"children\":[[\"$\",\"$L18\",null,{}],[\"$\",\"$L19\",null,{\"dataMenu\":[{\"id\":\"7b490eae-0f0a-47d0-b2fe-425ad5a2c4b8\",\"menuId\":\"8e9ab461-b705-4d89-a829-b849547994ab\",\"parentId\":\"20038820-f259-4b01-8d5b-015beda7eb98\",\"title\":\"Thông tin nội bộ\",\"url\":\"/chuyen-muc/thong-tin-noi-bo?id=d0307b27-e830-4995-be3c-cd07e020c503\",\"target\":\"_self\",\"order\":1,\"isVisible\":true,\"role\":\"\",\"icon\":\"\",\"creationTime\":\"2024-12-12T16:04:41.7718791\",\"lastModificationTime\":\"2026-03-12T16:32:19.7652196\",\"entityType\":0,\"entityId\":null,\"customLink\":null},{\"id\":\"5a85cfe3-680b-431b-84cb-476e4182a8bd\",\"menuId\":\"8e9ab461-b705-4d89-a829-b849547994ab\",\"parentId\":\"4007bd33-23be-406f-8b87-ab96dfeb25be\",\"title\":\"Tư vấn và Tiêm chủng Vắc xin\",\"url\":\" /chuyen-muc/tu-van-va-tiem-chung-vac-xin?id=71f1c417-aa8b-40af-ac6a-b174b520cef1\",\"target\":\"_self\",\"order\":1,\"isVisible\":true,\"role\":\"\",\"icon\":\"\",\"creationTime\":\"2025-08-06T08:30:08.5554107\",\"lastModificationTime\":\"2025-08-08T12:03:12.8077419\",\"entityType\":0,\"entityId\":null,\"customLink\":null},{\"id\":\"1dd151a3-a532-4bf4-9315-4b8ec2599f04\",\"menuId\":\"8e9ab461-b705-4d89-a829-b849547994ab\",\"parentId\":null,\"title\":\"Trang chủ\",\"url\":\"/\",\"target\"
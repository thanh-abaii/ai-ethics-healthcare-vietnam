		margin-top: 17px;
		font-size: 14px;
		font-style: normal;
		font-weight: 700;
		line-height: 130%; /* 18.2px */
		letter-spacing: 0.021px;
	}

	.button-dt {
		color: #FFF;
		background-color: #f70000;
		border-color: #f70000;
		padding: 3px 0.75rem;
		border-radius: 5px;
		margin: 2px;
	}

	.button-dt-close {

<script>
	function goToRelatedPage(pageNum) {
        // Hide all pages
        $('.related-news-page').hide();
        
        // Show the selected page
        $('#tlq-page-' + pageNum).show();
        
        // Update current page
        $('#currentRelatedPage').val(pageNum);
        
        // Update pagination display
        updatePagination(pageNum);
        
        // Update disabled state for prev/next buttons
        updatePaginationButtons(pageNum);
    }
    
    function prevRelatedPage() {
        let currentPage = parseInt($('#currentRelatedPage').val());
        if (currentPage > 1) {
            goToRelatedPage(currentPage - 1);
        }
    }
    
    function nextRelatedPage() {
        let currentPage = parseInt($('#currentRelatedPage').val());
        let totalPages = parseInt($('#totalRelatedPages').val());
        if (currentPage < totalPages) {
            goToRelatedPage(currentPage + 1);
        }
    }
    
    function updatePaginationButtons(currentPage) {
        let totalPages = parseInt($('#totalRelatedPages').val());
        
        // Handle prev button
        if (currentPage <= 1) {
            $('.pagination .prev-page').addClass('disabled');
        } else {
            $('.pagination .prev-page').removeClass('disabled');
        }
        
        // Handle next button
        if (currentPage >= totalPages) {
            $('.pagination .next-page').addClass('disabled');
        } else {
            $('.pagination .next-page').removeClass('disabled');
        }
    }
    
    function updatePagination(currentPage) {
        // Remove active class from all page numbers
        $('.pagination .page-number').removeClass('active');
        
        // Find the page number that matches the current page and add active class
        $('.pagination .page-number').each(function() {
            if (parseInt($(this).text()) === currentPage) {
                $(this).addClass('active');
            }
        });
        
        // If current page isn't visible, rebuild pagination
        if ($('.pagination .page-number.active').length === 0) {
            rebuildPagination(currentPage);
        }
    }
    
    function rebuildPagination(currentPage) {
        let totalPages = parseInt($('#totalRelatedPages').val());
        let isMobile = window.innerWidth <= 576;
        let maxVisible = isMobile ? 3 : 5; // Show fewer pages on mobile
        let halfVisible = Math.floor(maxVisible / 2);
        
        // Clear existing page numbers and ellipsis
        $('.pagination .page-number, .pagination .ellipsis').remove();
        
        // Always include first page
        let $firstPage = $('<a href="javascript:void(0)" class="page-number" onclick="goToRelatedPage(1)">1</a>');
        if (currentPage === 1) $firstPage.addClass('active');
        $('.pagination .prev-page').after($firstPage);
        
        // Add ellipsis after first page if needed
        let $lastElement = $firstPage;
        if (totalPages > maxVisible && currentPage > halfVisible + 1) {
            let $ellipsis = $('<span class="ellipsis">...</span>');
            $lastElement.after($ellipsis);
            $lastElement = $ellipsis;
        }
        
        // Add middle pages
        let startPage = Math.max(2, currentPage - halfVisible);
        let endPage = Math.min(totalPages - 1, currentPage + halfVisible);
        
        // Adjust if we're near the beginning
        if (currentPage <= halfVisible + 1) {
            endPage = Math.min(totalPages - 1, maxVisible - 1);
        }
        
        // Adjust if we're near the end
        if (currentPage >= totalPages - halfVisible) {
            startPage = Math.max(2, totalPages - maxVisible + 1);
        }
        
        // On mobile, further reduce visible pages if we're at the edges
        if (isMobile) {
            if (currentPage <= 2) {
                endPage = Math.min(totalPages - 1, 2);
            } else if (currentPage >= totalPages - 1) {
                startPage = Math.max(2, totalPages - 2);
            }
        }
        
        // Add middle page numbers
        for (let i = startPage; i <= endPage; i++) {
            let $pageLink = $('<a href="javascript:void(0)" class="page-number" onclick="goToRelatedPage(' + i + ')">' + i + '</a>');
            if (i === currentPage) $pageLink.addClass('active');
            $lastElement.after($pageLink);
            $lastElement = $pageLink;
        }
        
        // Add ellipsis before last page if needed
        if (totalPages > maxVisible && currentPage < totalPages - halfVisible) {
            let $ellipsis = $('<span class="ellipsis">...</span>');
            $lastElement.after($ellipsis);
            $lastElement = $ellipsis;
        }
        
        // Always include last page if it's not the first page
        if (totalPages > 1) {
            let $lastPage = $('<a href="javascript:void(0)" class="page-number" onclick="goToRelatedPage(' + totalPages + ')">' + totalPages + '</a>');
            if (currentPage === totalPages) $lastPage.addClass('active');
            $lastElement.after($lastPage);
        }
        
        // Listen for window resize to rebuild pagination
        $(window).off('resize.pagination').on('resize.pagination', function() {
            let wasMobile = isMobile;
            isMobile = window.innerWidth <= 576;
            if (wasMobile !== isMobile) {
                rebuildPagination(currentPage);
            }
        });
    }
	$(document).ready(function () {
		//load lần đầu lấy 3 comments
		getFeedback(3);


		let stars = document.querySelectorAll(".ratings span");
		let products = document.querySelectorAll(".ratings");
		let ratings = [];

		for (let star of stars) {
			star.addEventListener("click", function () {
				let children = star.parentElement.children;
				for (let child of children) {
					if (child.getAttribute("data-clicked")) {
						return false;
					}
				}

				this.setAttribute("data-clicked", "true");
				let rating = this.dataset.rating;
				let productId = this.parentElement.dataset.productid;
				let data = {
					"rating": rating,
					"product-id": productId,
				}
				ratings.push(data);
				localStorage.setItem("rating", JSON.stringify(ratings));
			});
		}

		if (localStorage.getItem("rating")) {
			ratings = JSON.parse(localStorage.getItem("rating"));
			for (let rating of ratings) {
				for (let product of products) {
					if (rating["product-id"] == product.dataset.productid) {
						let reverse = Array.from(product.children).reverse();
						let index = parseInt(rating["rating"]) - 1;
						reverse[index].setAttribute("data-clicked", "true");
					}
				}
			}
		}

		// Initialize pagination
        if ($('#totalRelatedPages').length) {
            let totalPages = parseInt($('#totalRelatedPages').val());
            if (totalPages > 1) {
                rebuildPagination(1);
            }
            goToRelatedPage(1);
        }
	});



	function submitUserForm() {
		/*var response = grecaptcha.getResponse();
        if (response.length == 0) {
            $("#g-recaptcha-error").html("<span style='color:red;'>This field is required.</span>");
            return false;
        }*/
		return true;
	};
	function verifyCaptcha() {
		$("#g-recaptcha-error").html("");
	}

	function sendFeedback() {
		event.preventDefault();
		let isValid = true;
		/*var response = grecaptcha.getResponse();
        if (response.length == 0) {
            $("#g-recaptcha-error").html("<span style='color:red;'>This field is required.</span>");
            return false;
        }*/
		$('[required]').each(function () {
			let fieldTitle = $(this).attr('title');
			if ($(this).val().toString().trim().length == 0) {
				isValid = false;
				Swal.fire({
					title: "Vui lòng nhập thông tin",
					icon: "error",
				})
				return false;
			} else if ($(this).attr("regex") != undefined) {
				let regex = new RegExp($(this).attr('regex'));
				if (!regex.test($(this).val())) {
					isValid = false;
					Swal.fire({
						title: "Vui lòng nhập đúng định dạng",
						icon: "error",
					})
					return false;
				}

			}
		});
		if (!isValid) return false;
		fetch('https://api.ipify.org?format=json')
				.then(response => response.json())
				.then(data => {
					const ipAddress = data.ip;
					const param = JSON.stringify({
						baiVietId: '4319395',
						noiDung: $("#commentContent").val(),
						ten: $("#commentName").val(),
						mail: $("#email").val(),
						soDienThoai: $("#soDienThoai").val(),
						tieuDeBaiViet: 'Thông báo về việc tiếp nhận bản tự công bố đạt tiêu chuẩn an toàn sinh học của Khoa Xét nghiệm - Truyền máu, Bệnh viện Ung bướu Đà Nẵng ngày 27/7/2026',
						tenTacGia: 'Nguyễn Đỗ Bảo Quyên',
						ipNguoiDung: ipAddress,
					});
					$.ajax({
						url: location.origin+'/api/v1/public/tuongtacbaiviet/themBinhLuan',
						type: 'POST',
						cache: false,
						dataType:"json",
						contentType:"application/json",
						data:param,
						/*data: {
                            baiVietId: '4319395',
				noiDung: $("#commentContent").val(),
				ten: $("#commentName").val(),
				mail: $("#email").val(),
				soDienThoai: $("#soDienThoai").val(),
				tieuDeBaiViet: 'Thông báo về việc tiếp nhận bản tự công bố đạt tiêu chuẩn an toàn sinh học của Khoa Xét nghiệm - Truyền máu, Bệnh viện Ung bướu Đà Nẵng ngày 27/7/2026',
				tenTacGia: 'Nguyễn Đỗ Bảo Quyên',
			},*/

						success: function () {
							$("#customSuccessPopupOverlay").removeClass("d-none");

							$("#commentContent").val('');
							$("#commentName").val('');
							$("#email").val('');
							$("#soDienThoai").val('');

							setTimeout(function () {
								$("#customSuccessPopupOverlay").addClass("d-none");
							}, 3000);
						},
						error: function (er) {
							Swal.fire({
								title: "Thực hiện không thành công",
								text: 'Gửi bình luận thất bại',
								icon: "error",
							})
						}
					});})
	}
	$(document).ready(function () {
		$("#customSuccessPopupOverlay").on("click", function () {
			$(this).addClass("d-none");
		});

		$(".custom-popup-ykien-binhluan").on("click", function (e) {
			e.stopPropagation();
		});
	});
	function getFeedback(sizecmt) {
		$('#comment-list').empty();
		const param = JSON.stringify({
			baiVietId: '4319395'
		});
		$.ajax({
			url: location.origin+'/api/v1/public/tuongtacbaiviet/truyCapBaiViet',
			type: 'POST',
			cache : false,
			dataType:"json",
			contentType:"application/json",
			data: param,
		}).done(function (data) {

			console.log(data)
			var dsBinhLuan = data.msg.thongTinBinhLuans;
			var count = data.msg.thongTinBinhLuans.length;
			var htmlYKien = '';
			if (dsBinhLuan.length > 0) {
				$('#binhLuanMacDinh').empty();
				// htmlYKien += '<h2 class="botting-border"><span class="text-border">Bình luận, ý kiến của bạn đọc (' + count + ')</span></h2>';
				for (var i = 0; i < dsBinhLuan.length; i++) {
					var obj = dsBinhLuan[i];
					htmlYKien += '<div class="item box_cm">';
					htmlYKien += '<a href="javascript:void(0)" class="avatar">\n' +
							'                <img src="https://soyte.danang.gov.vn/o/portal-home-multi-theme-syt/images/icons/iconuser.png">\n' +
							'            </a>';
					htmlYKien += '<div class="item-content">';
					htmlYKien += '<span class="user-name">' + obj.ten + '</span>' + ' <span class="date-cmt">' + obj.thoiGianBinhLuan + '</span></br>';
					htmlYKien += '<span class="text-comment">' + obj.noiDungHienThi + '</span>';
					htmlYKien += '</div>';
					htmlYKien += '</div>';
				}
				if (count > sizecmt) {
					htmlYKien += '<div class="text-center">\n' +
							'<button type="submit" class="btnmorecmt" onclick="getFeedback(' + (sizecmt + 10) + ')" >Xem thêm bình luận, ý kiến\n' +
							'</button>\n' +
							'</div>';
				}
				$('#comment-list').append(htmlYKien);
			}
			;
		});
	}
</script>

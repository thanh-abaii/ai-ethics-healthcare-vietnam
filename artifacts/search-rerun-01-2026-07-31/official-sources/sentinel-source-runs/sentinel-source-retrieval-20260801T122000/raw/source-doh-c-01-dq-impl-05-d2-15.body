			<div class="inner-bg-gray" onclick="location.href='/web/syt/-/thong-bao-viec-dang-ky-hanh-nghe-tai-cac-co-so-kham-benh-chua-benh-ngay-31-7-2026-tram-y-te-phuong-thanh-khe-tram-y-te-xa-thang-phu-phong-kham-da-khoa-an-duc-1-trung-tam-y-te-khu-vuc-hiep-duc-trung-tam-y-te-khu-vuc-tay-giang-trung-tam-y-te-khu-vuc-son-tra'">
				<div class="row">

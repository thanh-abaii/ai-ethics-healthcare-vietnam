    $(document).ready(function() {
        $('a[href="https://tinnhiemmang.vn/danh-ba-tin-nhiem/dananggovvn-1637728063"]').attr('href', 'https://tinnhiemmang.vn/danh-ba-tin-nhiem/soytedananggovvn-1637742283');
        
        $('a[href*="dananggovvn-1637728063"]').each(function() {
            var currentHref = $(this).attr('href');
            var newHref = currentHref.replace('dananggovvn-1637728063', 'soytedananggovvn-1637742283');
            $(this).attr('href', newHref);
        });
    });

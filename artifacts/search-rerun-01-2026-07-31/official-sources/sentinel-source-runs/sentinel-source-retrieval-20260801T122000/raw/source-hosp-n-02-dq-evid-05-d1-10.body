<style>
  /* mobile */
  @media screen and (max-width: 768px){
    .ck-reverse{
    flex-direction: column-reverse!important;
  }  
  }
  
    .specialty-gal {
            overflow: hidden;
            max-width: 1200px;
            position: relative;
            margin: 20px;
        }
        .gallery-wrapper {
            display: flex;
            transition: transform 0.3s ease;
        }
        .specialty-gal div {
            flex: 0 0 33.333%;
            padding: 0 10px;
            text-align: center;
        }
        @media screen and (max-width: 768px) {
            .specialty-gal div {
                flex: 0 0 100%;
            }
            .arrow {
                display: none;
            }
            
        }
        .specialty-gal img {
            width: 100%;
            transition: transform 0.3s ease;
        }
        .specialty-gal img:hover {
            transform: scale(1.05);
        }
        .arrow {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            font-size: 24px;
            cursor: pointer;
            padding: 10px;
        }
        .arrow-left {
            left: -10px;
        }
        .arrow-right {
            right: -10px;
        }
        .cat-tab{
            display: none;
        
        }
        .first_tab{

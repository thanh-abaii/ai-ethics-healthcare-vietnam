	var s = document.getElementById('emcTracking');
    var emcSiteId = s?.getAttribute('data-emcSiteId') || '';
	var _govaq = window._govaq || [];
	_govaq.push(['trackPageView']);
	_govaq.push(['enableLinkTracking']);
	(function () {
		_govaq.push(['setTrackerUrl', 'https://f-emc.ngsp.gov.vn/tracking']);
		_govaq.push(['setSiteId', emcSiteId]);
		var d = document,
				g = d.createElement('script'),
				s = d.getElementById('emcTracking');

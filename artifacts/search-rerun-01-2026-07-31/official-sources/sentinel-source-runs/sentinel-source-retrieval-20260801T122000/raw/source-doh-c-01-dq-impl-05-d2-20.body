                                                </span>
									</a>

									<a onclick="fontPlus();" href="javascript:void(0);" title="Tăng cỡ chữ" class="" data-toggle="tooltip">
                                                <span class="icon-tool">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewbox="0 0 28 28" fill="none">
                                                        <circle cx="14" cy="14" r="13.5" transform="rotate(-180 14 14)" stroke="#777777" />
                                                        <path d="M10 12L13.75 15.75L17.5 12" stroke="#777777" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                                                    </svg>
                                                </span>

		<dynamic-content language-id="vi_VN">&lt;p style="line-height:30px"&gt;Tải về Kế hoạch của Sở Y tế &lt;a href="/documents/131507/3118391/6732.SYT.NVY.signed.signed.signed.pdf/6575211b-f660-9504-ca0e-2a0c3b1ae531?t=1767571140460" style=";color: #2980b9;text-align: center;text-decoration: underline;font-weight: bold"&gt;tại đây&lt;/a&gt;&amp;nbsp;&lt;/p&gt;

&lt;p style="line-height: 30px; text-align: right;"&gt;Phòng Nghiệp vụ Y.&lt;/p&gt;</dynamic-content>
	</dynamic-element>
</root>, DDMStructureKey=41537, DDMTemplateKey=102007, defaultLanguageId=vi_VN, layoutUuid=, displayDate=Mon Jan 05 07:01:00 ICT 2026, expirationDate=null, reviewDate=null, indexable=true, smallImage=false, smallImageId=0, smallImageURL=, lastPublishDate=null, status=0, statusByUserId=1865343, statusByUserName=Admin Admin, statusDate=Mon Jan 05 16:14:54 ICT 2026}</span>
<a href="/vi/web/syt/-/ke-hoach-trien-khai-he-thong-quan-ly-quoc-gia-ve-hanh-nghe-va-hoat-dong-kham-benh-chua-benh" class=" w-100 same-height">
	<div class="row">
		<div class="col-12 col-md-4 pr-0 img-hdk-ct">
			<img id="tin-slide-img-left" class=" tin-slide-img-left img-tin-hd-khac" onerror="this.onerror=null; this.src='/documents/131507/131575/anh-mac-dinh-syt.jpg';" src="/documents/131507/131575/anh-mac-dinh-syt.jpg" alt="">

									<a onclick="giamTuongPhan();" href="javascript:void(0);" data-toggle="tooltip" title="Giảm tương phản">
                                                <span class="icon-tool">
                                                    <img src="/o/portal-home-multi-theme/icons/trothinh/trothinh_bright-down-btn.png" style="vertical-align: middle;opacity: 1; height: 28px">

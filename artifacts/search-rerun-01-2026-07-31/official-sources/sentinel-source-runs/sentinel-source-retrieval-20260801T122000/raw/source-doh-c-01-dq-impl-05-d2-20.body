	var s = document.getElementById('emcTracking');
    var emcSiteId = s?.getAttribute('data-emcSiteId') || '';
	var _govaq = window._govaq || [];
	_govaq.push(['trackPageView']);
	_govaq.push(['enableLinkTracking']);
	(function () {

\":\"http://apicms.bachmai.gov.vn/documents/0/0/chung.jpg/6ca687b5-bfd4-4dc1-b2de-d0760da73d74\",\"path\":\"http://apicms.bachmai.gov.vn/images/2026/7/29/363f0913-cc4e-457f-8f4b-3d971c312f9b_chung.jpg\"},\"categoryId\":null,\"categories\":[{\"id\":\"2d65d63d-0474-a9a4-9412-433c7270a14c\",\"name\":\"Thông báo và tin mời thầu\",\"slug\":\"thong-bao-va-tin-moi-thau\"}],\"isFeatured\":false,\"isHomepage\":false},{\"id\":\"c5616a57-cf38-4c0b-9c99-1fd4ec75bf2c\",\"title\":\"Thông báo về việc mời đơn vị tham gia thực hiện gói thầu “TV01 – Tư vấn lập hồ sơ mời thầu và đánh giá HSDT gói thầu XL+TB” đối với công trình “Cải tạo, sửa chữa khu nhà làm việc 2 tầng cho phòng Hành chính quản trị - Bệnh viện Bạch Mai”\",\"slug\":\"thong-bao-ve-viec-moi-don-vi-tham-gia-thuc-hien-goi-thau-“tv01-–-tu-van-lap-ho-so-moi-thau-va-danh-gia-hsdt-goi-thau-xltb”-doi-voi-cong-trinh-“cai-tao-sua-chua-khu-nha-lam-viec-2-tang-cho-phong-hanh-chinh-quan-tri-benh-vien-bach-mai”\",\"excerpt\":\"\u003cp\u003e\u003cspan lang=\\\"EN-US\\\"\u003eThực hiện Quyết định số 5507/QĐ-BM ng\u0026agrave;y 22/7/2026 của Gi\u0026aacute;m đốc Bệnh viện Bạch Mai về việc ph\u0026ecirc; duyệt kế hoạch lựa chọn nh\u0026agrave; thầu giai đoạn thực hiện c\u0026ocirc;ng tr\u0026igrave;nh \u0026ldquo;Cải tạo, sửa chữa khu nh\u0026agrave; l\u0026agrave;m việc 2 tầng cho ph\u0026ograve;ng H\u0026agrave;nh ch\u0026iacute;nh quản trị - Bệnh viện Bạch Mai\u0026rdquo;, Bệnh viện Bạch Mai đang tổ chức lựa chọn đơn vị tham gia thực hiện g\u0026oacute;i thầu \u0026ldquo;TV01 \u0026ndash; Tư vấn lập hồ sơ mời thầu v\u0026agrave; đ\u0026aacute;nh gi\u0026aacute; HSDT g\u0026oacute;i thầu XL+TB\u0026rdquo; thuộc c\u0026ocirc;ng tr\u0026igrave;nh tr\u0026ecirc;n với c\u0026aacute;c nội dung như sau:\u003c/span\u003e\u003c/p\u003e\",\"viewCount\":79,\"publishDate\":\"2026-07-27T00:00:00\",\"thumbnailId\":\"aab9ed2c-c65c-470a-ade4-ff713373d06f\",\"thumbnail\":{\"id\":\"aab9ed2c-c65c-470a-ade4-ff713373d06f\",\"fileName\":\"chung.jpg\",\"url
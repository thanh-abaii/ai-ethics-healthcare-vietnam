2a8-96faed573ff9\",\"path\":\"http://apicms.bachmai.gov.vn/images/2026/7/31/23a1b1d0-9792-4838-962a-bf377290366d_chung.jpg\"},\"categoryId\":null,\"categories\":[{\"id\":\"2d65d63d-0474-a9a4-9412-433c7270a14c\",\"name\":\"Thông báo và tin mời thầu\",\"slug\":\"thong-bao-va-tin-moi-thau\"}],\"isFeatured\":false,\"isHomepage\":false},{\"id\":\"48822b59-f35b-4b08-8043-2c47bd6f991b\",\"title\":\"Thư mời báo giá dịch vụ lập Báo cáo đề xuất cấp Giấy phép môi trường dự án Đầu tư xây dựng Trung tâm Cấp cứu đa năng Bệnh viện Bạch Mai\",\"slug\":\"thu-moi-bao-gia-dich-vu-lap-bao-cao-de-xuat-cap-giay-phep-moi-truong-du-an-dau-tu-xay-dung-trung-tam-cap-cuu-da-nang-benh-vien-bach-mai\",\"excerpt\":\"\u003cp class=\\\"MsoNormal\\\"\u003eK\u0026iacute;nh gửi:\u0026nbsp;\u0026nbsp;\u003cspan lang=\\\"EN-US\\\" style=\\\"mso-ansi-language: EN-US;\\\"\u003eC\u0026aacute;c đơn vị/nh\u0026agrave; cung cấp dịch vụ tư vấn m\u0026ocirc;i trường\u003c/span\u003e\u003c/p\u003e\\n\u003cp class=\\\"MsoNormal\\\"\u003eBệnh viện Bạch Mai \u003cspan lang=\\\"EN-US\\\" style=\\\"mso-ansi-language: EN-US;\\\"\u003emời đơn vị tham gia \u003c/span\u003e\u003cspan lang=\\\"NL\\\" style=\\\"mso-ansi-language: NL;\\\"\u003ecung cấp dịch vụ \u003c/span\u003e\u003cspan lang=\\\"EN-US\\\" style=\\\"mso-ansi-language: EN-US;\\\"\u003elập B\u0026aacute;o c\u0026aacute;o đề xuất cấp Giấy ph\u0026eacute;p m\u0026ocirc;i trường dự \u0026aacute;n Đầu tư x\u0026acirc;y dựng Trung t\u0026acirc;m Cấp cứu đa năng Bệnh viện Bạch Mai, với nội dung cụ thể như sau:\u003c/span\u003e\u003c/p\u003e\",\"viewCount\":56,\"publishDate\":\"2026-07-30T00:00:00\",\"thumbnailId\":\"25cb133e-66b9-43ac-84f1-2b511e7352c0\",\"thumbnail\":{\"id\":\"25cb133e-66b9-43ac-84f1-2b511e7352c0\",\"fileName\":\"chung.jpg\",\"url\":\"http://apicms.bachmai.gov.vn/documents/0/0/chung.jpg/25cb133e-66b9-43ac-84f1-2b511e7352c0\",\"path\":\"http://apicms.bachmai.gov.vn/images/2026/7/30/7f32af62-d241-4161-96b8-326a8db95d45_chung.jpg\"},\"categoryId\":null,\"categories\":[{\"id\":\"2d65d63d-0474-a9a4-9412-433c7270a14c\",\"name\":\"Thông báo và tin mời thầu\",\"slug\":\"thong-bao-va-tin-moi-thau\"}],\"isFeatured\":false,\"isHomepage\":false},{\"id\":\"437cd5b8-f4c6-4567-8c09-cec004559e6d\",\"title\":\"Thông báo về việc mời tham gia thực hiện gói thầu TV05 – Tư vấn kiểm toán công trình “Cải tạo hệ thống thoát nước từ khu vực cửa số 2 nhà K2  đến điểm thu viện phí số 3 – Bệnh viện Bạch Mai”\",\"slug\":\"thong-bao-ve-viec-moi-tham-gia-thuc-hien-goi-thau-tv05-–-tu-van-kiem-toan-cong-trinh-“cai-tao-he-thong-thoat-nuoc-tu-khu-vuc-cua-so-2-nha-k2-den-diem-thu-vien-phi-so-3-–-benh-vien-bach-mai”\",\"excerpt\":\"\u003cp class=\\\"MsoNormal\\\" style=\\\"text-indent: 0cm;\\\"\u003e\u003cspan lang=\\\"EN-US\\\"\u003eCăn cứ Quyết định số 5573/QĐ-BM ng\u0026agrave;y 25/7/2026 của Gi\u0026aacute;m đốc Bệnh viện Bạch Mai về việc ph\u0026ecirc; duyệt kế hoạch lựa chọn nh\u0026agrave; thầu giai đoạn thực hiện đầu tư c\u0026ocirc;ng tr\u0026igrave;nh \u0026ldquo;Cải tạo hệ thống tho\u0026aacute;t nước từ khu vực cửa số 2 nh\u0026agrave; K2 đến điểm thu viện ph\u0026iacute; số 3 - Bệnh viện Bạch Mai\u0026rdquo;;\u003c/span\u003e\u003c/p\u003e\\n\u003cp class=\\\"MsoNormal\\\" style=\\\"text-indent: 0cm;\\\"\u003e\u003cspan lang=\\\"EN-US\\\"\u003eBệnh viện Bạch Mai đang tổ chức lựa chọn đơn vị tham gia thực hiện g\u0026oacute;i thầu TV05 \u0026ndash; Tư vấn kiểm to\u0026aacute;n thuộc c\u0026ocirc;ng tr\u0026igrave;nh tr\u0026ecirc;n với c\u0026aacute;c nội dung như sau:\u003c/span\u003e\u003c/p\u003e\",\"viewCount\":41,\"publishDate\":\"2026-07-30T00:00:00\",\"thumbnailId\":\"a26bc97e-584c-45db-bec6-41f82baa1673\",\"thumbnail\":{\"id\":\"a26bc97e-584c-45db-bec6-41f82baa1673\",\"fileName\":\"chung.jpg\",\"url\":\"http://apicms.bachmai.gov.vn/documents/0/0/chung.jpg/a26bc97e-584c-45db-bec6-41f82baa1673\",\"path\":\"http://apicms.bachmai.gov.vn/images/2026/7/30/667720ae-2f07-4cda-878f-8871c4fb9ae7_chung.jpg\"},\"categoryId\":null,\"categories\":[{\"id\":\"2d65d63d-0474-a9a4-9412-433c7270a14c\",\"name\":\"Thông báo và tin mời thầu\",\"slug\":\"thong-bao-va-tin-moi-thau\"}],\"isFeatured\":false,\"isHomepage\":false},{\"id\":\"486c9333-7a8c-4d37-8a98-dc62c94b55fc\",\"title\":\"Thư mời báo giá dịch vụ đổ mực, sửa chữa và thay thế linh kiện, thiết bị máy in tại Bệnh viện Bạch Mai\",\"slug\":\"thu-moi-bao-gia-dich-vu-do-muc-sua-chua-va-thay-the-linh-kien-thiet-bi-may-in-tai-benh-vien-bach-mai\",\"excerpt\":\"\u003cp class=\\\"MsoNormal\\\" style=\\\"text-indent: 0cm;\\\"\u003e\u003cspan lang=\\\"EN-US\\\"\u003eK\u0026iacute;nh gửi:\u003cspan style=\\\"mso-spacerun: yes;\\\"\u003e\u0026nbsp; \u003c/span\u003eC\u0026aacute;c đơn vị/nh\u0026agrave; sản xuất tại Việt Nam\u003c/span\u003e\u003c/p\u003e\\n\u003cp class=\\\"MsoNormal\\\" style=\\\"text-indent: 0cm;\\\"\u003e\u003cspan lang=\\\"EN-US\\\"\u003eBệnh viện Bạch Mai c\u0026oacute; nhu cầu tiếp nhận b\u0026aacute;o gi\u0026aacute;: Cung cấp dịch vụ đổ mực, sửa chữa v\u0026agrave; thay thế linh kiện, thiết bị m\u0026aacute;y in\u003c/span\u003e\u003cspan style=\\\"mso-ansi-language: VI;\\\"\u003e tại Bệnh viện Bạch Mai \u003c/span\u003e\u003cspan lang=\\\"EN-US\\\"\u003enội dung cụ thể như sau:\u003c/span\u003e\u003c/p\u003e\",\"viewCount\":50,\"publishDate\":\"2026-07-30T00:00:00\",\"thumbnailId\":\"cadd3afa-6115-41b0-885e-b7461a645cef\",\"thumbnail\":{\"id\":\"cadd3afa-6115-41b0-885e-b7461a645cef\",\"fileName\":\"chung.jpg\",\"url\":\"http://apicms.bachmai.gov.vn/documents/0/0/chung.jpg/cadd3afa-6115-41b0-885e-b7461a645cef\",\"path\":\"http://apicms.bachmai.gov.vn/images/2026/7/30/bcb00ad1-f7e0-4052-961a-a111cc32c5a8_chung.jpg\"},\"categoryId\":null,\"categories\":[{\"id\":\"2d65d63d-0474-a9a4-9412-433c7270a14c\",\"name\":\"Thông báo và tin mời thầu\",\"slug\":\"thong-bao-va-tin-moi-thau\"}],\"isFeatured\":false,\"isHomepage\":false},{\"id\":\"7bf64d59-fa7e-4031-b503-e79debca220a\",\"title\":\"Thư mời báo giá Thuê xe ô tô trung chuyển đưa đón cán b
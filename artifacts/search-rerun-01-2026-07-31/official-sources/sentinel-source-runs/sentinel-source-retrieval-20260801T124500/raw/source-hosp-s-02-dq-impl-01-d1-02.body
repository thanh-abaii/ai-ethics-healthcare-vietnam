                        jQuery('#div_kq_tuvan').html(nd);
                        jQuery('#div_kq_tuvan').addClass("active");
                        jQuery("#div_kq_tuvan #form_close").click(function () {
                            jQuery('#div_kq_tuvan .mail_thongbao').remove('');

  <section class="content_subcate mt3 mb40 cat-tab first_tab " id="tong_quan">
    
    <div class="flex list_content_subcate ck-reverse"  style="flex-direction: row-reverse">
      <div class="col-6 thumb_subcate" style="aspect-ratio:8256/5504">
        <picture>

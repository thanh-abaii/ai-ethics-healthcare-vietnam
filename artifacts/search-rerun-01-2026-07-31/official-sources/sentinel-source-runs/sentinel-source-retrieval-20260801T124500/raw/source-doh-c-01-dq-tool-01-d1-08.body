abel class\u003d\"buoi\"\u003eS\u003c/label\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e 8h \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e HN GB ctac Dược, Mỹ phẩm năm 2025 (Trần Thanh Thủy) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Thứ trưởng Thuấn \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e 270 Võ Nguyên Giáp, P. NHS \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder22122025S \"\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Thăm các cơ quan, đơn vị nhân ngày 22/12 (Trần Thanh Thủy) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Các cơ quan, đơn vị \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder22122025C \"\u003e \u003ctd id\u003d\"b_cross22122025C\" rowspan\u003d\"1\" class\u003d\"m-cell buoi-cell\" style\u003d\"background:#CFCFCF;\"\u003e \u003clabel class\u003d\"buoi\"\u003eC\u003c/label\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e 14h \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Giao ban (Trần Thanh Thủy) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e BS Trần Thanh Thủy \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e BGĐ, các TP \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e PH SYT \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e VP \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder22122025T \"\u003e \u003ctd id\u003d\"b_cross22122025T\" rowspan\u003d\"1\" class\u003d\"m-cell buoi-cell\"\u003e \u003clabel class\u003d\"buoi\"\u003eT\u003c/label\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder23122025S \"\u003e \u003ctd id\u003d\"n_cross23122025\" rowspan\u003d\"3\" class\u003d\"thungay-cell\"\u003e \u003clabel class\u003d\"thu\"\u003eThứ ba\u003c/label\u003e \u003cbr\u003e \u003clabel class\u003d\"ngay\"\u003e23/12\u003c/label\u003e \u003c/td\u003e \u003ctd id\u003d\"b_cross23122025S\" rowspan\u003d\"1\" class\u003d\"m-cell buoi-cell\"\u003e \u003clabel class\u003d\"buoi\"\u003eS\u003c/label\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e 7h30 \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Chấm điểm xếp hạng lại các đơn vị sự nghiệp YT (Trần Thanh Thủy) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e BS Trần Thanh Thủy \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Đoàn thẩm định \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e TTYT Khu vực Thanh Khê \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder23122025C \"\u003e \u003ctd id\u003d\"b_cross23122025C\" rowspan\u003d\"1\" class\u003d\"m-cell buoi-cell\" style\u003d\"background:#CFCFCF;\"\u003e \u003clabel class\u003d\"buoi\"\u003eC\u003c/label\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e 13h0 \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Chấm điểm xếp hạng lại các đơn vị sự nghiệp YT (Trần Thanh Thủy) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e BS Trần Thanh Thủy) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Đoàn thẩm định \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e TTYT Hòa Vang \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder23122025T \"\u003e \u003ctd id\u003d\"b_cross23122025T\" rowspan\u003d\"1\" class\u003d\"m-cell buoi-cell\"\u003e \u003clabel class\u003d\"buoi\"\u003eT\u003c/label\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder24122025S \"\u003e \u003ctd id\u003d\"n_cross24122025\" rowspan\u003d\"3\" class\u003d\"thungay-cell\"\u003e \u003clabel class\u003d\"thu\"\u003eThứ tư\u003c/label\u003e \u003cbr\u003e \u003clabel class\u003d\"ngay\"\u003e24/12\u003c/label\u003e \u003c/td\u003e \u003ctd id\u003d\"b_cross24122025S\" rowspan\u003d\"1\" class\u003d\"m-cell buoi-cell\"\u003e \u003clabel class\u003d\"buoi\"\u003eS\u003c/label\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e 6h30 \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Chấm điểm xếp hạng lại các đơn vị sự nghiệp YT (Trần Thanh Thủy) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e BS Trần Thanh Thủy) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Đoàn thẩm định \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e BV ĐK Quảng Nam \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder24122025C \"\u003e \u003ctd id\u003d\"b_cross24122025C\" rowspan\u003d\"1\" class\u003d\"m-cell buoi-cell\" style\u003d\"background:#CFCFCF;\"\u003e \u003clabel class\u003d\"buoi\"\u003eC\u003c/label\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder24122025T \"\u003e \u003ctd id\u003d\"b_cross24122025T\" rowspan\u003d\"1\" class\u003d\"m-cell buoi-cell\"\u003e \u003clabel class\u003d\"buoi\"\u003eT\u003c/label\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder25122025S \"\u003e \u003ctd id\u003d\"n_cross25122025\" rowspan\u003d\"4\" class\u003d\"thungay-cell\"\u003e \u003clabel class\u003d\"thu\"\u003eThứ năm\u003c/label\u003e \u003cbr\u003e \u003clabel class\u003d\"ngay\"\u003e25/12\u003c/label\u003e \u003c/td\u003e \u003ctd id\u003d\"b_cross25122025S\" rowspan\u003d\"1\" class\u003d\"m-cell buoi-cell\"\u003e \u003clabel class\u003d\"buoi\"\u003eS\u003c/label\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e 8h \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Họp về việc triển khai th/h kết luận số 221-KL/TW ngày 28/11/2025 của Bộ Chính Trị, Ban Bí Thư (Trần Thị Thủy) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e BS Trần Thanh Thủy \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Các đơn vị \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e PH SYT \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder25122025C \"\u003e \u003ctd id\u003d\"b_cross25122025C\" rowspan\u003d\"2\" class\u003d\"m-cell b
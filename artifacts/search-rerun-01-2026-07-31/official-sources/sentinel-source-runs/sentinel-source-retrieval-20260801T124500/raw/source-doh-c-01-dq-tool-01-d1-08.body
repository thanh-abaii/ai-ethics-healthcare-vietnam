" rowspan\u003d\"5\" class\u003d\"thungay-cell\"\u003e \u003clabel class\u003d\"thu\"\u003eThứ hai\u003c/label\u003e \u003cbr\u003e \u003clabel class\u003d\"ngay\"\u003e10/11\u003c/label\u003e \u003c/td\u003e \u003ctd id\u003d\"b_cross10112025S\" rowspan\u003d\"2\" class\u003d\"m-cell buoi-cell\"\u003e \u003clabel class\u003d\"buoi\"\u003eS\u003c/label\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e 8h \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e HN công bố các QĐ về thành lập TCBM và CTCB của các cơ quan, đvị trực thuộc SYT ĐN (Trần Thanh Thủy) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e BS Trần Thanh Thủy \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e BGĐ và các TP, đơn vị \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e 118 Lê Đình Lý \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder10112025S \"\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Công bố QĐ về cán bộ, Giao ban (Trương Văn Trình) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e BGĐ, các phòng \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e CDC,SYT \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder10112025C \"\u003e \u003ctd id\u003d\"b_cross10112025C\" rowspan\u003d\"2\" class\u003d\"m-cell buoi-cell\" style\u003d\"background:#CFCFCF;\"\u003e \u003clabel class\u003d\"buoi\"\u003eC\u003c/label\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Làm việc với đoàn Ttra của Ttra TP về y tế (Trương Văn Trình) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Đoàn Ttra, các phòng \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e SYT \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder10112025C \"\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e 9h30 \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Giao ban (Trần Thanh Thủy) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e BS Trần Thanh Thủy \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e BGĐ và các TP \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e PH SYT \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder10112025T \"\u003e \u003ctd id\u003d\"b_cross10112025T\" rowspan\u003d\"1\" class\u003d\"m-cell buoi-cell\"\u003e \u003clabel class\u003d\"buoi\"\u003eT\u003c/label\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder11112025S \"\u003e \u003ctd id\u003d\"n_cross11112025\" rowspan\u003d\"4\" class\u003d\"thungay-cell\"\u003e \u003clabel class\u003d\"thu\"\u003eThứ ba\u003c/label\u003e \u003cbr\u003e \u003clabel class\u003d\"ngay\"\u003e11/11\u003c/label\u003e \u003c/td\u003e \u003ctd id\u003d\"b_cross11112025S\" rowspan\u003d\"1\" class\u003d\"m-cell buoi-cell\"\u003e \u003clabel class\u003d\"buoi\"\u003eS\u003c/label\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Làm việc tại cơ quan (Trương Văn Trình) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e SYT \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder11112025C \"\u003e \u003ctd id\u003d\"b_cross11112025C\" rowspan\u003d\"2\" class\u003d\"m-cell buoi-cell\" style\u003d\"background:#CFCFCF;\"\u003e \u003clabel class\u003d\"buoi\"\u003eC\u003c/label\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Họp hội đồng xét tuyển, Hội đồng thi đua (Trương Văn Trình) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Các thành viên HĐ \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e SYT \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder11112025C \"\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e 14h \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Họp triển khai công tác KSK NVQS năm 2026 (Trần Thanh Thủy) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Đại tá Trần Hữu Ích \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e 04 Lê Duẫn \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder11112025T \"\u003e \u003ctd id\u003d\"b_cross11112025T\" rowspan\u003d\"1\" class\u003d\"m-cell buoi-cell\"\u003e \u003clabel class\u003d\"buoi\"\u003eT\u003c/label\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_hol
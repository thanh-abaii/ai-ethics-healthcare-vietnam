                .lct-grid .chucnang-head {\r\n                                    width: 70px;\r\n                                }\r\n\r\n                                .lct-grid .dabanhanh * {\r\n                                    color: #00F;\r\n                                }\u003c/style\u003e\r\n                                \u003cscript type\u003d\"text/javascript\" charset\u003d\"utf-8\"\u003e/*\u003c![CDATA[*/\r\n                                window.defaultLichCongTac \u003d 3;/*]]\u003e*/\u003c/script\u003e\r\n                                \u003cscript type\u003d\"text/javascript\" charset\u003d\"utf-8\"\r\n                                        src\u003d\"/qlvbdh-app-portlet/js/lct.js?v\u003d1.05\"\u003e\u003c/script\u003e\r\n                                \u003cdiv class\u003d\"egov-container\" style\u003d\"font-size: 13px; margin: 5px; background: transparent;\"\u003e \u003cdiv class\u003d\"lct-grid-ctn\"\u003e \u003c!-- Form grid --\u003e \u003cform id\u003d\"lct_grid_form\" action\u003d\"\" method\u003d\"post\" autocomplete\u003d\"off\"\u003e \u003ctable id\u003d\"lct_grid\" class\u003d\"lct-grid table table-bordered\"\u003e \u003cthead\u003e \u003ctr\u003e \u003cth style\u003d\"width: 7%\" colspan\u003d\"2\"\u003engày\u003c/th\u003e \u003cth style\u003d\"width: 8%\"\u003eThời gian\u003c/th\u003e \u003cth style\u003d\"width: 20%\"\u003eNội dung\u003c/th\u003e \u003cth style\u003d\"width: 15%\"\u003eChủ trì\u003c/th\u003e \u003cth style\u003d\"width: 15%\"\u003eThành phần\u003c/th\u003e \u003cth style\u003d\"width: 15%\"\u003eĐịa điểm\u003c/th\u003e \u003cth style\u003d\"width: 15%\"\u003eĐơn vị chuẩn bị\u003c/th\u003e \u003c/tr\u003e \u003c/thead\u003e \u003ctbody id\u003d\"lct_grid_body\"\u003e \u003ctr class\u003d\"r_holder14072025S \"\u003e \u003ctd id\u003d\"n_cross14072025\" rowspan\u003d\"6\" class\u003d\"thungay-cell\"\u003e \u003clabel class\u003d\"thu\"\u003eThứ hai\u003c/label\u003e \u003cbr\u003e \u003clabel class\u003d\"ngay\"\u003e14/07\u003c/label\u003e \u003c/td\u003e \u003ctd id\u003d\"b_cross14072025S\" rowspan\u003d\"3\" class\u003d\"m-cell buoi-cell\"\u003e \u003clabel class\u003d\"buoi\"\u003eS\u003c/label\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Giao ban (Trương Văn Trình) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e BGĐ, các phòng \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e SYT \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder14072025S \"\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e 8h00 \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Giao ban cơ quan SYT \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e BS Trần Thanh Thủy - GĐ \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e BGĐ, Trưởng các phòng \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e PH SYT Tầng 23 \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e VP \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder14072025S \"\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e 9h30 \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Làm việc với UBND xã Hòa Tiến (Võ Thu Tùng) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Đ/c Nguyễn Thị Anh Thi - PCT UBND TP \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e HT của UBND xã Hòa Tiến \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e KHTC, TCCB \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder14072025C \"\u003e \u003ctd id\u003d\"b_cross14072025C\" rowspan\u003d\"2\" class\u003d\"m-cell buoi-cell\" style\u003d\"background:#CFCFCF;\"\u003e \u003clabel class\u003d\"buoi\"\u003eC\u003c/label\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-ce
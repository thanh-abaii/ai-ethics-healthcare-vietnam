3eThành phần\u003c/th\u003e \u003cth style\u003d\"width: 15%\"\u003eĐịa điểm\u003c/th\u003e \u003cth style\u003d\"width: 15%\"\u003eĐơn vị chuẩn bị\u003c/th\u003e \u003c/tr\u003e \u003c/thead\u003e \u003ctbody id\u003d\"lct_grid_body\"\u003e \u003ctr class\u003d\"r_holder27102025S \"\u003e \u003ctd id\u003d\"n_cross27102025\" rowspan\u003d\"5\" class\u003d\"thungay-cell\"\u003e \u003clabel class\u003d\"thu\"\u003eThứ hai\u003c/label\u003e \u003cbr\u003e \u003clabel class\u003d\"ngay\"\u003e27/10\u003c/label\u003e \u003c/td\u003e \u003ctd id\u003d\"b_cross27102025S\" rowspan\u003d\"3\" class\u003d\"m-cell buoi-cell\"\u003e \u003clabel class\u003d\"buoi\"\u003eS\u003c/label\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e 8h \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Họp Ban Giám đốc (Trần Thanh Thủy) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e BS Trần Thanh Thủy \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e BGĐ \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e PH SYT \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e VP \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder27102025S \"\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Giao ban (Trương Văn Trình) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e BGĐ, Các phòng \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e SYT \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder27102025S \"\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e 8h30 \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Giao ban (Trần Thanh Thuỷ) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e BS Trần Thanh Thuỷ \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e BGĐ, Các phòng \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e PH SYT \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e VP \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder27102025C \"\u003e \u003ctd id\u003d\"b_cross27102025C\" rowspan\u003d\"1\" class\u003d\"m-cell buoi-cell\" style\u003d\"background:#CFCFCF;\"\u003e \u003clabel class\u003d\"buoi\"\u003eC\u003c/label\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Làm việc tại cơ quan (Trương Văn Trình) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e SYT \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder27102025T \"\u003e \u003ctd id\u003d\"b_cross27102025T\" rowspan\u003d\"1\" class\u003d\"m-cell buoi-cell\"\u003e \u003clabel class\u003d\"buoi\"\u003eT\u003c/label\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder28102025S \"\u003e \u003ctd id\u003d\"n_cross28102025\" rowspan\u003d\"3\" class\u003d\"thungay-cell\"\u003e \u003clabel class\u003d\"thu\"\u003eThứ ba\u003c/label\u003e \u003cbr\u003e \u003clabel class\u003d\"ngay\"\u003e28/10\u003c/label\u003e \u003c/td\u003e \u003ctd id\u003d\"b_cross28102025S\" rowspan\u003d\"1\" class\u003d\"m-cell buoi-cell\"\u003e \u003clabel class\u003d\"buoi\"\u003eS\u003c/label\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Làm việc tại cơ quan (Trương Văn Trình) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e SYT \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder28102025C \"\u003e \u003ctd id\u003d\"b_cross28102025C\" rowspan\u003d\"1\" class\u003d\"m-cell buoi-cell\" style\u003d\"background:#CFCFCF;\"\u003e \u003clabel class\u003d\"buoi\"\u003eC\u003c/label\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Họp trực tuyến với BYT về PYTT, PY (Trương Văn Trình) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Các ĐV liên quan \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e SYT \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder28102025T \"\u003e \u003ctd id\u003d\"b_cross28102025T\" rowspan\u003d\"1\" class\u003d\"m-cell buoi-cell\"\u003e \u003clabel class\u003d\"buoi\"\u003eT\u003c/label\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder29102025S \"\u003e \u003ctd id\u003d\"n_cross29102025\" rowspan\u003d\"4\" class\u003d\"thungay-cell\"\u003e \u003clabel class\u003d\"thu\"\u003eThứ tư\u003c/label\u003e \u003cbr\u003e \u003clabel class\u003d\"ngay\"\u003e29/10\u003c/label\u003e \u003c/td\u003e \u003ctd id\u003d\"b_cross29102025S\" rowspan\u003d\"2\" class\u003d\"m-cell buoi-cell\"\u003e \u003clabel class\u003d\"buoi\"\u003eS\u003c/label\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Họp với TTCP về nhà đất 103 Hùng Vương (Trương Văn Trình) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e VP, Đoàn TTCP \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e 103 Hùng Vương \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder29102025S \"\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e 7h \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Họp về công tác ứng phó, khắc phục hậu quả mưa lũ (Trần Thanh Thủy) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Chủ tịch Phạm Đức Ẩn \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e PH2 T2, TTHC \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder29102025C \"\u003e \u003ctd id\u003d\"b_cross29102025C\" rowspan\u003d\"1\" class\u003d\"m-cell buoi-cell\" style\u003d\"background:#CFCFCF;\"\u003e \u003clabel class\u003d\"buoi\"\u003eC\u003c/label\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Họp về TTBYT của TTYT Hòa Vang (Trương Văn Trình) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e KHTC, các ĐV \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e SYT \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder29102025T \"\u003e \u003ctd id\u003d\"b_cross29102025T\" rowspan\u003d\"1\" class\u003d\"m-cell buoi-cell\"\u003e \u003clabel class\u003d\"buoi\"\u003eT\u003c/label\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder30102025S \"\u003e \u003ctd id\u003d\"n_cross30102025\" rowspan\u003d\"4\" class\u003d\"thungay-cell\"\u003e \u003clabel class\u003d\"thu\"\u003eThứ năm\u003c/label\u003e \u003cbr\u003e \u003clabel class\u003d\"ngay\"\u003e30/10\u003c/label\u003e \u003c/td\u003e \u003ctd id\u003d\"b_cross30102025S\" rowspan\u003d\"2\" class\u003d\"m-cell buoi-cell\"\u003e \u003clabel class\u003d\"buoi\"\u003eS\u003c/label\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e 8h \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Tham dự khóa đào tạo với chủ đề \"Nâng cao năng lực cạnh tranh cho doanh nghiệp trong lĩnh vực chăm sóc thông qua cải tiến mô hình cung cấp dịch vụ hướng tới bình đẳng giới\" (Trần Thanh Thủy) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e 05 Đống Đa \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder30102025S \"\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Làm việc tại cơ quan (Trương Văn Trình) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e SYT \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder30102025C \"\u003e \u003ctd id\u003d\"b_cross30102025C\" rowspan\u003d\"1\" class\u003d\"m-cell buoi-cell\" style\u003d\"background:#CFCFCF;\"\u003e \u003clabel class\u003d\"buoi\"\u003eC\u003c/label\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Làm việc tại cơ quan (Trương Văn Trình) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e SYT \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder30102025T \"\u003e \u003ctd id\u003d\"b_cross30102025T\" rowspan\u003d\"1\" class\u003d\"m-cell buoi-cell\"\u003e \u003clabel class\u003d\"buoi\"\u003eT\u003c/label\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder31102025S \"\u003e \u003ctd id\u003d\"n_cross31102025\" rowspan\u003d\"5\" class\u003d\"thungay-cell\"\u003e \u003clabel class\u003d\"thu\"\u003eThứ sáu\u003c/label\u003e \u003cbr\u003e \u003clabel class\u003d\"ngay\"\u003e31/10\u003c/label\u003e \u003c/td\u003e \u003ctd id\u003d\"b_cross31102025S\" rowspan\u003d\"3\" class\u003d\"m-cell buoi-cell\"\u003e \u003clabel class\u003d\"buoi\"\u003eS\u003c/label\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e 8h \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Họp chuẩn bị cho công tác tổ chức Hội nghị điển hình tiên tiến ngành Y tế Đà Nẵng (Trần Thanh Thủy) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e BS Trần Thanh Thủy \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e TCCB và cá
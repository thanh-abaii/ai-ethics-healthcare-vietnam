clearfix:after{content:\".\";display:block;clear:both;visibility:hidden;line-height:0;height:0;}html .clearfix{display:block;}* html .clearfix{height:1%;}.clear{clear:both;}.left{float:left;}.right{float:right;}.egov-button-normal.disabled,.egov-button-normal[disabled],.egov-button-normal.disabled:hover,.egov-button-normal[disabled]:hover,.egov-button.disabled,.egov-button[disabled],.egov-button.disabled:hover,.egov-button[disabled]:hover{background-color:#A7A7A7;cursor:default;}.header{border-bottom:1px solid #DDD;}.header .header-elem{padding:5px 0;}.header .header-elem.left{padding-left:10px;}.header .header-elem.right{padding-right:10px;}.header .title{font-size:18px;padding-top:8px;text-transform:uppercase;}.lct-filter .egov-select{width:auto;height:;}.lct-filter .filter-item{display:inline-block;margin:10px 3px;}#egov-content-container table.lct-grid{background-color:#FFF;border-spacing:0;border-collapse:collapse;padding:5px 0;width:100%;}.lct-grid th{text-align:center;background-color:#F1F3FF;padding:5px 0;}.lct-grid td,.lct-grid th{border:1px solid #CCC;}.lct-grid td{vertical-align:middle;}.lct-grid .txt-input-cell{cursor:text;padding:1px 3px 0;text-align:center;vertical-align:top;}.lct-grid .txt-input{border:0 none;width:98%;height:20px;line-height:20px;resize:none;}.lct-grid .thu,.lct-grid .ngay{font-weight:bold;}.lct-grid .m-cell{padding:3px 3px 0;text-align:center;}.lct-grid .highlight{font-weight:normal;background-color:#EDFFDE;}.lct-grid .thungay-cell{background-color:#FFF;width:60px;}.lct-grid .noidung-cell{width:30%;}.lct-grid .noidung-head{width:30%;}.lct-grid .chucnang-head{width:70px;}.lct-grid .dabanhanh *{color:#00F;}\u003c/style\u003e \u003cscript type\u003d\"text/javascript\" charset\u003d\"utf-8\"\u003e/*\u003c![CDATA[*/window.defaultLichCongTac\u003d3;/*]]\u003e*/\u003c/script\u003e \u003cscript type\u003d\"text/javascript\" charset\u003d\"utf-8\" src\u003d\"/qlvbdh-app-portlet/js/lct.js?v\u003d1.05\"\u003e\u003c/script\u003e \u003cdiv class\u003d\"egov-container\" style\u003d\"font-size: 13px; margin: 5px; background: transparent;\"\u003e \u003cdiv class\u003d\"lct-grid-ctn\"\u003e \u003c!-- Form grid --\u003e \u003cform id\u003d\"lct_grid_form\" action\u003d\"\" method\u003d\"post\" autocomplete\u003d\"off\"\u003e \u003ctable id\u003d\"lct_grid\" class\u003d\"lct-grid\"\u003e \u003cthead\u003e \u003ctr\u003e \u003cth style\u003d\"width: 7%\"colspan\u003d\"2\"\u003engày\u003c/th\u003e \u003cth style\u003d\"width: 8%\"\u003eThời gian\u003c/th\u003e \u003cth style\u003d\"width: 20%\"\u003eNội dung\u003c/th\u003e \u003cth style\u003d\"width: 15%\"\u003eChủ trì\u003c/th\u003e \u003cth style\u003d\"width: 15%\"\u003eThành phần\u003c/th\u003e \u003cth style\u003d\"width: 15%\"\u003eĐịa điểm\u003c/th\u003e \u003cth style\u003d\"width: 15%\"\u003eĐơn vị chuẩn bị\u003c/th\u003e \u003c/tr\u003e \u003c/thead\u003e \u003ctbody id\u003d\"lct_grid_body\"\u003e \u003ctr class\u003d\"r_holder29122025S \"\u003e \u003ctd id\u003d\"n_cross29122025\" rowspan\u003d\"5\" class\u003d\"thungay-cell\"\u003e \u003clabel class\u003d\"thu\"\u003eThứ hai\u003c/label\u003e \u003cbr\u003e \u003clabel class\u003d\"ngay\"\u003e29/12\u003c/label\u003e \u003c/td\u003e \u003ctd id\u003d\"b_cross29122025S\" rowspan\u003d\"2\" class\u003d\"m-cell buoi-cell\"\u003e \u003clabel class\u003d\"buoi\"\u003eS\u003c/label\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Làm việc tại cơ quan (Trương Văn Trình) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e SYT \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder29122025S \"\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e 8h \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Tham dự cuộc họp nghe báo cáo tình hình giải ngân KH vốn trong năm 2025 và KH vốn đầu tư công năm 2026 (Trần Thanh Thủy) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Chủ tịch UBND \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e HT1T2, TTHC \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder29122025C \"\u003e \u003ctd id\u003d\"b_cross29122025C\" rowspan\u003d\"2\" class\u003d\"m-cell buoi-cell\" style\u003d\"background:#CFCFCF;\"\u003e \u003clabel class\u003d\"buoi\"\u003eC\u003c/label\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Họp trực tuyến tổng kết ngành (Trương Văn Trình) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e BGĐ, Các phòng \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e TTHC \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder29122025C \"\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e 14h \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e HN lần thứ 2 BCH Đảng bộ UBND TP (Trần Thanh Thủy) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e HT1 T2, TTHC \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder29122025T \"\u003e \u003ctd id\u003d\"b_cross29122025T\" rowspan\u003d\"1\" class\u003d\"m-cell buoi-cell\"\u003e \u003clabel class\u003d\"buoi\"\u003eT\u003c/label\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder30122025S \"\u003e \u003ctd id\u003d\"n_cross30122025\" rowspan\u003d\"5\" class\u003d\"thungay-cell\"\u003e \u003clabel class\u003d\"thu\"\u003eThứ ba\u003c/label\u003e \u003cbr\u003e \u003clabel class\u003d\"ngay\"\u003e30/12\u003c/label\u003e \u003c/td\u003e \u003ctd id\u003d\"b_cross30122025S\" rowspan\u003d\"2\" class\u003d\"m-cell buoi-cell\"\u003e \u003clabel class\u003d\"buoi\"\u003eS\u003c/label\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Dự hội nghị tổng kết năm 2025, của BVTT (Trương Văn Trình) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e BVTT \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder30122025S \"\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e 8h \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Tham dự phiên họp UBND thành phố (Trần Thanh Thủy) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e HT1 T2, TTHC \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder30122025C \"\u003e \u003ctd id\u003d\"b_cross30122025C\" rowspan\u003d\"2\" class\u003d\"m-cell buoi-cell\" style\u003d\"background:#CFCFCF;\"\u003e \u003clabel class\u003d\"buoi\"\u003eC\u003c/label\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Họp với UBNDTP về bệnh viện chất lượng cao (Trương Văn Trình) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e KHTC \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e TTHC \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder30122025C \"\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e 16h \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Hn khoá sổ thu, chi NSNN tp năm 2025 và triển khai NV NSNN năm 2026 (Trần Thanh Thủy) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e 14 Lý Tự Trọng \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder30122025T \"\u003e \u003ctd id\u003d\"b_cross30122025T\" rowspan\u003d\"1\" class\u003d\"m-cell buoi-cell\"\u003e \u003clabel class\u003d\"buoi\"\u003eT\u003c/label\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder31122025S \"\u003e \u003ctd id\u003d\"n_cross31122025\" rowspan\u003d\"5\" class\u003d\"thungay-cell\"\u003e \u003clabel class\u003d\"thu\"\u003eThứ tư\u003c/label\u003e \u003cbr\u003e \u003clabel class\u003d\"ngay\"\u003e31/12\u003c/label\u003e \u003c/td\u003e \u003ctd id\u003d\"b_cross31122025S\" rowspan\u003d\"2\" class\u003d\"m-cell buoi-cell\"\u003e \u003clabel class\u003d\"buoi\"\u003eS\u003c/label\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Làm việc tại cơ quan (Trương Văn Trình) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e SYT \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder31122025S \"\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e 8h30 \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Giao ban (Trần Thanh Thủy) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Bs Trần Thanh Thủy \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e BGĐ, các TP \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e PH SYT \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e VP \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder31122025C \"\u003e \u003ctd id\u003d\"b_cross31122025C\" rowspan\u003d\"2\" class\u003d\"m-cell buoi-cell\" style\u003d\"background:#CFCFCF;\"\u003e \u003clabel class\u003d\"buoi\"\u003eC\u003c/label\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Dự hội nghị tổng kết năm 2025 của BVPSNĐN (Trương Văn Trình) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e BVPSNĐN \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder31122025C \"\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e 14h \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Tham dự phiên họp UBND thành phố (Trần Thanh Thủy) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e HT1 T2, TTHC \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \
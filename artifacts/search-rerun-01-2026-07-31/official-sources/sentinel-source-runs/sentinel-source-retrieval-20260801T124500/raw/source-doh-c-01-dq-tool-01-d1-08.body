\n                                    border-collapse: collapse;\r\n                                    padding: 5px 0;\r\n                                    width: 100%;\r\n                                }\r\n\r\n                                .lct-grid th {\r\n                                    text-align: center;\r\n                                    background-color: #F1F3FF;\r\n                                    padding: 5px 0;\r\n                                }\r\n\r\n                                .lct-grid td, .lct-grid th {\r\n                                    border: 1px solid #CCC;\r\n                                }\r\n\r\n                                .lct-grid td {\r\n                                    vertical-align: middle;\r\n                                }\r\n\r\n                                .lct-grid .txt-input-cell {\r\n                                    cursor: text;\r\n                                    padding: 1px 3px 0;\r\n                                    text-align: center;\r\n                                    vertical-align: top;\r\n                                }\r\n\r\n                                .lct-grid .txt-input {\r\n                                    border: 0 none;\r\n                                    width: 98%;\r\n                                    height: 20px;\r\n                                    line-height: 20px;\r\n                                    resize: none;\r\n                                }\r\n\r\n                                .lct-grid .thu, .lct-grid .ngay {\r\n                                    font-weight: bold;\r\n                                }\r\n\r\n                                .lct-grid .m-cell {\r\n                                    padding: 3px 3px 0;\r\n                                    text-align: center;\r\n                                }\r\n\r\n                                .lct-grid .highlight {\r\n                                    font-weight
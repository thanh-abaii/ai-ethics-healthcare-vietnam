\"\u003e BGĐ và các Trưởng phòng \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e PH SYT \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e VP \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder24112025S \"\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Giao ban (Trương Văn Trình) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e BGĐ, các phòng \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e SYT \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder24112025C \"\u003e \u003ctd id\u003d\"b_cross24112025C\" rowspan\u003d\"2\" class\u003d\"m-cell buoi-cell\" style\u003d\"background:#CFCFCF;\"\u003e \u003clabel class\u003d\"buoi\"\u003eC\u003c/label\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Làm việc tại cơ quan (Trương Văn Trình) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e SYT \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder24112025C \"\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Làm việc tại cơ quan (Trần Thanh Thủy) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e SYT \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder24112025T \"\u003e \u003ctd id\u003d\"b_cross24112025T\" rowspan\u003d\"1\" class\u003d\"m-cell buoi-cell\"\u003e \u003clabel class\u003d\"buoi\"\u003eT\u003c/label\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder25112025S \"\u003e \u003ctd id\u003d\"n_cross25112025\" rowspan\u003d\"6\" class\u003d\"thungay-cell\"\u003e \u003clabel class\u003d\"thu\"\u003eThứ ba\u003c/label\u003e \u003cbr\u003e \u003clabel class\u003d\"ngay\"\u003e25/11\u003c/label\u003e \u003c/td\u003e \u003ctd id\u003d\"b_cross25112025S\" rowspan\u003d\"3\" class\u003d\"m-cell buoi-cell\"\u003e \u003clabel class\u003d\"buoi\"\u003eS\u003c/label\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Họp trực tuyến về CLBV (Trương Văn Trình) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e NVY \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e BVUB \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder25112025S \"\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e 08:00 \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Hội thảo \"Phát triển Công nghiệp Công nghệ số: Thực thi chính sách và tạo động lực tăng trưởng mới\" tại TP Đà Nẵng (163038) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Tham dự \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Mường Thanh Grand, 962 Ngô Quyền, p An Hải, tp Đà Nẵng \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder25112025S \"\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e 8h \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Tháp tùng LĐ TP trao quà khắc phục hậu quả thiên tai (Trần Thanh Thủy) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e GĐ, PGĐ Nhi, BTXH ,NVY \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e TTYT kv Bắc Trà My Xã Lãnh Ngọc \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder25112025C \"\u003e \u003ctd id\u003d\"b_cross25112025C\" rowspan\u003d\"2\" class\u003d\"m-cell buoi-cell\" style\u003d\"background:#CFCFCF;\"\u003e \u003clabel class\u003d\"buoi\"\u003eC\u003c/label\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Làm việc tại cơ quan (Trương Văn Trình) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e SYT \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder25112025C \"\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Làm việc tại cơ quan (Trần Thanh Thủy) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder25112025T \"\u003e \u003ctd id\u003d\"b_cross25112025T\" rowspan\u003d\"1\" class\u003d\"m-cell buoi-cell\"\u003e \u003clabel class\u003d\"buoi\"\u003eT\u003c/label\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder26112025S \"\u003e \u003ctd id\u003d\"n_cross26112025\" rowspan\u003d\"7\" class\u003d\"thungay-cell\"\u003e \u003clabel class\u003d\"thu\"\u003eThứ tư\u003c/label\u003e \u003cbr\u003e \u003clabel class\u003d\"ngay\"\u003e26/11\u003c/label\u003e \u003c/td\u003e \u003ctd id\u003d\"b_cross26112025S\" rowspan\u003d\"3\" class\u003d\"m-cell buoi-cell\"\u003e \u003clabel class\u003d\"buoi\"\u003eS\u003c/label\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Họp với HĐND về đơn của BVCLC Gia đình (Trương Văn Trình) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e HĐNDTP \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder26112025S \"\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e 08:00 \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Hội thảo Nâng cao năng lực mạng lưới truyền thông - giáo dục sức khỏe năm 2025 (163038) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e tham dự \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Trường Sơn Tùng 2 - 7 Hà Bổng, p An Hải, TP Đà Nẵng \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder26112025S \"\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e 8h \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Hội thảo Nâng cao năng lực mạng lưới truyền thông - giáo dục sức khỏe năm 2025 (Trần Thanh Thủy) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e KS Trường Sơn Tùng 2, 07 Hà Bổng, p An Hải, TP Đà Nẵng \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder26112025C \"\u003e \u003ctd id\u003d\"b_cross26112025C\" rowspan\u003d\"3\" class\u003d\"m-cell buoi-cell\" style\u003d\"background:#CFCFCF;\"\u003e \u003clabel class\u003d\"buoi\"\u003eC\u003c/label\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Làm việc tại cơ quan (Trương Văn Trình) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e SYT \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder26112025C \"\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e 14:30 \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Họp thẩm định quy hoạch Phân khu xây dựng Khu du lịch khu vực Khe Răm thuộc phân khu sinh thái phía tây, TL 1/2000 (163038) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Thành viên Hội đồng \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Phòng họp Giao ban Tầng 3 TTHC \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder26112025C \"\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e 14h \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e khảo sát thực tế các dự án (D/án đầu tư xd Cải tạo và bổ sung TTB BV PSN Đà Nẵng) (Trần Thanh Thủy) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e BV Phụ sản Nhi ĐN \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder26112025T \"\u003e \u003ctd id\u003d\"b_cross26112025T\" rowspan\u003d\"1\" class\u003d\"m-cell buoi-cell\"\u003e \u003clabel class\u003d\"buoi\"\u003eT\u003c/label\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder27112025S \"\u003e \u003ctd id\u003d\"n_cross27112025\" rowspan\u003d\"4\" class\u003d\"thungay-cell\"\u003e \u003clabel class\u003d\"thu\"\u003eThứ năm\u003c/label\u003e \u003cbr\u003e \u003clabel class\u003d\"ngay\"\u003e27/11\u003c/label\u003e \u003c/td\u003e \u003ctd id\u003d\"b_cross27112025S\" rowspan\u003d\"2\" class\u003d\"m-cell buoi-cell\"\u003e \u003clabel class\u003d\"buoi\"\u003eS\u003c/label\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e 8h \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Lễ bàn giao xe cấp cứu và TTB do Tập đoàn Vingroup tài trợ (Trần Thanh Thủy) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e BGĐ, Các phòng \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e TTCC \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder27112025S \"\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Dự buổi Ktra ĐTBB, lễ bàn giao xe Cấp Cứu (Trương Văn Trình) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e BGĐ, Các phòng \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e BVTT, TTCC \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder27112025C \"\u003e \u003ctd id\u003d\"b_cross27112025C\" rowspan\u003d\"1\" class\u003d\"m-cell buoi-cell\" style\u003d\"background:#CFCFCF;\"\u003e \u003clabel class\u003d\"buoi\"\u003eC\u003c/label\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Làm việc tại cơ quan (Trương Văn Trình) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e SYT \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder27112025T \"\u003e \u003ctd id\u003d\"b_cross27112025T\" rowspan\u003d\"1\" class\u003d\"m-cell buoi-cell\"\u003e \u003clabel class\u003d\"buoi\"\u003eT\u003c/label\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder28112025S \"\u003e \u003ctd id\u003d\"n_cross28112025\" rowspan\u003d\"6\" class\u003d\"thungay-cell\"\u003e \u003clabel class\u003d\"thu\"\u003eThứ sáu\u003c/label\u003e \u003cbr\u003e \u003clabel class\u003d\"ngay\"\u003e28/11\u003c/label\u003e \u003c/td\u003e \u003ctd id\u003d\"b_cross28112025S\" rowspan\u003d\"4\" class\u003d\"m-cell buoi-cell\"\u003e \u003clabel class\u003d\"buoi\"\u003eS\u003c/label\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e 8h \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e HN Mạng lưới CS Trẻ sinh non bằng phương pháp Kangaroo khu vực Châu Á - Châu Đại Dương lần thứ 3 (Trần Thanh Thủy) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e CDC \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder28112025S \"\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e 14h \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Lễ Khai trương Phòng Nuôi con bằng sữa mẹ Nhà ga hành khách T1, Cảng hàng không QT ĐN (Trần Thanh Thủy) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Nhà ga hành khách T1, cảng KH QT ĐN \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder28112025S \"\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e 16h \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Cùng Lãnh đạo Cục Phòng bệnh thăm Ngân hàng sữa mẹ (Trần Thanh Thủy) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e BV PSN Đà Nẵng \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder28112025S \"\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Ktra CLXN (Trương Văn Trình) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Đoàn Ktra \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e BVGĐ \u003c/td\u003e \u003ctd class\u003d\"txt-input-c
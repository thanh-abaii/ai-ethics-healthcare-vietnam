el class\u003d\"buoi\"\u003eS\u003c/label\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e 08:00 \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Làm việc với Đoàn giám sát Ban VHXH HĐND (Võ Thu Tùng) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Trưởng ban VHXN, HĐND \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Báo cáo \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e HĐND tp Đà Nẵng, 32 Bạch Đằng \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Sở Y tế \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder20112025S \"\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e 8h \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Đoàn gs TT HĐND tp làm việc với SYT về th/h các qđ của pl về ctac q/lý và tổ chức hđ của các cs KCB tư nhân (Trần Thanh Thủy) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e BGĐ, Các phòng \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e 32 Bạch Đằng \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder20112025S \"\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Làm việc với HĐND về BVTN (Trương Văn Trình) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e BGĐ, Các phòng \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e HĐNDTP \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder20112025C \"\u003e \u003ctd id\u003d\"b_cross20112025C\" rowspan\u003d\"4\" class\u003d\"m-cell buoi-cell\" style\u003d\"background:#CFCFCF;\"\u003e \u003clabel class\u003d\"buoi\"\u003eC\u003c/label\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e 14:00 \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Thăm Sở GD\u0026ĐT và Trường Đại học KTYD (Võ Thu Tùng) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e LĐ và chuyên viên \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Sở GD\u0026ĐT, Trường ĐHKTYD \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Sở Y tế \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder20112025C \"\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e 15:30:00 \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Kỷ niệm 43 năm ngày Nhà giáo Việt Nam - Trường Đại học KTYD Đà Nẵng (Võ Thu Tùng) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Hiệu trưởng Trường ĐHKTYD \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Tham dự \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e King Garden, 456A Nguyễn Tri Phương, TPĐN \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Trường ĐHKTYD \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder20112025C \"\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e 15h30 \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e KN 43 năm Ngày Nhà giáo Việt Nam (Trần Thanh Thủy) (Trường ĐH Kỹ thuật Y - Dược Đà Nẵng) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e 456A Nguyễn Tri Phương \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder20112025C \"\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Làm việc tại cơ quan (Trương Văn Trình) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e SYT \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder20112025T \"\u003e \u003ctd id\u003d\"b_cross20112025T\" rowspan\u003d\"1\" class\u003d\"m-cell buoi-cell\"\u003e \u003clabel class\u003d\"buoi\"\u003eT\u003c/label\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder21112025S \"\u003e \u003ctd id\u003d\"n_cross21112025\" rowspan\u003d\"6\" class\u003d\"thungay-cell\"\u003e \u003clabel class\u003d\"thu\"\u003eThứ sáu\u003c/label\u003e \u003cbr\u003e \u003clabel class\u003d\"ngay\"\u003e21/11\u003c/label\u003e \u003c/td\u003e \u003ctd id\u003d\"b_cross21112025S\" rowspan\u003d\"3\" class\u003d\"m-cell buoi-cell\"\u003e \u003clabel class\u003d\"buoi\"\u003eS\u003c/label\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e 07:30 \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Hội thảo \"Xây dựng Đề án chuyển đổi số góp phần thúc đẩy, tạo động lực góp phần phát triển Kinh tế - Xã hội TP Đà Nẵng - Thành phố đổi mới sáng tạo\" (163038) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Tham dự \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e HT 1 tầng 2 TTHC \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder21112025S \"\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e 7h30 \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e HN công bố các QĐ về công tác cán bộ (Trần Thanh Thủy) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e BGĐ; Các Trưởng, Phó phòng \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e 72 Bạch Đằng \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder21112025S \"\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Hội đồng GĐYK (Trương Văn Trình) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Hội đồng \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e TTGĐYK \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder21112025C \"\u003e \u003ctd id\u003d\"b_cross21112025C\" rowspan\u003d\"2\" class\u003d\"m-cell buoi-cell\" style\u003d\"background:#CFCFCF;\"\u003e \u003clabel class\u003d\"buoi\"\u003eC\u003c/label\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e 14:00 \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Hội thảo \"Giải pháp thông minh cho Kỷ nguyên số - Hybrid Connect 2025\" (163038) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Tham dự \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e 270 Võ Nguyên Giáp, p NHS, TP Đà Nẵng \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder21112025C \"\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Làm việc tại cơ quan (Trương Văn Trình) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e SYT \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder21112025T \"\u003e \u003ctd id\u003d\"b_cross21112025T\" rowspan\u003d\"1\" class\u003d\"m-cell buoi-cell\"\u003e \u003clabel class\u003d\"buoi\"\u003eT\u003c/label\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder22112025S \"\u003e \u003ctd id\u003d\"n_cross22112025\" rowspan\u003d\"4\" class\u003d\"thungay-cell\"\u003e \u003clabel class\u003d\"thu\"\u003eThứ bảy\u003c/label\u003e \u003cbr\u003e \u003clabel class\u003d\"ngay\"\u003e22/11\u003c/label\u003e \u003c/td\u003e \u003ctd id\u003d\"b_cross22112025S\" rowspan\u003d\"2\" class\u003d\"m-cell buoi-cell\"\u003e \u003clabel class\u003d\"buoi\"\u003eS\u003c/label\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e 08:00 \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Liên hoan nghệ thuật quần chúng VC-LĐ TTYT khu vực Thanh Khế (163038) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Ban giám khảo \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e 36 Đỗ Ngọc Du, p Thanh Khê, tp Đà Nẵng \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder22112025S \"\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Làm việc với các BVCK (Trương Văn Trình) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Các phòng, BV \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Tam Kỳ \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \
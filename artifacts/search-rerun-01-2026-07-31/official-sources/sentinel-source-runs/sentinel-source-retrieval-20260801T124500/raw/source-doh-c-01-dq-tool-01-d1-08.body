3c/tr\u003e \u003c/thead\u003e \u003ctbody id\u003d\"lct_grid_body\"\u003e \u003ctr class\u003d\"r_holder21042025S \"\u003e \u003ctd id\u003d\"n_cross21042025\" rowspan\u003d\"3\" class\u003d\"thungay-cell\"\u003e \u003clabel class\u003d\"thu\"\u003eThứ hai\u003c/label\u003e \u003cbr\u003e \u003clabel class\u003d\"ngay\"\u003e21/04\u003c/label\u003e \u003c/td\u003e \u003ctd id\u003d\"b_cross21042025S\" rowspan\u003d\"1\" class\u003d\"m-cell buoi-cell\"\u003e \u003clabel class\u003d\"buoi\"\u003eS\u003c/label\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Giao ban (Trương Văn Trình) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Các phòng, BGĐ \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e SYT \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder21042025C \"\u003e \u003ctd id\u003d\"b_cross21042025C\" rowspan\u003d\"1\" class\u003d\"m-cell buoi-cell\" style\u003d\"background:#CFCFCF;\"\u003e \u003clabel class\u003d\"buoi\"\u003eC\u003c/label\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Họp tổ thẩm định nhu cầu thuốc BDG, Xây dựng các TYT (Trương Văn Trình) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Các phòng LQ, Tổ thẩm định \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e SYT \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder21042025T \"\u003e \u003ctd id\u003d\"b_cross21042025T\" rowspan\u003d\"1\" class\u003d\"m-cell buoi-cell\"\u003e \u003clabel class\u003d\"buoi\"\u003eT\u003c/label\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d
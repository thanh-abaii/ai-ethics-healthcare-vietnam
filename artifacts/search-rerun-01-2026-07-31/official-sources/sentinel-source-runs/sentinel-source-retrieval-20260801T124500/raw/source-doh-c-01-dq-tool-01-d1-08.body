</script>
<script>
    const pageSize = 5;
    let currentPage = 1;

    function renderPagination(totalPages) {
        let html = '';

        const prevPage = Math.max(currentPage - 1, 1);
        const nextPage = Math.min(currentPage + 1, totalPages);

        html += '<li class="page-item ' + (currentPage === 1 ? 'disabled' : '') + '">' +
            '<a class="page-link" href="#" onclick="changePage(' + prevPage + ')">Trước</a>' +
            '</li>';

        for (let i = 1; i <= totalPages; i++) {
            html += '<li class="page-item ' + (i === currentPage ? 'active' : '') + '">' +
                '<a class="page-link" href="#" onclick="changePage(' + i + ')">' + i + '</a>' +
                '</li>';
        }

        html += '<li class="page-item ' + (currentPage === totalPages ? 'disabled' : '') + '">' +
            '<a class="page-link" href="#" onclick="changePage(' + nextPage + ')">Sau</a>' +
            '</li>';

        document.getElementById('pagination').innerHTML = html;
    }

    function renderList() {
        const container = document.getElementById('lich-cong-tac-khac-wrapper');
        const start = (currentPage - 1) * pageSize;
        const end = start + pageSize;

        const filtered = lichCongTacList.filter(function(item) {
            const ma = item.ma;
            const week = parseInt(ma.slice(-2));
            return week !== 31;
        });

        const totalPages = Math.ceil(filtered.length / pageSize);
        const pagedItems = filtered.slice(start, end);

        let html = '<ul class="list-unstyled">';
        pagedItems.forEach(function(item) {
            const ma = item.ma;
            const week = parseInt(ma.slice(-2));
            const yearAndWeek = ma.slice(-6);
            const year = yearAndWeek.slice(0, 4)

            html += '<li class="mb-2">' +
                '<a class="lich-tuan-khac d-block text-primary" style="font-weight: 500; font-size: 16px;" ' +
                'href="?tuan=' + week + '">' +
                'Lịch công tác tuần ' + week + ' năm ' + year +
                '</a>' +
                '</li>';
        });
        html += '</ul>';

        container.innerHTML = html;
        renderPagination(totalPages);
    }

    function changePage(page) {
        currentPage = page;
        renderList();
    }

    renderList();
</script>






	
	

					
				
			
		
	
	



	

			
		
	

	

		
		
	







	







                       }\r\n\r\n                                .lct-grid td, .lct-grid th {\r\n                                    border: 1px solid #CCC;\r\n                                }\r\n\r\n                                .lct-grid td {\r\n                                    vertical-align: middle;\r\n                                }\r\n\r\n                                .lct-grid .txt-input-cell {\r\n                                    cursor: text;\r\n                                    padding: 1px 3px 0;\r\n                                    text-align: center;\r\n                                    vertical-align: top;\r\n                                }\r\n\r\n                                .lct-grid .txt-input {\r\n                                    border: 0 none;\r\n                                    width: 98%;\r\n                                    height: 20px;\r\n                                    line-height: 20px;\r\n                                    resize: none;\r\n                                }\r\n\r\n                                .lct-grid .thu, .lct-grid .ngay {\r\n                                    font-weight: bold;\r\n                                }\r\n\r\n                                .lct-grid .m-cell {\r\n                                    padding: 3px 3px 0;\r\n                                    text-align: center;\r\n                                }\r\n\r\n                                .lct-grid .highlight {\r\n                                    font-weight: normal;\r\n                                    background-color: #EDFFDE;\r\n                                }\r\n\r\n                                .lct-grid .thungay-cell {\r\n                                    background-color: #FFF;\r\n                                    width: 60px;\r\n                                }\r\n\r\n                                .lct-grid .noidung-cell {\r\n                                    width: 30%;\r\n                                }\r\n\r\n                                .lct-grid .noidung-head {\r\n                                    width: 30%;\r\n                                }\r\n\r\n                                .lct-grid .chucnang-head {\r\n                                    width: 70px;\r\n                                }\r\n\r\n                                .lct-grid .dabanhanh * {\r\n                                    color: #00F;\r\n                                }\u003c/style\u003e\r\n                                \u003cscript type\u003d\"text/javascript\" charset\u003d\"utf-8\"\u003e/*\u003c![CDATA[*/\r\n                                window.defaultLichCongTac \u003d 3;/*]]\u003e*/\u003c/script\u003e\r\n                                \u003cscript type\u003d\"text/javascript\" charset\u003d\"utf-8\"\r\n                                        src\u003d\"/qlvbdh-app-portlet/js/lct.js?v\u003d1.05\"\u003e\u003c/script\u003e\r\n                                \u003cdiv class\u003d\"egov-container\" style\u003d\"font-size: 13px; margin: 5px; background: transparent;\"\u003e \u003cdiv class\u003d\"lct-grid-ctn\"\u003e \u003c!-- Form grid --\u003e \u003cform id\u003d\"lct_grid_form\" action\u003d\"\" method\u003d\"post\" autocomplete\u003d\"off\"\u003e \u003ctable id\u003d\"lct_grid\" class\u003d\"lct-grid table table-bordered\"\u003e \u003cthead\u003e \u003ctr\u003e \u003cth style\u003d\"width: 7%\" colspan\u003d\"2\"\u003engày\u003c/th\u003e \u003cth style\u003d\"width: 8%\"\u003eThời gian\u003c/th\u003e \u003cth style\u003d\"width: 20%\"\u003eNội dung\u003c/th\u003e \u003cth style\u003d\"width: 15%\"\u003eChủ trì\u003c/th\u003e \u003cth style\u003d\"width: 15%\"\u003eThành phần\u003c/th\u003e \u003cth style\u003d\"width: 15%\"\u003eĐịa điểm\u003c/th\u003e \u003cth style\u003d\"width: 15%\"\u003eĐơn vị chuẩn bị\u003c/th\u003e \u003c/tr\u003e \u003c/thead\u003e \u003ctbody id\u003d\"lct_grid_body\"\u003e \u003ctr class\u003d\"r_holder03032025S \"\u003e \u003ctd id\u003d\"n_cross03032025\" rowspan\u003d\"5\" class\u003d\"thungay-cell\"\u003e \u003clabel class\u003d\"thu\"\u003eThứ hai\u003c/label\u003e \u003cbr\u003e \u003clabel class\u003d\"ngay\"\u003e03/03\u003c/label\u003e \u003c/td\u003e \u003ctd id\u003d\"b_cross03032025S\" rowspan\u003d\"2\" class\u003d\"m-cell buoi-cell\"\u003e \u003clabel class\u003d\"buoi\"\u003eS\u003c/label\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e 9h30 \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Giao ban (Trần Thanh Thủy) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e BGĐ, Các phòng \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e PH SYT \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder03032025S \"\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Giao ban (Trương Văn Trình) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e BGĐ, các phòng \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e SYT \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder03032025C \"\u003e \u003ctd id\u003d\"b_cross03032025C\" rowspan\u003d\"2\" class\u003d\"m-cell buoi-cell\" style\u003d\"background:#CFCFCF;\"\u003e \u003clabel class\u003d\"buoi\"\u003eC\u003c/label\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Làm việc tại cơ quan (Trần Thanh Thủy) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Phòng làm việc \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder03032025C \"\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Làm việc tại cơ quan (Trương Văn Trình) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e SYT \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder03032025T \"\u003e \u003ctd id\u003d\"b_cross03032025T\" rowspan\u003d\"1\" class\u003d\"m-cell buoi-cell\"\u003e \u003clabel class\u003d\"buoi\"\u003eT\u003c/label\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder04032025S \"\u003e \u003ctd id\u003d\"n_cross04032025\" rowspan\u003d\"5\" class\u003d\"thungay-cell\"\u003e \u003clabel class\u003d\"thu\"\u003eThứ ba\u003c/label\u003e \u003cbr\u003e \u003clabel class\u003d\"ngay\"\u003e04/03\u003c/label\u003e \u003c/td\u003e \u003ctd id\u003d\"b_cross04032025S\" rowspan\u003d\"2\" class\u003d\"m-cell buoi-cell\"\u003e \u003clabel class\u003d\"buoi\"\u003eS\u003c/label\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e 8h00 \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Họp với CT UBND TP về việc tiếp nhận các nội dung liên quan đến LĐTBXH (Trần Thanh Thủy) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e PHGBT3 \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder04032025S \"\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Làm việc với UBND về vướng mắc khi bàn giao TT05-06 (Trương Văn Trình) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e UBND, các thành phần liên quan \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e TTHC \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder04032025C \"\u003e \u003ctd id\u003d\"b_cross04032025C\" rowspan\u003d\"2\" class\u003d\"m-cell buoi-cell\" style\u003d\"background:#CFCFCF;\"\u003e \u003clabel class\u003d\"buoi\"\u003eC\u003c/label\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Làm việc tại cơ quan (Trần Thanh Thủy) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Phòng làm việc \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder04032025C \"\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Họp về đấu thầu thuốc nhóm 3 của tổ lập KHĐT (Trương Văn Trình) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Tổ Lập KHĐT \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e SYT \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder04032025T \"\u003e \u003ctd id\u003d\"b_cross04032025T\" rowspan\u003d\"1\" class\u003d\"m-cell buoi-cell\"\u003e \u003clabel class\u003d\"buoi\"\u003eT\u003c/label\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder05032025S \"\u003e \u003ctd id\u003d\"n_cross05032025\" rowspan\u003d\"5\" class\u003d\"thungay-cell\"\u003e \u003clabel class\u003d\"thu\"\u003eThứ tư\u003c/label\u003e \u003cbr\u003e \u003clabel class\u003d\"ngay\"\u003e05/03\u003c/label\u003e \u003c/td\u003e \u003ctd id\u003d\"b_cross05032025S\" rowspan\u003d\"2\" class\u003d\"m-cell buoi-cell\"\u003e \u003clabel class\u003d\"buoi\"\u003eS\u003c/label\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Làm việc tại cơ quan (Trần Thanh Thủy) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Phòng làm việc \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder05032025S \"\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Làm việc tại cơ quan (Trương Văn Trình) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e SYT \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder05032025C \"\u003e \u003ctd id\u003d\"b_cross05032025C\" rowspan\u003d\"2\" class\u003d\"m-cell buoi-cell\" style\u003d\"background:#CFCFCF;\"\u003e \u003clabel class\u003d\"buoi\"\u003eC\u003c/label\u003e \u003c/td\u003e \u003c
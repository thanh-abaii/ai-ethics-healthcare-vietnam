d class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder07032025C \"\u003e \u003ctd id\u003d\"b_cross07032025C\" rowspan\u003d\"2\" class\u003d\"m-cell buoi-cell\" style\u003d\"background:#CFCFCF;\"\u003e \u003clabel class\u003d\"buoi\"\u003eC\u003c/label\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e 14h00 \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Làm việc tại Trung tâm điều dưỡng người tâm thần (Trần Thanh Thủy) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Đường Đà Sơn \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder07032025C \"\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Họp hội đồng GĐYK (Trương Văn Trình) \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e Hội đồng \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e TTGĐYK \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder07032025T \"\u003e \u003ctd id\u003d\"b_cross07032025T\" rowspan\u003d\"1\" class\u003d\"m-cell buoi-cell\"\u003e \u003clabel class\u003d\"buoi\"\u003eT\u003c/label\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003ctd class\u003d\"txt-input-cell\"\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr class\u003d\"r_holder08032025S \"\u003e \u003ctd id\u003d\"n_cross08032025\" rowspan\u003d\"3\" class\u003d\"thungay-c
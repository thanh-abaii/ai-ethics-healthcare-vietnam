    <script>
        $(document).ready(function () {
          try {
            var linkCheck = $('a[href="https://hoidap.danang.gov.vn/CD_TraCuu.aspx"]');
            var linkInsertAfter = $('a[href="https://gopy.danang.gov.vn"]');
        
            if (linkCheck.length === 0 && linkInsertAfter.length > 0) {
              var newLink = `
                <a target="_blank" href="https://hoidap.danang.gov.vn/CD_TraCuu.aspx" title="Hỏi đáp" class="item d-flex align-items-center" 
                   style="--bg-urll: url(/documents/131507/131575/background-blq-syt2.jpg); 
                          --bg-linear: linear-gradient(180deg, rgb(255 156 156 / 0%) 0%, rgba(120, 187, 255, 0) 72.47%);">
                  <img src="/documents/131507/131575/entypo_chat.png" alt="">
                  <div class="flex-fill d-flex justify-content-center">
                    <p class="mb-0"><span class="no-wrap" style="color: #2E2E2E;">HỎI ĐÁP</span></p>
                  </div>
                </a>
              `;
              linkInsertAfter.after(newLink);
            }
          } catch (e) {
            console.error("Lỗi khi thêm link HỎI ĐÁP:", e);
          }
        });
    </script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
          try {
            var linkCheck = document.querySelector('a[href="https://hoidap.danang.gov.vn/CD_TraCuu.aspx"]');
            var linkInsertAfter = document.querySelector('a[href="https://gopy.danang.gov.vn"]');
      
            if (!linkCheck && linkInsertAfter) {
              var newLink = document.createElement("a");
              newLink.setAttribute("target", "_blank");
              newLink.setAttribute("href", "https://hoidap.danang.gov.vn/CD_TraCuu.aspx");
              newLink.setAttribute("title", "Hỏi đáp");
              newLink.className = "item d-flex align-items-center";
              newLink.style.setProperty("--bg-urll", "url(/documents/131507/131575/background-blq-syt2.jpg)");
              newLink.style.setProperty("--bg-linear", "linear-gradient(180deg, rgb(255 156 156 / 0%) 0%, rgba(120, 187, 255, 0) 72.47%)");
      
              newLink.innerHTML = `
                <img src="/documents/131507/131575/entypo_chat+%282%29.png/3dd4eebd-885f-7a4f-eec2-61991ff2c8e1?t=1749521463361" alt="">
                <div class="flex-fill d-flex justify-content-center">
                  <p class="mb-0"><span class="no-wrap" style="color: #2E2E2E;">HỎI ĐÁP</span></p>
                </div>
              `;
      
              // Thêm newLink ngay sau linkInsertAfter
              linkInsertAfter.parentNode.insertBefore(newLink, linkInsertAfter.nextSibling);
            }
          } catch (e) {
            console.error("Lỗi khi thêm link HỎI ĐÁP:", e);
          }
        });
      </script>

</body>
</html>
			
			
		
	
	
	
	


	
	

					
				
			
		
	
	




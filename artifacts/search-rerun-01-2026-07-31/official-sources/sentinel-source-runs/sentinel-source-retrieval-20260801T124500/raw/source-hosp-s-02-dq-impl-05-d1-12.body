ption><option  value='234'>Trung tâm Sơ sinh</option><option  value='69'>Trung tâm Xét nghiệm</option><option  value='71'>Trung tâm Tế bào gốc</option><option  value='342'>Khoa Dinh dưỡng Tiết chế</option><option  value='67'>Khoa Khám bệnh</option><option  value='61'>Khoa Nội tổng hợp</option><option  value='237'>Khoa Kiểm soát nhiễm khuẩn</option><option  value='230'>Khoa Dược</option><option  value='55'>Khoa Giải phẫu bệnh &amp; Tế bào</option><option  value='66'>Khoa Gây mê hồi sức</option><option  value='214'>Trung tâm tiêm chủng</option><option  value='290'>Trung tâm Đào tạo &amp; Nghiên cứu khoa học</option><option  value='68'>Khoa Ngoại tổng hợp</option><option  value='352'>Khoa Hồi sức tích cực - Chống độc</option>                                </select>

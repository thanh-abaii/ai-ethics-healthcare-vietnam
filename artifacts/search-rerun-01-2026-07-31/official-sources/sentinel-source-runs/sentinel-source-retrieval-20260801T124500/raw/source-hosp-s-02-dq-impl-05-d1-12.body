        jQuery("#id_close").click(function () {
            jQuery('#div_popup').removeClass('show');
        });
        jQuery(".div_close").click(function () {
            jQuery('#div_popup').removeClass('show');
        });
        jQuery(".click_ptrang_tinnghi").click(function () {
            var ptrang =  jQuery(this).data('ptrang');
            var cgia =  jQuery(this).data('cgia');
            jQuery(this).addClass('load');
            jQuery.ajax({
                type: "POST",
                url: 'https://tamanhhospital.vn/wp-content/themes/wg/ajax_tnghi.php',
                data: { cur_trang: ptrang, cur_cgia: cgia, cur_limit: 13},
                dataType: "html",
                success: function (html) {
                    jQuery('.list_thietbi').html(html);
                    jQuery('#collapsetitle_lienquan .click_ptrang_tiennghi.active').removeClass('active');
                    jQuery('#collapsetitle_lienquan .tiennghi_'+ptrang).addClass('active');
                    jQuery('.load').removeClass('load');
                }
            });
        });
    });
</script>

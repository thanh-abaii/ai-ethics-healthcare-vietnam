<script type="text/javascript">
$(document).ready(function() {
 $("#ysf-primary-geo-navigation-sites .country-site a:contains('Guam (USA)')")
    .first()
    .text("Guam (USA) *");
  
   $("#ysf-primary-geo-navigation-sites .country-site a:contains('American Samoa (USA)')")
    .first()
    .text("American Samoa (USA) *");


 $("#ysf-primary-geo-navigation-sites .country-site a:contains('Northern Mariana Islands (USA)')")
    .first()
    .text("Northern Mariana Islands (USA) *");
  
 $('#sf-geo-navigation-container .sf-secondary-geo-navigation-country a')
    .filter(function () {
      return $.trim($(this).text()) === 'Guam (USA)';
    })
    .text('Guam (USA) *');


 $('#sf-geo-navigation-container .sf-secondary-geo-navigation-country a')
    .filter(function () {
      return $.trim($(this).text()) === 'American Samoa (USA)';
    })
    .text('American Samoa (USA) *');

   $('#sf-geo-navigation-container .sf-secondary-geo-navigation-country a')
    .filter(function () {
      return $.trim($(this).text()) === 'Northern Mariana Islands (USA)';
    })
    .text('Northern Mariana Islands (USA) *');

});

</script>

<script type="text/javascript">
$(document).on("click", 'li.has-children > a:contains("Countries")', function () {

  var $li = $(this).closest("li.has-children");
  var $container = $li.find(".sf-secondary-geo-navigation-container").first();
  var $wrapper = $li.find(".sf-secondary-geo-navigation-wrapper").first();

  // Only append if container is visible/open
  if ($container.is(":visible")) {

    if ($wrapper.find(".__countries-click-note").length === 0) {
      $wrapper.append('<p>&nbsp;</p><p class="__countries-click-note"><small><i>* In 2025, the United Nations Secretary General, as depository of the WHO Constitution, circulated a notification from the United States of America of its intention to withdraw from the World Health Organization with a stated effective date of 22 January 2026. This notification is pending consideration by WHO’s Governing Bodies. References to the United States of America or its territories within the WHO context, including any display or otherwise of its national flag or insignia, should be understood as subject to, and without prejudice to, such consideration by WHO’s Governing Bodies.</i></small></p>');
    }
  }
});


$(document).on("click", "a:contains('Regions')", function () {
  $(".sf-secondary-geo-navigation-wrapper").find(".__who-note").remove();
});
</script>

84\",\"static/chunks/3584-7e99a282bc4340d3.js\",\"5802\",\"static/chunks/5802-31bb055cbf75f5b2.js\",\"4468\",\"static/chunks/4468-ae1aadbaccef42f9.js\",\"5955\",\"static/chunks/app/(vi)/page-31d7143f1d6d2558.js\"],\"default\"]\n24:T49d,"])</script><script>self.__next_f.push([1,"\u003cp\u003eChiều ng\u0026agrave;y 09/7/2026, Ủy vi\u0026ecirc;n Bộ Ch\u0026iacute;nh trị, Thủ tướng Ch\u0026iacute;nh phủ L\u0026ecirc; Minh Hưng c\u0026ugrave;ng đo\u0026agrave;n c\u0026ocirc;ng t\u0026aacute;c Trung ương đ\u0026atilde; tới thăm c\u0026aacute;n bộ vi\u0026ecirc;n chức, người lao động v\u0026agrave; động vi\u0026ecirc;n người bệnh đang điều trị tại Bệnh viện Bạch Mai cơ sở Ninh B\u0026igrave;nh. C\u0026ugrave;ng đi với Thủ tướng c\u0026oacute; Bộ trưởng, Chủ nhiệm Văn ph\u0026ograve;ng Ch\u0026iacute;nh phủ Đặng Xu\u0026acirc;n Phong; Bộ trưởng Bộ Y tế Đ\u0026agrave;o Hồng Lan; \u003cspan data-subtree=\"aimfl,mfl\" data-copy-service-computed-style=\"font-family: \u0026quot;Google Sans\u0026quot;, Arial, sans-serif; font-size: 16px; font-weight: 400; margin: 0px; text-decoration: none; border-bottom: 0px rgb(10, 10, 10);\"\u003eB\u0026iacute; thư Tỉnh ủy Ninh B\u0026igrave;nh \u003c/span\u003e\u003cspan class=\"Yjhzub\"\u003eTrần Huy Tuấn\u003c/span\u003e c\u0026ugrave;ng l\u0026atilde;nh đạo nhiều ban, bộ, ng\u0026agrave;nh. Sự kiện diễn ra v\u0026agrave;o thời điểm đặc biệt quan trọng: Cơ sở mới vừa tr\u0026ograve;n 2 tuần vận h\u0026agrave;nh ch\u0026iacute;nh thức kể từ ng\u0026agrave;y khai trương (26/6/2026).\u003c/p\u003e"])</script><script>self.__next_f.push([1,"25:T499,"])</script><script>self.__next_f.push([1,"\u003cp class=\"MsoNormal\" style=\"text-align: justify; line-height: 15.0pt; mso-line-height-rule: exactly; margin: 6.0pt 0in 6.0pt 0in;\"\u003e\u003cspan style=\"font-size: 12.0pt;\"\u003eTrong d\u0026ograve;ng chảy kh\u0026ocirc;ng ngừng đổi mới của ng\u0026agrave;nh y tế, hợp t\u0026aacute;c giữa c\u0026aacute;c đơn vị đầu ng\u0026agrave;nh đang trở th\u0026agrave;nh \u0026ldquo;ch\u0026igrave;a kh\u0026oacute;a\u0026rdquo; để n\u0026acirc;ng cao năng lực chuy\u0026ecirc;n m\u0026ocirc;n v\u0026agrave; chất lượng điều trị. Lễ k\u0026yacute; kết chuyển giao kỹ thuật giữa Bệnh viện Bạch Mai v\u0026agrave; Bệnh viện Phổi Trung ương \u003c/span\u003e\u003cspan style=\"font-size: 12.0pt; mso-ansi-language: EN-US;\"\u003ediễn ra chiều ng\u0026agrave;y 14/4/2026 \u003c/span\u003e\u003cspan style=\"font-size: 12.0pt;\"\u003ekh\u0026ocirc;ng chỉ l\u0026agrave; một hoạt động chuy\u0026ecirc;n m\u0026ocirc;n\u003c/span\u003e\u003cspan style=\"font-size: 12.0pt; mso-ansi-language: EN-US;\"\u003e\u003cspan style=\"mso-spacerun: yes;\"\u003e\u0026nbsp; \u003c/span\u003e\u003c/span\u003e\u003cspan style=\"font-size: 12.0pt;\"\u003em\u0026agrave; c\u0026ograve;n l\u0026agrave; dấu mốc thể hiện tầm nh\u0026igrave;n chiến lược v\u0026agrave; sự đồng h\u0026agrave;nh đầy tr\u0026aacute;ch nhiệm v\u0026igrave; sức khỏe nh\u0026acirc;n d\u0026acirc;n.\u003c/span\u003e\u003c/p\u003e"])</script><script>self.__next_f.push([1,"5:[\"$\",\"$L23\",null,{\"props\":{\"posts\":{\"totalCount\":1847,\"items\":[{\"id\":\"547614ea-e657-4cb2-983a-1c9086174cfb\",\"title\":\"Viêm gan B: Khoảng trống hiểu biết, chủ quan và hệ lụy cả cộng đồng\",\"slug\":\"viem-gan-b-khoang-trong-hieu-biet-chu-quan-va-he-luy-ca-cong-dong\",\"excerpt\":\"\u003cp class=\\\"MsoNormal\\\" style=\\\"margin-top: 12.0pt; text-align: justify;\\\"\u003e\u003cspan lang=\\\"EN-US\\\" style=\\\"font-size: 12.0pt;\\\"\u003eVi r\u0026uacute;t vi\u0026ecirc;m gan B c\u0026oacute; thể \u0026acirc;m thầm tồn tại trong tế b\u0026agrave;o gan h\u0026agrave;ng chục năm, từng ng\u0026agrave;y g\u0026acirc;y vi\u0026ecirc;m, hoại tử, xơ h\u0026oacute;a v\u0026agrave; ph\u0026aacute; hủy l\u0026aacute; gan m\u0026agrave; người bệnh gần như kh\u0026ocirc;ng hay biết. Đến khi v\u0026agrave;ng da, bụng trướng, xuất huyết ti\u0026ecirc;u h\u0026oacute;a hay suy kiệt, nhiều người mới b\u0026agrave;ng ho\u0026agrave;ng nhận ra bệnh đ\u0026atilde; tiến triển th\u0026agrave;nh xơ gan, suy gan, thậm ch\u0026iacute; ung thư gan.\u003c/span\u003e\u003c/p\u003e\",\"viewCount\":104,\"publishDate\":\"2026-07-31T00:00:00\",\"thumbnailId\":\"22ea0ca7-fcdb-485a-bf84-edfd622c31f6\",\"thumbnail\":{\"id\":\"22ea0ca7-fcdb-485a-bf84-edfd622c31f6\",\"fileName\":\"picture1.jpg\",\"url\":\"http://apicms.bachmai.gov.vn/documents/0/0/picture1.jpg/22ea0ca7-fcdb-485a-bf84-edfd622c31f6\",\"path\":\"http://apicms.bachmai.gov.vn/images/2026/7/31/54d8cf82-fd76-4759-8122-7b525febaa4f_picture1.jpg\"},\"categoryId\":null,\"categories\":[{\"id\":\"b00df27b-bbcd-fffe-ee65-5a225b509ff6\",\"name\":\"Y học thường thức\",\"slug\":\"y-hoc-thuong-thuc\"}],\"isFeatured\":false,\"isHomepage\":true},{\"id\":\"c5bdcec6-dc62-4363-8717-5d88894d7905\",\"title\":\"Tiếp bước người Thầy lớn - Viết tiếp trang sử vẻ vang của Bệnh viện Bạch Mai và nền y học Việt Nam\",\"slug\":\"tiep-buoc-nguoi-thay-lon-viet-tiep-trang-su-ve-vang-cua-benh-vien-bach-mai-va-nen-y-hoc-viet-nam\",\"excerpt\":\"\u003cp class=\\\"MsoNormal\\\" style=\\\"text-align: justify; margin: 6.0pt 0in 6.0pt 0in;\\\"\u003e\u003cspan lang=\\\"EN-US\\\" style=\\\"font-family: 'Times New Roman',serif;\\\"\u003eC\u0026oacute; những con người khi rời c\u0026otilde;i tạm, sự ra đi kh\u0026ocirc;ng chỉ để lại khoảng trống trong một gia đ\u0026igrave;nh hay một cơ quan, m\u0026agrave; c\u0026ograve;n để lại khoảng lặng trong cả một chuy\u0026ecirc;n ng\u0026agrave;nh, một nền y học. Sự từ biệt của\u0026nbsp;Anh h\u0026ugrave;ng Lao động, Thầy thuốc Nh\u0026acirc;n d\u0026acirc;n, Gi\u0026aacute;o sư Vũ Văn Đ\u0026iacute;nh\u0026nbsp;l\u0026agrave; một mất m\u0026aacute;t như vậy.\u003c/span\u003e\u003c/p\u003e\",\"viewCount\":2085,\"publishDate\":\"2026-07-31T00:00:00\",\"thumbnailId\":\"b44ac19c-0430-4d6a-b524-a0e5f70373db\",\"thumbnail\":{\"id\":\"b44ac19c-0430-4d6a-b524-a0e5f70373db\",\"fileName\":\"339a1935.JPG\",\"url\":\"http://apicms.bachmai.gov.vn/documents/0/0/339a1935.JPG/b44ac19c-0430-4d6a-b524-a0e5f70373db\",\"path\":\"http://apicms.bachmai.gov.vn/images/2026/7/31/db93312d-b571-4af2-8e50-9c9ab55ff88a_339a1935.JPG\"},\"categoryId\":null,\"categories\":[{\"id\":\"0dd604d2-9f22-30ce-7edf-2c8f61bf4e94\",\"name\":\"Tin trong ngành\",\"slug\":\"tin-trong-nganh\"}],\"isFeatured\":false,\"isHomepage\":true},{\"id\":\"add2a3c6-284d-4d03-9f29-e2ab4c4cd693\",\"title\":\"Bệnh viện Bạch Mai và Bộ Y tế Angola thúc đẩy hợp tác đào tạo nguồn nhân lực y tế\",\"slug\":\"benh-vien-bach-mai-va-bo-y-te-angola-thuc-day-hop-tac-dao-tao-nguon-nhan-luc-y-te\",\"excerpt\":\"\u003cp class=\\\"MsoNormal\\\" style=\\\"text-align: justify; margin: 6.0pt 0in 6.0pt 0in;\\\"\u003e\u003cspan style=\\\"font-size: 12.0pt; line-height: 107%; font-family: 'Times New Roman',serif; mso-ansi-language: VI;\\\"\u003eS\u0026aacute;ng 30/7, tại H\u0026agrave; Nội, Bệnh viện Bạch Mai tiếp v\u0026agrave; l\u0026agrave;m việc với đo\u0026agrave;n c\u0026ocirc;ng t\u0026aacute;c Bộ Y tế Angola nhằm trao đổi về khả năng hợp t\u0026aacute;c trong đ\u0026agrave;o tạo, ph\u0026aacute;t triển nguồn nh\u0026acirc;n lực y tế v\u0026agrave; chuyển giao kỹ thuật chuy\u0026ecirc;n m\u0026ocirc;n giữa hai b\u0026ecirc;n. Buổi l\u0026agrave;m việc mở ra những định hướng hợp t\u0026aacute;c thiết thực, g\u0026oacute;p phần tiếp nối truyền thống hữu nghị l\u0026acirc;u đời giữa Việt Nam v\u0026agrave; Angola trong lĩnh vực y tế.\u003c/span\u003e\u003c/p\u003e\",\"viewCount\":98,\"publishDate\":\"2026-07-31T00:00:00\",\"thumbnailId\":\"a3635896-6e95-422c-900d-c59c52368031\",\"thumbnail\":{\"id\":\"a3635896-6e95-422c-900d-c59c52368031\",\"fileName\":\"17853806592576700255871163948402g8211773668289608312ce6db84bbe97212d1bbd2f1b75dc68c5.jpg\",\"url\":\"http://apicms.bachmai.gov.vn/documents/0/0/17853806592576700255871163948402g8211773668289608312ce6db84bbe97212d1bbd2f1b75dc68c5.jpg/a3635896-6e95-422c-900d-c59c52368031\",\"path\":\"http://apicms.bachmai.gov.vn/images/2026/7/30/c29d008e-4275-48ce-b18d-d8b3c3581ddf_17853806592576700255871163948402g8211773668289608312ce6db84bbe97212d1bbd2f1b75dc68c5.jpg\"},\"categoryId\":null,\"categories\":[{\"id\":\"6fe85f1d-d00b-b3be-1d7d-99e588de7e2e\",\"name\":\"Tin hoạt động Bệnh viện\",\"slug\":\"tin-hoat-ong-benh-vien\"}],\"isFeatured\":false,\"isHomepage\":true},{\"id\":\"34d83d53-e87a-4af6-b158-e6ff4cf28e7e\",\"title\":\"Tai nạn từ đồ chơi: Bé trai 5 tuổi được nội soi lấy dị vật trực tràng an toàn\",\"slug\":\"tai-nan-tu-do-choi-be-trai-5-tuoi-duoc-noi-soi-lay-di-vat-truc-trang-an-toan\",\"excerpt\":\"\u003cp class=\\\"MsoNormal\\\" style=\\\"text-align: justify; margin: 6.0pt 0in 6.0pt 0in;\\\"\u003e\u003cspan style=\\\"font-family: 'Times New Roman',serif; mso-ansi-language: VI;\\\"\u003eTrẻ nhỏ với bản t\u0026iacute;nh t\u0026ograve; m\u0026ograve; thường dễ đối mặt với những tai nạn sinh hoạt trớ tr\u0026ecirc;u, đặc biệt l\u0026agrave; việc nh\u0026eacute;t đồ chơi v\u0026agrave;o c\u0026aacute;c lỗ tự nhi\u0026ecirc;n tr\u0026ecirc;n cơ thể. Mới đ\u0026acirc;y, nhờ ứng dụng kỹ thuật nội soi can thiệp hiện đại, c\u0026aacute;c b\u0026aacute;c sĩ đ\u0026atilde; xử tr\u0026iacute; th\u0026agrave;nh c\u0026ocirc;ng một ca dị vật trực tr\u0026agrave;ng, qua đ\u0026oacute; tiếp tục cảnh b\u0026aacute;o phụ huynh về những tai nạn đ\u0026aacute;ng tiếc c\u0026oacute; thể xảy ra từ c\u0026aacute;c m\u0026oacute;n đồ chơi c\u0026oacute; k\u0026iacute;ch thước nhỏ. \u003c/span\u003e\u003c/p\u003e\",\"viewCount\":133,\"publishDate\":\"2026-07-31T00:00:00\",\"thumbnailId\":\"4fd408be-1bc7-4446-8930-d47bab33e09d\",\"thumbnail\":{\"id\":\"4fd408be-1bc7-4446-8930-d47bab33e09d\",\"fileName\":\"picture2.jpg\",\"url\":\"http://apicms.bachmai.gov.vn/documents/0/0/picture2.jpg/4fd408be-1bc7-4446-8930-d47bab33e09d\",\"path\":\"http://apicms.bachmai.gov.vn/images/2026/7/31/35bec7e4-3530-4bc7-b552-7d7764fad7ed_picture2.jpg\"},\"categoryId\":null,\"categories\":[{\"id\":\"b00df27b-bbcd-fffe-ee65-5a225b509ff6\",\"name\":\"Y học thường thức\",\"slug\":\"y-hoc-thuong-thuc\"}],\"isFeatured\":false,\"isHomepage\":true},{\"id\":\"c1a8d55d-1a67-4d0f-97cb-c6ecb5f86ff0\",\"title\":\"Vĩnh biệt Giáo sư, Anh hùng Lao động, Thầy thuốc Nhân dân Vũ Văn Đính - Người đặt nền móng cho chuyên ngành Hồi sức cấp cứu Việt Nam\",\"slug\":\"vinh-biet-giao-su-anh-hung-lao-dong-thay-thuoc-nhan-dan-vu-van-dinh-nguoi-dat-nen-mong-cho-chuyen-nganh-hoi-suc-cap-cuu-viet-nam\",\"excerpt\":\"\u003cp class=\\\"MsoNormal\\\" style=\\\"text-align: justify;\\\"\u003e\u003cspan style=\\\"font-family: 'Times New Roman',serif; mso-ansi-language: VI;\\\"\u003eNhững ng\u0026agrave;y cuối th\u0026aacute;ng Bảy, Bệnh viện Bạch Mai đ\u0026oacute;n nhận một mất m\u0026aacute;t lớn khi Gi\u0026aacute;o sư, Anh h\u0026ugrave;ng Lao động, Thầy thuốc Nh\u0026acirc;n d\u0026acirc;n Vũ Văn Đ\u0026iacute;nh từ trần.\u003c/span\u003e\u003c/p\u003e\\n\u003cp class=\\\"MsoNormal\\\" style=\\\"text-align: justify;\\\"\u003e\u003cspan style=\\\"font-family: 'Times New Roman',serif; mso-ansi-language: VI;\\\"\u003eSự ra đi của Gi\u0026aacute;o sư l\u0026agrave; niềm tiếc thương s\u0026acirc;u sắc đối với c\u0026aacute;c thế hệ học tr\u0026ograve;, đồng nghiệp v\u0026agrave; đội ngũ thầy thuốc đ\u0026atilde; từng được \u0026ocirc;ng d\u0026igrave;u dắt, truyền cảm hứng v\u0026agrave; đồng h\u0026agrave;nh trong suốt qu\u0026aacute; tr\u0026igrave;nh x\u0026acirc;y dựng, ph\u0026aacute;t triển chuy\u0026ecirc;n ng\u0026agrave;nh Hồi sức cấp cứu Việt Nam.\u003c/span\u003e\u003c/p\u003e\",\"viewCount\":236,\"publishDate\":\"2026-07-30T00:00:00\",\"thumbnailId\":\"c609b0fc-befc-4e73-bfe5-6e73aeff0d3c\",\"thumbnail\":{\"id\":\"c609b0fc-befc-4e73-bfe5-6e73aeff0d3c\",\"fileName\":\"screenshot1785383914.png\",\"url\":\"http://apicms.bachmai.gov.vn/documents/0/0/screenshot1785383914.png/c609b0fc-befc-4e73-bfe5-6e73aeff0d3c\",\"path\":\"http://apicms.bachmai.gov.vn/images/2026/7/30/16f3d679-2a18-45fd-979d-34a97c60a494_screenshot1785383914.png\"},\"categoryId\":null,\"categories\":[{\"id\":\"0dd604d2-9f22-30ce-7edf-2c8f61bf4e94\",\"name\":\"Tin trong ngành\",\"slug\":\"tin-trong-nganh\"}],\"isFeatured\":false,\"isHomepage\":true},{\"id\":\"d0041381-d232-41b1-8a5f-ce50e0416c2d\",\"title\":\"Những người điều dưỡng lặng thầm phía sau hành trình hồi sinh người bệnh\",\"slug\":\"nhung-nguoi-dieu-duong-lang-tham-phia-sau-hanh-trinh-hoi-sinh-nguoi-benh\",\"excerpt\":\"\u003cp class=\\\"MsoNormal\\\" style=\\\"text-align: justify; margin: 6.0pt 0in 6.0pt 0in;\\\"\u003e\u003cspan style=\\\"font-size: 12.0pt; line-height: 115%; mso-ansi-language: VI;\\\"\u003eGiữa tiếng m\u0026aacute;y thở, \u0026aacute;nh s\u0026aacute;ng từ những m\u0026agrave;n h\u0026igrave;nh theo d\u0026otilde;i hoạt động suốt ng\u0026agrave;y đ\u0026ecirc;m v\u0026agrave; những hồi chu\u0026ocirc;ng b\u0026aacute;o động c\u0026oacute; thể vang l\u0026ecirc;n bất cứ l\u0026uacute;c n\u0026agrave;o, người điều dưỡng hồi sức vẫn lặng lẽ c\u0026oacute; mặt b\u0026ecirc;n từng giường bệnh. Từ việc kiểm tra đường truyền, theo d\u0026otilde;i từng chỉ số sinh tồn đến một lời động vi\u0026ecirc;n hay c\u0026aacute;i nắm tay kh\u0026iacute;ch lệ, tất cả đều g\u0026oacute;p phần g\u0026igrave;n giữ sự sống v\u0026agrave; tiếp th\u0026ecirc;m niềm tin cho người bệnh trong những thời khắc mong manh nhất.\u003c/span\u003e\u003c/p\u003e\",\"viewCount\":248,\"publishDate\":\"2026-07-30T00:00:00\",\"thumbnailId\":\"457c54f6-3f48-46e6-b4f7-38805d509f03\",\"thumbnail\":{\"id\":\"457c54f6-3f48-46e6-b4f7-38805d509f03\",\"fileName\":\"17853105329502525361213050377605g821177366828960831207800a1a201a3f71302063da0a8e7455.jpg\",\"url\":\"http://apicms.bachmai.gov.vn/documents/0/0/17853105329502525361213050377605g821177366828960831207800a1a201a3f71302063da0a8e7455.jpg/457c54f6-3f48-46e6-b4f7-38805d509f03\",\"path\":\"http://apicms.bachmai.gov.vn/images/2026/7/30/96f64572-bc2c-43db-a760-568bc7943403_17853105329502525361213050377605g821177366828960831207800a1a201a3f71302063da0a8e7455.jpg\"},\"categoryId\":null,\"categories\":[{\"id\":\"0dd604d2-9f22-30ce-7edf-2c8f61bf4e94\",\"name\":\"Tin trong ngành\",\"slug\":\"tin-trong-nganh\"}],\"isFeatured\":false,\"isHomepage\":true}]},\"categoryPosts\":[{\"id\":\"bb6b3854-8431-4970-8404-f63537e5211f\",\"name\":\"Đào tạo, chỉ đạo tuyến\",\"slug\":\"dao-tao-chi-dao-tuyen\",\"description\":\"\",\"parentId\":\"c0b1bf85-a976-e9b2-8181-5b820937e898\",\"creationTime\":\"2025-04-03T09:24:22.1786002\",\"lastModificationTime\":\"2025-04-22T09:11:31.8883012\",\"isHompage\":true,\"isDisplay\":true,\"isFeatured\":false,\"order\":7},{\"id\":\"b00df27b-bbcd-fffe-ee65-5a225b509ff6\",\"name\":\"Y học thường thức\",\"slug\":\"y-hoc-thuong-thuc\",\"description\":\"\u003ch1 classname=\\\"sub-title h1\\\"\u003eHành trình của Hạnh phúc \u0026amp; Hy vọng\u003c/h1\u003e\u003cdiv classname=\\\"desc\\\"\u003eTừng ngày, từng giờ, tại Bạch Mai, những câu chuyện về sự hồi sinh diệu kỳ và những cuộc chuyển giao sự sống đầy cảm động vẫn đang diễn ra.\u003c/div\u003e\",\"parentId\":\"c0b1bf85-a976-e9b2-8181-5b820937e898\",\"creationTime\":\"1970-01-02T00:00:00\",\"lastModificationTime\":\"2025-04-03T11:55:32.6415873\",\"isHompage\":true,\"isDisplay\":true,\"isFeatured\":false,\"order\":2},{\"id\":\"d89b2ecb-6b98-3a76-4026-6bc7202eed4e\",\"name\":\"Bài viết chuyên môn\",\"slug\":\"bai-viet-chuyen-mon\",\"description\":null,\"parentId\":\"c0b1bf85-a976-e9b2-8181-5b820937e898\",\"creationTime\":\"1970-01-02T00:00:00\",\"lastModificationTime\":\"2025-02-24T22:40:34.2479372\",\"isHompage\":true,\"isDisplay\":true,\"isFeatured\":false,\"order\":3},{\"id\":\"6fe85f1d-d00b-b3be-1d7d-99e588de7e2e\",\"name\":\"Tin hoạt động Bệnh viện\",\"slug\":\"tin-hoat-ong-benh-vien\",\"description\":null,\"parentId\":\"c0b1bf85-a976-e9b2-8181-5b820937e898\",\"creationTime\":\"1970-01-02T00:00:00\",\"lastModificationTime\":\"2025-02-24T22:14:13.6597955\",\"isHompage\":true,\"isDisplay\":true,\"isFeatured\":false,\"order\":1}],\"doctorI
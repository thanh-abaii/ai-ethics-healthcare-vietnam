ress\":\"\",\"letter\":\"P\",\"thumbnail\":\"/images/2025/2/25/aa076130-c847-4bf3-96ca-0c06bf339864_tt.jpg\",\"parentId\":\"bb389bf2-b048-4188-9b7f-65d5742e4779\",\"order\":9,\"isSpecialtyUnit\":false,\"slug\":\"khoa-phau-thuat-tiet-nieu\"},{\"id\":\"6bf5d66d-9c28-aa09-a4db-954b0cd4d754\",\"name\":\"Khoa Tai Mũi Họng\",\"phone\":null,\"address\":null,\"letter\":\"K\",\"thumbnail\":\"/images/2025/2/25/4570318a-8ec5-4d6a-8b58-53b300dc2e2c_30oct2023093539gmtupload01168233.jpg\",\"parentId\":\"bb389bf2-b048-4188-9b7f-65d5742e4779\",\"order\":13,\"isSpecialtyUnit\":false,\"slug\":\"khoa-tai-mui-hong\"},{\"id\":\"a44779ee-8e80-b082-f11b-ec3462f4b4ca\",\"name\":\"Phòng Tổ chức cán bộ\",\"phone\":\"\",\"address\":null,\"letter\":\"T\",\"thumbnail\":\"/images/2025/6/12/94112e01-3266-4016-b4eb-672ede6d09d2_1000027371.jpg\",\"parentId\":\"00000000-0000-0000-0000-000000000003\",\"order\":999,\"isSpecialtyUnit\":false,\"slug\":\"phong-to-chuc-can-bo\"}],\"dataPostFeatured\":{\"totalCount\":107,\"items\":[{\"id\":\"bf0a0a2b-f6c2-44ef-bf64-3239693cdb84\",\"title\":\"Thông báo về Lễ viếng, Lễ truy điệu và Lễ an táng Giáo sư Vũ Văn Đính - Anh Hùng lao động, Thầy thuốc nhân dân\",\"slug\":\"thong-bao-ve-le-vieng-le-truy-dieu-va-le-an-tang-giao-su-vu-van-dinh-anh-hung-lao-dong-thay-thuoc-nhan-dan\",\"excerpt\":\"\",\"viewCount\":64,\"publishDate\":\"2026-07-31T00:00:00\",\"thumbnailId\":\"e95e2896-ccaa-4c75-b199-ec095c5e7daa\",\"thumbnail\":{\"id\":\"e95e2896-ccaa-4c75-b199-ec095c5e7daa\",\"fileName\":\"geminigeneratedimage9zkbmn9zkbmn9zkb.png\",\"url\":\"http://apicms.bachmai.gov.vn/documents/0/0/geminigeneratedimage9zkbmn9zkbmn9zkb.png/e95e2896-ccaa-4c75-b199-ec095c5e7daa\",\"path\":\"http://apicms.bachmai.gov.vn/images/2026/7/31/e6c535c1-aefe-46b8-9992-83cc880bcf71_geminigeneratedimage9zkbmn9zkbmn9zkb.png\"},\"categoryId\":null,\"categories\":[{\"id\":\"0dd604d2-9f22-30ce-7edf-2c8f61bf4e94\",\"name\":\"Tin trong ngành\",\"slug\":\"tin-trong-nganh\"}],\"isFeatured\":true,\"isHomepage\":false},{\"id\":\"f65083f1-81af-4c72-b136-043f85791321\",\"title\":\"Chuyến xe 5 giờ sáng xuyên màn mưa và giọt nước mắt nghẹn ngào của người cha ở Ninh Bình\",\"slug\":\"chuyen-xe-5-gio-sang-xuyen-man-mua-va-giot-nuoc-mat-nghen-ngao-cua-nguoi-cha-o-ninh-binh\",\"excerpt\":\"\u003cp class=\\\"MsoNormal\\\" style=\\\"text-align: justify; line-height: 15.0pt; mso-line-height-rule: exactly; margin: 6.0pt 0in 6.0pt 0in;\\\"\u003e\u003cspan style=\\\"font-family: 'Times New Roman',serif; mso-ansi-language: VI;\\\"\u003eMột ca chấn thương h\u0026agrave;m mặt phức tạp do tai nạn giao th\u0026ocirc;ng vừa được c\u0026aacute;c b\u0026aacute;c sĩ Khoa Răng H\u0026agrave;m Mặt, Bệnh viện Bạch Mai xử tr\u0026iacute; th\u0026agrave;nh c\u0026ocirc;ng tại cơ sở Ninh B\u0026igrave;nh. Đằng sau ca phẫu thuật l\u0026agrave; h\u0026agrave;nh tr\u0026igrave;nh vượt mưa từ H\u0026agrave; Nội xuống Ninh B\u0026igrave;nh từ 5 giờ s\u0026aacute;ng của TS.BSCC. Ho\u0026agrave;ng Ngọc Lan c\u0026ugrave;ng \u0026ecirc;-k\u0026iacute;p, đồng thời khẳng định năng lực triển khai kỹ thuật chuy\u0026ecirc;n s\u0026acirc;u ngay tại địa phương.\u003c/span\u003e\u003c/p\u003e\",\"viewCount\":1261,\"publishDate\":\"2026-07-29T00:00:00\",\"thumbnailId\":\"c6e3c100-4fc5-4845-953f-8c767c5cd185\",\"thumbnail\":{\"id\":\"c6e3c100-4fc5-4845-953f-8c767c5cd185\",\"fileName\":\"17853170582812525361213050377605g821177366828960831247263ac9c0ff086da11126098b3f8bfc.jpg\",\"url\":\"http://apicms.bachmai.gov.vn/documents/0/0/17853170582812525361213050377605g821177366828960831247263ac9c0ff086da11126098b3f8bfc.jpg/c6e3c100-4fc5-4845-953f-8c767c5cd185\",\"path\":\"http://apicms.bachmai.gov.vn/images/2026/7/29/9e1a1ee5-2296-43b1-a9a6-ebdd57fd4765_17853170582812525361213050377605g821177366828960831247263ac9c0ff086da11126098b3f8bfc.jpg\"},\"categoryId\":null,\"categories\":[{\"id\":\"6fe85f1d-d00b-b3be-1d7d-99e588de7e2e\",\"name\":\"Tin hoạt động Bệnh viện\",\"slug\":\"tin-hoat-ong-benh-vien\"}],\"isFeatured\":true,\"isHomepage\":true},{\"id\":\"a6e87e78-59f9-4ca9-9820-c0c929d8aec4\",\"title\":\"Bệnh viện Bạch Mai cơ sở Ninh Bình: Đưa y tế tuyến cuối, chất lượng cao đến gần với người dân\",\"slug\":\"benh-vien-bach-mai-co-so-ninh-binh-dua-y-te-tuyen-cuoi-chat-luong-cao-den-gan-voi-nguoi-dan\",\"excerpt\":\"\u003cp class=\\\"MsoNormal\\\" style=\\\"text-align: justify; line-height: 15.0pt; mso-line-height-rule: exactly; margin: 6.0pt 0in 6.0pt 0in;\\\"\u003e\u003cspan style=\\\"font-size: 12.0pt; mso-ansi-language: VI;\\\"\u003eChỉ sau hơn ba tuần hoạt động, Bệnh viện Bạch Mai cơ sở Ninh B\u0026igrave;nh kh\u0026ocirc;ng chỉ tiếp nhận hơn 42.800 lượt kh\u0026aacute;m ngoại tr\u0026uacute; v\u0026agrave; điều trị gần 4.800 người bệnh nội tr\u0026uacute;, m\u0026agrave; c\u0026ograve;n li\u0026ecirc;n tiếp l\u0026agrave;m chủ nhiều kỹ thuật chuy\u0026ecirc;n s\u0026acirc;u, cứu sống nhiều ca bệnh nặng ngay tại địa phương. Những kết quả bước đầu cho thấy m\u0026ocirc; h\u0026igrave;nh \\\"Một Bạch Mai - Hai cơ sở\\\" đang ph\u0026aacute;t huy hiệu quả, gi\u0026uacute;p người d\u0026acirc;n được tiếp cận dịch vụ y tế chất lượng cao m\u0026agrave; kh\u0026ocirc;ng c\u0026ograve;n phải vất vả chuyển l\u0026ecirc;n H\u0026agrave; Nội. \u003c/span\u003e\u003c/p\u003e\",\"viewCount\":716,\"publishDate\":\"2026-07-24T00:00:00\",\"thumbnailId\":\"5c434027-2cd8-4960-b11a-72bc8e38301c\",\"thumbnail\":{\"id\":\"5c434027-2cd8-4960-b11a-72bc8e38301c\",\"fileName\":\"e17edafe-6a28-4ec3-b1b7-e7779baef4efmceu89764123241783601805843.jpg\",\"url\":\"http://apicms.bachmai.gov.vn/documents/0/0/e17edafe-6a28-4ec3-b1b7-e7779baef4efmceu89764123241783601805843.jpg/5c434027-2cd8-4960-b11a-72bc8e38301c\",\"path\":\"http://apicms.bachmai.gov.vn/images/2026/7/24/0560d66b-e3cd-4d5a-ad9a-ec61c1c06268_e17edafe-6a28-4ec3-b1b7-e7779baef4efmceu89764123241783601805843.jpg\"},\"categoryId\":null,\"categories\":[{\"id\":\"0dd604d2-9f22-30ce-7edf-2c8f61bf4e94\",\"name\":\"Tin trong ngành\",\"slug\":\"tin-trong-nganh\"}],\"isFeatured\":true,\"isHomepage\":true},{\"id\":\"4b70138b-ecb2-43ba-bb38-d30284918bb0\",\"title\":\"Bệnh viện Bạch Mai cơ sở Ninh Bình: Khẳng định vai trò bệnh viện tuyến trung ương trong chăm sóc sức khỏe nhân dân\",\"slug\":\"benh-vien-bach-mai-co-so-ninh-binh-khang-dinh-vai-tro-benh-vien-tuyen-trung-uong-trong-cham-soc-suc-khoe-nhan-dan\",\"excerpt\":\"\u003cp class=\\\"MsoNormal\\\" style=\\\"text-align: justify;\\\"\u003e\u003cspan lang=\\\"EN-US\\\"\u003eSau 13 ng\u0026agrave;y ch\u0026iacute;nh thức đi v\u0026agrave;o hoạt động, Bệnh viện Bạch Mai cơ sở Ninh B\u0026igrave;nh đ\u0026atilde; tiếp nhận hơn 27.000 lượt kh\u0026aacute;m ngoại tr\u0026uacute;, c\u0026ocirc;ng suất sử dụng giường bệnh nội tr\u0026uacute; lu\u0026ocirc;n ở mức cao. Những kết quả bước đầu cho thấy hiệu quả của m\u0026ocirc; h\u0026igrave;nh \\\"Hai cơ sở - Một Bệnh viện - One Bạch Mai\\\", g\u0026oacute;p phần đưa dịch vụ y tế chất lượng cao đến gần hơn với người d\u0026acirc;n khu vực ph\u0026iacute;a Nam đồng bằng s\u0026ocirc;ng Hồng v\u0026agrave; c\u0026aacute;c tỉnh Bắc Trung Bộ.\u003c/span\u003e\u003c/p\u003e\",\"viewCount\":1493,\"publishDate\":\"2026-07-10T16:04:41.8584163\",\"thumbnailId\":\"cc29507c-ca26-4b5c-bef1-f5aabfdab4d3\",\"thumbnail\":{\"id\":\"cc29507c-ca26-4b5c-bef1-f5aabfdab4d3\",\"fileName\":\"z80281984607867e5829ee13117a35fc5233eeec448b31.jpg\",\"url\":\"http://apicms.bachmai.gov.vn/documents/0/0/z80281984607867e5829ee13117a35fc5233eeec448b31.jpg/cc29507c-ca26-4b5c-bef1-f5aabfdab4d3\",\"path\":\"http://apicms.bachmai.gov.vn/images/2026/7/10/f992bc80-6af1-4c9b-8be2-9d30dfc6ccdd_z80281984607867e5829ee13117a35fc5233eeec448b31.jpg\"},\"categoryId\":null,\"categories\":[{\"id\":\"6fe85f1d-d00b-b3be-1d7d-99e588de7e2e\",\"name\":\"Tin hoạt động Bệnh viện\",\"slug\":\"tin-hoat-ong-benh-vien\"}],\"isFeatured\":true,\"isHomepage\":true},{\"id\":\"465d33c5-057d-4d2c-837b-fc16243aab46\",\"title\":\"Thủ tướng Chính phủ Lê Minh Hưng thăm và làm việc tại Bệnh viện Bạch Mai cơ sở Ninh Bình \",\"slug\":\"thu-tuong-chinh-phu-le-minh-hung-tham-va-lam-viec-tai-benh-vien-bach-mai-co-so-ninh-binh\",\"excerpt\":\"$24\",\"viewCount\":1533,\"publishDate\":\"2026-07-09T20:01:44.5725105\",\"thumbnailId\":\"fa7fd9c7-e3ef-4eda-ba09-fb5fb830e317\",\"thumbnail\":{\"id\":\"fa7fd9c7-e3ef-4eda-ba09-fb5fb830e317\",\"fileName\":\"dsc05774.jpg\",\"url\":\"http://apicms.bachmai.gov.vn/documents/0/0/dsc05774.jpg/fa7fd9c7-e3ef-4eda-ba09-fb5fb830e317\",\"path\":\"http://apicms.bachmai.gov.vn/images/2026/7/9/da198cdf-df14-409f-bd45-50826dcef81a_dsc05774.jpg\"},\"categoryId\":null,\"categories\":[{\"id\":\"6fe85f1d-d00b-b3be-1d7d-99e588de7e2e\",\"name\":\"Tin hoạt động Bệnh viện\",\"slug\":\"tin-hoat-ong-benh-vien\"}],\"isFeatured\":true,\"isHomepage\":true},{\"id\":\"7f3ba26c-937d-431c-a387-20331026bd28\",\"title\":\"Thông báo về việc triển khai ký số, đóng dấu số và tra cứu giấy tờ điện tử  do Bệnh viện Bạch Mai phát hành\",\"slug\":\"thong-bao-ve-viec-trien-khai-ky-so-dong-dau-so-va-tra-cuu-giay-to-dien-tu-do-benh-vien-bach-mai-phat-hanh\",\"excerpt\":\"\u003cp class=\\\"MsoNormal\\\" style=\\\"text-align: justify;\\\"\u003e\u003cspan lang=\\\"EN-US\\\"\u003eCăn cứ Nghị định số 23/2025/NĐ-CP ng\u0026agrave;y 21 th\u0026aacute;ng 02 năm 2025 của Ch\u0026iacute;nh phủ quy định về chữ k\u0026yacute; điện tử v\u0026agrave; dịch vụ tin cậy;\u003c/span\u003e\u003c/p\u003e\\n\u003cp class=\\\"MsoNormal\\\" style=\\\"text-align: justify;\\\"\u003e\u003cspan lang=\\\"EN-US\\\"\u003eCăn cứ chủ trương của Ch\u0026iacute;nh phủ v\u0026agrave; Bộ Y tế về đẩy mạnh cải c\u0026aacute;ch thủ tục h\u0026agrave;nh ch\u0026iacute;nh, chuyển đổi số trong lĩnh vực kh\u0026aacute;m bệnh, chữa bệnh.\u003c/span\u003e\u003c/p\u003e\",\"viewCount\":495,\"publishDate\":\"2026-07-08T00:00:00\",\"thumbnailId\":\"d79a92a3-d7b4-45cf-a96e-1fd92365541a\",\"thumbnail\":{\"id\":\"d79a92a3-d7b4-45cf-a96e-1fd92365541a\",\"fileName\":\"z8025092790110d01d03000143b19375616605844bdeb2.jpg\",\"url\":\"http://apicms.bachmai.gov.vn/documents/0/0/z8025092790110d01d03000143b19375616605844bdeb2.jpg/d79a92a3-d7b4-45cf-a96e-1fd92365541a\",\"path\":\"http://apicms.bachmai.gov.vn/images/2026/7/9/83f76a71-386b-4058-ae13-306a6209c539_z8025092790110d01d03000143b19375616605844bdeb2.jpg\"},\"categoryId\":null,\"categories\":[{\"id\":\"2d65d63d-0474-a9a4-9412-433c7270a14c\",\"name\":\"Thông báo và tin mời thầu\",\"slug\":\"thong-bao-va-tin-moi-thau\"}],\"isFeatured\":true,\"isHomepage\":false},{\"id\":\"f8713a00-4ac5-431b-9b48-26921de2f0d5\",\"title\":\"Khai trương Bệnh viện Bạch Mai cơ sở Ninh Bình: Mở rộng không gian phát triển y tế chất lượng cao\",\"slug\":\"khai-truong-benh-vien-bach-mai-co-so-ninh-binh-mo-rong-khong-gian-phat-trien-y-te-chat-luong-cao\",\"excerpt\":\"\u003cp class=\\\"MsoNormal\\\" style=\\\"text-align: justify; margin: 6.0pt 0in 6.0pt 0in;\\\"\u003e\u003cspan style=\\\"font-size: 12.0pt; line-height: 115%; font-family: 'Times New Roman',serif; mso-ascii-theme-font: major-latin; mso-hansi-theme-font: major-latin; mso-bidi-theme-font: major-latin; mso-ansi-language: VI;\\\"\u003eS\u0026aacute;ng 26/6, Bộ Y tế phối hợp Bệnh viện Bạch Mai tổ chức Lễ khai trương hoạt động Bệnh viện Bạch Mai cơ sở Ninh B\u0026igrave;nh. Đ\u0026acirc;y l\u0026agrave; dấu mốc quan trọng trong lộ tr\u0026igrave;nh ho\u0026agrave;n thiện mạng lưới y tế chuy\u0026ecirc;n s\u0026acirc;u, hiện thực h\u0026oacute;a chủ trương của Đảng, Nh\u0026agrave; nước về n\u0026acirc;ng cao năng lực kh\u0026aacute;m, chữa bệnh, giảm qu\u0026aacute; tải cho c\u0026aacute;c bệnh viện tuyến Trung ương v\u0026agrave; tạo điều kiện để người d\u0026acirc;n được tiếp cận dịch vụ y tế chất lượng cao ngay tại khu vực.\u003c/span\u003e\u003c/p\u003e\",\"viewCount\":6212,\"publishDate\":\"2026-06-26T00:00:00\",\"thumbnailId\":\"54e127c9-ff6d-403e-9a1d-90af8b5ce653\",\"thumbnail\":{\"id\":\"54e127c9-ff6d-403e-9a1d-90af8b5ce653\",\"fileName\":\"17824656272032525361213050377605g62628288862733438447a67937589488de8f6b81b5f931a44ba.jpg\",\"url\":\"http://apicms.bachmai.gov.vn/documents/0/0/17824656272032525361213050377605g62628288862733438447a67937589488de8f6b81b5f931a44ba.jpg/54e127c9-ff6d-403e-9a1d-90af8b5ce653\",\"path\":\"http://apicms.bachmai.gov.vn/images/2026/6/26/1bd7c92f-049d-4cbe-bfd0-bf9025977a7e_17824656272032525361213050377605g62628288862733438447a67937589488de8f6b81b5f931a44ba.jpg\"},\"categoryId\":null,\"categories\":[{\"id\":\"6fe85f1d-d00b-b3be-1d7d-99e588de7e2e\",\"name\":\"Tin hoạt động Bệnh viện\",\"slug\":\"tin-hoat-ong-benh-vien\"}],\"isFeatured\":true,\"isHomepage\":true},{\"id\":\"24fd246b-cc5c-41c4-a35b-025d02c41dc5\",\"title\":\"Thông báo kết quả xét tặng danh hiệu “Thầy thuốc nhân dân”, “Thầy thuốc ưu tú” Lần thứ 15 tại Hội đồng cấp cơ sở Bệnh viện Bạch Mai\",\"slug\":\"thong-bao-ket-qua-xet-tang-danh-hieu-“thay-thuoc-nhan-dan”-“thay-thuoc-uu-tu”-lan-thu-15-tai-hoi-dong-cap-co-so-benh-vien-bach-mai\",\"excerpt\":\"\u003cp class=\\\"MsoNormal\\\" style=\\\"text-align: justify;\\\"\u003eHội đồng x\u0026eacute;t tặng danh hiệu \u0026ldquo;Thầy thuốc nh\u0026acirc;n d\u0026acirc;n\u0026rdquo;, \u0026ldquo;Thầy thuốc ưu t\u0026uacute;\u0026rdquo; lần thứ 15 của Bệnh viện gửi tới to\u0026agrave;n thể c\u0026aacute;c đơn vị trực thuộc Bệnh viện ( qua hệ thống BM Office v\u0026agrave; Website Bệnh viện) danh s\u0026aacute;ch c\u0026aacute;c c\u0026aacute; nh\u0026acirc;n đề nghị x\u0026eacute;t tặng \u0026ldquo;Thầy thuốc nh\u0026acirc;n d\u0026acirc;n\u0026rdquo;, \u0026ldquo;Thầy thuốc ưu t\u0026uacute;\u0026rdquo; đ\u0026atilde; đạt điều kiện, ti\u0026ecirc;u chuẩn để đưa v\u0026agrave;o danh s\u0026aacute;ch tr\u0026igrave;nh Hội đồng cấp tr\u0026ecirc;n.\u003c/p\u003e\",\"viewCount\":357,\"publishDate\":\"2026-06-19T00:00:00\",\"thumbnailId\":\"cf65e5df-e377-45d5-aa5c-3247607e9dd7\",\"thumbnail\":{\"id\":\"cf65e5df-e377-45d5-aa5c-3247607e9dd7\",\"fileName\":\"geminigeneratedimage8xy5w18xy5w18xy5.png\",\"url\":\"http://apicms.bachmai.gov.vn/documents/0/0/geminigeneratedimage8xy5w18xy5w18xy5.png/cf65e5df-e377-45d5-aa5c-3247607e9dd7\",\"path\":\"http://apicms.bachmai.gov.vn/images/2026/6/19/09723b3c-da98-4363-b56a-e038a5f36084_geminigeneratedimage8xy5w18xy5w18xy5.png\"},\"categoryId\":null,\"categories\":[{\"id\":\"2d65d63d-0474-a9a4-9412-433c7270a14c\",\"name\":\"Thông báo và tin mời thầu\",\"slug\":\"thong-bao-va-tin-moi-thau\"}],\"isFeatured\":true,\"isHomepage\":false},{\"id\":\"04178668-8a2c-4fb8-b54b-0b0c9f40255d\",\"title\":\"Bệnh viện Bạch Mai vinh danh 329 chuyên gia, người tài năng: Lan tỏa giá trị y đức và trí tuệ Việt Nam\",\"slug\":\"benh-vien-bach-mai-vinh-danh-329-chuyen-gia-nguoi-tai-nang-lan-toa-gia-tri-y-duc-va-tri-tue-viet-nam\",\"excerpt\":\"\u003cp class=\\\"MsoNormal\\\" style=\\\"text-align: justify;\\\"\u003e\u003cspan style=\\\"font-family: 'Times New Roman',serif;\\\"\u003eNg\u0026agrave;y 18/5, Bệnh viện Bạch Mai long trọng tổ chức Lễ vinh danh Chuy\u0026ecirc;n gia, Người t\u0026agrave;i năng năm 2026 v\u0026agrave; ra mắt cuốn s\u0026aacute;ch \u0026ldquo;Ch\u0026acirc;n dung Chuy\u0026ecirc;n gia, Người t\u0026agrave;i năng Bệnh viện Bạch Mai năm 2026\u0026rdquo;. Chương tr\u0026igrave;nh diễn ra đ\u0026uacute;ng dịp Ng\u0026agrave;y Khoa học v\u0026agrave; C\u0026ocirc;ng nghệ Việt Nam 18/5, hướng tới kỷ niệm Ng\u0026agrave;y sinh Chủ tịch Hồ Ch\u0026iacute; Minh - người lu\u0026ocirc;n d\u0026agrave;nh sự quan t\u0026acirc;m s\u0026acirc;u sắc tới sự nghiệp chăm s\u0026oacute;c sức khỏe nh\u0026acirc;n d\u0026acirc;n v\u0026agrave; đội ngũ thầy thuốc Việt Nam. \u003c/span\u003e\u003c/p\u003e\",\"viewCount\":13509,\"publishDate\":\"2026-05-18T00:00:00\",\"thumbnailId\":\"1f254dbd-a240-470c-849d-5553a53b5787\",\"thumbnail\":{\"id\":\"1f254dbd-a240-470c-849d-5553a53b5787\",\"fileName\":\"z78393554814666d3fc85d19f0c888abfa9cf79df5f91a.jpg\",\"url\":\"http://apicms.bachmai.gov.vn/documents/0/0/z78393554814666d3fc85d19f0c888abfa9cf79df5f91a.jpg/1f254dbd-a240-470c-849d-5553a53b5787\",\"path\":\"http://apicms.bachmai.gov.vn/images/2026/5/18/07f7492e-102f-4793-abad-9cc4788a42be_z78393554814666d3fc85d19f0c888abfa9cf79df5f91a.jpg\"},\"categoryId\":null,\"categories\":[{\"id\":\"6fe85f1d-d00b-b3be-1d7d-99e588de7e2e\",\"name\":\"Tin hoạt động Bệnh viện\",\"slug\":\"tin-hoat-ong-benh-vien\"}],\"isFeatured\":true,\"isHomepage\":true},{\"id\":\"06ca4da3-7307-4d3a-82d2-af3330848ed1\",\"title\":\"Bệnh viện Bạch Mai và Bệnh viện Phổi Trung ương: Tăng cường hợp tác chuyên môn, nâng tầm kỹ thuật vì người bệnh\",\"slug\":\"benh-vien-bach-mai-va-benh-vien-phoi-trung-uong-tang-cuong-hop-tac-chuyen-mon-nang-tam-ky-thuat-vi-nguoi-benh\",\"excerpt\":\"$25\",\"viewCount\":929,\"publishDate\":\"2026-04-15T00:00:00\",\"thumbnailId\":\"90bd9f78-e55b-47c3-be7b-e059c64e7ce4\",\"thumbnail\":{\"id\":\"90bd9f78-e55b-47c3-be7b-e059c64e7ce4\",\"fileName\":\"dsc1451.jpg\",\"url\":\"http://apicms.bachmai.gov.vn/documents/0/0/dsc1451.jpg/90bd9f78-e55b-47c3-be7b-e059c64e7ce4\",\"path\":\"http://apicms.bachmai.gov.vn/images/2026/4/14/cb6ff425-ab1e-4e74-b8af-dcd784b6260e_dsc1451.jpg\"},\"categoryId\":null,\"categories\":[{\"id\":\"6fe85f1d-d00b-b3be-1d7d-99e588de7e2e\",\"name\":\"Tin hoạt động Bệnh viện\",\"slug\":\"tin-hoat-ong-benh-vien\"}],\"isFeatured\":true,\"isHomepage\":true}]},\"siteSettings\":[{\"id\":\"9829f09a-f92f-4e4d-9901-8e1af9f3a114\",\"key\":\"header-image\",\"value\":\"\u003cp\u003e\u003cimg src=\\\"https://apicms.bachmai.gov.vn/images/2025/2/19/31d91cc4-154e-4bd7-95ac-73f0d09b8a47_0a710ded-f617-4516-a0d5-aa4692b2363f_mceu_92191181111739953645214.jpg\\\" alt=\\\"\\\" width=\\\"420\\\" height=\\\"56\\\"\u003e\u003c/p\u003e\",\"type\":\"home\",\"creationTime\":\"2025-02-19T17:48:20.8863684\",\"lastModificationTime\":\"2025-02-19T17:49:10.1755412\"},{\"id\":\"805bacee-5ed4-4f1b-959c-e9c27c0e0320\",\"key\":\"book-appointment-cs2\",\"value\":\"\u003cp\u003ehttps://bachmai.gov.vn/bai-viet/lich-kham-va-tu-van-theo-yeu-cau-tai-co-so-ninh-binh-tu-2772026-den-0282026?id=d8166c
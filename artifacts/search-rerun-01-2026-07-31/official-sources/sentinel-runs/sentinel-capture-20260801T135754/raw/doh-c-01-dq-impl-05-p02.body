				function loadChatScript() {
    if (document.getElementById("chative-script")) return;
    const s = document.createElement("script");
    s.id = "chative-script";
    s.src = "https://messenger.svc.chative.io/static/v1.0/channels/sa4bddfb4-f369-42f1-9b12-d80f4a72c33f/messenger.js?mode=livechat";
    s.async = true;
    document.head.appendChild(s);
}

loadChatScript();

if (!window._chativeNavigateBound) {
    window._chativeNavigateBound = true;

    Liferay.on("endNavigate", function () {
        const cleanup = () => {
            document.querySelectorAll('[id^="chative-"], .chative-widget, iframe[src*="chative"]').forEach(el => el.remove());
            const oldScript = document.getElementById("chative-script");
            if (oldScript) oldScript.remove();
        };
        cleanup();
        setTimeout(() => {
            loadChatScript();
        }, 1500);
    });
}

				

				$(document).ready(function() {
    
    //ảnh lỗi => width =0 => thay ảnh mặc định
    document.querySelectorAll('.sticker-img').forEach(function (img) {
        img.onerror = function () {
            this.src = '/documents/131507/0/SoYTe.png/1ae92045-fecf-cf35-3d2d-8731942ee69a';
        };

        if (!img.complete || img.naturalWidth === 0) {
            img.src = '/documents/131507/0/SoYTe.png/1ae92045-fecf-cf35-3d2d-8731942ee69a';
        }
    });
    document.querySelectorAll('.subtext-item').forEach(el => {
        if (el.textContent.trim().startsWith('Vào ngày')) {
            el.remove();
        }
    });

    document.querySelectorAll('.pagination .dropdown-icon').forEach(el => {
        el.classList.add('page-link');
    });

    // Thay đổi "Search ..." thành tiếng Việt
    $('.form-control.input-group-inset.input-group-inset-after.search-bar-keywords-input')
    .attr('placeholder', 'Tìm kiếm ...');


    $('<style>')
    .prop('type', 'text/css')
    .html('.form-control.input-group-inset.input-group-inset-after.search-bar-keywords-input::placeholder { font-style: italic; }')
    .appendTo('head');

    // Thay đổi "Results for" thành tiếng Việt
    var searchLabel = $('.search-total-label').html();
    searchLabel = searchLabel.replace('Results for', 'kết quả cho');
    $('.search-total-label').html(searchLabel);
    
    // Thay đổi "Entries" thành tiếng Việt
    var entriesText = $('.dropdown-toggle.page-link').html();
    entriesText = entriesText.replace('Entries', 'Mục');
    $('.dropdown-toggle.page-link').html(entriesText);
    
    // Thay đổi "of" thành tiếng Việt
    var paginationText = $('.pagination-results').html();
    paginationText = paginationText.replace('of', 'trong');
    $('.pagination-results').html(paginationText);
    
    //Thay background 
    $('.sticker-secondary, .sticker-default').css({
        'background-color': 'transparent',
        'background-image': 'url(/documents/131507/0/SoYTe.png/1ae92045-fecf-cf35-3d2d-8731942ee69a)',
        'background-size': 'cover',
        'background-position': 'center',
        'color': '#FFF'
    });
    
    // xoá icon ở giữa image
    $('svg.lexicon-icon.lexicon-icon-web-content, svg.lexicon-icon.lexicon-icon-page').remove();

    //thay list trang thành ...
    document.querySelectorAll('.dropdown.page-item').forEach(el => {
        const div = document.createElement('div');
        div.className = 'custom-pagination-points';
        div.textContent = '...';
        el.innerHTML = '';
        el.appendChild(div);
    });

});

// Thay ảnh lần 2
$(window).on('load', function() {  

    document.querySelectorAll('.sticker-img').forEach(function (img) {
        img.onerror = function () {
            this.src = '/documents/131507/0/SoYTe.png/1ae92045-fecf-cf35-3d2d-8731942ee69a';
        };

        if (!img.complete || img.naturalWidth === 0) {
            img.src = '/documents/131507/0/SoYTe.png/1ae92045-fecf-cf35-3d2d-8731942ee69a';
        }
    });

    document.querySelectorAll('.subtext-item').forEach(el => {
        if (el.textContent.trim().startsWith('Vào ngày')) {
            el.remove();
        }
    });

    //Thay background lần 2 tránh lỗi
    $('<style>')
    .prop('type', 'text/css')
    .html(`
        .sticker-secondary, .sticker-default {
            background-color: transparent !important;
            background-image: url(/documents/131507/0/SoYTe.png/1ae92045-fecf-cf35-3d2d-8731942ee69a) !important;
            background-size: cover !important;
            background-position: center !important;
            color: #FFF !important;
        }
    `)
    .appendTo('head');
    
    //xoá icon ở giữa image
    $('svg.lexicon-icon.lexicon-icon-web-content, svg.lexicon-icon.lexicon-icon-page').remove();
    setTimeout(resizeStickers, 200);
});

function resizeStickers() {
  if (window.innerWidth < 576) {
    const col = document.querySelector(".list-group-item-flex");
    if (col) {
      const colWidth = col.offsetWidth; 
      const newHeight = colWidth * 3 / 4;
      document.querySelectorAll(".sticker")
        .forEach(sticker => {
          sticker.style.height = newHeight + "px";
        });
    }
  } else {
    document.querySelectorAll(".sticker")
      .forEach(sticker => {
        sticker.style.height = "";
      });
  }
}
			

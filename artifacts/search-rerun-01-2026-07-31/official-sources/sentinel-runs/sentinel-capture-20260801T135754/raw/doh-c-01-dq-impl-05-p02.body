                <option class="custom-option-enabled" style="cursor: pointer !important; color: #2E2E2E !important;" value="https://sontra.danang.gov.vn/" data-target="_blank">UBND Quận Sơn Trà</option>
                <option class="custom-option-enabled" style="cursor: pointer !important; color: #2E2E2E !important;" value="https://nguhanhson.danang.gov.vn/" data-target="_blank">UBND Quận Ngũ Hành Sơn</option>

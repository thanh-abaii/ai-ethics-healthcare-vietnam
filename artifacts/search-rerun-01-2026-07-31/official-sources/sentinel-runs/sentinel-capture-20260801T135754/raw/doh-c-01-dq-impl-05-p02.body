(function() {
    'use strict';
    
    
    // Danh sách các parameters cần loại bỏ
    var parametersToRemove = [
        'reloadpage',
        'refresh',
        'reload',
        'timestamp',
        'cache',
        '_t',
        'debug'
    ];
    
    // URL đích sau khi clean
    var targetURL = 'https://trangthongtinsoyte.sdtech.vn/group/syt/quan-ly-video';
    
    function cleanURL() {
        try {
            var currentURL = window.location.href;
            var url = new URL(currentURL);
            var hasChanges = false;
            
            // Loại bỏ các parameters không mong muốn
            parametersToRemove.forEach(function(param) {
                if (url.searchParams.has(param)) {
                    url.searchParams.delete(param);
                    hasChanges = true;
                }
            });
            
            // Nếu có thay đổi, redirect về URL đích
            if (hasChanges) {
                var cleanedURL = url.toString();
                
                // Nếu sau khi clean thì URL chỉ còn base path, redirect về target
                if (cleanedURL === targetURL || 
                    cleanedURL === targetURL + '?' || 
                    cleanedURL === targetURL + '#') {
                    window.location.href = targetURL;
                } else {
                    window.location.href = cleanedURL;
                }
            }
            
        } catch (e) {
            
            // Fallback method - dùng regex
            fallbackCleanURL();
        }
    }
    
    function fallbackCleanURL() {
        try {
            var currentURL = window.location.href;
            var originalURL = currentURL;
            
            // Loại bỏ từng parameter
            parametersToRemove.forEach(function(param) {
                var regex = new RegExp('[?&]' + param + '=([^&#]*)', 'gi');
                currentURL = currentURL.replace(regex, '');
            });
            
            // Clean up remaining & và ? thừa
            currentURL = currentURL.replace(/[?&]$/, ''); // Remove trailing ? or &
            currentURL = currentURL.replace(/[?]&/, '?'); // Replace ?& with ?
            currentURL = currentURL.replace(/[&]{2,}/g, '&'); // Replace multiple & with single &
            
            if (currentURL !== originalURL) {
                
                // Nếu URL clean rồi thì về target
                if (currentURL === targetURL || 
                    currentURL === targetURL + '?' || 
                    currentURL === targetURL + '#') {
                    window.location.href = targetURL;
                } else {
                    window.location.href = currentURL;
                }
            }
            
        } catch (e) {
        }
    }
    
    // Tự động chạy khi script load
    function autoClean() {
        // Kiểm tra xem có parameters cần loại bỏ không
        var currentSearch = window.location.search;
        var currentURL = window.location.href;
        
        var needsCleaning = parametersToRemove.some(function(param) {
            return currentSearch.includes(param + '=');
        });
        
        if (needsCleaning) {
            cleanURL();
        } 
    }
    
    // Utility functions
    window.URLCleaner = {
        clean: cleanURL,
        addParameterToRemove: function(param) {
            if (parametersToRemove.indexOf(param) === -1) {
                parametersToRemove.push(param);
            }
        },
        removeParameterFromList: function(param) {
            var index = parametersToRemove.indexOf(param);
            if (index > -1) {
                parametersToRemove.splice(index, 1);
            }
        },
        getParametersToRemove: function() {
            return parametersToRemove.slice(); // Return copy
        },
        setTargetURL: function(url) {
            targetURL = url;
        },
        status: function() {
            return {
                currentURL: window.location.href,
                targetURL: targetURL,
                parametersToRemove: parametersToRemove,
                currentParameters: window.location.search
            };
        }
    };
    
    // Chạy ngay khi load
    if (document.readyState === 'loading') {
        if (document.addEventListener) {
            document.addEventListener('DOMContentLoaded', autoClean);
        } else {
            setTimeout(autoClean, 100);
        }
    } else {
        autoClean();
    }
    
    // Chạy ngay lập tức luôn
    setTimeout(autoClean, 0);
})();

// Manual trigger function
function cleanURL() {
    if (window.URLCleaner) {
        window.URLCleaner.clean();
    }
}

// Force clean to target URL
function goToCleanURL() {
    window.location.href = 'https://trangthongtinsoyte.sdtech.vn/group/syt/quan-ly-video';
}

</script>

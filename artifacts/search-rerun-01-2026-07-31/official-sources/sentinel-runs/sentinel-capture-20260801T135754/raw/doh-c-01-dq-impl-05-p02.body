<html>
<head>
    <!-- Add Select2 CSS and JS -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <style>
        li.lienket-li {
            color: #000;
            font-size: 16px;
            font-style: normal;
            font-weight: 700;
            line-height: 130%;
            letter-spacing: 0.024px;
            margin-bottom: 16px;
        }
        .no-margin {
            margin: 0 !important;
        }

        .lien-ket-website #lienKet {
            background: #F6F6F6;

        }
        select.custom-select {
            padding: 10px 12px;
            flex-direction: column;
            align-items: flex-start;
            gap: 30px;
            color: var(--cpblue-182940, #182940);
            font-family: Roboto;
            font-size: 14px;
            font-style: normal;
            font-weight: 500;
            line-height: 130%;
            letter-spacing: 0.175px;
            border-radius: 6px;
            border: 1px solid var(--cpgreyeeeeee, #EEE);
            height: auto;
            position: relative;
            display: inline-block;
            cursor: pointer;
        }
        .title-custom- {
            background-color: #BCE6FE;
            color: rgba(13, 76, 146, 1);

            text-align-last: center;
            padding: 15px;
            font-family: Roboto;
            font-size: 16px;
            font-weight: 700;
            line-height: 20.8px;
            letter-spacing: 0.005em;
            text-align: center;
            text-underline-position: from-font;
            text-decoration-skip-ink: none;

        }
        .custom-select,
        .custom-select option {
            /*color: rgba(119, 119, 119, 0.6);*/
            font-family: Roboto;
            font-size: 14px;
            font-weight: 500;
            line-height: 18.2px;
            letter-spacing: 0.0125em;
            text-align: left;
            text-underline-position: from-font;
            text-decoration-skip-ink: none;
        }


        /* select2 css */
        .website-lien-ket-bottom .select2-container--default .select2-selection--single {
            padding: 10px 12px;
            height: auto;
            border-radius: 6px;
            border: none !important;
        }
        .select2-container .select2-selection--single{
            height: 40px !important;
        }
        .website-lien-ket-bottom .select2-container--default .select2-selection--single .select2-selection__rendered {
            color: #444;
            font-family: Roboto;
            font-size: 16px;
            font-weight: 400;
            line-height: 20px !important;
        }
        .select2-container--default .select2-selection--single .select2-selection__rendered {
            color: #444;
            font-family: Roboto;
            font-size: 16px;
            font-weight: 400;
        }
        .select2-container--default .select2-search--dropdown .select2-search__field {
            border-radius: 4px;
            padding: 8px;
        }
        .select2-results__option {
            padding: 8px 12px;
            font-family: Roboto;
            font-size: 14px;
        }
        .select2-selection__clear{
            display: none !important;
        }

        .select2-container--default .select2-selection--single .select2-selection__arrow{
            top: 8px
        }
        .wrapper-select-lienket{
            padding: 17.5px 15px;
        }
        .select2-results__option[aria-label="Chọn liên kết"] {
            display: none !important;
        }
        .lienket-dropdown-container .portlet-boundary_com_liferay_site_navigation_menu_web_portlet_SiteNavigationMenuPortlet_ {
            width: 33.33% ;
        }
        @media screen and (max-width: 576px) {
            .lienket-dropdown-container .portlet-boundary_com_liferay_site_navigation_menu_web_portlet_SiteNavigationMenuPortlet_ {
                width: 100% !important;
            }
            .lienket-dropdown-container{
                flex-direction: column;
                width: 100% !important;
            }
        }

        .bootstrap-table .fixed-table-container .table thead th[data-field="hoVaTen"] .th-inner{
            width: unset !important ;
        }
        a:hover {
            text-decoration: none !important;
        }
        .menu-item .menu-active{
            color: #FFA300;
        }
        #main-content {
            background-color: #EBFDFF;
        }
        .main_blog_post_content .mbp_thumb_post{
            background-color: #EBFDFF;
        }
        #main-content .yui3-dd-drop{
            background-color: #ffffff;
        }
        .footer-img .bg-footer{
            margin-right: 0px;
        }
        .table-responsive::-webkit-scrollbar {
            display: none; /* Chrome, Safari */
        }
        @media screen and (min-width: 1024px) and (max-width: 1366px) {
            .menu-item .menu-link-item {
                font-size: 12px !important;
            }
            .header-username{
                font-size: 14px ;
            }
            .header-username .mb-0{
                margin-top: 5px !important;
            }
        }
        #title-detail {
    margin-top: 0 !important;
}
        #title-detail .title-divvv{
            margin-top: 0;
        }
    </style>
</head>

<body>
<div class="website-lien-ket-bottom">
    <select class="form-control my-3 custom-select" size="1" onchange="redirectToPage(this.value)">
        <option>Website Sở Ban Ngành</option>
                        <option class="custom-option-enabled" style="cursor: pointer !important; color: #2E2E2E !important;" value="https://noivu.danang.gov.vn/" data-target="_blank">Sở Nội Vụ</option>
                <option class="custom-option-enabled" style="cursor: pointer !important; color: #2E2E2E !important;" value="https://socongthuong.danang.gov.vn/" data-target="_blank">Sở Công Thương Đà Nẵng</option>
                <option class="custom-option-enabled" style="cursor: pointer !important; color: #2E2E2E !important;" value="https://danang.edu.vn/" data-target="_blank">Sở Giáo dục và Đào tạo Đà Nẵng</option>
                <option class="custom-option-enabled" style="cursor: pointer !important; color: #2E2E2E !important;" value="https://taichinh.danang.gov.vn/" data-target="_blank">Sở Tài chính</option>
                <option class="custom-option-enabled" style="cursor: pointer !important; color: #2E2E2E !important;" value="https://snnmt.danang.gov.vn/" data-target="_blank">Sở Nông nghiệp và Môi trường</option>
                <option class="custom-option-enabled" style="cursor: pointer !important; color: #2E2E2E !important;" value="https://sotuphap.danang.gov.vn/" data-target="_blank">Sở Tư pháp</option>
                <option class="custom-option-enabled" style="cursor: pointer !important; color: #2E2E2E !important;" value="https://vhtt.danang.gov.vn/" data-target="_blank">Sở Văn hóa và Thể thao thành phố Đà Nẵng</option>
                <option class="custom-option-enabled" style="cursor: pointer !important; color: #2E2E2E !important;" value="https://sxd.danang.gov.vn/" data-target="_blank">Sở Xây dựng</option>
                <option class="custom-option-enabled" style="cursor: pointer !important; color: #2E2E2E !important;" value="https://dost.danang.gov.vn/" data-target="_blank">Sở Khoa học và Công nghệ Đà Nẵng</option>
                <option class="custom-option-enabled" style="cursor: pointer !important; color: #2E2E2E !important;" value="https://fad.danang.gov.vn/" data-target="_blank">Sở Ngoại vụ</option>
                <option class="custom-option-enabled" style="cursor: pointer !important; color: #2E2E2E !important;" value="https://www.ddif.com.vn/" data-target="_blank">Quỹ Đầu tư phát triển</option>
    </select>
</div>

<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<script>
    $(document).ready(function() {
        $('.custom-select').select2({
            placeholder: "Chọn liên kết",
            allowClear: true,
            width: '100%',
            language: {
                noResults: function() {
                    return "Không tìm thấy kết quả";
                },
                searching: function() {
                    return "Đang tìm kiếm..."
                }
            }
        })
    });

    function redirectToPage(url) {
        if (url) {
            window.open(url, '_blank');
        }
    }
</script>
<script>
$(function() {
  // 1. Chọn menu Trang 1: <a class="ha"> trong .li-new-child
  $('.li-new-child a.ha').each(function() {
    var text = $(this).text().replace(/\s+/g, ' ').trim();
    if (text === 'Văn bản trung ương' || text === 'Văn bản thành phố') {
      $(this).attr('target', '_blank');
    }
  });

  // 2. Chọn menu Trang 2: <a> trong .li-level-3-col, chứa span.span-level-3-col
  $('.ul-level-2-col .li-level-3-col > a').each(function() {
    // Lấy text từ chính thẻ <span> bên trong <a>
    var span = $(this).find('.span-level-3-col').clone();
    span.find('p').remove(); // xóa tooltip <p> bên trong span
    var text = span.text().replace(/\s+/g, ' ').trim();

    if (text === 'Văn bản trung ương' || text === 'Văn bản thành phố') {
      $(this).attr('target', '_blank');
    }
  });
});

</script>

</body>
</html>
			
			
		
	
	
	
	


	
	

					
				
			
		
	
	




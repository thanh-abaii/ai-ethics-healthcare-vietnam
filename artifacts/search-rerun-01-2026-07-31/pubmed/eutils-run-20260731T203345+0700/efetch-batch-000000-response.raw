#x43e; &#x438;&#x441;&#x43f;&#x43e;&#x43b;&#x44c;&#x437;&#x43e;&#x432;&#x430;&#x43d;&#x438;&#x44f; &#x438;&#x442;&#x435;&#x440;&#x430;&#x442;&#x438;&#x432;&#x43d;&#x44b;&#x43c; &#x441;&#x43f;&#x43e;&#x441;&#x43e;&#x431;&#x43e;&#x43c; &#x441;&#x43e;&#x442;&#x440;&#x443;&#x434;&#x43d;&#x438;&#x43a;&#x430;&#x43c;&#x438; &#x43a;&#x43b;&#x438;&#x43d;&#x438;&#x43a;&#x438;.</AbstractText><AbstractText Label="&#x412;&#x42b;&#x412;&#x41e;&#x414;&#x42b;" NlmCategory="UNASSIGNED">&#x414;&#x43b;&#x44f; &#x440;&#x430;&#x437;&#x440;&#x430;&#x431;&#x43e;&#x442;&#x43a;&#x438; &#x438; &#x432;&#x43d;&#x435;&#x434;&#x440;&#x435;&#x43d;&#x438;&#x44f; &#x442;&#x435;&#x445;&#x43d;&#x43e;&#x43b;&#x43e;&#x433;&#x438;&#x439; &#x446;&#x438;&#x444;&#x440;&#x43e;&#x432;&#x43e;&#x433;&#x43e; &#x437;&#x434;&#x440;&#x430;&#x432;&#x43e;&#x43e;&#x445;&#x440;&#x430;&#x43d;&#x435;&#x43d;&#x438;&#x44f; &#x43d;&#x435;&#x43e;&#x431;&#x445;&#x43e;&#x434;&#x438;&#x43c; &#x444;&#x443;&#x43d;&#x43a;&#x446;&#x438;&#x43e;&#x43d;&#x430;&#x43b;&#x44c;&#x43d;&#x43e; &#x441;&#x43e;&#x432;&#x43c;&#x435;&#x441;&#x442;&#x438;&#x43c;&#x44b;&#x439; &#x438; &#x441;&#x43e;&#x43e;&#x442;&#x432;&#x435;&#x442;&#x441;&#x442;&#x432;&#x443;&#x44e;&#x449;&#x438;&#x439; &#x43f;&#x43b;&#x430;&#x43d; &#x443;&#x43f;&#x440;&#x430;&#x432;&#x43b;&#x435;&#x43d;&#x438;&#x44f; &#x434;&#x430;&#x43d;&#x43d;&#x44b;&#x43c;&#x438;, &#x432;&#x43a;&#x43b;&#x44e;&#x447;&#x430;&#x44f; &#x441;&#x431;&#x43e;&#x440;, &#x43e;&#x431;&#x43c;&#x435;&#x43d; &#x438; &#x438;&#x43d;&#x442;&#x435;&#x433;&#x440;&#x430;&#x446;&#x438;&#x44e;. &#x418;&#x441;&#x441;&#x43b;&#x435;&#x434;&#x43e;&#x432;&#x430;&#x43d;&#x438;&#x44f; &#x43f;&#x43e; &#x432;&#x43e;&#x432;&#x43b;&#x435;&#x447;&#x435;&#x43d;&#x438;&#x44e; &#x438; &#x432;&#x43d;&#x435;&#x434;&#x440;&#x435;&#x43d;&#x438;&#x44e; &#x434;&#x43e;&#x43b;&#x436;&#x43d;&#x44b; &#x440;&#x430;&#x437;&#x440;&#x430;&#x431;&#x430;&#x442;&#x44b;&#x432;&#x430;&#x442;&#x44c;&#x441;&#x44f; &#x438; &#x43f;&#x440;&#x43e;&#x4
    <script>
        WebControlConfig.isHomePage = true;
        $(document).ready(function () {
            //WebControl.initLoadMore();

            // Business Slider
            var businessSlider = {
                track: $('.c-business-slider__track'),
                items: $('.c-business-item'),
                prevBtn: $('.c-business-slider__btn--prev'),
                nextBtn: $('.c-business-slider__btn--next'),
                currentIndex: 0,
                itemsToShow: 5,
                itemWidth: 0,
                totalItems: 0,

                init: function() {
                    this.totalItems = this.items.length;
                    this.updateItemWidth();
                    this.bindEvents();
                    this.updateButtons();

                    // Touch/swipe support
                    var startX = 0;
                    var currentX = 0;
                    var isDragging = false;
                    var self = this;

                    this.track.on('mousedown touchstart', function(e) {
                        isDragging = true;
                        startX = e.type === 'touchstart' ? e.originalEvent.touches[0].clientX : e.clientX;
                        self.track.css('cursor', 'grabbing');
                    });

                    $(document).on('mousemove touchmove', function(e) {
                        if (!isDragging) return;
                        currentX = e.type === 'touchmove' ? e.originalEvent.touches[0].clientX : e.clientX;
                    });

                    $(document).on('mouseup touchend', function() {
                        if (!isDragging) return;
                        isDragging = false;
                        self.track.css('cursor', 'grab');

                        var diffX = startX - currentX;
                        if (Math.abs(diffX) > 50) {
                            if (diffX > 0) {
                                self.next();
                            } else {
                                self.prev();
                            }
                        }
                    });
                },

                updateItemWidth: function() {
                    var containerWidth = $('.c-business-slider__wrapper').width();
                    var gap = 20;

                    if ($(window).width() < 768) {
                        this.itemsToShow = 1;
                    } else if ($(window).width() < 1024) {
                        this.itemsToShow = 3;
                    } else {
                        this.itemsToShow = 5;
                    }

                    this.itemWidth = (containerWidth - (gap * (this.itemsToShow - 1))) / this.itemsToShow;
                    this.items.css('width', this.itemWidth + 'px');
                },

                bindEvents: function() {
                    var self = this;
                    this.prevBtn.on('click', function() { self.prev(); });
                    this.nextBtn.on('click', function() { self.next(); });

                    $(window).on('resize', function() {
                        self.updateItemWidth();
                        self.updatePosition(false);
                    });
                },

                prev: function() {
                    if (this.currentIndex > 0) {
                        this.currentIndex--;
                        this.updatePosition();
                    }
                },

                next: function() {
                    var maxIndex = this.totalItems - this.itemsToShow;
                    if (this.currentIndex < maxIndex) {
                        this.currentIndex++;
                        this.updatePosition();
                    }
                },

                updatePosition: function(animate) {
                    animate = animate !== false;
                    var gap = 20;
                    var translateX = -(this.currentIndex * (this.itemWidth + gap));

                    if (animate) {
                        this.track.css({
                            'transform': 'translateX(' + translateX + 'px)',
                            'transition': 'transform 0.3s ease'
                        });
                    } else {
                        this.track.css({
                            'transform': 'translateX(' + translateX + 'px)',
                            'transition': 'none'
                        });
                    }

                    this.updateButtons();
                },

                updateButtons: function() {
                    this.prevBtn.prop('disabled', this.currentIndex === 0);
                    this.nextBtn.prop('disabled', this.currentIndex >= this.totalItems - this.itemsToShow);
                }
            };

            if ($('.c-business-slider').length) {
                businessSlider.init();
            }
        });
    </script>


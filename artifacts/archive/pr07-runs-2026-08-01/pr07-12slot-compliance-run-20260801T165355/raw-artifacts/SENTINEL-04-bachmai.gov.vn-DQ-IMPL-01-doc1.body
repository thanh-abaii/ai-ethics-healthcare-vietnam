04-f63537e5211f"><svg class="w-7 h-7 text-brand"><use xlink:href="/assets/svgsprite/sprite.svg#icon-flower"></use></svg><span class="whitespace-nowrap">Đào tạo, chỉ đạo tuyến</span></a></li><li class=""><a title="Thư viện hình ảnh" class="flex items-center" target="_self" href="/thu-vien-anh?id=51a9e464-6b4e-2c64-178b-e96d83bbca1d"><svg class="w-7 h-7 text-brand"><use xlink:href="/assets/svgsprite/sprite.svg#icon-flower"></use></svg><span class="whitespace-nowrap">Thư viện hình ảnh</span></a></li><li class=""><a title="Thư viện video" class="flex items-center" target="_self" href="/thu-vien-video?id=51a9e464-6b4e-2c64-178b-e96d83bbca1d"><svg class="w-7 h-7 text-brand"><use xlink:href="/assets/svgsprite/sprite.svg#icon-flower"></use></svg><span class="whitespace-nowrap">Thư viện video</span></a></li></ul></li><li class="menu-item "><a class="link-menu flex items-center space-x-2" target="_self" href=" /chuyen-muc/thong-tin-tuyen-dung?id=d671d286-cb7e-4d1a-a742-d324ceef6158"><span>Thông tin tuyển dụng</span></a></li><li class="menu-item "><a class="link-menu flex items-center space-x-2" target="_self" href="#"><span>Dành cho bệnh nhân</span><svg class="w-2.5 h-2.5 text-main"><use xlink:href="/assets/svgsprite/sprite.svg#icon-arrow-down"></use></svg></a><ul class="list-menu-child"><li class=""><a title="Tư vấn và Tiêm chủng Vắc xin" class="flex items-center" target="_self" href=" /chuyen-muc/tu-van-va-tiem-chung-vac-xin?id=71f1c417-aa8b-40af-ac6a-b174b520cef1"><svg class="w-7 h-7 text-brand"><use xlink:href="/assets/svgsprite/sprite.svg#icon-flower"></use></svg><span class="whitespace-nowrap">Tư vấn và Tiêm chủng Vắc xin</span></a></li><li class=""><a title="Hướng dẫn và Quy trình khám chữa bệnh" class="flex items-center" target="_self" href="/chuyen-muc/huong-dan-kham-chua-benh-258?id=49a0cfb4-2d21-d9b8-6e2f-e85f6f82e8d2"><svg class="w-7 h-7 text-brand"><use xlink:href="/assets/svgsprite/sprite.svg#icon-flower"></use></svg><span class="whitespace-nowrap">Hướng dẫn và Quy trình khám chữa bệnh</span></a></li><li class=""><a title="Bảng giá dịch vụ bệnh viện" class="flex items-center" target="_self" href="/chuyen-muc/bang-gia-dich-vu-benh-vien?id=f110e771-fb8e-f4bd-8b3f-c590057ac439"><svg class="w-7 h-7 text-brand"><use xlink:href="/assets/svgsprite/sprite.svg#icon-flower"></use></svg><span class="whitespace-nowrap">Bảng giá dịch vụ bệnh viện</span></a></li><li class=""><a title="Chế độ chính sách" class="flex items-center" target="_self" href="/chuyen-muc/che-do-chinh-sach?id=27c106ac-2ee1-13f1-d767-54a50273b0d7"><svg class="w-7 h-7 text-brand"><use xlink:href="/assets/svgsprite/sprite.svg#icon-flower"></use></svg><span class="whitespace-nowrap">Chế độ chính sách</span></a></li><li class=""><a title="Nhịp cầu nhân ái" class="flex items-center" target="_self" href="/chuyen-muc/nhip-cau-an-ai?id=5f378e4b-f605-9119-c818-27e5225b973f"><svg class="w-7 h-7 text-brand"><use xlink:href="/assets/svgsprite/sprite.svg#icon-flower"></use></svg><span class="whitespace-nowrap">Nhịp cầu nhân ái</span></a></li></ul></li><li class="menu-item "><a class="link-menu flex items-center space-x-2" target="_self" href="/chuyen-muc/hop-thu-ban-doc?id=9ee624ad-868c-5a95-becd-52f35ae338ed"><span>Hộp thư bạn đọc</span></a></li><li class="menu-item "><a class="link-menu flex items-center space-x-2" target="_self" href="#"><span>Bach Mai Family</span><svg class="w-2.5 h-2.5 text-main"><use xlink:href="/assets/svgsprite/sprite.svg#icon-arrow-down"></use></svg></a><ul class="list-menu-child"><li class=""><a title="Thông tin nội bộ" class="flex items-center" target="_self" href="/chuyen-muc/thong-tin-noi-bo?id=d0307b27-e830-4995-be3c-cd07e020c503"><svg class="w-7 h-7 text-brand"><use xlink:href="/assets/svgsprite/sprite.svg#icon-flower"></use></svg><span class="whitespace-nowrap">Thông tin nội bộ</span></a></li></ul></li></ul></nav></div></div><div class="flex-1"><div class="post-detail mb-60"><div class="container pt-md-4 pt-2"><div class="row"><div class="col-md-2 d-md-block d-none"><div class="sticky top-0 d-flex align-items-center flex-column"><div class="post-detail__share d-flex align-items-center align-items-center flex-column w-100"><span class="mb-3">Chia sẻ</span><ul><li class="mb-3"><div class="fb-share-button" data-href="https://developers.facebook.com/docs/plugins/" data-layout="" data-size=""><a title="Chia sẻ lên facebook" target="_blank" class="fb-xfbml-parse-ignore" href="https://www.facebook.com/sharer/sharer.php?u="><svg class="w-8 h-8 text-main"><use xlink:href="/assets/svgsprite/sprite.svg#icon-facebook-2"></use></svg></a></div></li><li class="mb-3"><a title="Chat với chúng tôi qua messager" target="_blank" href="https://www.facebook.com/messages/t/111400055865569"><svg class="w-8 h-8 text-main"><use xlink:href="/assets/svgsprite/sprite.svg#icon-messenger"></use></svg></a></li><li class="mb-3"><a title="Chat với chúng tôi qua zalo" target="_blank" href="http://zalo.me/benhvienbachmai"><svg class="w-8 h-8 text-main"><use xlink:href="/assets/svgsprite/sprite.svg#icon-zalo-2"></use></svg></a></li><li class="mb-3"><span class="cursor-pointer" title="Sao chép đường dẫn"><svg class="w-8 h-8 text-main"><use xlink:href="/assets/svgsprite/sprite.svg#icon-url"></use></svg></span></li><li class="mb-3" title="In bài viết này"><button><svg class="w-8 h-8 text-main"><use xlink:href="/assets/svgsprite/sprite.svg#icon-print"></use></svg></button></li></ul></div></div></div><div class="col-md-6" id="content-post"><div id="title-print" class="mb-6"><img src="/logo/logo.png" alt="Bệnh viện Bạch Mai"/><span class="mt-3 d-block">Ngày đăng: <!-- -->07/03/2025</span><span>Tác giả: <!-- -->Bài ảnh: Nguyên Hà - Thành Dương</span></div><h3 class="h3">Ứng dụng trí tuệ nhân tạo góp phần nâng cao hiệu quả chẩn đoán, điều trị bệnh ung thư phổi</h3><div class="post-detail__content mt-3 d-flex d-none d-md-flex"><div class="post-detail__content-item"><svg class="w-5 h-5 text-brand"><use xlink:href="/assets/svgsprite/sprite.svg#icon-clock-2"></use></svg><span>07/03/2025</span></div><div class="post-detail__content-item"><svg class="w-5 h-5 text-brand"><use xlink:href="/assets/svgsprite/sprite.svg#icon-eye"></use></svg><span>1799<!-- --> lượt xem</span></div><a class="post-detail__sub cursor-pointer" href="/chuyen-muc/bai-viet-chuyen-mon?id=d89b2ecb-6b98-3a76-4026-6bc7202eed4e">Bài viết chuyên môn</a></div><div class="content-excerpt mt-6 break-words" style="font-size:var(--font-size)"><div><p class="MsoNormal" style="text-align: justify; line-height: 17.0pt; mso-line-height-rule: exactly; margin: 6.0pt 0cm 6.0pt 0cm;"><span style="font-size: 12.0pt;">Ứng dụng tr&iacute; tuệ nh&acirc;n tạo (AI) trong y học cận l&acirc;m s&agrave;ng mang lại nhiều lợi &iacute;ch cho người bệnh v&agrave; đội ngũ y b&aacute;c sĩ. Đ&acirc;y l&agrave; c&ocirc;ng cụ đắc lực hỗ trợ c&aacute;c b&aacute;c sĩ trong chẩn đo&aacute;n v&agrave; điều trị bệnh, tối ưu ho&aacute; hiệu suất, năng suất l&agrave;m việc của c&aacute;n bộ y tế, cải thiện v&agrave; n&acirc;ng cao chất lượng chuy&ecirc;n m&ocirc;n cũng như dịch vụ kh&aacute;m chữa bệnh, r&uacute;t ngắn thời gian chờ đợi của người bệnh, giảm thiểu bỏ s&oacute;t tổn thương, ph&aacute;t hiện, chẩn đo&aacute;n bệnh đ&uacute;ng, sớm.</span></p></div></div><div class="content-editor content-editor-post mt-2 break-words" style="font-size:var(--font-size)"><div><p class="MsoNormal" style="text-align: justify; line-height: 17.0pt; mso-line-height-rule: exactly; margin: 6.0pt 0cm 6.0pt 0cm;"><span style="font-size: 12.0pt;">Hội thảo khoa học: &ldquo;Giới thiệu, vận h&agrave;nh hệ thống t&iacute;ch hợp phần mềm tr&ecirc;n 3 cơ sở dữ liệu: CT lồng ngực, Nội soi phế quản v&agrave; m&ocirc; bệnh học trong chẩn đo&aacute;n ung thư phổi&rdquo; diễn ra ng&agrave;y 6/3 tại Bệnh viện Bạch Mai. Tại hội thảo, c&aacute;c chuy&ecirc;n gia, ph&oacute; gi&aacute;o sư, tiến sĩ, b&aacute;c sĩ đầu ng&agrave;nh v&agrave; nh&oacute;m nghi&ecirc;n cứu đ&atilde; đưa ra những kết quả thử nghiệm c&aacute;c module phần mềm ph&aacute;t hiện v&agrave; chẩn đo&aacute;n ung thư phổi đ&aacute;ng ch&uacute; &yacute; v&agrave; hết sức tiềm năng.</span></p>
<p class="MsoNormal" style="text-align: justify; line-height: 17.0pt; mso-line-height-rule: exactly; margin: 6.0pt 0cm 6.0pt 0cm;"><span style="font-size: 12.0pt;">Chương tr&igrave;nh c&oacute; sự tham gia đ&ocirc;ng đảo của c&aacute;c c&aacute; nh&acirc;n, đơn vị, tổ chức, cơ sở y tế trong ngo&agrave;i Bệnh viện Bạch Mai như: Viện Tr&iacute; tuệ nh&acirc;n tạo, Đại học C&ocirc;ng nghệ, Bệnh viện Đại học Y H&agrave; Nội, Bệnh viện K, c&aacute;c Trung t&acirc;m thuộc Bệnh viện Bạch Mai gồm: <span style="mso-spacerun: yes;">&nbsp;</span>Trung t&acirc;m H&ocirc; Hấp, Trung t&acirc;m Điện Quang, Trung t&acirc;m Y học hạt nh&acirc;n v&agrave; Ung bướu.</span></p>
<p class="MsoNormal" style="text-align: justify; line-height: 17.0pt; mso-line-height-rule: exactly; margin: 6.0pt 0cm 6.0pt 0cm;"><span style="font-size: 12.0pt;">C&oacute; thể n&oacute;i rằng, trong cuộc c&aacute;ch mạng số, ng&agrave;nh y tế Việt Nam n&oacute;i chung v&agrave; Bệnh viện Bạch Mai n&oacute;i ri&ecirc;ng đ&atilde; ứng dụng c&ocirc;ng nghệ AI trong phục vụ chuy&ecirc;n m&ocirc;n kh&aacute;m chữa bệnh từ sớm.</span></p>
<p class="MsoNormal" style="line-height: 17pt; margin: 6pt 0cm; text-align: center;"><span style="font-size: 12.0pt;"><img src="https://apicms.bachmai.gov.vn/images/2025/3/7/001b4396-e78c-4788-955b-2c560320c1b0_mceu_94350300111741316350880.jpg"></span></p>
<p class="MsoNormal" style="line-height: 17pt; margin: 6pt 0cm; text-align: center;"><span style="font-size: 12pt; color: #3598db;">PGS.TS Vũ Văn Gi&aacute;p - Ph&oacute; Gi&aacute;m đốc Bệnh viện ph&aacute;t biểu tại Hội thảo, nhấn mạnh vai tr&ograve; của AI trong việc hỗ trợ c&aacute;c b&aacute;c sĩ trong chẩn đo&aacute;n v&agrave; điều trị bệnh&nbsp;</span></p>
<p class="MsoNormal" style="text-align: justify; line-height: 17.0pt; mso-line-height-rule: exactly; margin: 6.0pt 0cm 6.0pt 0cm;"><span style="font-size: 12.0pt;">&ldquo;Khi chưa c&oacute; ứng dụng AI, c&aacute;c b&aacute;c sĩ <span style="mso-spacerun: yes;">&nbsp;</span>kh&aacute; vất vả để đưa ra quyết định ch&iacute;nh x&aacute;c. Ứng dựng tr&iacute; tuệ nh&acirc;n tạo trong kh&aacute;m chữa bệnh, c&aacute;c b&aacute;c sĩ c&oacute; th&ecirc;m nhiều th&ocirc;ng tin hữu &iacute;ch, nhận định được tổn thương ph&aacute;t hiện từ sớm, kh&ocirc;ng bỏ s&oacute;t tổn thương, từ đ&oacute; đưa ra những quyết định, chẩn đo&aacute;n ch&iacute;nh x&aacute;c hơn, lựa chọn ph&aacute;c đồ điều trị tối ưu, c&aacute; thể ho&aacute;, ph&ugrave; hợp với từng thể trạng người bệnh. Lợi &iacute;ch tr&iacute; tuệ nh&acirc;n tạo mang lại thực sự l&agrave; một cuộc c&aacute;ch mạng, gi&uacute;p y b&aacute;c sĩ tối ưu hiệu suất l&agrave;m việc, chẩn đo&aacute;n điều trị, tăng chất lượng chuy&ecirc;n m&ocirc;n v&agrave; giảm thời gian chờ đợi người bệnh&rdquo;, PGS. TS Vũ Văn Gi&aacute;p - Ph&oacute; Gi&aacute;m đốc Bệnh viện Bạch Mai chia sẻ.</span></p>
<p class="MsoNormal" style="text-align: justify; line-height: 17.0pt; mso-line-height-rule: exactly; margin: 6.0pt 0cm 6.0pt 0cm;"><span style="font-size: 12.0pt;">Sau 2 năm miệt m&agrave;i, với đề t&agrave;i nghi&ecirc;n cứu cấp nh&agrave; nước về c&aacute;c modul phần mềm ph&aacute;t hiện v&agrave; chẩn đo&aacute;n ung thư phổi dựa tr&ecirc;n h&igrave;nh ảnh CT Lồng ngực, ảnh nội soi phế quả, ảnh m&ocirc; bệnh học tại c&aacute;c cơ sở y tế, c&aacute;c th&agrave;nh vi&ecirc;n của nh&oacute;m nghi&ecirc;n cứu hết sức nỗ lực, <span style="mso-spacerun: yes;">&nbsp;</span>đạt được c&aacute;c chỉ ti&ecirc;u của Bộ Khoa học c&ocirc;ng nghệ. Kết quả đ&aacute;nh gi&aacute; về độ nhạy, độ đặc hiệu, ph&aacute;t hiện được c&aacute;c tổn thương ung thư phổi đạt được c&aacute;c chỉ ti&ecirc;u, hết sức tiềm năng, c&oacute; thể ứng dụng để triển khai trong thực tế. </span></p>
<p class="MsoNormal" style="text-align: justify; line-height: 17.0pt; mso-line-height-rule: exactly; margin: 6.0pt 0cm 6.0pt 0cm;"><span style="font-size: 12.0pt;">&ldquo;Khi kết quả được nghiệm thu sẽ chuyển giao, hỗ trợ cho c&aacute;c cơ sở y tế tr&ecirc;n cả nước. Cụ thể, chỉ cần c&oacute; h&igrave;nh ảnh chụp cắt lớp vi t&iacute;nh, h&igrave;nh ảnh nội soi, h&igrave;nh ảnh m&ocirc; bệnh học đẩy về Bệnh viện Bạch Mai, sau một thời gian rất nhanh sẽ c&oacute; kết quả trả về cho c&aacute;c cơ sở y tế đối chiếu, r&agrave; so&aacute;t. V&agrave; với lượng dữ liệu ng&agrave;y c&agrave;ng lớn, cập nhật thường xuy&ecirc;n, m&aacute;y chủ tinh chỉnh, th&ocirc;ng minh hơn, ch&uacute;ng ta sẽ c&oacute; một sản phẩm Tr&iacute; tuệ Việt, Kh&aacute;t vọng Việt phục vụ chăm s&oacute;c sức khoẻ cho người d&acirc;n&rdquo;,<span style="mso-spacerun: yes;">&nbsp; </span>PGS. TS Vũ Văn Gi&aacute;p b&agrave;y tỏ kỳ vọng.</span></p>
<p class="MsoNormal" style="text-align: justify; line-height: 17.0pt; mso-line-height-rule: exactly; margin: 6.0pt 0cm 6.0pt 0cm;"><span style="font-size: 12.0pt;">Cũng tại Hội thảo khoa học, c&aacute;c chuy&ecirc;n gia, nh&oacute;m nghi&ecirc;n cứu đ&aacute;nh gi&aacute;, c&aacute;c modul phần mềm ph&aacute;t hiện v&agrave; chẩn đo&aacute;n ung thư phổi dựa tr&ecirc;n h&igrave;nh ảnh CT Lồng ngực, ảnh nội soi phế quản, ảnh m&ocirc; bệnh học bước đầu đ&atilde; c&oacute; những bước tiến ph&aacute;t triển, tuy nhi&ecirc;n cần li&ecirc;n tục tinh chỉnh, bổ sung để kết quả ng&agrave;y c&agrave;ng s&aacute;t, ho&agrave;n thiện hơn chẩn đo&aacute;n ung thư phổi, tạo tiền đề ph&aacute;t triển c&aacute;c phần mềm AI để hỗ trợ c&aacute;c y b&aacute;c sĩ.</span></p>
<p class="MsoNormal" style="text-align: justify; line-height: 17.0pt; mso-line-height-rule: exactly; margin: 6.0pt 0cm 6.0pt 0cm;"><span style="font-size: 12.0pt;">&ldquo;Bộ dữ liệu (CT Lồng ngực, Nội soi phế quản, M&ocirc; bệnh học) đ&atilde; thu thập nh&igrave;n chung đảm bảo chất lượng để huấn luyện c&aacute;c m&ocirc; h&igrave;nh AI hỗ trợ chẩn đo&aacute;n ung thư phổi cho kết quả khả quan tr&ecirc;n dữ liệu kiểm thử thực tế. C&aacute;c module AI hỗ trợ chẩn đo&aacute;n UTP dựa tr&ecirc;n h&igrave;nh ảnh CT Lồng ngực, ảnh nội soi phế quản, ảnh m&ocirc; bệnh học được t&iacute;ch hợp v&agrave;o c&aacute;c hệ thống hiện c&oacute; (PACS, NSPQ) c&oacute; hiệu suất cao, cho thấy khả năng triển khai thực tế, kh&ocirc;ng thay đổi tới quy tr&igrave;nh chẩn đo&aacute;n hiện tại của b&aacute;c sỹ&rdquo;, c&aacute;c chuy&ecirc;n gia chỉ ra kết quả thử nghiệm.</span></p>
<p class="MsoNormal" style="text-align: justify; line-height: 17.0pt; mso-line-height-rule: exactly; margin: 6.0pt 0cm 6.0pt 0cm;"><span style="font-size: 12.0pt;"><img src="https://apicms.bachmai.gov.vn/images/2025/3/7/c64383ec-c04f-4697-9998-36dccc6dd48f_mceu_51282412721741316510386.jpg"></span></p>
<p class="MsoNormal" style="line-height: 17pt; margin: 6pt 0cm; text-align: center;"><span style="font-size: 12pt; color: #3598db;">Nh&oacute;m nghi&ecirc;n cứu v&agrave; c&aacute;c đại biểu thể hiện quyết t&acirc;m sẽ cho ra đời một sản phẩm Tr&iacute; tuệ Việt, kh&aacute;t vọng Việt phục vụ chăm s&oacute;c sức khỏe cho người d&acirc;n</span></p>
<p class="MsoNormal" style="text-align: justify; line-height: 17.0pt; mso-line-height-rule: exactly; margin: 6.0pt 0cm 6.0pt 0cm;"><span style="font-size: 12.0pt;">Ung thư phổi l&agrave; một trong những bệnh c&oacute; tỷ lệ mắc v&agrave; tử vong đứng h&agrave;ng thứ 2 tại Việt Nam v&agrave; Thế giới, nguy cơ ng&agrave;y c&agrave;ng tăng. Vấn đề đặt ra l&agrave; phải s&agrave;ng lọc, ph&aacute;t hiện, chẩn đo&aacute;n sớm mới cứu được người bệnh. Tại Việt Nam, mặc d&ugrave; ph&aacute;c đồ điều trị đ&atilde; c&oacute; nhiều tiến bộ, ph&aacute;t triển tuy nhi&ecirc;n tỷ lệ ph&aacute;t hiện bệnh sớm vẫn c&ograve;n hạn chế. AI c&oacute; thể hỗ trợ v&agrave; cải thiện vấn đề n&agrave;y.</span></p>
<p class="MsoNormal" style="text-align: justify; line-height: 17.0pt; mso-line-height-rule: exactly; margin: 6.0pt 0cm 6.0pt 0cm;"><span style="font-size: 12.0pt;">C&aacute;c chuy&ecirc;n gia, nh&oacute;m nghi&ecirc;n cứu đều đồng quan điểm rằng, AI - Tr&iacute; tuệ nh&acirc;n tạo kh&ocirc;ng thể thay thế ho&agrave;n to&agrave;n c&aacute;c y b&aacute;c sĩ. Qu&aacute; tr&igrave;nh x&acirc;y dựng dữ liệu, gắn nh&atilde;n, quy tr&igrave;nh vận h&agrave;nh phải tu&acirc;n thủ, đảm bảo độ chuẩn x&aacute;c, AI mới hỗ trợ được tối đa cho c&aacute;c y b&aacute;c sĩ trong qu&aacute; tr&igrave;nh chẩn đo&aacute;n v&agrave; điều trị. </span></p></div></div><div></div><h5 class="h5 post-author"><strong class="text-right d-block py-4">Bài ảnh: Nguyên Hà - Thành Dương</strong></h5><hr/></div><div class="col-md-4"><div class="post-detail__booking   d-flex justify-content-center   flex-column   align-items-center   sticky   top-0   "><a class="pt-3" target="_blank" href="https://dkkham.bachmai.gov.vn/?lang=vi"><img src="/assets/images/category-detail/banner-detail-bookingvn.svg" alt="Banner 1"/></a><a class="pt-3" target="_blank" href="https://www.facebook.com/ivf.bvbachmai?mibextid=wwXIfr&amp;amp;rdid=3T7idKPcBTOMoHIp&amp;amp;share_url=https%3A%2F%2Fwww.facebook.com%2Fshare%2F19iG4mTy8p%2F%3Fmibextid%3DwwXIfr"><img src="/assets/images/category-detail/banner2vn.jpg" alt="Banner 2"/></a></div></div></div><div class="row mt-64"><h1 class="h4 font-700 mb-4">Tin tức cùng chuyên mục</h1><div class="col-md-6 col-sm-12 col-12"><div class="post-category-item"><a title="Bài 2: Quản lý suy tim tại nhà: Dùng thuốc đúng, nhận biết dấu hiệu nguy hiểm" class="post-item post-item-bg d-block" href="/bai-viet/bai-2-quan-ly-suy-tim-tai-nha-dung-thuoc-dung-nhan-biet-dau-hieu-nguy-hiem?id=59211c4d-5df9-431c-8bea-03059bb80070"><div class="base-image"><div class="base-image__item" style="padding-bottom:60%"><img alt="" loading="lazy" width="600" height="400" decoding="async" data-nimg="1" style="color:t
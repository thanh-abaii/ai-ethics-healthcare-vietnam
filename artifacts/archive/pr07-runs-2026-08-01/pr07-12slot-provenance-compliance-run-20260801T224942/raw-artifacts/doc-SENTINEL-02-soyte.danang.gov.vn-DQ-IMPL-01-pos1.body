<script>
$(document).ready(function(){
    $('#carouselExampleIndicators').carousel({
        interval: 5000
    });
    
    function handleVideoLoading() {
        $('.video-syt').each(function() {
            var video = $(this);
            var placeholder = video.parent().find('.video-placeholder');
            
            function showVideo() {
                video.addClass('loaded');
                placeholder.fadeOut(300);
                
                setTimeout(function() {
                    if (video[0].readyState >= 3) {
                        video.attr('controls', 'controls');
                    }
                }, 100);
            }
            
            if (video[0].readyState >= 3) {
                showVideo();
            } else {
                video.on('canplay loadeddata', function() {
                    showVideo();
                });
                
                video.on('error', function() {
                    placeholder.html('<div style="color: white; text-align: center; padding: 10px;">Unable to load video</div>');
                });
                
                setTimeout(function() {
                    if (!video.hasClass('loaded') && video[0].readyState < 3) {
                        video[0].load();
                    }
                }, 1000);
            }
        });
    }
    
    handleVideoLoading();
    
    $('#carouselExampleIndicators').on('slid.bs.carousel', function() {
        handleVideoLoading();
    });
});
</script>

	.ratings {
		display: flex;
		flex-direction: row-reverse;
	}

	.ratings span {
		cursor: pointer;
		transition: color 0.8s ease;
		font-size: 50px;
	}

	.ratings span:hover {
		transition: color 0.8s ease;
		color: #FDE16D;
	}

	.ratings span:hover ~ span {
		transition: color 0.8s ease;
		color: #FDE16D;
	}

	.ratings span[data-clicked] {
		color: #FDE16D;
	}

	.ratings span[data-clicked] ~ span {
		color: #FDE16D;
	}


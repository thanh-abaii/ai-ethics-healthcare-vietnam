	/* Nút play overlay */
	.video-play-button {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		width: 60px;
		height: 60px;
		background: rgba(0, 0, 0, 0.7);
		border: 3px solid #fff;
		border-radius: 50%;
		cursor: pointer;
		z-index: 10;
		display: flex;
		align-items: center;
		justify-content: center;
		transition: all 0.3s ease;
	}

	.video-play-button:hover {
		background: rgba(0, 0, 0, 0.9);
		transform: translate(-50%, -50%) scale(1.1);
	}

	.video-play-button::before {
		content: '';
		width: 0;
		height: 0;
		border-style: solid;
		border-width: 15px 0 15px 25px;
		border-color: transparent transparent transparent #fff;
		margin-left: 5px;
	}

	.video-play-button.playing {
		display: none;
	}

	.social-buttons {
		display: flex;
	}

	.article-head {
		margin-bottom: 0;
	}

	.botting-border {
		color: #292a32;
		background: unset;
		font-family: "Roboto";
		text-transform: unset;
		font-weight: bold;
		font-size: 20px;
		margin-bottom: 15px;
		border-bottom: 3px solid #d1d2d4;
	}

	.buttonIn {
		position: relative;
	}

	.btnsend {
		color: #FFF;
		border-color: #f70000;

	.star {
		position: relative;
		display: inline-block;
		transition: color 0.2s ease;
		color: #ebebeb;
	}

	.star:before {
		content: '\2605';
		width: 30px;
		height: 30px;
		font-size: 30px;
	}

	.star:hover,
	.star.selected,
	.star:hover ~ .star,
	.star.selected ~ .star {
		transition: color 0.8s ease;
		color: #FDE16D;
	}

	.ratings-wrapper {
		display: inline-block;
		margin-bottom: 20px;

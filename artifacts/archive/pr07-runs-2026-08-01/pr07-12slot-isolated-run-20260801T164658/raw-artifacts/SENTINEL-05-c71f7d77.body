<div class="bg_section div_chuyenkhoa pt_15 pb_35">
    <h2 class="cl_head sz_24 font_hel text-uppercase text-center">
        <div class="div_head div_head_mobile sz_mb_18 pb_15">
        CHUYÊN KHOA        </div>
    </h2>
        <div class="container">
        <div class="row  pt_15">
		
            <div class="col-xs-12">
                <div class="slide_show3_center owl-carousel  owl-theme ">
                    <div class='item bg_white home_khoa pl_15 pr_15'><div class='bg_white'><div class="item khoa_item bg_white text-center">
    <div class=" item_box">
        <div class="info_khoa pt_15 pb_15 pl_15 pr_15">
